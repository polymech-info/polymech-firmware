  <tool version="1.1" type="turning general" unit="millimeters" guid="{364e5cab-0866-4df6-bda1-e67c6ca5084a}">
    <description>CNMT Right Hand</description>
    <nc number="0" compensation-offset="0" turret="0" break-control="0" manual-tool-change="0"/>
    <coolant mode="flood"/>
    <material name="carbide"/>
    <insert shape="C" relief-angle="0" tolerance="M" cross-section="T" diameter="9.67194" thickness="3.96875" corner-radius="0.8" tip-angle="0" groove-width="0" insert-width="0" head-length="0" overall-length="30" thread-pitch="0" internal-thread="no"/>
    <turning-holder clamping="D" shape="C" style="L" relief-angle="0" hand="R" shank-height="20" shank-width="20" chamfer-width="0" chamfer-height="0" diameter="9.67194" overall-length="125" head-length="32" cutting-width="25" round-shank="no" side-angle="0"/>
    <turning-setup compensation="tip tangent" tool-angle="0" right-spindle="no"/>
    <motion surface-speed="91440" ramp-spindle-rpm="0" clockwise="yes" feed-mode="per-revolution" cutting-feedrate="0.127" entry-feedrate="0.127" exit-feedrate="0.127" plunge-feedrate="0" ramp-feedrate="0" retract-feedrate="0"/>
  </tool>
