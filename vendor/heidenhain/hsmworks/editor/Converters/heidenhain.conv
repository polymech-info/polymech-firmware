function getParameter(name) {
	if (!(name in propertyNames)) {
		throw new Error(name + " not a known property");
	}
	if (!(name in globals)) {
		throw new Error(name + " not yet set");
	}
	return globals[name];
}

function setParameter(name, value) {
	if (!(name in propertyNames)) {
		throw new Error(name + " not a known property");
	}
	globals[name] = value;
}

function setStock(stock) {

	stockXMin = stockXOutput.format(stock.minX);
	stockYMin = stockYOutput.format(stock.minY);
	stockZMin = stockZOutput.format(stock.minZ);

	stockXOutput.reset();
	stockYOutput.reset();
	stockZOutput.reset();

	stockXMax = stockXOutput.format(stock.maxX);
	stockYMax = stockYOutput.format(stock.maxY);
	stockZMax = stockZOutput.format(stock.maxZ);
}


function setFeedrate(movement, feedrate) {
	if (Math.round(feedrate) == -1) {

	} else {
		feedrates[movement] = Math.round(feedrate);
	}
}

function cyclDef17(distance, depth, stign)
{
	writeBlock("CYCL DEF 17.0 GEVIND");
	writeBlock("CYCL DEF 17.1 AFST.", distance);
	writeBlock("CYCL DEF 17.2 DYBDE", depth);
	writeBlock("CYCL DEF 17.3 STIGN", stign);
}


function cycle203(sd, depth, pFr, firstDepth, topDwell, surface, sd2, peck2, peckClearance, peckAmount, BottomDwell, retractFeedrate, peck)
{
	writeBlock("CYCL DEF 203 UNIVERSAL BORING");
	writeBlock("Q200=" + sd, "; SIKKERHEDS-AFSTAND");
	writeBlock("Q201=" + depth, "; DYBDE");
	writeBlock("Q206=" + pFr, "; TILSPAENDING DYBDE");
	writeBlock("Q202=" + firstDepth, "; INDSTILLINGS-DYBDE");
	writeBlock("Q210=" + topDwell, "; DVAELETID OPPE");
	writeBlock("Q203=" + surface, "; OVERFLADE");
	writeBlock("Q204=" + sd2, "; 2. SIKKERHEDS-AFST.");
	writeBlock("Q212=" + peck2, "; REDUKTION FREM");
	writeBlock("Q213=" + peckAmount, "; SPAANDBRUD ANTAL");
	writeBlock("Q205=" + peckClearance, " ; MIN FREMRYK DYBDE.");
	writeBlock("Q211=" + BottomDwell, "; DVAELETID NEDE");
	writeBlock("Q208=" + retractFeedrate, "; TILSPENDING-TILBAGE");
	writeBlock("Q256=" + peck, " ; UDK-VED-SPAANBRUD");
}

function label0()
{
	writeBlock(commentFront,"LBL","0");
}

function label1()
{
	writeBlock(commentFront, "LBL", "1");
}

function label2()
{
	writeBlock(commentFront, "LBL", "2");
}

function setPlane(newPlane)
{
	plane = planeOutput.format(newPlane);
}