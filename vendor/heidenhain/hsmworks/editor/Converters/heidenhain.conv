function writeBlock() {
	if (globals.showSequenceNumbers) {
		writeWords2(sequenceNumber, arguments);
		sequenceNumber += globals.sequenceNumberIncrement;
	} else {
		writeWords(arguments);
	}
}

function getFeedrate(movement) {

	var defaultF;

	if (alwaysPrintPrefix) 
	{
		defaultF = "F";
	} else
	{
		defaultF = "";
	}

	if (movement == MOVE_RAPID) {
		lastFeedrate = "FMAX";
		return "FMAX";
	}
	if (!(movement in feedrates)) {
		lastFeedrate = defaultF; //was "F"
		return defaultF;
	}

	feedOutput.reset();
	var currentFeedrate = feedOutput.format(feedrates[movement]);

	if (lastFeedrate == currentFeedrate) {
		if (!(movement in feedrates)) {
			lastFeedrate = defaultF; //was "F"

			return defaultF;
		}
	} else {
		lastFeedrate = currentFeedrate;
		return currentFeedrate || defaultF;;
	}

	return feedOutput.format(feedrates[movement]) || defaultF;
}

function getCompensation() {

	var defaultC;

	if (alwaysPrintPrefix) {
		defaultC = "R";
	} else {
		defaultC = "";
	}

	if (lastCompensation == compensationTmp) {

		return defaultC;
	}
	compensationTmp = lastCompensation;
	switch (lastCompensation) {
	case COMPENSATION_LEFT: { return "RL"; break };
	case COMPENSATION_RIGHT: { return "RR"; break };
	case COMPENSATION_OFF: { return "R0"; break };
	}
}

function reset() {
	xOutput.reset();
	yOutput.reset();
	zOutput.reset();
}

function onInit() {
	//commentFormat = createFormat({ prefix: ""});
	gFormat = createFormat({ prefix: "G", decimals: 0, width: 2 });
	fFormat = createFormat({ decimals: 0, prefix: "F" });
	xyzFormat = createFormat({ decimals: 3, forceDecimal: false, forceSign: false, forceDelim: true, removeIntZero: true });
	abcFormat = createFormat({ decimals: 3, forceDecimal: false, forceSign: true, forceDelim: true, removeIntZero: true });
	sweepFormat = createFormat({ decimals: 3, forceDecimal: false, forceSign: true, forceDelim: true, removeIntZero: true });
	stockFormat = createFormat({ decimals: 3, forceDecimal: false, forceSign: true, forceDelim: true, removeIntZero: true });
	drillingFormat = createFormat({ decimals: 3, forceDecimal: false, forceSign: false, forceDelim: true, removeIntZero: false });
	mFormat = createFormat({ decimals: 0, forceDecimal: false, forceSign: false, forceDelim: false, removeIntZero: false });
	drillingFormat = createFormat({ decimals: 3, forceDecimal: false, forceSign: false, forceDelim: true, removeIntZero: false });
	drillingFormatSign = createFormat({ decimals: 3, forceDecimal: false,  forceSign: true, forceDelim: true, removeIntZero: false });
	

	intFormat = createFormat({ decimals: 0 });
	realFormat = createFormat({ decimals: 3, forceDecimal: false, forceSign: true, forceDelim: true, removeIntZero: false });
	paramFormat = createFormat({ prefix: "Q", decimals: 0 });
	paramOutput = createVariable({ force: true }, paramFormat);
	mOutput = createVariable({ force: false }, mFormat);

	defaultDoubleFormat = createFormat({ decimals: 3 });
	defaultDoubleOutput = createVariable({ force: true }, defaultDoubleFormat);

	gOutput = createVariable({}, gFormat);

	feedOutput = createVariable({}, fFormat);
	compensationOutput = createVariable({}, gFormat);
	
	xDrillingOutput = createVariable({ prefix: "X", force: false }, xyzFormat);
	yDrillingOutput = createVariable({ prefix: "Y", force: false }, xyzFormat);
	zDrillingOutput = createVariable({ prefix: "Z", force: false }, xyzFormat);

	xOutput = createVariable({ prefix: "X" }, xyzFormat);
	yOutput = createVariable({ prefix: "Y" }, xyzFormat);
	zOutput = createVariable({ prefix: "Z" }, xyzFormat);

	aOutput = createVariable({ prefix: "A" }, abcFormat);
	bOutput = createVariable({ prefix: "B" }, abcFormat);
	cOutput = createVariable({ prefix: "C" }, abcFormat);

	xCircleCenterOutput = createVariable({ prefix: "X", force: true }, xyzFormat);
	yCircleCenterOutput = createVariable({ prefix: "Y", force: true }, xyzFormat);
	zCircleCenterOutput = createVariable({ prefix: "Z" }, xyzFormat);

	iOutput = createVariable({ prefix: "I", force: true }, xyzFormat);
	jOutput = createVariable({ prefix: "J", force: true }, xyzFormat);
	kOutput = createVariable({ prefix: "K", force: true }, xyzFormat);

	stockXOutput = createVariable({ prefix: "X" }, stockFormat);
	stockYOutput = createVariable({ prefix: "Y" }, stockFormat);
	stockZOutput = createVariable({ prefix: "Z" }, stockFormat);

	drillingOutput = createVariable({ force: true }, drillingFormat);
	drillingOutputSign = createVariable({ force: true ,forceSign: true}, drillingFormatSign);
	drillingOutputNoSign = createVariable({ force: true,forceSign:false }, drillingFormat);

	toleranceOutput = createVariable({ prefix: "", force: false }, realFormat);

	sweepOutput = createVariable({ prefix: "IPA", force: true }, sweepFormat);

	sOutput = createVariable({ prefix: "S", force: true }, intFormat);
	tOutput = createVariable({ prefix: "", force: true }, intFormat);
	//tOutput = createVariable({ prefix: "TOOL CALL ", force: true }, intFormat);

	feedrates = {};

	lastFeedrate = "";

	lastCompensation = null;
	compensationTmp = null;

	planeOutput = createVariable({ force: false, prefix: "G" }, intFormat);

	dwellOutput = createVariable({}, xyzFormat);

	sequenceNumber = globals.sequenceNumberStart;

	stockXMin = stockXOutput.format(0)
		stockYMin = stockYOutput.format(0)
		stockZMin = stockZOutput.format(0)

		stockXOutput.reset();
	stockYOutput.reset();
	stockZOutput.reset();

	stockXMax = stockXOutput.format(0)
		stockYMax = stockYOutput.format(0)
		stockZMax = stockZOutput.format(0)

		stockXOutput.reset();
	stockYOutput.reset();
	stockZOutput.reset();

	first = true;
	prevToolNo = -1;
	prevToolss = -1;
	tiltAngle = 0;
	rotAngle = 0;
	thirdAngle = 0;
	pathType = 0;
	//toolList = new Array();

	lastX = xOutput.format(-9999999);   //TODO get some better start values
	lastY = yOutput.format(-9999999);
	lastZ = zOutput.format(-9999999);
	reset();
}

function onOpen(operationName, isClipboard) {
	if (first) {
		ProgramName = operationName;
		writeBlock("BEGIN PGM ", operationName, "MM");
		writeBlock("BLK FORM 0.1 Z", stockXMin, stockYMin, stockZMin);
		writeBlock("BLK FORM 0.2", stockXMax, stockYMax, stockZMax);

		outputToolList();
		first = false;
	}
}

function onClose() {
	var f = getFeedrate(MOVE_RAPID)

		writeBlock("M9");
	writeBlock("L Z1. R", f, "M91");
	//lastX = xOutput.format(-9999999);   
	//lastY = yOutput.format(-9999999);
	lastZ = zOutput.format(-9999999);
	writeBlock("L Y+600. R", f, "M91");
	writeBlock("M30");

	/*
	CALL LABELS HERE
	*/

	writeBlock("END PGM ", ProgramName, "MM");
}

