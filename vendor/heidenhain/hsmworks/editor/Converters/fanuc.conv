function onDrillingHeader(obj) {

	var garbX = xDrillingOutput.format(xOutput.getLast());
	var garby = yDrillingOutput.format(yOutput.getLast());
	var garbz = zDrillingOutput.format(zOutput.getLast());
	// indicate that the drill header was called 
	//drillHeaderCalled = true;

	// Indicate that the next hole (onDrillingPoint) is the first hole after the header
	drillIsFirst = true;
	drillHeader = obj;
	//onComment(drillHeader.name);

	// Calculate the various parameters
	retractDistance = drillHeader.retractPlane - drillHeader.referencePlane; // Used as Second Safety Clearance

	if (drillHeader.safeDistanceIsAbsolute) {
		safeDistance = drillHeader.safeDistance - drillHeader.referencePlane;
	}
	else {
		safeDistance = drillHeader.safeDistance;
	}

	referenceHeight = drillHeader.referencePlane;

	if (drillHeader.endDepthIsAbsolute) {
		depth = drillHeader.referencePlane - drillHeader.endDepth;
	}
	else {
		depth = drillHeader.endDepth;
	}

	if (drillHeader.name == "BORING") 
	{
		var x = xDrillingOutput.format(drillHeader.endX);
		var y = yDrillingOutput.format(drillHeader.endY);
		var z = zDrillingOutput.format(drillHeader.endZ);
		var r = rOutput.format(drillHeader.retractPlane);
		feedrateReset();
		var f = getFeedrate(MOVE_PLUNGE);
		pOutput.reset();
		var p = pOutput.format(drillHeader.topDwelling);

		var g;
		if (drillHeader.topDwelling > 0) {
			g = "G82";
		} else {
			g = "G81"; 
		}

		writeBlock("G99",g, x, y, z, r, p,f);

		var z = zOutput.format(drillHeader.retractPlane);
	}
	else if (drillHeader.name == "UDSPAANING")
	{
		var x = xDrillingOutput.format(drillHeader.endX);
		var y = yDrillingOutput.format(drillHeader.endY);
		zOutput.reset();
		var z = zDrillingOutput.format(drillHeader.endZ);
		var r = rOutput.format(drillHeader.referencePlane - (drillHeader.safeDistance - drillHeader.retractPlane));
		var q = qOutput.format(drillHeader.firstDepth);
		feedrateReset();
		var f = getFeedrate(MOVE_PLUNGE);

		var g;
		if (tool.spindleSpeed < 0) {
			g = "G73";
		} else {
			g = "G83";
		}

		writeBlock("G99",g, x, y, z, r, q, f);
	} 
	else if (drillHeader.name == "UNIVERSAL")
	{
		var x = xDrillingOutput.format(drillHeader.endX);
		var y = yDrillingOutput.format(drillHeader.endY);
		var z = zDrillingOutput.format(drillHeader.endZ);
		var r = rOutput.format(drillHeader.retractPlane);
		var q = qOutput.format(drillHeader.firstDepth);
		feedrateReset();
		var f = getFeedrate(MOVE_PLUNGE);

		var p = "";

		if (drillHeader.topDwelling > 0)
		{
			//p = pOutput.format(drillHeader.topDwelling * 1000);
		}

		var g;
		if (tool.spindleSpeed < 0) {
			g = "G73";
		} else {
			g = "G73";
		}

		writeBlock("G99",g, x, y, z, r, p,q, f);

		var z = zOutput.format(drillHeader.retractPlane);
	}
	else if (drillHeader.name == "GEVIND")
	{
		var g;
		if (tool.spindleSpeed < 0) {
			g = "G74";
		} else {
			g = "G84";
		}

		var x = xDrillingOutput.format(drillHeader.endX);
		var y = yDrillingOutput.format(drillHeader.endY);
		var z = zDrillingOutput.format(drillHeader.endZ);
		var r = rOutput.format(drillHeader.referencePlane - (drillHeader.safeDistance - drillHeader.retractPlane));

		feedrateReset();
		var f = getFeedrate(MOVE_PLUNGE);
		var s = sOutput.format(Math.abs(tool.spindleSpeed));
		writeBlock("M29",s);
		writeBlock("G99", g, x, y, z, r, f);
	} 
	else if (drillHeader.name == "ROERHUL")
	{
		var x = xDrillingOutput.format(drillHeader.endX);
		var y = yDrillingOutput.format(drillHeader.endY);
		var z = zDrillingOutput.format(drillHeader.endZ);
		var r = rOutput.format(drillHeader.retractPlane);
		feedrateReset();
		var f = getFeedrate(MOVE_PLUNGE);
		var p = "";

		if (drillHeader.topDwelling > 0) {
			//p = pOutput.format(drillHeader.topDwelling * 1000);
		}

		var g;
		if (tool.spindleSpeed < 0) {
			g = "G76";
		} else {
			g = "G86";
		}

		writeBlock("G99",g, x, y, z, r, p, f);

		var z = zOutput.format(drillHeader.retractPlane);
	}
	else if (drillHeader.name == "MISC1")
	{
		var x = xDrillingOutput.format(drillHeader.endX);
		var y = yDrillingOutput.format(drillHeader.endY);
		var z = zDrillingOutput.format(drillHeader.endZ);
		var r = rOutput.format(drillHeader.retractPlane);
		var q = qOutput.format(drillHeader.firstDepth);
		feedrateReset();
		var f = getFeedrate(MOVE_PLUNGE);

		var p = "";

		if (drillHeader.topDwelling > 0) {
			pOutput.reset();
			p = pOutput.format(drillHeader.topDwelling );
		}

		var g;
		if (tool.spindleSpeed < 0) {
			g = "G76";
		} else {
			g = "G76";
		}

		writeBlock("G99", g, x, y, z, r, p, f);

		var z = zOutput.format(drillHeader.retractPlane);
	}
	else if (drillHeader.name == "MISC2")
	{

	}
}

