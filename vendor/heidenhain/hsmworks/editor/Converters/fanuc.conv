function outputToolList()
{
	for (key in toolList)
	{
		ctool = toolList[key];
		//writeBlock(JSON.stringify(ctool))

		oTool = "TOOL" + ctool.toolNumber;
		oTool = oTool +  spacePadding(oTool.length,8);

		oComment = "\"" + ctool.toolOperationCommment.trim() + "\"";
		oComment = oComment + spacePadding(oComment.length, 40);

		oUm = "UM D=" + ctool.dia;
		oUm = oUm + spacePadding(oUm.length, 10);

		oCr = "CR=" + ctool.rad;
		oCr = oCr + spacePadding(oCr.length, 10);

		oA = ""//"A=" ;
			//oTool = oTool + spacePadding(oTool.length, 8);

			oFl = "FL=" + ctool.fluteLength;
		oFl = oFl + spacePadding(oFl.length, 10);

		oSl = "SL=" + ctool.shoulderLength;
		oSl = oSl + spacePadding(oSl.length, 10);

		oBl = "BL=" + ctool.overallLength;
		oBl = oBl + spacePadding(oBl.length, 10);

		oAd = "AD=" + ctool.diameter;
		oAd = oAd + spacePadding(oAd.length, 10);

		writeBlock(commentFront, oTool, oComment, oUm, oCr, oA, oFl, oSl, oBl, oAd, commentBack);
	}
}

function spacePadding(length,numSpace)
{
	var padding = "";
	while(length < numSpace)
	{
		padding = padding + " ";
		length = length + 1
	}
	return padding;
}

function setToolList(inToolList)
{
	completeToolList = inToolList;

	var u = {}, a = [];
	for (var i = 0, l = inToolList.length; i < l; ++i) {
		if (!u.hasOwnProperty(inToolList[i].toolNumber)) {
			a.push(inToolList[i]);
			u[inToolList[i].toolNumber] = 1;
		}
	}

	toolList = a;
}

function setMisc1005(text)
{
	if(text.textAsComment.length >0)
	{
		writeBlock(commentFront, text.textAsComment.toUpperCase(), commentBack);
	}
}

function setMisc1008(text)
{
	toolOperationCommment = text.toolOperationCommment;
	//writeBlock("(", text.toolOperationCommment,")");
}

function onToolChange(toolData) {

	tool = toolData;
	feedOutput.reset();

	var t = tOutput.format(toolData.toolNumber);
	var s = sOutput.format(Math.abs(toolData.spindleSpeed));
	//var f = feedOutput.format(toolData.feedrate);
	var p = toolData.plane;
	var tn = toolData.toolName;
	var postfix = "DR+0 ;"

		var axis = "";

	if (p == PLANE_XY) {
		axis = "Z";
	}
	else if (p == PLANE_YZ) {
		axis = "Y";
	}
	else if (p == PLANE_XZ) {
		axis = "X";
	}

	var f = getFeedrate(MOVE_RAPID);

	if (prevToolNo != t)
	{
		toolChanged = true;
		prevToolNo = t;
		lastSS = tool.spindleSpeed;
		//first = true;
		prevCooling = -1;
		//writeBlock("M9");
		//writeBlock("L Z1. R", f, "M91");
		//lastX = xOutput.format(-9999999);   
		//lastY = yOutput.format(-9999999);
		//lastZ = zOutput.format(-9999999);

		//writeBlock("TOOL CALL", t, axis, s, postfix, tn);

		if (!first) {

			gCode = gOutput.format(0);
			writeBlock("M5")
				writeBlock("G91", gCode, "G28", "Z0.");
			writeBlock("G28", "Y0", "A0.");
			if (opCode == 3) {
				reset();
				writeBlock("/", "G28", "X0.", "Y0.");

				var xh = xOutput.format(tool.xh);
				var yh = yOutput.format(tool.yh);
				var zh = zOutput.format(tool.zh);

				writeBlock("/", "G92", xh,yh,zh);
			}

			writeBlock("M01");


		} else {
			if (opCode == 3) {
				reset();
				writeBlock("/","G91","G28","Z0.");
				writeBlock("/", "G28", "X0.", "Y0.");

				var xh = xOutput.format(tool.xh);
				var yh = yOutput.format(tool.yh);
				var zh = zOutput.format(tool.zh);

				writeBlock("/", "G92", xh, yh, zh);
			}
		}

		var x = xOutput.format(toolData.xr);
		var y = yOutput.format(toolData.yr);
		var z = zOutput.format(toolData.zr);

		writeBlock("(", toolData.toolName.toUpperCase(), ")");

		if (toolOperationCommment.length > 0) {
			writeBlock(commentFront, toolOperationCommment.toUpperCase(), commentBack);
			toolOperationCommment = "";
		}
		//reset();

		var ssM;
		if (toolData.spindleSpeed < 0) {
			ssM = mOutput.format(4); //"M4";
		} else
		{
			ssM = mOutput.format(3); // "M3";
		}
		gOutput.reset();
		gCode = gOutput.format(0);
		writeBlock("T" + toolData.toolNumber,"M6")
			writeBlock(gCode, "G90", "G54", x, y, s, ssM);

		writeBlock("G43", "H" + toolData.toolNumber);// insert next tool as T
		first = false
			//reset();
			//zOutput.reset();

			//onLinearXY(toolData.xr, toolData.yr, MOVE_RAPID);
	} else {
		if (toolData.mode == 1000)
		{
			var ssM;
			if (toolData.spindleSpeed < 0) {
				ssM = mOutput.format(4); //"M4";
			} else {
				ssM = mOutput.format(3); // "M3";
			}

			if (lastSS != tool.spindleSpeed)
			{
				writeBlock(s,ssM);
				lastSS = tool.spindleSpeed;
			}

			//var discardz = zOutput.format(-99999);
			if (toolOperationCommment.length > 0)
			{
				writeBlock(commentFront, toolOperationCommment.toUpperCase(), commentBack);
				toolOperationCommment = "";
			}
			if (toolData.zr > zOutput.getLast())
			{
				onLinearZ(toolData.zr, MOVE_RAPID);
			} else
			{
				onLinearXY(toolData.xr, toolData.yr, MOVE_RAPID);
			}
			if (subProgramRunning == 1)
			{
				//writeBlock("CALL LBL", currentSubprogramID + ""); //test1
			}
		} else
		{
			if (toolOperationCommment.length > 0)
			{
				writeBlock(commentFront, toolOperationCommment.toUpperCase(), commentBack);
				toolOperationCommment = "";
			}
			if (subProgramRunning == 1)
			{
				//writeBlock("CALL LBL", currentSubprogramID + "");
			}

		}
	}
}

function startOfOperation(synctoolOp, dataStream, syncOpId)
{
}

function subProgram(SP)
{
	if (SP.sub_trns_id > 0 )//&& SP.sub_sec_no == 0)
	{
		currentSubprogramID = SP.sub_op_id + 10;

	} else if (SP.sub_trns_id == 0)// && SP.sub_sec_no == 1)
	{
		currentSubprogramID = SP.sub_op_id + 100;
	}

	writeBlock("CALL LBL", currentSubprogramID + "");
	/*
	if (subProgramRunning == 0 && currentSubprogramID > 100)
	{
	lastSubprogramID = currentSubprogramID;
	writeBlock("CALL LBL", currentSubprogramID + "" );
	}
	*/
	subProgramRunning = subProgramRunning + 1;
}

function endSubProgram(esub_op_id, esub_grp_id, esub_trns_id, esub_sec_no, esub_totl_no, esub_chn_no)
{
	subProgramRunning = subProgramRunning - 1;
}

function setToolParameters(TP)
{
	ToolParameters = TP;
}

function onLinear(x, y, z, movement)
{
	var lastX = xOutput.getLast();
	var lastY = yOutput.getLast();
	var lastZ = zOutput.getLast();

	//onComment(lastX + " " + x + " " + lastY + " " + y + " " + lastZ + " " + z + " ");
	//onComment((Math.abs(lastX - x))+" "+(Math.abs(lastY - y))+" "+(Math.abs(lastZ - z)));
	if ((Math.abs(lastX - x) >= epsilon) || (Math.abs(lastY - y) >= epsilon) || (Math.abs(lastZ - z) >= epsilon))
	{
		var x = xOutput.format(x);
		var y = yOutput.format(y);
		var z = zOutput.format(z);
		var f = getFeedrate(movement);
		var m = defaultM;//mOutput.format(3);

		//feedrateReset();
		//var fTest = getFeedrate(movement);

		if (movement == MOVE_RAPID)
		{
			gCode = gOutput.format(0);
			f = "";
		} else
		{
			gCode = gOutput.format(1);
		}

		//var comp = getCompensation();

		if (lastCompensation != null) {
			cGcode = compOutput.format(getCompensation());

		} else {
			cGcode = "";
		}

		var diaOff = "";
		if (getCompensation() == 41) {
			diaOff = dOutput.format(getToolCompensation());
		} else if (getCompensation() == 42) {
			diaOff = dOutput.format(getToolCompensation());
		}
		//writeBlock("comp:"+);
		if (first) {
			//m = mOutput.format(3);
			/*
			if (lastSS > 0)
			{
			writeBlock(gCode, x, y, r, f, "M3");
			} else if (lastSS < 0) {
			writeBlock(gCode, x, y, r, f, "M4");
			} else if (lastSS == 0) {
			writeBlock(gCode, x, y, r, f, "M5");
			}
			*/
			writeBlock(cGcode,diaOff,gCode, x, y, z, f);
			//x = xOutput.format(x);
			//y = yOutput.format(y);
			//m = "M";
			first = false;
			//zOutput.reset();
			//prevCooling = -1;
		} else
		{
			/*
			if (tool.coolant == 0 && prevCooling != 0)
			{
			prevCooling = 0;
			m = "M9";
			globalM = mOutput.format(9);
			//globalM = xOutput.format(9);
			}
			else if (tool.coolant == 1 && prevCooling != 1)
			{
			prevCooling = 1;
			m = "M8";
			globalM = mOutput.format(8);
			}
			*/
			writeBlock(cGcode,diaOff,gCode, x, y, z, f, m);
		}
	}
}

function onLinearXY(inx, iny, movement)
{
	if (xOutput.getLast() != inx || yOutput.getLast() != iny) {
		var r = getCompensation();
		var f = getFeedrate(movement);
		var x;
		var y;

		if (movement == MOVE_PLUNGE) {
			x = xDrillingOutput.format(inx);
			y = yDrillingOutput.format(iny);

			xOutput.format(inx);
			yOutput.format(iny);
		} else
		{
			x = xOutput.format(inx);
			y = yOutput.format(iny);
		}

		var m = defaultM;

		if (movement == MOVE_RAPID)
		{
			gCode = gOutput.format(0);
			f = "";
		}
		/*
		else if (drillHeader.topDwelling > 0)
		{
		gCode = gOutput.format(82);
		}
		else if (movement == MOVE_PLUNGE) {
		gCode = gOutput.format(81);
		} */

		else
		{
			gCode = gOutput.format(1);
		}

		/*
		feedrateReset();
		var fTest = getFeedrate(movement);
		if (fTest == "FMAX") {
		gCode = gOutput.format(0);
		f = "";
		} else {
		gCode = gOutput.format(1);
		}*/



		if (toolChanged) {
			globalM = mOutput.format(3);
			toolChanged = false;
		}
		if (first) {
			if (lastSS > 0) {
				writeBlock(gCode, x, y, r, f);
			} else if (lastSS < 0) {
				writeBlock(gCode, x, y, r, f);
			} else if (lastSS == 0) {
				writeBlock(gCode, x, y, r, f);
			}

			zOutput.reset();
			first = false;
		}
		else {
			writeBlock(gCode, x, y, r, f, m);
		}
	}
}

function onLinearZ(inz, movement)
{
	if (zOutput.getLast() != inz) {
		var r = getCompensation();
		var f = getFeedrate(movement);
		var z = zOutput.format(inz);

		feedrateReset();
		var fTest = getFeedrate(movement);

		if (movement == MOVE_RAPID) {
			gCode = gOutput.format(0);
			f = "";
		} else {
			gCode = gOutput.format(1);
		}

		//var m = "M";
		//writeBlock("L", z, r, f, defaultM);
		writeBlock(gCode, z, r, f, defaultM );
	}
}

function onCircular(cx, cy, cz, ex, ey, ez, isCW, movement)
{
	// current position
	var lastX = xOutput.getLast();
	var lastY = yOutput.getLast();
	var lastZ = zOutput.getLast();
	var fullCircle = false;

	if ((Math.abs(lastX - ex) <= epsilon) && (Math.abs(lastY - ey) <= epsilon))
	{
		fullCircle = true;
	}

	gCode = gOutput.format(isCW ? 2 : 3);

	var lastPlane = planeOutput.getLast();	
	//writeBlock(commentFront,"cx "+cx, "cy "+cy,"cz "+cz);
	//writeBlock(commentFront,"ex "+ex,"ey "+ey,"ez "+ez);
	//writeBlock(commentFront,"lastX "+lastX,"lastY "+lastY,"lastZ "+lastZ);

	var exf;
	var eyf;
	var ezf;
	var i;
	var j;
	var k;

	xOutput.reset();
	yOutput.reset();
	if(lastPlane == 17)
	{
		exf = xOutput.format(ex);
		eyf = yOutput.format(ey);
		ezf = zOutput.format(ez);

		i = iOutput.format(cx );//- lastX);
		j = jOutput.format(cy );//- lastY);
		// k = kOutput.format(cz - lastZ);

		k = "";
	}
	else if (lastPlane== 18)
	{
		exf = xOutput.format(ex);
		eyf = yOutput.format(ez*-1);
		ezf = zOutput.format(ey);

		i = iOutput.format(cx);//- lastX);
		// j = kOutput.format(cz*-1 - lastY);
		k = kOutput.format(cy);// - lastZ);

		j = "";
	}
	else if (lastPlane == 19)
	{
		exf = xOutput.format(ez);
		eyf = yOutput.format(ex);
		ezf = zOutput.format(ey);

		// i = kOutput.format(cz - lastX);
		j = jOutput.format(cx);// - lastY);
		k = kOutput.format(cy);// - lastZ);

		i = "";
	}

	var f = getFeedrate(movement);

	var r = getCompensation();

	if (globals.arcType == 2) { // radius
		var radius = Math.sqrt(((cx - ex) * (cx - ex)) + ((cy - ey) * (cy - ey)));

		var rad = radiusOutput.format(radius);
		writeBlock(plane, gCode, exf, eyf, ezf, rad, f, defaultM, "");

		//writeBlock(c, g, x, y, z, r, f);
	} else if (globals.arcType == 0) { // relative

	}
	else 
	{ // absolute
		if (!fullCircle)
		{
			if (Math.abs(lastZ - ez) > globals.tolerance)
			{
				writeBlock(plane ,gCode, exf, eyf, ezf, i, j, k, r,f, defaultM,"");
			} 
			else 
			{
				writeBlock(plane, gCode, exf, eyf, ezf, i, j, k, r, f, defaultM, "");
			}
		} 
		else //full circle
		{
			if (Math.abs(lastZ - ez) > globals.tolerance)
			{
				writeBlock(plane, gCode, exf, eyf, ezf, i, j, k, r, f, defaultM), "";
			} 
			else 
			{
				writeBlock(plane, gCode, i, j, k, r, f, defaultM, "");
			}
		}
	}
}

function onCompensation(compensation) {
	dOutput.reset();
	lastCompensation = compensation;
}

function onDwell(seconds) {
	writeBlock("CYCL DEF 9.0 DWELL TIME");
	writeBlock("CYCL DEF 9.1 DWELL", '"' + dwellOutput.format(seconds) + '"');
	writeBlock("CYCL CALL");
}

