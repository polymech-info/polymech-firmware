function getParameter(name) {
	if (!(name in propertyNames)) {
		throw new Error(name + " not a known property");
	}
	if (!(name in globals)) {
		throw new Error(name + " not yet set");
	}
	return globals[name];
}

function setParameter(name, value) {
	if (!(name in propertyNames)) {
		throw new Error(name + " not a known property");
	}
	globals[name] = value;
}

function getNextTool()
{
	while(completeToolListIndex < completeToolList.length && completeToolList[completeToolListIndex].toolNumber == tool.toolNumber)
	{
		//writeBlock("completeToolList " + completeToolList[completeToolListIndex].toolNumber);
		completeToolListIndex = completeToolListIndex +1;
	}
	if (completeToolListIndex == completeToolList.length)
	{
		completeToolListIndex = 0;
	}
}

function setStock(inStock) {

	stock = inStock;

	stockXMin = stockXOutput.format(inStock.minX);
	stockYMin = stockYOutput.format(inStock.minY);
	stockZMin = stockZOutput.format(inStock.minZ);

	stockXOutput.reset();
	stockYOutput.reset();
	stockZOutput.reset();

	stockXMax = stockXOutput.format(inStock.maxX);
	stockYMax = stockYOutput.format(inStock.maxY);
	stockZMax = stockZOutput.format(inStock.maxZ);
}

