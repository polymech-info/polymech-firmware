function onDrillingPointConversion(inX, inY,inZ,ref)
{
	zOutput.reset();
	var f = getFeedrate(MOVE_RAPID);

	var z = zOutput.format(drillHeaderConv.initialHeight);

	if (drillHeaderConv.type == 200)
	{

		if (xOutput.getLast() != inX || yOutput.getLast() != inY)
