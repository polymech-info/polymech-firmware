             ;Machine Parameters Tuning Cycle
             ;Tuning Mode: Standard (tuning off)
             ;
             ;Legend:
             ;  = :value same as standard
             ;  > :value higher than standard
             ;  < :value lower than standard
             ;  - :value has no effect
             ;--------------------------------------------------------------
             ;MP1070 Radial acceleration
             ;Input: 0.001 to 100 [m/s^2]
             ;       exact     smooth    rough
             ;       <         =         >
MP 1070    : 0.5
             ;--------------------------------------------------------------
             ;MP1085 Max. permissible axis-specific jerk during machining
             ;       movements for the operating modes
             ;       "Program Run Full Sequence," "Program Run Single Block,"
             ;       and "Positioning with Manual Data Input" and
             ;       PLC-Positioning, as long as feed rate not FMAX or
             ;       feed rate < value in MP1090.
             ;       (up to now for all axis in MP1090.0)
             ;            MP1060.x^2 * 60000
             ; MP1085.x >= ------------------
             ;               MP1010.x
             ;Input: 0.1 to 1000 [m/s^3]
             ;       exact     smooth    rough
             ;       <         =         >
MP 1085.0  : 10
MP 1085.1  : 10
MP 1085.2  : 10
MP 1085.3  : 10
MP 1085.4  : 10
MP 1085.5  : 10
MP 1085.6  : 10
MP 1085.7  : 10
MP 1085.8  : 10
MP 1085.9  : 10
MP 1085.10 : 10
MP 1085.11 : 10
MP 1085.12 : 10
MP 1085.13 : 10
             ;--------------------------------------------------------------
             ;MP1090 Limitation of contouring jerk as a result from
             ;       MP1085.x or MP1086.x
             ;            MP1060^2 * 60000
             ; MP1090 >= ------------------
             ;               MP1010
             ;Input: 0.1 to 1000 [m/s^3]
             ;       0 = not active
             ;       exact     smooth    rough
             ;       <         =         >
MP 1090.0  : 10         ;Jerk limitation for feed rate < Fmax
             ;       exact     smooth    rough
             ;       =         =         =
MP 1090.1  : 20         ;Jerk limitation for feed rate = Fmax
             ;--------------------------------------------------------------
             ;MP1200 Nominal position value filter
             ;Input: 0 = Single filter
             ;       1 = Double filter (not used)
             ;       2 = HSC filter
             ;       3 = "Advanced HSC filter"
             ;       exact     smooth    rough
             ;       2         0(3)      0
MP 1200    : 0
             ;--------------------------------------------------------------
             ;MP1202 Cycle 32 3D milling - predefined tolerance
             ;Input: 0,0000 to 3,0000 [mm]
             ;       exact     smooth    rough
             ;       <         =         >
MP 1202.0  : 0.03       ;Corners with movement with machining feed rate
             ;       exact     smooth    rough
             ;       =         =         =
MP 1202.1  : 0.25       ;Corners with movement with rapid traverse
             ;--------------------------------------------------------------
             ;MP1210 Cut-off frequency for single filter
