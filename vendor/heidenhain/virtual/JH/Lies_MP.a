             ;           Eingabe: 0 bis 9,999 [V]
MP 3240.2  : 0.01
             ;------------------------------------------------------------------
             ;MP3310 Begrenzung S-Override
             ;Eingabe: 0 bis 100 [%]
MP 3310.0  : 130        ;maximal
MP 3310.1  : 50         ;minimal
             ;------------------------------------------------------------------
             ;MP3350 Maximal zulässige Überschreitung der Spindeldrehzahl
