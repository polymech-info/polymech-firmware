     DIA-FINNISH = NIMI ?
     DIA-DUTCH = NAAM ?
     DIA-POLISH = NAZWA ?
     DIA-HUNGARIA = NAME?
   NAME = DOC
     TYPE = C
     WIDTH = 24
     DEC = 0
     DIA-ENGLISH = COMMENT ?
     DIA-GERMAN = KOMMENTAR ?
     DIA-CZECH = KOMENTAR ?
     DIA-FRENCH = COMMENTAIRE ?
     DIA-ITALIAN = COMMENTO ?
