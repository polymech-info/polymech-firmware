*-----------------------------------------------------------------------------
*  M-Funktionen
*-----------------------------------------------------------------------------
*  Modul-Beschreibung
*
*-----------------------------------------------------------------------------

#define /s    KL_max_M_Funk_Bereich_1                  K +89
#define /s    KL_min_M_Funk_Bereich_2                  K +300
#define /s    KL_max_M_Funk_Bereich_2                  K +999

#define /s    ML_Hilfsmerker_M_Impuls                  M

GLOBAL M_Funktionen

;----------------------------
LBL M_Funktionen
;----------------------------

  L      PN_M4092_Quit_M_Funktion
  R      MG_FN19_Daten_neu

  LN     NP_M4072_Strobe_M_Funktion
  R      PN_M4092_Quit_M_Funktion

  LN     NP_M4072_Strobe_M_Funktion
  AN     ML_Hilfsmerker_M_Impuls
  EMT

  L      NP_W260_M_Code
  =X
  >      KL_max_M_Funk_Bereich_1
  A[
    L      NP_W260_M_Code
    <      KL_min_M_Funk_Bereich_2
  ]
  S      PN_Fehler_M_Befehl_ohne_Funktion
  EMT

  L      NP_W260_M_Code
  >      KL_max_M_Funk_Bereich_2
  S      PN_Fehler_M_Befehl_ohne_Funktion
  EMT

  L      NP_W260_M_Code
  <      KL_min_M_Funk_Bereich_2
  IFT
    L      KF M_Funk_Tab[X]
    =X
  ELSE
    L      NP_W260_M_Code
    -      KL_min_M_Funk_Bereich_2
    =X

    L      KF M_Funk_Tab_2[X]
    =X
  ENDI

  L      NP_M4072_Strobe_M_Funktion
  AN     ML_Hilfsmerker_M_Impuls
  =      MG_Impuls_M_Funktion

  L      NP_M4072_Strobe_M_Funktion
  =      M0[X]
  =      ML_Hilfsmerker_M_Impuls

EM

