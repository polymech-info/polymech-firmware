LBL WZW_Output_Restore

#ifdef $iTNC530Prog$
  L      NP_M4172_1_PLC_Durchlauf_nach_Netz_Ein
  R      ML_WZ_Greifer_Zangen_zu
  R      ML_WZ_Greifer_Zange_1_auf
  R      ML_WZ_Greifer_Zange_2_auf
  S      ML_WZ_Greifer_einsetzen
  R      ML_WZ_Greifer_ausheben
  R      ML_WZ_Schleuse_auf
  S      ML_WZ_Schleuse_zu
#endif
  L      ML_WZ_Greifer_Zangen_zu
  =      O_WZ_Greifer_Zangen_zu

  L      ML_WZ_Greifer_Zange_1_auf
  =      O_WZ_Greifer_Zange_1_auf

  L      ML_WZ_Greifer_Zange_2_auf
  =      O_WZ_Greifer_Zange_2_auf

  L      ML_WZ_Greifer_einsetzen
  =      O_WZ_Greifer_einsetzen

  L      ML_WZ_Greifer_ausheben
  =      O_WZ_Greifer_ausheben

  L      ML_WZ_Greifer_drehen_ccw_links
  =      O_WZ_Greifer_drehen_ccw_links

  L      ML_WZ_Greifer_drehen_cw_rechts
  =      O_WZ_Greifer_drehen_cw_rechts

#if CFG_WZ_Magazin_Schleuse = "aktiv"
  L      ML_WZ_Schleuse_auf
  =      O_WZ_Schleuse_auf

  L      ML_WZ_Schleuse_zu
  =      O_WZ_Schleuse_zu
#endif

EM

