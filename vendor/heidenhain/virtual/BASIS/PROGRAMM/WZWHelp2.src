LBL WZW_Output_Backup

  LN     MG_Steuerung_betriebsbereit
  R      O_WZ_Greifer_Zangen_zu
  R      O_WZ_Greifer_Zange_1_auf
  R      O_WZ_Greifer_Zange_2_auf
  R      O_WZ_Greifer_einsetzen
  R      O_WZ_Greifer_ausheben
  R      O_WZ_Schleuse_zu
  R      O_WZ_Greifer_drehen_ccw_links
  R      O_WZ_Greifer_drehen_cw_rechts
  EMT

  L      O_WZ_Greifer_Zangen_zu
  =      ML_WZ_Greifer_Zangen_zu

  L      O_WZ_Greifer_Zange_1_auf
  =      ML_WZ_Greifer_Zange_1_auf

  L      O_WZ_Greifer_Zange_2_auf
  =      ML_WZ_Greifer_Zange_2_auf

  L      O_WZ_Greifer_einsetzen
  =      ML_WZ_Greifer_einsetzen

  L      O_WZ_Greifer_ausheben
  =      ML_WZ_Greifer_ausheben

  L      O_WZ_Greifer_drehen_ccw_links
  =      ML_WZ_Greifer_drehen_ccw_links

  L      O_WZ_Greifer_drehen_cw_rechts
  =      ML_WZ_Greifer_drehen_cw_rechts

#if CFG_WZ_Magazin_Schleuse = "aktiv"
  L      O_WZ_Schleuse_auf
  =      ML_WZ_Schleuse_auf

  L      O_WZ_Schleuse_zu
  =      ML_WZ_Schleuse_zu
#endif

EM
