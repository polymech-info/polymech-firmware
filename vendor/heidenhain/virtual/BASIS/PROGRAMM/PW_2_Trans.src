*-----------------------------------------------------------------------------
*  Paletten Wechsler translatorisch
*-----------------------------------------------------------------------------
*  Modul-Beschreibung
*
*-----------------------------------------------------------------------------

#define /s    KL_PW_Anzahl_2                           K +2
#define /s    KL_Palette_0                             K +0
#define /s    KL_Palette_1                             K +1
#define /s    KL_Palette_2                             K +2

#define /s    ML_Stack_synchronisieren                 M
#define /s    ML_PW_fertig                             M
#define /s    ML_Taste_betaetigt                       M
#define /s    ML_X_in_PW1_Posit                        M
#define /s    ML_X_in_PW2_Posit                        M

#include Mac_Lib.inc

EXTERN Start_Posit
EXTERN In_Posit

GLOBAL Pal_Wechsler

;----------------------------
LBL Pal_Wechsler
;----------------------------

  L      MG_Paletten_Wechsel_Pendeln_inaktiv
  IFT
    L      MG_M60_Paletten_Wechsel
    O      MG_M61_Palette_1_einwechseln
    O      MG_M62_Palette_2_einwechseln
    S      PN_Fehler_M_Befehl_ohne_Funktion
    EM
  ENDI

  L      MG_Rohteil_Seite_1
  O      MG_Rohteil_Seite_2
  =      O_LED_PW_Freigabe

  L      MG_M60_Paletten_Wechsel
  O      MG_M61_Palette_1_einwechseln
  O      MG_M62_Palette_2_einwechseln
  IFT
    L      MG_Takt_500_ms
    R      O_LED_PW_Freigabe
  ENDI

  L      MG_Taste_Anwahl_Rohteil_inaktiv
  S      MG_Rohteil_Seite_1
  S      MG_Rohteil_Seite_2
  IFF
    L      MG_Taste_Anwahl_Rohteil
    AN     ML_Taste_betaetigt
    A      I_PW_Platz_1_belegt
    XO     MG_Rohteil_Seite_1
    =      MG_Rohteil_Seite_1
  ENDI

  L      MG_Taste_Anwahl_Rohteil
  AN     ML_Taste_betaetigt
  A      I_PW_Platz_2_belegt
  XO     MG_Rohteil_Seite_2
  =      MG_Rohteil_Seite_2

  L      MG_Taste_Anwahl_Rohteil
  =      ML_Taste_betaetigt

  L      MG_PW_aktiv
  R      TS_PW_Timeout
  S      TS_PW_Timer_allgemein

  CASE   BG_Schritt_PW
    CM     PW_Aktivierung              ;00
    CM     PW_Freigabe                 ;01
    CM     Z_Start                     ;02
    CM     Z_in_PW_Posit               ;03
    CM     B_Start                     ;04
    CM     B_in_PW_Posit               ;05
    CM     P_Schleuse_auf              ;06
    CM     Sprung_Ma_leer              ;07 ---> (1)
    CM     X_PW_aus_Start              ;08
    CM     X_in_PW_aus_Posit           ;09
    CM     P_Schleuse_ist_auf          ;10
    CM     PW_Ma_zu_Halt               ;11
    CM     PW_in_Halt_Pos              ;12
    CM     Pal_entspannen              ;13
    CM     Pal_entspannt               ;14
    CM     PW_Time                     ;15
    CM     PW_zu_Belade_Pos            ;16
    CM     PW_in_Belade_Pos            ;17
    CM     Sprung_Ma_leeren            ;18 ---> (2)
    CM     Pal_entspannen              ;19 <--- (1)
    CM     Pal_entspannt               ;20
    CM     X_PW_ein_Start              ;21
    CM     X_in_PW_ein_Posit           ;22
    CM     PW_Belad_zu_Halt            ;23
    CM     PW_in_Halt_Pos              ;24
    CM     Pal_spannen                 ;25
    CM     Pal_gespannt                ;26
    CM     PW_zu_Maschine              ;27
    CM     PW_in_Maschine              ;28
    CM     Pal_spannen                 ;29 <--- (2)
    CM     Pal_gespannt                ;30
    CM     P_Schleuse_zu               ;31
    CM     P_Schleuse_ist_zu           ;32
    CM     PW_Quit                     ;33
    CM     PW_Ende                     ;34
  ENDC

  PLL
  S      TS_PW_Timeout
  IFT
    INC    BG_Schritt_PW
  ENDI

*  L      MG_PW_Diagnose
*  IFT
*    L      KL_Offset_PW_translat_1
*    +      BG_Schritt_PW
*    =X
*
*    L      S#D0[X]
*    =      SG_Diagnose_Zeile_1
*    INCX
*
*    L      S#D0[X]
*    =      SG_Diagnose_Zeile_2
*    INCX
*
*    L      S#D0[X]
*    =      SG_Diagnose_Zeile_3
*  ENDI

  LN     MG_PW_aktiv
  EMT

  L      MG_Impuls_NC_Start
  R      MG_PW_Unterbrechung

  L      MG_Taste_NC_Start
  O      MG_Impuls_CE_Taste
  S      TS_PW_Timeout

  LN     TR_PW_Timeout
  AN     TS_PW_Timeout
  =      PN_Fehler_PW_Timeout
  S      MG_PW_Unterbrechung

  L      MG_Taste_NC_Stop
  O      MG_Impuls_External_STOP
  S      MG_PW_Unterbrechung

  L      MG_Impuls_Internal_STOP
  O      MG_BA_Wechsel_Auto_Manu
  ON     MG_Steuerung_betriebsbereit
  CMT    PW_Reset

EM

;----------------------------
LBL PW_Aktivierung                     ;00

  L      MG_M60_Paletten_Wechsel
  O      MG_M61_Palette_1_einwechseln
  O      MG_M62_Palette_2_einwechseln
  A      MG_PW_Grund_Stellung
  S      MG_PW_aktiv
  PSL

EM

;----------------------------
LBL PW_Freigabe                        ;01

  L      MG_Eins_Merker
  S      TS_PW_Timeout

  L      MG_M60_Paletten_Wechsel
  A      I_PW_Platz_1_belegt
  A      I_PW_Platz_2_belegt
  S      PN_M4092_Quit_M_Funktion
  JPT    PW_Ende

  L      MG_M61_Palette_1_einwechseln
  AN     I_PW_Platz_1_belegt
  S      PN_M4092_Quit_M_Funktion
  JPT    PW_Ende

  L      MG_M62_Palette_2_einwechseln
  AN     I_PW_Platz_2_belegt
  S      PN_M4092_Quit_M_Funktion
  JPT    PW_Ende

  L      MG_M61_Palette_1_einwechseln
  AN     MG_Rohteil_Seite_1
  =      PN_Fehler_Anwahl_Table_1
  IFT
    L      MG_Takt_1_s
    =      O_LED_PW_Freigabe
  ENDI

  L      MG_M62_Palette_2_einwechseln
  AN     MG_Rohteil_Seite_2
  =      PN_Fehler_Anwahl_Table_2
  IFT
    L      MG_Takt_1_s
    =      O_LED_PW_Freigabe
  ENDI

  LN     I_PW_Beladetuer_geschlossen
  S      PN_Fehler_PW_Beladetuer_offen

  L      I_Arbeitsraum_1_zu_verriegelt
  A      I_Arbeitsraum_2_zu_verriegelt
  AN     PN_Fehler_PW_Beladetuer_offen
  O      MG_Tueren_inaktiv
  AN     PN_Fehler_Anwahl_Table_1
  AN     PN_Fehler_Anwahl_Table_2
  A      MG_Stern_ein
  AN     NP_M4157_BA_Restore_Position_aktiv
  AN     NP_M4193_RUNCANCEL_Makro_aktiv
  PSL

EM

;----------------------------
LBL Pal_entspannen                     ;11

  L      MG_Eins_Merker
  S      O_Palette_in_Maschine_entspannen
  R      O_Palette_in_Maschine_spannen
  PSL

EM

;----------------------------
LBL Pal_spannen                        ;20

  L      MG_Eins_Merker
  R      O_Palette_in_Maschine_entspannen
  S      O_Palette_in_Maschine_spannen
  PSL

EM

;----------------------------
LBL Pal_entspannt                      ;12

  L      I_Palette_in_Maschine_entspannt
  AN     I_Palette_in_Maschine_gespannt
  AN     MG_PW_Unterbrechung
  PSL

  L      MG_PW_Unterbrechung
  =      MG_Win_Pal_in_Maschine_entspannen

EM

;----------------------------
LBL Pal_gespannt                       ;21

  LN     I_Palette_in_Maschine_entspannt
  A      I_Palette_in_Maschine_gespannt
  AN     MG_PW_Unterbrechung
  PSL

  L      MG_PW_Unterbrechung
  =      MG_Win_Pal_in_Maschine_spannen

EM

;----------------------------
LBL P_Schleuse_auf                     ;03

  L      MG_Eins_Merker
  S      O_PW_Schleuse_auf
  R      O_PW_Schleuse_zu
  PSL

EM

;----------------------------
LBL P_Schleuse_ist_auf                 ;08

  L      I_PW_Schleuse_auf
  AN     I_PW_Schleuse_zu
  AN     MG_PW_Unterbrechung
  PSL

  L      MG_PW_Unterbrechung
  =      MG_Win_PW_Schleuse_auf

EM

;----------------------------
LBL P_Schleuse_zu                      ;24

  L      MG_Eins_Merker
  R      O_PW_Schleuse_auf
  S      O_PW_Schleuse_zu
  PSL

EM

;----------------------------
LBL P_Schleuse_ist_zu                  ;25

  LN     I_PW_Schleuse_auf
  A      I_PW_Schleuse_zu
  AN     MG_PW_Unterbrechung
  PSL

  L      MG_PW_Unterbrechung
  =      MG_Win_PW_Schleuse_zu

EM

;----------------------------
LBL Sprung_Ma_leer                     ;05

  L      I_PW_Platz_1_belegt
  A      I_PW_Platz_2_belegt
  IFT
    L      BG_Schritt_PW
    +      K+11
    =      BG_Schritt_PW
  ENDI

  PS     MG_Eins_Merker

EM

;----------------------------
LBL Sprung_Ma_leeren                   ;15

  L      MG_M60_Paletten_Wechsel
  IFT
    L      BG_Schritt_PW
    +      K+10
    =      BG_Schritt_PW
  ENDI

  PS     MG_Eins_Merker

EM

;----------------------------
LBL PW_Belad_zu_Halt                   ;18
LBL PW_zu_Maschine                     ;22

  L      ML_X_in_PW1_Posit
  R      O_PW_1_zu_Belade_Position
  S      O_PW_1_zu_Maschinen_Position

  L      ML_X_in_PW2_Posit
  R      O_PW_2_zu_Belade_Position
  S      O_PW_2_zu_Maschinen_Position

  PS     MG_Eins_Merker

EM

;----------------------------
LBL PW_Ma_zu_Halt                      ;09
LBL PW_zu_Belade_Pos                   ;13

  L      ML_X_in_PW1_Posit
  S      O_PW_1_zu_Belade_Position
  R      O_PW_1_zu_Maschinen_Position

  L      ML_X_in_PW2_Posit
  S      O_PW_2_zu_Belade_Position
  R      O_PW_2_zu_Maschinen_Position

  PS     MG_Eins_Merker

EM

;----------------------------
LBL PW_in_Halt_Pos                     ;10 ;19

  L      I_PW_1_in_Halt_Position
  R      O_PW_1_zu_Belade_Position
  R      O_PW_1_zu_Maschinen_Position

  L      I_PW_2_in_Halt_Position
  R      O_PW_2_zu_Belade_Position
  R      O_PW_2_zu_Maschinen_Position

  LN     O_PW_1_zu_Belade_Position
  AN     O_PW_1_zu_Maschinen_Position
  AN     O_PW_2_zu_Belade_Position
  AN     O_PW_2_zu_Maschinen_Position
  AN     MG_PW_Unterbrechung
  PSL

  L      MG_PW_Unterbrechung
  =      MG_Win_PW_zu_Halt_Position

EM

;----------------------------
LBL PW_in_Belade_Pos                   ;14

  L      I_PW_1_in_Belade_Position
  R      O_PW_1_zu_Belade_Position
  R      O_PW_1_zu_Maschinen_Position

  L      I_PW_2_in_Belade_Position
  R      O_PW_2_zu_Belade_Position
  R      O_PW_2_zu_Maschinen_Position

  LN     O_PW_1_zu_Belade_Position
  AN     O_PW_1_zu_Maschinen_Position
  AN     O_PW_2_zu_Belade_Position
  AN     O_PW_2_zu_Maschinen_Position
  AN     MG_PW_Unterbrechung
  PSL

  L      MG_PW_Unterbrechung
  =      MG_Win_PW_zum_Beladen

EM

;----------------------------
LBL PW_in_Maschine                     ;23

  L      I_PW_1_in_Maschinen_Position
  R      O_PW_1_zu_Belade_Position
  R      O_PW_1_zu_Maschinen_Position

  L      I_PW_2_in_Maschinen_Position
  R      O_PW_2_zu_Belade_Position
  R      O_PW_2_zu_Maschinen_Position

  LN     O_PW_1_zu_Belade_Position
  AN     O_PW_1_zu_Maschinen_Position
  AN     O_PW_2_zu_Belade_Position
  AN     O_PW_2_zu_Maschinen_Position
  AN     MG_PW_Unterbrechung
  PSL

  L      MG_PW_Unterbrechung
  =      MG_Win_PW_zu_Maschine

EM

;----------------------------
LBL X_PW_aus_Start                     ;06

  L      MG_M60_Paletten_Wechsel
  IFT
    L      I_PW_Platz_1_belegt
    AN     I_PW_Platz_2_belegt
    JPT    X_PW2_Start

    LN     I_PW_Platz_1_belegt
    A      I_PW_Platz_2_belegt
    JPT    X_PW1_Start
  ENDI

  L      MG_M61_Palette_1_einwechseln
  A      I_PW_Platz_1_belegt
  AN     I_PW_Platz_2_belegt
  JPT    X_PW2_Start

  L      MG_M62_Palette_2_einwechseln
  AN     I_PW_Platz_1_belegt
  A      I_PW_Platz_2_belegt
  JPT    X_PW1_Start

  L      MG_Eins_Merker
  S      MG_PW_Unterbrechung
  S      MG_Win_Fehler_Platz_Sensoren

  PS     MG_Null_Merker

EM

;----------------------------
LBL X_PW_ein_Start                     ;16

  L      MG_M61_Palette_1_einwechseln
  A      I_PW_Platz_1_belegt
  A      I_PW_Platz_2_belegt
  JPT    X_PW1_Start

  L      MG_M62_Palette_2_einwechseln
  A      I_PW_Platz_1_belegt
  A      I_PW_Platz_2_belegt
  JPT    X_PW2_Start

  L      MG_Eins_Merker
  S      MG_PW_Unterbrechung
  S      MG_Win_Fehler_Platz_Sensoren

  PS     MG_Null_Merker

EM

;----------------------------
LBL X_in_PW_aus_Posit                  ;07

  L      MG_M60_Paletten_Wechsel
  IFT
    L      I_PW_Platz_1_belegt
    AN     I_PW_Platz_2_belegt
    JPT    X_in_PW2_Posit

    LN     I_PW_Platz_1_belegt
    A      I_PW_Platz_2_belegt
    JPT    X_in_PW1_Posit
  ENDI

  L      MG_M61_Palette_1_einwechseln
  A      I_PW_Platz_1_belegt
  AN     I_PW_Platz_2_belegt
  JPT    X_in_PW2_Posit

  L      MG_M62_Palette_2_einwechseln
  AN     I_PW_Platz_1_belegt
  A      I_PW_Platz_2_belegt
  JPT    X_in_PW1_Posit

  L      MG_Eins_Merker
  S      MG_PW_Unterbrechung
  S      MG_Win_Fehler_Platz_Sensoren

  PS     MG_Null_Merker

EM

;----------------------------
LBL X_in_PW_ein_Posit                  ;17

  L      MG_M61_Palette_1_einwechseln
  A      I_PW_Platz_1_belegt
  A      I_PW_Platz_2_belegt
  JPT    X_in_PW1_Posit

  L      MG_M62_Palette_2_einwechseln
  A      I_PW_Platz_1_belegt
  A      I_PW_Platz_2_belegt
  JPT    X_in_PW2_Posit

  L      MG_Eins_Merker
  S      MG_PW_Unterbrechung
  S      MG_Win_Fehler_Platz_Sensoren

  PS     MG_Null_Merker

EM

;----------------------------
LBL Z_Start                            ;02

  L      MG_PW_Unterbrechung
  IFT
    PS     MG_Null_Merker
  ELSE
    PS     KG_Achse_Z
    PS     DG_Pendel_Pos_Z
    CM     Start_Posit
    PLL
    SN     MG_PW_Unterbrechung
    PSL
  ENDI

EM

;----------------------------
LBL Z_in_PW_Posit                      ;03

  L      MG_PW_Unterbrechung
  =      MG_Win_PW_Posit_Z

  PS     KG_Achse_Z
  PS     DG_Pendel_Pos_Z
  CM     In_Posit
  PLL
  AN     MG_PW_Unterbrechung
  PSL

EM

;----------------------------
LBL B_Start                            ;02

  L      MG_PW_Unterbrechung
  IFT
    PS     MG_Null_Merker
  ELSE
    PS     KG_Achse_4
    PS     K +0
    CM     Start_Posit
  ENDI

EM

;----------------------------
LBL B_in_PW_Posit                      ;04

  L      MG_PW_Unterbrechung
  =      MG_Win_PW_Posit_4

  PS     KG_Achse_4
  PS     K +0
  CM     In_Posit
  PLL
  AN     MG_PW_Unterbrechung
  PSL

EM

;----------------------------
LBL X_PW1_Start

  L      MG_PW_Unterbrechung
  IFT
    PS     MG_Null_Merker
  ELSE
    PS     KG_Achse_X
    PS     DG_Pendel_Pos_1_X
    CM     Start_Posit
    PLL
    SN     MG_PW_Unterbrechung
    PSL
  ENDI

EM

;----------------------------
LBL X_PW2_Start

  L      MG_PW_Unterbrechung
  IFT
    PS     MG_Null_Merker
  ELSE
    PS     KG_Achse_X
    PS     DG_Pendel_Pos_2_X
    CM     Start_Posit
    PLL
    SN     MG_PW_Unterbrechung
    PSL
  ENDI

EM

;----------------------------
LBL X_in_PW1_Posit

  L      MG_PW_Unterbrechung
  =      MG_Win_PW_Posit_X

  PS     KG_Achse_X
  PS     DG_Pendel_Pos_1_X
  CM     In_Posit
  PLL
  AN     MG_PW_Unterbrechung
  S      ML_X_in_PW1_Posit
  R      ML_X_in_PW2_Posit
  PSL

EM

;----------------------------
LBL X_in_PW2_Posit

  L      MG_PW_Unterbrechung
  =      MG_Win_PW_Posit_X

  PS     KG_Achse_X
  PS     DG_Pendel_Pos_2_X
  CM     In_Posit
  PLL
  AN     MG_PW_Unterbrechung
  R      ML_X_in_PW1_Posit
  S      ML_X_in_PW2_Posit
  PSL

EM

;----------------------------
LBL PW_Quit                            ;26

  LN     NP_M4072_Strobe_M_Funktion
  AN     MG_PW_Unterbrechung
  PSL

  LN     MG_PW_Unterbrechung
  S      PN_M4092_Quit_M_Funktion

EM

;----------------------------
LBL PW_Ende                            ;27

  PS     MG_Null_Merker

LBL PW_Reset

  L      ML_X_in_PW1_Posit
  R      MG_Rohteil_Seite_1

  L      ML_X_in_PW2_Posit
  R      MG_Rohteil_Seite_2

  L      MG_Eins_Merker
  R      O_PW_2_zu_Belade_Position
  R      O_PW_2_zu_Maschinen_Position
  R      ML_X_in_PW1_Posit
  R      ML_X_in_PW2_Posit
  R      MG_PW_aktiv
  R      MG_PW_Unterbrechung

  L      K+0
  =      BG_Schritt_PW

EM

;----------------------------
LBL PW_Time

  LN     TR_PW_Timer_allgemein
  =      TS_PW_Timer_allgemein
  PSL

EM
