  CM     Energy_Option
#endif

#if CFG_PLC_PY_Server = "aktiv"
  CM     TCP_IP_Server
#endif

#if CFG_PLC_PY_Client_1 = "aktiv"
  CM     TCP_IP_Client
#endif

#if CFG_Python = "aktiv"
