  CMF    Spindel_Getriebe
  CM     Spindel_Referenz
  CM     Spindel
  CM     Tastsystem
  CM     Spindel_Richten

#if CFG_3D_Kopf = "aktiv"
  CM     Kopf_3D
#endif

*#if 3D_Kopf_Wechsel = &aktiv
  CM     Kopf_3D_Wechsel
*#endif

  CM     Hirth
  CM     Achsen

  CM     Teilapparat
  CM     Kuehlmittel
  CM     Spaenefoerderer
  CM     WZW_manu

#if WZ_Greifer ! &inaktiv
