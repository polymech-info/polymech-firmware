  CMT    Init_nach_Reset

  CM     Simulation_Beginn
  CM     Grund_Funktionen
  CM     OEM_Funktion_Beginn

#if CFG_FS = "aktiv"
  CM     FS_Allgemein
#endif

  L      NP_M4174_1_PLC_Durchlauf_nach_MP_Edit
  R      MG_Maschinenparameter_gelesen

  LN     MG_Maschinenparameter_gelesen
  CMT    MP_lesen

  CM     MP_Teil_Datei

