#endif

  CM     Manuell_Handrad
  CM     MP_Tab_editieren
  CM     Hydraulik
  CM     Diagnose
  CM     FN19
  CM     M_Funktionen
#if CFG_IPC_61x0 = "aktiv"
  CM     IPC_61x0
#endif
  CM     Achs_Kompensation

#if (CFG_Temperatur_Kompensation = "MP_Faktor") or (CFG_Temperatur_Kompensation = "Tabelle")
  CM     Temperatur_Komp
#endif
  CM     PLC_Preset

  CM     Axis_Limit
  CM     Tueren
  CM     NC_Start_Stop
  CM     Referenz_Achsen

#if CFG_Schmierung_Achsen = "aktiv"
  CM     Schmierung
#endif

  L      MG_Spindel_mit_Stern_Dreieck_Umschaltung
