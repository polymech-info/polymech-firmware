;----------------------------
LBL WZW_auto_Reset

  L      MG_Eins_Merker
  R      ML_2nd_TOOL_CALL_folgt
  R      MG_WZW_automatisch
  R      MG_WZW_Unterbrechung
  R      MG_WZW_Spindel_Richten_ein
  R      MG_Win_Window_JA_Nein
  R      ML_WZ_Greifer_cw_rechts_stop
  R      ML_WZ_Greifer_ccw_links_stop
  R      PN_Fehler_WZ_Spindel_ok
  R      PN_M4542_Platz_Tabelle_fest
  R      O_WZ_Greifer_zu_Mittelstellung
  R      MG_Sn_O_Spindel_ausblasen

  L      K+0
  =      BG_Schritt_WZW
  =      BL_WZM_Index

  REPEAT
    L      MG_Eins_Merker
    R      STG_WZM[BL_WZM_Index].MG_WZM_Tool_Call

    INC    BL_WZM_Index

    L      BL_WZM_Index
    >=     KG_WZM_max_Anzahl
  UNTILT

  L      K+0
  =      BL_WZM_Index

EM

