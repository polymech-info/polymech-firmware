*-----------------------------------------------------------------------------
*  Spindel Referenz - Sonderablauf (X30)
*-----------------------------------------------------------------------------
*  Modul-Beschreibung
*    Sonderablauf wenn kein direktes Messgeraet an Spindel
*      MP3143: 1,3 oder
*      MP3143: 2
*
*    M18 - erneute Referenz Aufname für Spindeln mit Sonderablauf (X30)
*
*-----------------------------------------------------------------------------

#define /s    KL_Richtung_positiv                      K +1

#define /s    BL_Schritt_Referenz                      B

#include Mac_Lib.inc

GLOBAL Spindel_Referenz

;----------------------------
LBL Spindel_Referenz
;----------------------------

  CASE   BL_Schritt_Referenz
    CM     Referenz_aktiv              ;00
    CM     G_Stufe_ok                  ;01
    CM     Regler_ein                  ;02
    CM     Referenz_start              ;03
    CM     Referenz_ok                 ;04
    CM     Referenz_Quit               ;05
    CM     Referenz_Ende               ;06
  ENDC

  PLL
  IFT
    INC    BL_Schritt_Referenz
  ENDI

  LN     MG_Steuerung_betriebsbereit
  CMT    Spindel_Reset

EM

;----------------------------
LBL Referenz_aktiv                     ;00

  L      MG_M18_Spindel_Referenz
  S      MG_Spindel_Referenz_aktiv

  L      MG_Spindel_Referenz_aktiv
  A      MG_Spindel_steht
  AN     MG_Arbeitsraum_offen
  PSL

EM

;----------------------------
LBL G_Stufe_ok                         ;01

  LN     PN_M4134_Strobe_G_Stufe_Drehzahl
  PSL

EM

;----------------------------
LBL Regler_ein                         ;02

  L      MG_Spindel_digital
  IFT
    L      DG_Antriebe_bereit_MC
    BT     KG_Spindel
    PSL
  ELSE
    LN     TR_Regler_Freigabe_S
    PSL
  ENDI

EM

;----------------------------
LBL Referenz_start                     ;03

  PS     KG_Spindel
  PS     STG_Spindel[BG_Index_Sn].DG_Referenz_Drehzahl
  PS     KL_Richtung_positiv
  CM     9220                          ;Referenzmarke überfahren
  PLW
  ==     K+0
  PSL
    M_Modul_Fehler_anzeigen

EM

;----------------------------
LBL Referenz_ok                        ;04

  LN     NP_M4018_S_keine_Referenz
  PSL

EM

;----------------------------
LBL Referenz_Quit                      ;05

  L      MG_M18_Spindel_Referenz
  S      PN_M4092_Quit_M_Funktion

  LN     MG_M18_Spindel_Referenz
  PSL

EM

;----------------------------
LBL Referenz_Ende                      ;06

  PS     MG_Null_Merker

LBL Spindel_Reset

  L      MG_Eins_Merker
  R      MG_Spindel_Referenz_aktiv

  L      K+0
  =      BL_Schritt_Referenz

EM
