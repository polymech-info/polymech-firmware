*-----------------------------------------------------------------------------
*  Werkzeug Magazin mit Zählimpuls-Steuerung
*-----------------------------------------------------------------------------
*  Modul-Beschreibung
*  PLC Status (Tool Table):
*    #Bit 1 (%00000010) - WZ mit Überlänge
*                       - (WZ Platz nicht ausklappen nach TOOL DEF)
*  $WS
*  Fehlermeldungen, Timer (Array) magazinabhängig
*-----------------------------------------------------------------------------

#define /s    KL_Soll_Pos_fuer_Rechtslauf              K -1000
#define /s    KL_Soll_Pos_fuer_Linkslauf               K +1000
#define /s    KL_String_Anzahl                         K +3

#define /s    ML_WZM_Diagnose                   M
#define /s    ML_debug_WZM_01                          M

#define /s    BL_WZM_Index                             B
#define /s    BL_WZM_Achs_Index                        B
#define /s    BL_String_Index                          B

#define /s    WL_Zeile_Dialog_Datei                    W

#define /s /r WL_WZM_Ist_Platz_remanent                W [&KG_max_WZM_Anzahl]
#define /s /r WL_WZM_Ist_2_Platz_remanent              W [&KG_max_WZM_Anzahl]

EXTERN Absolut

GLOBAL WZ_Magazin
GLOBAL WZM_rechts_drehen
GLOBAL WZM_links_drehen

;----------------------------
LBL WZ_Magazin
;----------------------------

  LN     MG_WZW_Auto_aktiv
  EMT

  CM     WZM_n_Input_lesen

  LN     NP_M4074_Strobe_TOOL_DEF
  R      PN_M4094_Quit_TOOL_DEF

  L      K+0
  =      BL_WZM_Index

  L      MG_Eins_Merker
  R      MG_WZM_n_Start_aktiv
  R      TS_WZM_Timeout
  R      PN_Fehler_WZM_Referenz

  REPEAT

    L      WL_WZM_Ist_Platz_remanent[BL_WZM_Index]
    =      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Platz

#if WZ_Magazin_Referenz_Sensor = &inaktiv
    L      WL_WZM_Ist_2_Platz_remanent[BL_WZM_Index]
    =      STG_WZM[BL_WZM_Index].WG_WZM_Ist_2_Platz_Zaehler
#endif

    L      STG_WZM[BL_WZM_Index].WG_WZM_Ist_2_Platz_Zaehler
    ==     K+0
    A[
      L      STG_WZM[BL_WZM_Index].WG_MP7261_WZM_max_Platz
      >      K+0
    ]
    S      STG_WZM[BL_WZM_Index].MG_WZM_Referenz_notwendig

    L      STG_WZM[BL_WZM_Index].MG_WZM_Referenz_notwendig
    A      MG_Steuerung_betriebsbereit
    AN     MG_WZW_Help
    S      PN_Fehler_WZM_Referenz
    IFT
      L      STG_WZM[BL_WZM_Index].MG_O_WZM_Rechtslauf
      O      STG_WZM[BL_WZM_Index].MG_O_WZM_Linkslauf
      A      MG_Takt_1_s
      R      PN_Fehler_WZM_Referenz
    ENDI

    L      STG_WZM[BL_WZM_Index].MG_I_WZM_Referenz
    AN     STG_WZM[BL_WZM_Index].ML_WZM_Referenz
#if WZ_Magazin_Referenz_Sensor = &aktiv
    A      STG_WZM[BL_WZM_Index].MG_WZM_Referenz_notwendig
#endif
    IFT
      L      K+0
      =      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Soll_Platz_Differenz

      L      K+1
      =      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Platz
      =      STG_WZM[BL_WZM_Index].WG_WZM_Ist_2_Platz_Zaehler
      =      STG_WZM[BL_WZM_Index].WG_WZM_Soll_Platz
    ENDI

    L      STG_WZM[BL_WZM_Index].MG_I_WZM_Referenz
    =      STG_WZM[BL_WZM_Index].ML_WZM_Referenz

    L      STG_WZM[BL_WZM_Index].MG_I_WZM_Zaehler
    AN     STG_WZM[BL_WZM_Index].ML_WZM_Zaehler
    A      STG_WZM[BL_WZM_Index].MG_O_WZM_Rechtslauf
    IFT
      INC    STG_WZM[BL_WZM_Index].WG_WZM_Ist_Platz
      DEC    STG_WZM[BL_WZM_Index].WG_WZM_Ist_Soll_Platz_Differenz

      L      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Platz
      >      STG_WZM[BL_WZM_Index].WG_MP7261_WZM_max_Platz
      IFT
        L      K+1
        =      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Platz
      ENDI
    ENDI

    L      STG_WZM[BL_WZM_Index].MG_I_WZM_Zaehler
    AN     STG_WZM[BL_WZM_Index].ML_WZM_Zaehler
    A      STG_WZM[BL_WZM_Index].MG_O_WZM_Linkslauf
    IFT
      DEC    STG_WZM[BL_WZM_Index].WG_WZM_Ist_Platz
      DEC    STG_WZM[BL_WZM_Index].WG_WZM_Ist_Soll_Platz_Differenz

      L      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Platz
      ==     K+0
      IFT
        L      STG_WZM[BL_WZM_Index].WG_MP7261_WZM_max_Platz
        =      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Platz
      ENDI
    ENDI

    L      STG_WZM[BL_WZM_Index].MG_I_WZM_Zaehler
    =      STG_WZM[BL_WZM_Index].ML_WZM_Zaehler

    L      STG_WZM[BL_WZM_Index].MG_I_WZM_Genauhalt
    AN     STG_WZM[BL_WZM_Index].ML_WZM_Genauhalt
    A      STG_WZM[BL_WZM_Index].MG_O_WZM_Rechtslauf
#if WZ_Magazin_Referenz_Sensor = &aktiv
    AN     STG_WZM[BL_WZM_Index].MG_WZM_Referenz_notwendig
#endif
    IFT
      S      MG_WZ_Vorwahl_Status_lesen

      INC    STG_WZM[BL_WZM_Index].WG_WZM_Ist_2_Platz_Zaehler

      L      STG_WZM[BL_WZM_Index].WG_WZM_Ist_2_Platz_Zaehler
      >      STG_WZM[BL_WZM_Index].WG_MP7261_WZM_max_Platz
      IFT
        L      K+1
        =      STG_WZM[BL_WZM_Index].WG_WZM_Ist_2_Platz_Zaehler
      ENDI
    ENDI

    L      STG_WZM[BL_WZM_Index].MG_I_WZM_Genauhalt
    AN     STG_WZM[BL_WZM_Index].ML_WZM_Genauhalt
    A      STG_WZM[BL_WZM_Index].MG_O_WZM_Linkslauf
#if WZ_Magazin_Referenz_Sensor = &aktiv
    AN     STG_WZM[BL_WZM_Index].MG_WZM_Referenz_notwendig
#endif
    IFT
      S      MG_WZ_Vorwahl_Status_lesen

      DEC    STG_WZM[BL_WZM_Index].WG_WZM_Ist_2_Platz_Zaehler

      L      STG_WZM[BL_WZM_Index].WG_WZM_Ist_2_Platz_Zaehler
      ==     K+0
      IFT
        L      STG_WZM[BL_WZM_Index].WG_MP7261_WZM_max_Platz
        =      STG_WZM[BL_WZM_Index].WG_WZM_Ist_2_Platz_Zaehler
      ENDI
    ENDI

    L      STG_WZM[BL_WZM_Index].MG_I_WZM_Genauhalt
    =      STG_WZM[BL_WZM_Index].ML_WZM_Genauhalt

    L      BG_WZM_Index_Tool_Call
    ==     BL_WZM_Index
    A      NP_M4074_Strobe_TOOL_DEF
    AN     STG_WZM[BL_WZM_Index].MG_WZM_Unterbrechung
    AN     MG_WZM_Beladen_aktiv
    AN     STG_WZM[BL_WZM_Index].MG_WZM_Tool_Def
    S      STG_WZM[BL_WZM_Index].MG_WZM_Tool_Def
    S      MG_WZM_Tool_Def_aktiv
    IFT
      L      NP_W262_Werkzeug_Platz_Nummer
      =      STG_WZM[BL_WZM_Index].WL_Tool_Def_Platz_Nummer
      L      NP_W264_Werkzeug_Nummer
      =      STG_WZM[BL_WZM_Index].WL_Tool_Def_Werkzeug_Nummer
    ENDI

    L      MG_Eins_Merker
    S      TS_WZM_1_Genauhalt[BL_WZM_Index]

    L      STG_WZM[BL_WZM_Index].MG_WZM_Start
*$WS   =      TS_WZM_Timeout
    R      TS_WZM_Timeout

    LN     STG_WZM[BL_WZM_Index].MG_O_WZM_Index_ausheben
    AN     STG_WZM[BL_WZM_Index].MG_I_WZM_Index_eingesetzt
    =      STG_WZM[BL_WZM_Index].MG_O_WZM_Index_einsetzen

    CASE   STG_WZM[BL_WZM_Index].BG_Schritt_WZM
      CM     WZ_Magazin_Start          ;00
      CM     Tool_Def_Quit             ;01
      CM     Mag_Platz_ein             ;02
      CM     Mag_Platz_Pos_ein         ;03
      CM     Magazin_Richtung          ;04
      CM     Mag_Index_aus             ;05
      CM     Mag_Index_Pos_aus         ;06
      CM     Magazin_SOLL_Pos          ;07
      CM     Time_genau_Halt           ;08
      CM     Mag_Index_Pos_ein         ;09
      CM     Mag_genau_Halt            ;10
      CM     T_Vorwahl_Status          ;11
      CM     Mag_Platz_ein_aus         ;12
      CM     Mag_Platz_Posit           ;13
      CM     WZ_Magazin_Ende           ;14
    ENDC

    PLL
    AN     STG_WZM[BL_WZM_Index].MG_WZM_Unterbrechung
    S      TS_WZM_Timeout
    =      STG_WZM[BL_WZM_Index].ML_Schritt_Start
    IFT
      INC    STG_WZM[BL_WZM_Index].BG_Schritt_WZM
    ENDI

    L      STG_WZM[BL_WZM_Index].BG_Schritt_WZM
    <>     STG_WZM[BL_WZM_Index].BL_Schritt_WZM
    ON     ML_WZM_Diagnose
    A      MG_WZM_Diagnose
    IFT
      L      K +0
      =      BL_String_Index

      L      STG_WZM[BL_WZM_Index].BG_Schritt_WZM
      =      STG_WZM[BL_WZM_Index].BL_Schritt_WZM
      REPEAT
        L      STG_WZM[BL_WZM_Index].BL_Schritt_WZM
        =X

        L      KF Diagnose[X]
        =      WL_Zeile_Dialog_Datei
        =X

        L      S#D0[X]
        =      SG_WZM_Diagnose_Zeile_1[BL_String_Index]

        INC    STG_WZM[BL_WZM_Index].BL_Schritt_WZM
        INC    BL_String_Index
        INCX

        L      BL_String_Index
        >=     KL_String_Anzahl
      UNTILT
    ENDI

    L      STG_WZM[BL_WZM_Index].BG_Schritt_WZM
    =      STG_WZM[BL_WZM_Index].BL_Schritt_WZM

    L      MG_WZM_Diagnose
    =      ML_WZM_Diagnose

    L      STG_WZM[BL_WZM_Index].MG_WZM_Start
    S      MG_WZM_n_Start_aktiv
    IFT
      L      STG_WZM[BL_WZM_Index].MG_Status[KG_Posit_Fehler]
      =      PN_Fehler_Posit_WZM

      L      MG_Taste_NC_Start_P_Impuls
      R      STG_WZM[BL_WZM_Index].MG_WZM_Unterbrechung

      L      MG_Taste_NC_Start
      O      MG_Impuls_CE_Taste
      S      TS_WZM_Timeout

      LN     TS_WZM_Timeout
      AN     TR_WZM_Timeout
      =      PN_Fehler_WZM_Timeout
      S      STG_WZM[BL_WZM_Index].MG_WZM_Unterbrechung

      L      MG_Impuls_External_STOP
      AN     NP_M4157_BA_Restore_Position_aktiv
      O      MG_Taste_NC_Stop
      S      STG_WZM[BL_WZM_Index].MG_WZM_Unterbrechung

      L      STG_WZM[BL_WZM_Index].MG_WZM_Unterbrechung
      O      MG_Impuls_End_PGM_M02_M30
      O      MG_Arbeitsraum_offen
      R      STG_WZM[BL_WZM_Index].MG_WZM_Tool_Def

      L      MG_Impuls_Internal_STOP
      O      MG_Impuls_WZW_Help
      O      MG_Impuls_WZW_Service
      ON     MG_Steuerung_betriebsbereit
      CMT    WZ_Magazin_Reset
    ENDI

    L      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Platz
    =      WL_WZM_Ist_Platz_remanent[BL_WZM_Index]

    L      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Platz
    +      STG_WZM[BL_WZM_Index].DG_WZM_Offset_Beladeplatz
    -      K+1
    MOD    STG_WZM[BL_WZM_Index].WG_MP7261_WZM_max_Platz
    +      K+1
    =      STG_WZM[BL_WZM_Index].WG_WZM_Beladen_Ist_Platz

#if WZ_Magazin_Referenz_Sensor = &inaktiv
    L      STG_WZM[BL_WZM_Index].WG_WZM_Ist_2_Platz_Zaehler
    =      WL_WZM_Ist_2_Platz_remanent[BL_WZM_Index]
#endif

    INC    BL_WZM_Index

    L      BL_WZM_Index
    >=     WG_WZM_Anzahl
    O      ML_debug_WZM_01
  UNTILT

  CM     WZM_n_Output_schreiben

EM

;----------------------------
LBL WZ_Magazin_Start                   ;00

  LN     STG_WZM[BL_WZM_Index].MG_I_WZM_Zaehler
  ON     STG_WZM[BL_WZM_Index].MG_I_WZM_Genauhalt
  AN     MG_WZW_automatisch
  S      STG_WZM[BL_WZM_Index].MG_WZM_Referenz_notwendig

#if WZ_Magazin_Referenz_Sensor = &aktiv
  L      STG_WZM[BL_WZM_Index].MG_WZM_Referenz_notwendig
  A      MG_Taste_NC_Start_P_Impuls
  A      MG_Steuerung_betriebsbereit
  A      MG_WZW_Grund_Stellung
  AN     MG_WZW_Help
  S      STG_WZM[BL_WZM_Index].MG_WZM_Start
#endif

  L      STG_WZM[BL_WZM_Index].MG_WZM_Tool_Def
  O      STG_WZM[BL_WZM_Index].MG_WZM_Beladen_Entladen_Start
  A      MG_WZW_Grund_Stellung
  AN     MG_WZW_automatisch
  O      STG_WZM[BL_WZM_Index].MG_WZM_Tool_Call
  S      STG_WZM[BL_WZM_Index].MG_WZM_Start

  L      STG_WZM[BL_WZM_Index].MG_WZM_Start
  PSL
  EMF

  L      STG_WZM[BL_WZM_Index].MG_WZM_Beladen_Entladen_Start
  IFT
    L      STG_WZM[BL_WZM_Index].WG_WZM_Beladen_Soll_Platz
    =      STG_WZM[BL_WZM_Index].WG_WZM_Soll_Platz
  ENDI

  L      STG_WZM[BL_WZM_Index].MG_WZM_Tool_Def
  AN     STG_WZM[BL_WZM_Index].MG_WZM_Tool_Call
  R      STG_WZM[BL_WZM_Index].MG_WZM_Tool_Def
  IFT
    L      STG_WZM[BL_WZM_Index].WL_Tool_Def_Platz_Nummer
    =      STG_WZM[BL_WZM_Index].WG_WZM_Soll_Platz
  ENDI

  L      STG_WZM[BL_WZM_Index].MG_WZM_Tool_Call
  R      STG_WZM[BL_WZM_Index].MG_WZM_Tool_Call
  IFT
    L      WG_WZW_Platz_Nummer
    =      STG_WZM[BL_WZM_Index].WG_WZM_Soll_Platz
  ENDI

  L      STG_WZM[BL_WZM_Index].WG_WZM_Soll_Platz
  <=     K+0
  A      MG_BA_Automatik
  AN     MG_Edit_Platz_Tabelle
  IFT
    L      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Platz
    =      STG_WZM[BL_WZM_Index].WG_WZM_Soll_Platz
  ENDI

#if WZ_Magazin_Referenz_Sensor = &aktiv
  L      STG_WZM[BL_WZM_Index].MG_WZM_Referenz_notwendig
  IFT
    L      K-1000
    =      STG_WZM[BL_WZM_Index].WG_WZM_Soll_Platz
  ENDI
#endif

  L      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Platz
  ==     STG_WZM[BL_WZM_Index].WG_WZM_Soll_Platz
  IFT
    L      NP_M4074_Strobe_TOOL_DEF
    S      PN_M4094_Quit_TOOL_DEF
    S      TS_WZM_Timeout

    PLL
    A      MG_Null_Merker
    PSL

    LN     NP_M4074_Strobe_TOOL_DEF
    JPT    WZ_Magazin_Reset
  ENDI

EM

;----------------------------
LBL Tool_Def_Quit                      ;01

  L      NP_M4074_Strobe_TOOL_DEF
  S      PN_M4094_Quit_TOOL_DEF

  LN     NP_M4074_Strobe_TOOL_DEF
  AN     STG_WZM[BL_WZM_Index].MG_WZM_Unterbrechung
  R      STG_WZM[BL_WZM_Index].MG_WZM_Tool_Def
  PSL

EM

;----------------------------
LBL Mag_Platz_ein                      ;02

  L      MG_Eins_Merker
  S      STG_WZM[BL_WZM_Index].MG_O_WZM_Platz_einklappen
  R      STG_WZM[BL_WZM_Index].MG_O_WZM_Platz_ausklappen
  PSL

EM

;----------------------------
LBL Mag_Platz_Pos_aus

#if WZ_Platz_ausklappen_90_Grad = &aktiv
  L      STG_WZM[BL_WZM_Index].MG_I_WZM_Platz_ausgeklappt
  AN     STG_WZM[BL_WZM_Index].MG_I_WZM_Platz_eingeklappt
  AN     STG_WZM[BL_WZM_Index].MG_WZM_Unterbrechung
  PSL

  L      STG_WZM[BL_WZM_Index].MG_WZM_Unterbrechung
  =      MG_Win_WZ_Platz_ausklappen
#else
  PS     MG_Eins_Merker
#endif

EM

;----------------------------
LBL Mag_Platz_Pos_ein                  ;03

#if WZ_Platz_ausklappen_90_Grad = &aktiv
  LN     STG_WZM[BL_WZM_Index].MG_I_WZM_Platz_ausgeklappt
  A      STG_WZM[BL_WZM_Index].MG_I_WZM_Platz_eingeklappt
  AN     STG_WZM[BL_WZM_Index].MG_WZM_Unterbrechung
  PSL

  L      STG_WZM[BL_WZM_Index].MG_WZM_Unterbrechung
  =      MG_Win_WZ_Platz_einklappen
#else
  PS     MG_Eins_Merker
#endif

EM

;----------------------------
LBL Magazin_Richtung                   ;04

  PS     MG_Eins_Merker

  L      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Platz
  -      STG_WZM[BL_WZM_Index].WG_WZM_Soll_Platz
  PSW
  CM     Absolut
  PLW
  =      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Soll_Platz_Differenz
  <=[
    L      STG_WZM[BL_WZM_Index].WG_MP7261_WZM_max_Platz
    /      K+2
  ]
  =      STG_WZM[BL_WZM_Index].ML_Diff_kleiner_gleich_Mag_halbe
  IFF
    L      STG_WZM[BL_WZM_Index].WG_MP7261_WZM_max_Platz
    -      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Soll_Platz_Differenz
    =      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Soll_Platz_Differenz

    PS     STG_WZM[BL_WZM_Index].WG_WZM_Ist_Soll_Platz_Differenz
    CM     Absolut
    PL     STG_WZM[BL_WZM_Index].WG_WZM_Ist_Soll_Platz_Differenz
  ENDI

  L      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Platz
  >      STG_WZM[BL_WZM_Index].WG_WZM_Soll_Platz
  =      STG_WZM[BL_WZM_Index].ML_Ist_Pos_groesser_Soll_Pos

  L      STG_WZM[BL_WZM_Index].ML_Diff_kleiner_gleich_Mag_halbe
  XO     STG_WZM[BL_WZM_Index].ML_Ist_Pos_groesser_Soll_Pos
  =      STG_WZM[BL_WZM_Index].ML_WZM_Richtung_rechts

EM

;----------------------------
LBL Mag_Index_aus                      ;05

  L      MG_Eins_Merker
  S      STG_WZM[BL_WZM_Index].MG_O_WZM_Index_ausheben
  PSL

EM

;----------------------------
LBL Mag_Index_Pos_aus                  ;06

#if WZ_Magazin_Index = &aktiv
  LN     STG_WZM[BL_WZM_Index].MG_I_WZM_Index_eingesetzt
  A      STG_WZM[BL_WZM_Index].MG_I_WZM_Index_ausgehoben
  AN     STG_WZM[BL_WZM_Index].MG_WZM_Unterbrechung
  PSL

  L      STG_WZM[BL_WZM_Index].MG_WZM_Unterbrechung
  =      MG_Win_WZ_Mag_Index_ausheben
#else
  PS     MG_Eins_Merker
#endif

EM

;----------------------------
LBL Magazin_SOLL_Pos                   ;07

  L      STG_WZM[BL_WZM_Index].MG_WZM_Start
  A      STG_WZM[BL_WZM_Index].ML_WZM_Richtung_rechts
  =      STG_WZM[BL_WZM_Index].MG_O_WZM_Rechtslauf

  L      STG_WZM[BL_WZM_Index].MG_WZM_Start
  AN     STG_WZM[BL_WZM_Index].ML_WZM_Richtung_rechts
  =      STG_WZM[BL_WZM_Index].MG_O_WZM_Linkslauf

  L      STG_WZM[BL_WZM_Index].MG_I_WZM_Zaehler
  O      STG_WZM[BL_WZM_Index].MG_I_WZM_Genauhalt
  AN     I_WZM_Tuer_zu
  AN     MG_Tueren_inaktiv
  S      STG_WZM[BL_WZM_Index].MG_WZM_Unterbrechung

  L      STG_WZM[BL_WZM_Index].MG_I_WZM_Zaehler
  O      STG_WZM[BL_WZM_Index].MG_I_WZM_Genauhalt
  A      STG_WZM[BL_WZM_Index].MG_WZM_Unterbrechung
  R      STG_WZM[BL_WZM_Index].MG_O_WZM_Rechtslauf
  R      STG_WZM[BL_WZM_Index].MG_O_WZM_Linkslauf

#if WZ_Magazin_Index = &aktiv
  L      STG_WZM[BL_WZM_Index].MG_I_WZM_Index_eingesetzt
  ON     STG_WZM[BL_WZM_Index].MG_I_WZM_Index_ausgehoben
  R      STG_WZM[BL_WZM_Index].MG_O_WZM_Rechtslauf
  R      STG_WZM[BL_WZM_Index].MG_O_WZM_Linkslauf
#endif

  L      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Platz
  <>     STG_WZM[BL_WZM_Index].WG_WZM_Soll_Platz
  ON     STG_WZM[BL_WZM_Index].MG_I_WZM_Zaehler
  ON     STG_WZM[BL_WZM_Index].MG_I_WZM_Genauhalt
  =      TS_WZM_1_verzoegert_Stop[BL_WZM_Index]

  LN     TS_WZM_1_verzoegert_Stop[BL_WZM_Index]
  AN     TR_WZM_1_verzoegert_Stop[BL_WZM_Index]
  R      STG_WZM[BL_WZM_Index].MG_O_WZM_Rechtslauf
  R      STG_WZM[BL_WZM_Index].MG_O_WZM_Linkslauf
#if WZ_Magazin_Index = &aktiv
  R      STG_WZM[BL_WZM_Index].MG_O_WZM_Index_ausheben
#endif

  PSL

  L      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Soll_Platz_Differenz
  >      K+1
  AN     STG_WZM[BL_WZM_Index].MG_WZM_Unterbrechung
#if WZ_Magazin_Index = &aktiv
  AN     STG_WZM[BL_WZM_Index].MG_I_WZM_Index_eingesetzt
  A      STG_WZM[BL_WZM_Index].MG_I_WZM_Index_ausgehoben
  A      STG_WZM[BL_WZM_Index].MG_O_WZM_Index_ausheben
#endif
  =      STG_WZM[BL_WZM_Index].MG_O_WZM_Eilgang

  L      STG_WZM[BL_WZM_Index].MG_O_WZM_Rechtslauf
  O      STG_WZM[BL_WZM_Index].MG_O_WZM_Linkslauf
  AN     STG_WZM[BL_WZM_Index].MG_O_WZM_Eilgang
#if WZ_Magazin_Index = &aktiv
  AN     STG_WZM[BL_WZM_Index].MG_I_WZM_Index_eingesetzt
  A      STG_WZM[BL_WZM_Index].MG_I_WZM_Index_ausgehoben
  A      STG_WZM[BL_WZM_Index].MG_O_WZM_Index_ausheben
#endif
  =      STG_WZM[BL_WZM_Index].MG_O_WZM_Schleichgang

#if WZ_Magazin_Index = &aktiv
  L      STG_WZM[BL_WZM_Index].MG_I_WZM_Index_eingesetzt
  ON     STG_WZM[BL_WZM_Index].MG_I_WZM_Index_ausgehoben
  A      STG_WZM[BL_WZM_Index].MG_O_WZM_Index_ausheben
  A      STG_WZM[BL_WZM_Index].MG_WZM_Unterbrechung
  =      MG_Win_WZ_Mag_Index_ausheben
#endif

  LN     STG_WZM[BL_WZM_Index].ML_WZM_Start_manuell
  A      STG_WZM[BL_WZM_Index].MG_I_WZM_Zaehler
  A      STG_WZM[BL_WZM_Index].ML_WZM_manuell_rechts
  R      STG_WZM[BL_WZM_Index].ML_WZM_manuell_rechts
  CMT    WZM_rechts_Stop

  LN     STG_WZM[BL_WZM_Index].ML_WZM_Start_manuell
  A      STG_WZM[BL_WZM_Index].MG_I_WZM_Zaehler
  A      STG_WZM[BL_WZM_Index].ML_WZM_manuell_links
  R      STG_WZM[BL_WZM_Index].ML_WZM_manuell_links
  CMT    WZM_links_Stop

  L      MG_Eins_Merker
  R      STG_WZM[BL_WZM_Index].ML_WZM_Start_manuell

EM

;----------------------------
LBL Time_genau_Halt                    ;08

  L      MG_Eins_Merker
  R      TS_WZM_1_Genauhalt[BL_WZM_Index]

  LN     TR_WZM_1_Genauhalt[BL_WZM_Index]
  PSL

EM

;----------------------------
LBL Mag_Index_Pos_ein                  ;09

#if WZ_Magazin_Index = &aktiv
  L      STG_WZM[BL_WZM_Index].MG_I_WZM_Index_eingesetzt
  AN     STG_WZM[BL_WZM_Index].MG_I_WZM_Index_ausgehoben
  AN     STG_WZM[BL_WZM_Index].MG_WZM_Unterbrechung
  PSL

  L      STG_WZM[BL_WZM_Index].MG_WZM_Unterbrechung
  =      MG_Win_WZ_Mag_Index_einsetzen
#else
  PS     MG_Eins_Merker
#endif

EM

;----------------------------
LBL Mag_genau_Halt                     ;10

  L      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Platz
  <>     STG_WZM[BL_WZM_Index].WG_WZM_Ist_2_Platz_Zaehler
  ON     STG_WZM[BL_WZM_Index].MG_I_WZM_Zaehler
  ON     STG_WZM[BL_WZM_Index].MG_I_WZM_Genauhalt
  =      STG_WZM[BL_WZM_Index].MG_WZM_Referenz_notwendig

  PS     MG_Eins_Merker

EM

;----------------------------
LBL T_Vorwahl_Status                   ;11

  L      MG_Eins_Merker
  S      MG_WZ_Vorwahl_Status_lesen
  PSL

EM

;----------------------------
LBL Mag_Platz_ein_aus                  ;12

  LN     MG_WZ_Vorwahl_Status_lesen
  PSL
  EMF

#if WZ_Platz_ausklappen_90_Grad = &aktiv
  L      MG_BA_Manuell
  O      MG_WZM_Beladen_aktiv
  EMT

  L      BG_WZ_Vorwahl_Status
  BT     K+1
  =      MG_WZ_Ueberlaenge

  LN     MG_WZ_Ueberlaenge
  R      STG_WZM[BL_WZM_Index].MG_O_WZM_Platz_einklappen
  S      STG_WZM[BL_WZM_Index].MG_O_WZM_Platz_ausklappen
#endif

EM

;----------------------------
LBL Mag_Platz_Posit                    ;13

  L      MG_WZ_Ueberlaenge
  O      MG_BA_Manuell
  O      MG_WZM_Beladen_aktiv
  O      STG_WZM[BL_WZM_Index].MG_WZM_Referenz_notwendig
  CMT    Mag_Platz_Pos_ein
  CMF    Mag_Platz_Pos_aus

EM

;----------------------------
LBL WZ_Magazin_Ende                    ;14

  PS     MG_Null_Merker

LBL WZ_Magazin_Reset

  L      MG_Eins_Merker
  R      STG_WZM[BL_WZM_Index].MG_WZM_Start
  R      STG_WZM[BL_WZM_Index].MG_WZM_Unterbrechung
  R      STG_WZM[BL_WZM_Index].MG_WZM_Beladen_Entladen_Start
  R      MG_SK_WZ_Beladen
  R      MG_SK_WZ_Entladen
  R      MG_WZM_Tool_Def_aktiv
  R      STG_WZM[BL_WZM_Index].ML_WZM_Start_manuell
  R      STG_WZM[BL_WZM_Index].ML_WZM_manuell_links
  R      STG_WZM[BL_WZM_Index].ML_WZM_manuell_rechts
  R      STG_WZM[BL_WZM_Index].MG_O_WZM_Rechtslauf
  R      STG_WZM[BL_WZM_Index].MG_O_WZM_Linkslauf
  R      STG_WZM[BL_WZM_Index].MG_O_WZM_Eilgang
  R      STG_WZM[BL_WZM_Index].MG_O_WZM_Schleichgang

  L      K+0
  =      STG_WZM[BL_WZM_Index].BG_Schritt_WZM

*$WS Diagnose wie WZ_Mag1.src
  L      S"            "
  =      SG_WZM_Diagnose_Zeile_1
  =      SG_WZM_Diagnose_Zeile_2
  =      SG_WZM_Diagnose_Zeile_3

EM

;----------------------------
LBL WZM_rechts_drehen

  L      BG_WZM_Index_Tool_Call
  =      BL_WZM_Index

#if WZ_Magazin_Referenz_Sensor = &aktiv
  L      STG_WZM[BL_WZM_Index].MG_WZM_Referenz_notwendig
  EMT
#endif

  L      MG_BA_Manuell
  O      MG_Edit_Platz_Tabelle
  =      STG_WZM[BL_WZM_Index].ML_WZM_Start_manuell
  S      STG_WZM[BL_WZM_Index].ML_WZM_manuell_rechts

  LN     STG_WZM[BL_WZM_Index].MG_WZM_Start
  S      STG_WZM[BL_WZM_Index].MG_WZM_Start
  IFT
    L      KL_Soll_Pos_fuer_Rechtslauf
    =      STG_WZM[BL_WZM_Index].WG_WZM_Soll_Platz
  ENDI

EM

;----------------------------
LBL WZM_rechts_Stop

  L      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Platz
  +      K+1
  =      STG_WZM[BL_WZM_Index].WG_WZM_Soll_Platz

  L      STG_WZM[BL_WZM_Index].WG_WZM_Soll_Platz
  >      STG_WZM[BL_WZM_Index].WG_MP7261_WZM_max_Platz
  IFT
    L      K+1
    =      STG_WZM[BL_WZM_Index].WG_WZM_Soll_Platz
  ENDI

  L      K+1
  =      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Soll_Platz_Differenz

EM

;----------------------------
LBL WZM_links_drehen

  L      BG_WZM_Index_Tool_Call
  =      BL_WZM_Index

#if WZ_Magazin_Referenz_Sensor = &aktiv
  L      STG_WZM[BL_WZM_Index].MG_WZM_Referenz_notwendig
  EMT
#endif

  L      MG_BA_Manuell
  O      MG_Edit_Platz_Tabelle
  =      STG_WZM[BL_WZM_Index].ML_WZM_Start_manuell
  S      STG_WZM[BL_WZM_Index].ML_WZM_manuell_links

  LN     STG_WZM[BL_WZM_Index].MG_WZM_Start
  S      STG_WZM[BL_WZM_Index].MG_WZM_Start
  IFT
    L      KL_Soll_Pos_fuer_Linkslauf
    =      STG_WZM[BL_WZM_Index].WG_WZM_Soll_Platz
  ENDI

EM

;----------------------------
LBL WZM_links_Stop

  L      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Platz
  -      K+1
  =      STG_WZM[BL_WZM_Index].WG_WZM_Soll_Platz

  L      STG_WZM[BL_WZM_Index].WG_WZM_Soll_Platz
  ==     K+0
  IFT
    L      STG_WZM[BL_WZM_Index].WG_MP7261_WZM_max_Platz
    =      STG_WZM[BL_WZM_Index].WG_WZM_Soll_Platz
  ENDI

  L      K+1
  =      STG_WZM[BL_WZM_Index].WG_WZM_Ist_Soll_Platz_Differenz

EM

;----------------------------
LBL WZM_n_Input_lesen

#if CFG_Simulation = "inaktiv"
  L      I_WZM_1_Platz_ausgeklappt
  =      STG_WZM[KG_WZM_1_Index].MG_I_WZM_Platz_ausgeklappt

  L      I_WZM_1_Platz_eingeklappt
  =      STG_WZM[KG_WZM_1_Index].MG_I_WZM_Platz_eingeklappt

  L      I_WZM_1_Genauhalt
  =      STG_WZM[KG_WZM_1_Index].MG_I_WZM_Genauhalt

  L      I_WZM_1_Zaehler
  =      STG_WZM[KG_WZM_1_Index].MG_I_WZM_Zaehler

  L      I_WZM_1_Index_eingesetzt
  =      STG_WZM[KG_WZM_1_Index].MG_I_WZM_Index_eingesetzt

  L      I_WZM_1_Index_ausgehoben
  =      STG_WZM[KG_WZM_1_Index].MG_I_WZM_Index_eingesetzt

  L      I_WZM_1_Platz_belegt
  =      STG_WZM[KG_WZM_1_Index].MG_I_WZM_Platz_belegt

  L      I_WZM_2_Platz_ausgeklappt
  =      STG_WZM[KG_WZM_2_Index].MG_I_WZM_Platz_ausgeklappt

  L      I_WZM_2_Platz_eingeklappt
  =      STG_WZM[KG_WZM_2_Index].MG_I_WZM_Platz_eingeklappt

  L      I_WZM_2_Genauhalt
  =      STG_WZM[KG_WZM_2_Index].MG_I_WZM_Genauhalt

  L      I_WZM_2_Zaehler
  =      STG_WZM[KG_WZM_2_Index].MG_I_WZM_Zaehler

  L      I_WZM_2_Index_eingesetzt
  =      STG_WZM[KG_WZM_2_Index].MG_I_WZM_Index_eingesetzt

  L      I_WZM_2_Index_ausgehoben
  =      STG_WZM[KG_WZM_2_Index].MG_I_WZM_Index_eingesetzt

  L      I_WZM_2_Platz_belegt
  =      STG_WZM[KG_WZM_2_Index].MG_I_WZM_Platz_belegt

#if WZ_Magazin_Referenz_Sensor = &aktiv
  L      I_WZM_1_Referenz
  =      STG_WZM[KG_WZM_1_Index].MG_I_WZM_Referenz

  L      I_WZM_2_Referenz
  =      STG_WZM[KG_WZM_2_Index].MG_I_WZM_Referenz
#endif
#endif

EM

;----------------------------
LBL WZM_n_Output_schreiben

*$WS für 8 Magazine über Konstantenfeld und Repeat Schleife

  L      STG_WZM[KG_WZM_1_Index].MG_O_WZM_Platz_ausklappen
  =      O_WZM_1_Platz_ausklappen

  L      STG_WZM[KG_WZM_1_Index].MG_O_WZM_Platz_einklappen
  =      O_WZM_1_Platz_einklappen

  L      STG_WZM[KG_WZM_1_Index].MG_O_WZM_Rechtslauf
  =      O_WZM_1_Rechtslauf

  L      STG_WZM[KG_WZM_1_Index].MG_O_WZM_Linkslauf
  =      O_WZM_1_Linkslauf

  L      STG_WZM[KG_WZM_1_Index].MG_O_WZM_Eilgang
  =      O_WZM_1_Eilgang

  L      STG_WZM[KG_WZM_1_Index].MG_O_WZM_Schleichgang
  =      O_WZM_1_Schleichgang

  L      STG_WZM[KG_WZM_1_Index].MG_O_WZM_Index_ausheben
  =      O_WZM_1_Index_ausheben

  L      STG_WZM[KG_WZM_1_Index].MG_O_WZM_Index_einsetzen
  =      O_WZM_1_Index_einsetzen

  L      STG_WZM[KG_WZM_2_Index].MG_O_WZM_Platz_ausklappen
  =      O_WZM_2_Platz_ausklappen

  L      STG_WZM[KG_WZM_2_Index].MG_O_WZM_Platz_einklappen
  =      O_WZM_2_Platz_einklappen

  L      STG_WZM[KG_WZM_2_Index].MG_O_WZM_Rechtslauf
  =      O_WZM_2_Rechtslauf

  L      STG_WZM[KG_WZM_2_Index].MG_O_WZM_Linkslauf
  =      O_WZM_2_Linkslauf

  L      STG_WZM[KG_WZM_2_Index].MG_O_WZM_Eilgang
  =      O_WZM_2_Eilgang

  L      STG_WZM[KG_WZM_2_Index].MG_O_WZM_Schleichgang
  =      O_WZM_2_Schleichgang

  L      STG_WZM[KG_WZM_2_Index].MG_O_WZM_Index_ausheben
  =      O_WZM_2_Index_ausheben

  L      STG_WZM[KG_WZM_2_Index].MG_O_WZM_Index_einsetzen
  =      O_WZM_2_Index_einsetzen

EM

KFIELD Diagnose
  KG_Dia_WZ_Magazin_Zaehlimpuls        ;-1
  KG_Dia_WZ_Magazin_Start              ;00
  KG_Dia_Tool_Def_Quit                 ;01
  KG_Dia_Mag_Platz_ein                 ;02
  KG_Dia_Mag_Platz_Pos_ein             ;03
  KG_Dia_Magazin_Richtung              ;04
  KG_Dia_Mag_Index_aus                 ;05
  KG_Dia_Mag_Index_Pos_aus             ;06
  KG_Dia_Magazin_SOLL_Pos              ;07
  KG_Dia_Time_genau_Halt               ;08
  KG_Dia_Mag_Index_Pos_ein             ;09
  KG_Dia_Mag_genau_Halt                ;10
  KG_Dia_T_Vorwahl_Status              ;11
  KG_Dia_Mag_Platz_ein_aus             ;12
  KG_Dia_Mag_Platz_Posit               ;13
  KG_Dia_WZ_Magazin_Ende               ;14
  KG_Dia_leer                          ;15
ENDK

