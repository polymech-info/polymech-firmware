*-----------------------------------------------------------------------------
*  WZW Automatik Doppelarmgreifer Kurvenscheibe
*-----------------------------------------------------------------------------
*  Modul-Beschreibung
*
*-----------------------------------------------------------------------------

#define /s    KL_WZ_ohne_Platz                         K -1
#define /s    KL_WZ_mit_Platz                          K +1
#define /s    KL_Werkzeug_in_Spindel                   K +0
#define /s    KL_String_Anzahl                         K +3

#define /s    ML_2nd_TOOL_CALL_folgt                   M
#define /s    ML_WZ_Greifer_cw_rechts_stop             M
#define /s    ML_WZ_Greifer_ccw_links_stop             M
#define /s    ML_TOOL_CALL_alt                         M
#define /s    ML_Stack_synchronisieren                 M
#define /s    ML_Schritt_Start                         M
#define /s    ML_WZW_Diagnose                          M

#define /s    BL_WZM_Achs_Index                        B
#define /s    BL_WZM_Index                             B
#define /s    BL_Schritt_WZW                           B
#define /s    BL_String_Index                          B

#define /s    WL_Zeile_Dialog_Datei                    W

#include Mac_Lib.inc

EXTERN In_Posit
EXTERN Start_Posit
#if WZ_Magazin = &Asynchron
EXTERN Absolut
#endif

GLOBAL WZW_auto

;----------------------------
LBL WZW_auto
;----------------------------

  LN     MG_WZW_Auto_aktiv
  EMT

#if Mittel_Position_WZ_Wechsel = &aktiv
  LN     PN_M4540_T_neu_zuerst_Festplatzwechsel
  S      PN_M4540_T_neu_zuerst_Festplatzwechsel
#else
  L      PN_M4540_T_neu_zuerst_Festplatzwechsel
  R      PN_M4540_T_neu_zuerst_Festplatzwechsel
#endif

  L      NP_M4521_TOOL_CALL_T_0_programmiert
  A      NP_M4520_TOOL_CALL_2_Strobe
  A      NP_M4073_Strobe_TOOL_CALL
  A      MG_WZW_T0_auto_manu_notwendig
  S      PN_Fehler_TOOL_CALL_T0
  EMT

  L      NP_M4073_Strobe_TOOL_CALL
  IFT
    L      NP_W262_Werkzeug_Platz_Nummer
    >=     KL_WZ_mit_Platz
    AN     NP_M4175_Stern_blinkt
    AN     MG_WZW_automatisch
    S      MG_WZW_automatisch
    IFT
      L      NP_W262_Werkzeug_Platz_Nummer
      =      WG_WZW_Platz_Nummer

      L      NP_W264_Werkzeug_Nummer
      =      WG_WZW_auto_Werkzeug_Nummer
    ENDI
  ENDI

  L      STG_WZM[BG_WZM_Index_Tool_Call].WG_MP7261_WZM_max_Platz
  >=     KL_WZ_mit_Platz
  A      MG_WZW_manuell
  A      NP_M4073_Strobe_TOOL_CALL
  O      MG_WZW_automatisch
  A[
    L      MG_Impuls_Internal_STOP
    ON     MG_Steuerung_betriebsbereit
  ]
  S      MG_Platz_Tabelle_pruefen

  L      MG_Platz_Tabelle_angewaehlt
  A      MG_WZW_Grund_Stellung
  AN     MG_WZW_manuell
  AN     MG_WZW_automatisch
  R      MG_Platz_Tabelle_pruefen

  L      MG_Platz_Tabelle_pruefen
  AN     MG_WZW_manuell
  AN     MG_WZW_automatisch
  AN     MG_WZW_Help
  A      MG_WZW_Grund_Stellung
  =      PN_Fehler_Platz_Tabelle_pruefen

  L      MG_WZW_automatisch
  R      TS_WZW_Timeout
  S      TS_WZW_Timer_allgemein
  S      TS_WZ_Greifer_Mittelpos_verzoegert_Stop

  CASE   BG_Schritt_WZW
    CM     WZW_auto_Start              ;00
    CM     WZ_in_Spindel_OK            ;01
    CM     Spi_voll_leer               ;02
    CM     WZW_Magazin_Start           ;03
    CM     S_Start                     ;04
    CM     Z_Start                     ;05
    CM     T_Schleuse_auf              ;06
    CM     Z_in_WZW_Pos                ;07
    CM     XY_Start                    ;08
    CM     WZ_Status_lesen             ;09
    CM     T_Schleuse_ist_auf          ;10
    CM     Magazin_in_Pos              ;11
    CM     WZ_Platz_aus                ;12
    CM     WZ_Platz_Time               ;13
    CM     S_in_WZW_Pos                ;14
    CM     X_in_WZW_Pos                ;15
    CM     Y_in_WZW_Pos                ;16
    CM     Mag_voll_leer               ;17
    CM     WZ_Platz_Pos_aus            ;18
    CM     Greifer_zu_Spindel          ;19
    CM     Greifer_an_Spindel          ;20
    CM     Zange_zu                    ;21
    CM     Zange_ist_zu                ;22
    CM     WZ_entspannen               ;23
    CM     WZ_entspannt                ;24
    CM     WZW_auto_Time               ;25
    CM     Tneu_merken                 ;26
    CM     T0_in_Status                ;27
    CM     T_Status_ok                 ;28
    CM     Tool_Call_2nd               ;29
    CM     Tool_Call_Wait              ;30
    CM     Greifer_ausheben            ;31
#if Mittel_Position_WZ_Wechsel = &aktiv
    CM     Sprung_Greifer              ;32     ---> (1)
    CM     WZ_Greifer_Mitte_stop       ;33
    CM     WZ_Greifer_verzoegern       ;34
    CM     Greifer_in_Mittelstellung   ;35
    CM     WZW_Magazin_Start           ;36
    CM     Magazin_in_Pos              ;37
    CM     WZ_Platz_aus                ;38
    CM     WZ_Platz_Pos_aus            ;39
    CM     Mag_leer                    ;40
    CM     Greifer_einsetzen           ;41
#endif                                 ;
    CM     Greifer_eingesetzt          ;42 ;32 <--- (1)
    CM     WZ_spannen                  ;43 ;33
    CM     WZ_gespannt                 ;44 ;34
    CM     Tneu_in_Status              ;45 ;35
    CM     T_Status_ok                 ;46 ;36
    CM     Greifer_zu_Grundstellung    ;47 ;37
    CM     WZ_in_Mag_lesen             ;48 ;38
    CM     Greifer_in_Grundstellung    ;49 ;39
    CM     Zange_auf                   ;50 ;40
    CM     Zange_ist_auf               ;51 ;41
    CM     WZ_Platz_ein_aus            ;52 ;42
    CM     WZ_Platz_Pos_ok             ;53 ;43
    CM     T_Schleuse_zu               ;54 ;44
    CM     T_Schleuse_ist_zu           ;55 ;45
    CM     Spi_leer_voll               ;56 ;46
    CM     Tool_Call_quitt             ;57 ;47
    CM     WZW_auto_Ende               ;58 ;48
  ENDC

  PLL
  S      TS_WZW_Timeout
  =      ML_Schritt_Start
  IFT
    INC    BG_Schritt_WZW
  ENDI

  L      MG_WZW_Diagnose
  CMT    Diagnose_String

  LN     MG_WZW_automatisch
  EMT

  L      MG_Impuls_NC_Start
  R      MG_WZW_Unterbrechung

  L      MG_Taste_NC_Start_P_Impuls
  S      TS_WZW_Timeout

  L      MG_Taste_NC_Stop
  O      MG_Impuls_External_STOP
  R      TS_WZW_Timeout
  R      TR_WZW_Timeout

  LN     TS_WZW_Timeout
  AN     TR_WZW_Timeout
  =      PN_Fehler_WZW_Timeout
  S      MG_WZW_Unterbrechung

  L      MG_Impuls_Internal_STOP
  O      MG_BA_Wechsel_Auto_Manu
  O      MG_Arbeitsraum_offen
  ON     MG_Steuerung_betriebsbereit
  CMT    WZW_auto_Reset

  L      PN_Fehler_WZW_Timeout
  IFT
    CM     Diagnose_String

    PS     K &PN_Fehler_WZW_Timeout - 4800
    PS     K &SG_WZW_Diagnose_Zeile_2
    PS     BG_Schritt_WZW
    PS     BG_Schritt_WZW
    CM     9084                        ;PLC-Fehlermeldung anzeigen
    M_Modul_Fehler_anzeigen
  ENDI

EM

;----------------------------
LBL Diagnose_String

  L      K +0
  =      BL_String_Index

  L      BG_Schritt_WZW
  =      BL_Schritt_WZW
  REPEAT
    L      BL_Schritt_WZW
    =X

    L      KF Diagnose[X]
    =      WL_Zeile_Dialog_Datei
    =X

    L      S#D0[X]
    =      SG_WZW_Diagnose_Zeile_1[BL_String_Index]

    INC    BL_Schritt_WZW
    INC    BL_String_Index
    INCX

    L      BL_String_Index
    >=     KL_String_Anzahl
  UNTILT

  L      BG_Schritt_WZW
  =      BL_Schritt_WZW

EM


#if Mittel_Position_WZ_Wechsel = &aktiv
;----------------------------
LBL Sprung_Greifer                     ;32

  PS     MG_Eins_Merker

  LN     ML_2nd_TOOL_CALL_folgt
  O      NP_M4523_TOOL_CALL_ohne_Platznummer
  IFT
    L      BG_Schritt_WZW
    +      K+9
    =      BG_Schritt_WZW
  ENDI

EM
#endif

;----------------------------
LBL WZW_auto_Start                     ;00

  LN     MG_WZW_Grund_Stellung
  A      MG_WZW_automatisch
  S      PN_Fehler_WZW_Grund_Stellung
  S      MG_WZW_Unterbrechung

  L      MG_WZM_n_Start_aktiv
  S      TS_WZW_Timeout

  L      MG_WZW_automatisch
  AN     MG_WZW_manuell
  AN     MG_WZM_n_Start_aktiv
  A      MG_WZW_Grund_Stellung
  AN     MG_WZW_Unterbrechung
  PSL

EM

;----------------------------
LBL WZ_in_Spindel_OK                   ;01

  L      MG_Taste_NC_Start_P_Impuls
  A      MG_BA_Automatik
  R      MG_WZW_ohne_Tool_Call

  L      MG_WZW_ohne_Tool_Call
  =      PN_Fehler_WZ_Spindel_ok
  =      MG_Win_Window_JA_Nein
  S      TS_WZW_Timeout

  LN     MG_Referenz_Achsen_aufgenommen
  S      PN_Fehler_Referenz_notwendig

  LN     MG_WZW_ohne_Tool_Call
  AN     PN_Fehler_Referenz_notwendig
  AN     MG_WZW_Unterbrechung
  PSL

  L      NP_M4175_Stern_blinkt
  JPT    WZW_auto_Reset

EM

;----------------------------
LBL Spi_voll_leer                      ;17

  L      MG_WZ_Status_lesen
  IFT
    PS     MG_Null_Merker
  ELSE
    L      WG_Werkzeug_in_Spindel
    >      K+0
    CMT    Spi_voll
    CMF    Spi_leer
  ENDI

EM

;----------------------------
LBL Spi_leer_voll                      ;35 ;45

  L      WG_WZW_auto_neue_Werkzeug_Nummer
  >      K+0
  CMT    Spi_voll
  CMF    Spi_leer

EM

;----------------------------
LBL Spi_voll

  LN     MG_Sn_I_WZ_ist_in_Spindel
  AN     MG_Inbetriebnahme
  AN     STG_Spindel[BG_Index_Sn].MG_WZ_Ueberwachung_inaktiv
  S      PN_Fehler_Spindel_leer

  LN     PN_Fehler_Spindel_leer
  PSL

  L      NP_M4175_Stern_blinkt
  JPT    WZW_auto_Reset

EM

;----------------------------
LBL Spi_leer

  L      MG_Sn_I_WZ_ist_in_Spindel
  AN     MG_Inbetriebnahme
  AN     STG_Spindel[BG_Index_Sn].MG_WZ_Ueberwachung_inaktiv
  S      PN_Fehler_Spindel_nicht_leer

  LN     PN_Fehler_Spindel_nicht_leer
  PSL

  L      NP_M4175_Stern_blinkt
  JPT    WZW_auto_Reset

EM

;----------------------------
LBL Mag_voll_leer                      ;16

  L      NP_M4521_TOOL_CALL_T_0_programmiert
  CMT    Mag_leer
  CMF    Mag_voll

EM

;----------------------------
LBL Mag_leer                           ;40

  L      STG_WZM[BG_WZM_Index_Tool_Call].MG_I_WZM_Platz_belegt
  AN     MG_Inbetriebnahme
  AN     STG_WZM[BG_WZM_Index_Tool_Call].MG_WZM_Ueberwachung_inaktiv
  S      PN_Fehler_WZM_Platz_belegt

  LN     PN_Fehler_WZM_Platz_belegt
  PSL

  L      NP_M4175_Stern_blinkt
  JPT    WZW_auto_Reset

EM

;----------------------------
LBL Mag_voll                           ;30

  LN     STG_WZM[BG_WZM_Index_Tool_Call].MG_I_WZM_Platz_belegt
  AN     MG_Inbetriebnahme
  AN     STG_WZM[BG_WZM_Index_Tool_Call].MG_WZM_Ueberwachung_inaktiv
  S      PN_Fehler_WZM_Werkzeug_fehlt

  LN     PN_Fehler_WZM_Werkzeug_fehlt
  PSL

  L      NP_M4175_Stern_blinkt
  JPT    WZW_auto_Reset

EM

;----------------------------
LBL WZW_Magazin_Start                  ;02 ;36

  CM     Magazin_Position
  PLL
  =N     STG_WZM[BG_WZM_Index_Tool_Call].MG_WZM_Tool_Call

  LN     MG_WZW_Unterbrechung
  PSL

EM

;----------------------------
LBL Magazin_in_Pos                     ;10 ;37

  CM     Magazin_Position

  L      STG_WZM[BG_WZM_Index_Tool_Call].MG_WZM_Start
  AN     MG_WZW_Unterbrechung
  S      TS_WZW_Timeout

  PLL
  AN     MG_WZW_Unterbrechung
  PSL

EM

#if WZ_Magazin = &Asynchron
;----------------------------
LBL Magazin_Position

  L      STG_WZM[BG_WZM_Index_Tool_Call].BG_WZM_Achs_Index
  =      BL_WZM_Achs_Index

  L      WG_WZW_Platz_Nummer
  X      STG_WZM[BG_WZM_Index_Tool_Call].DG_WZM_Platz_Pos_Differenz
  -      DG_Ref_Pos_Achse[BL_WZM_Achs_Index]
  PSW
  CM     Absolut
  PLW
  <      DG_MP1030_Pos_Fenster[BL_WZM_Achs_Index]
  O[
    L      DG_Ref_Pos_Achse[BL_WZM_Achs_Index]
    <      DG_MP1030_Pos_Fenster[BL_WZM_Achs_Index]
    A[
      L      WG_WZW_Platz_Nummer
      ==     STG_WZM[BG_WZM_Index_Tool_Call].WG_MP7261_WZM_max_Platz
    ]
  ]
  AN     STG_WZM[BG_WZM_Index_Tool_Call].MG_Status[KG_Posit_aktiv]
  AN     STG_WZM[BG_WZM_Index_Tool_Call].MG_WZM_Start
  AN     STG_WZM[BG_WZM_Index_Tool_Call].MG_WZM_Tool_Call
  PSL

EM
#endif

#if WZ_Magazin = &Impuls
;----------------------------
LBL Magazin_Position

  L      STG_WZM[BG_WZM_Index_Tool_Call].WG_WZM_Ist_Platz
  ==     WG_WZW_Platz_Nummer
  AN     STG_WZM[BG_WZM_Index_Tool_Call].MG_WZM_Start
  AN     STG_WZM[BG_WZM_Index_Tool_Call].MG_WZM_Tool_Call
  AN     STG_WZM[BG_WZM_Index_Tool_Call].MG_WZM_Referenz_notwendig
  PSL

EM
#endif

;----------------------------
LBL S_Start                            ;03

  LN     MG_WZW_Unterbrechung
  PSL
  EMF

  L      MG_Spindel_mit_Messgeraet
  S      MG_WZW_Spindel_Richten_ein

EM

;----------------------------
LBL S_in_WZW_Pos                       ;13

  LN     MG_Spindel_mit_Messgeraet
  A      MG_Spindel_aus
  O      MG_Spindel_in_WZW_Position
  AN     MG_WZW_Spindel_Richten_ein
  AN     MG_WZW_Unterbrechung
  PSL

EM

;----------------------------
LBL XY_Start                           ;07

  CM     X_Start
  CM     Y_Start
  PL     ML_Stack_synchronisieren

EM

;----------------------------
LBL Z_Start                            ;04

  L      MG_WZW_Unterbrechung
  IFT
    PS     MG_Null_Merker
  ELSE
    PS     KG_Achse_Z
    PS     DG_WZW_Pos_Z_einsetzen
    CM     Start_Posit
    PLL
    SN     MG_WZW_Unterbrechung
    PSL
  ENDI

EM

;----------------------------
LBL Z_in_WZW_Pos                       ;06

  PS     KG_Achse_Z
  PS     DG_WZW_Pos_Z_einsetzen
  CM     In_Posit
  PLL
  AN     MG_WZW_Unterbrechung
  PSL

EM

;----------------------------
LBL Y_Start

  L      MG_WZW_Unterbrechung
  IFT
    PS     MG_Null_Merker
  ELSE
    PS     KG_Achse_Y
    PS     DG_WZW_Pos_Y
    CM     Start_Posit
    PLL
    SN     MG_WZW_Unterbrechung
    PSL
  ENDI

EM

;----------------------------
LBL Y_in_WZW_Pos                       ;15

  PS     KG_Achse_Y
  PS     DG_WZW_Pos_Y
  CM     In_Posit
  PLL
  AN     MG_WZW_Unterbrechung
  PSL

EM

;----------------------------
LBL X_Start

  L      MG_WZW_Unterbrechung
  IFT
    PS     MG_Null_Merker
  ELSE
    PS     KG_Achse_X
    PS     DG_WZW_Pos_X
    CM     Start_Posit
    PLL
    SN     MG_WZW_Unterbrechung
    PSL
  ENDI

EM

;----------------------------
LBL X_in_WZW_Pos                       ;14

  PS     KG_Achse_X
  PS     DG_WZW_Pos_X
  CM     In_Posit
  PLL
  AN     MG_WZW_Unterbrechung
  PSL

EM

;----------------------------
LBL WZ_Status_lesen                    ;08

  L      MG_Eins_Merker
  S      MG_WZ_Status_lesen
  PSL

EM

;----------------------------
LBL WZ_in_Mag_lesen                    ;39 ;49

  L      MG_Eins_Merker
#if WZ_Platz_ausklappen_90_Grad = &aktiv
  S      MG_WZ_Vorwahl_Status_lesen
#endif
  PSL

EM

;----------------------------
LBL WZ_Platz_aus                       ;11 ;38

  L      MG_Eins_Merker
  R      STG_WZM[BG_WZM_Index_Tool_Call].MG_O_WZM_Platz_einklappen
  S      STG_WZM[BG_WZM_Index_Tool_Call].MG_O_WZM_Platz_ausklappen
  PSL

EM

;----------------------------
LBL WZ_Platz_ein_aus                   ;43 ;53

  LN     MG_WZ_Vorwahl_Status_lesen
  PSL
  EMF

  L      BG_WZ_Vorwahl_Status
  BT     K+1
  =      MG_WZ_Ueberlaenge

  L      MG_WZ_Ueberlaenge
  S      STG_WZM[BG_WZM_Index_Tool_Call].MG_O_WZM_Platz_einklappen
  R      STG_WZM[BG_WZM_Index_Tool_Call].MG_O_WZM_Platz_ausklappen

EM

;----------------------------
LBL WZ_Platz_Pos_ok                    ;44 ;54

  L      MG_WZ_Ueberlaenge
  CMT    WZ_Platz_Pos_ein
  CMF    WZ_Platz_Pos_aus

EM

;----------------------------
LBL WZ_Platz_Pos_aus                   ;18 ;39

#if WZ_Platz_ausklappen_90_Grad = &aktiv
  L      STG_WZM[BG_WZM_Index_Tool_Call].MG_I_WZM_Platz_ausgeklappt
  AN     STG_WZM[BG_WZM_Index_Tool_Call].MG_I_WZM_Platz_eingeklappt
  AN     MG_WZW_Unterbrechung
  PSL
#else
  PS     MG_Eins_Merker
#endif

EM

;----------------------------
LBL WZ_Platz_Pos_ein

#if WZ_Platz_ausklappen_90_Grad = &aktiv
  LN     STG_WZM[BG_WZM_Index_Tool_Call].MG_I_WZM_Platz_ausgeklappt
  A      STG_WZM[BG_WZM_Index_Tool_Call].MG_I_WZM_Platz_eingeklappt
  AN     MG_WZW_Unterbrechung
  PSL

#else
  PS     MG_Eins_Merker
#endif

EM

;----------------------------
LBL Greifer_ausheben                   ;31

  L      MG_WZ_Greifer_in_Entspannen
  AN     MG_WZW_Unterbrechung
  S      O_WZ_Greifer_drehen_cw_rechts
  S      MG_Sn_O_Spindel_ausblasen

  LN     I_WZ_Greifer_Brems_Position
  PSL

EM

;----------------------------
LBL WZ_entspannen                      ;23

  L      MG_Eins_Merker
  S      MG_Sn_O_WZ_entspannen
  PSL

EM

;----------------------------
LBL WZ_spannen                         ;33 ;43

  L      MG_Eins_Merker
  R      MG_Sn_O_WZ_entspannen
  PSL

EM

;----------------------------
LBL T_Schleuse_auf                     ;05

  L      MG_Eins_Merker
  S      O_WZ_Schleuse_auf
  R      O_WZ_Schleuse_zu
  PSL

EM

;----------------------------
LBL T_Schleuse_zu                      ;45 ;55

  L      MG_Eins_Merker
  R      O_WZ_Schleuse_auf
  S      O_WZ_Schleuse_zu
  PSL

EM

;----------------------------
LBL T_Schleuse_ist_auf                 ;09

#if CFG_WZ_Magazin_Schleuse = "aktiv"
  L      I_WZ_Schleuse_auf
  AN     I_WZ_Schleuse_zu
  AN     MG_WZW_Unterbrechung
  PSL

#else
  PS     MG_Eins_Merker
#endif

EM

;----------------------------
LBL T_Schleuse_ist_zu                  ;46 ;56

#if CFG_WZ_Magazin_Schleuse = "aktiv"
  LN     I_WZ_Schleuse_auf
  A      I_WZ_Schleuse_zu
  AN     MG_WZW_Unterbrechung
  PSL

#else
  PS     MG_Eins_Merker
#endif

EM

;----------------------------
LBL WZ_entspannt                       ;24

  LN     MG_Sn_I_WZ_gespannt
  A      MG_Sn_I_WZ_entspannt
  AN     MG_WZW_Unterbrechung
  PSL

EM

;----------------------------
LBL WZ_gespannt                        ;34 ;44

  L      MG_Sn_I_WZ_gespannt
  AN     MG_Sn_I_WZ_entspannt
  AN     MG_WZW_Unterbrechung
  PSL

EM

;----------------------------
LBL Zange_zu                           ;21

  L      MG_Eins_Merker
  S      O_WZ_Greifer_Zangen_zu
  PSL

EM

;----------------------------
LBL Zange_auf                          ;41 ;51

  L      MG_Eins_Merker
  R      O_WZ_Greifer_Zangen_zu
  PSL

EM

;----------------------------
LBL Zange_ist_zu                       ;22

#if WZ_Zange = &aktiv
  LN     I_WZ_Greifer_Zangen_auf
  AN     MG_WZW_Unterbrechung
  PSL
#else
  PS     MG_Eins_Merker
#endif

EM

;----------------------------
LBL Zange_ist_auf                      ;42 ;52

#if WZ_Zange = &aktiv
  L      I_WZ_Greifer_Zangen_auf
  AN     MG_WZW_Unterbrechung
  PSL
#else
  PS     MG_Eins_Merker
#endif

EM

;----------------------------
LBL Greifer_zu_Spindel                 ;19

  L      MG_WZ_Greifer_in_Grundstellung
  AN     MG_WZW_Unterbrechung
  S      O_WZ_Greifer_drehen_cw_rechts

  LN     I_WZ_Greifer_Brems_Position
  PSL

EM

;----------------------------
LBL Greifer_zu_Grundstellung           ;38 ;48

  L      MG_WZ_Greifer_in_Spannen
  AN     MG_WZW_Unterbrechung
  S      O_WZ_Greifer_drehen_cw_rechts

  LN     I_WZ_Greifer_Brems_Position
  PSL


EM

;----------------------------
LBL Greifer_an_Spindel                 ;20

  L      I_WZ_Greifer_Brems_Position
  R      O_WZ_Greifer_drehen_cw_rechts

  L      MG_WZ_Greifer_in_Entspannen
  AN     MG_WZW_Unterbrechung
  R      O_WZ_Greifer_drehen_cw_rechts
  PSL


EM

#if Mittel_Position_WZ_Wechsel = &aktiv
;----------------------------
LBL WZ_Greifer_Mitte_stop              ;33

  L      I_WZ_Greifer_Mittelstellung
  PSL

EM

;----------------------------
LBL Greifer_in_Mittelstellung          ;35

*$WS Nr input for braking

  L      MG_Eins_Merker
  R      O_WZ_Greifer_drehen_cw_rechts

  L      MG_WZ_Greifer_Wechseln
  AN     MG_WZW_Unterbrechung
  R      O_WZ_Greifer_drehen_cw_rechts
  R      MG_Sn_O_Spindel_ausblasen
  PSL


EM

;----------------------------
LBL Greifer_einsetzen                  ;41

  L      MG_WZ_Greifer_Wechseln
  AN     MG_WZW_Unterbrechung
  S      O_WZ_Greifer_drehen_cw_rechts
  S      MG_Sn_O_Spindel_ausblasen

  LN     I_WZ_Greifer_Brems_Position
  PSL


EM
#endif

;----------------------------
LBL Greifer_eingesetzt                 ;32 ;42

  L      I_WZ_Greifer_Brems_Position
  R      O_WZ_Greifer_drehen_cw_rechts

  L      MG_WZ_Greifer_in_Spannen
  AN     MG_WZW_Unterbrechung
  R      O_WZ_Greifer_drehen_cw_rechts
  R      MG_Sn_O_Spindel_ausblasen
  PSL


EM

;----------------------------
LBL Greifer_in_Grundstellung           ;40 ;50

  L      I_WZ_Greifer_Brems_Position
  R      O_WZ_Greifer_drehen_cw_rechts

  L      MG_WZ_Greifer_in_Grundstellung
  AN     MG_WZW_Unterbrechung
  R      O_WZ_Greifer_drehen_cw_rechts
  PSL

EM

;----------------------------
LBL Tneu_merken                        ;26

  PS     MG_Eins_Merker

  L      WG_WZW_auto_Werkzeug_Nummer
  =      WG_WZW_auto_neue_Werkzeug_Nummer

EM

;----------------------------
LBL T0_in_Status                       ;27

  LN     MG_WZ_Status_lesen
  AN     MG_WZW_Unterbrechung
  S      PN_M4538_Vorwahl_Werkzeug
  S      PN_M4542_Platz_Tabelle_fest
  PSL
  EMF

  L      K+0
  =      NP_W264_Werkzeug_Nummer
  =      WG_Werkzeug_in_Spindel

EM

;----------------------------
LBL Tneu_in_Status                     ;36 ;46

  LN     MG_WZ_Status_lesen
  AN     MG_WZW_Unterbrechung
  PSL
  EMF

  L      MG_Eins_Merker
  R      PN_M4542_Platz_Tabelle_fest
  S      PN_M4538_Vorwahl_Werkzeug

  L      NP_W262_Werkzeug_Platz_Nummer
  ==     KL_WZ_ohne_Platz
  IFT
    L      NP_W264_Werkzeug_Nummer
    =      WG_WZW_auto_Werkzeug_Nummer
  ENDI

  L      WG_WZW_auto_neue_Werkzeug_Nummer
  =      NP_W264_Werkzeug_Nummer
  =      WG_Werkzeug_in_Spindel

EM

;----------------------------
LBL T_Status_ok                        ;28 ;37 ;47

  LN     PN_M4538_Vorwahl_Werkzeug
  PSL

  L      NP_W262_Werkzeug_Platz_Nummer
  >=     KL_WZ_mit_Platz
  O      NP_M4520_TOOL_CALL_2_Strobe
  EMT

  L      WG_WZW_auto_Werkzeug_Nummer
  =      NP_W264_Werkzeug_Nummer

EM

;----------------------------
LBL Tool_Call_2nd                      ;29

#if Mittel_Position_WZ_Wechsel = &aktiv
  LN     NP_M4520_TOOL_CALL_2_Strobe
  ON     NP_M4073_Strobe_TOOL_CALL
  PSL
  EMT

  L      NP_M4520_TOOL_CALL_2_Strobe
  AN     MG_WZW_Unterbrechung
  S      ML_2nd_TOOL_CALL_folgt
  S      PN_M4093_Quit_TOOL_CALL
#else
  PS     MG_Eins_Merker
#endif

EM

;----------------------------
LBL Tool_Call_Wait                     ;30

  L      NP_M4073_Strobe_TOOL_CALL
  PSL
  EMF

  L      NP_W262_Werkzeug_Platz_Nummer
  >=     KL_WZ_mit_Platz
  IFT
    L      NP_W262_Werkzeug_Platz_Nummer
    =      WG_WZW_Platz_Nummer

    L      NP_W264_Werkzeug_Nummer
    =      WG_WZW_auto_Werkzeug_Nummer
  ENDI

EM

;----------------------------
LBL Tool_Call_quitt                    ;47 ;57

  L      NP_W262_Werkzeug_Platz_Nummer
  ==     KL_WZ_ohne_Platz
  ON     NP_M4073_Strobe_TOOL_CALL
  S      MG_WZ_Vorwahl_Status_lesen
  PSL
  EMT

  L      NP_M4073_Strobe_TOOL_CALL
  AN     MG_WZW_Unterbrechung
  S      PN_M4093_Quit_TOOL_CALL

EM

;----------------------------
LBL WZW_auto_Ende                      ;48 ;58

  PS     MG_Null_Merker

;----------------------------
LBL WZW_auto_Reset

  L      MG_Eins_Merker
  R      ML_2nd_TOOL_CALL_folgt
  R      MG_WZW_automatisch
  R      MG_WZW_Unterbrechung
  R      STG_WZM[BG_WZM_Index_Tool_Call].MG_WZM_Tool_Call
  R      MG_WZW_Spindel_Richten_ein
  R      MG_Win_Window_JA_Nein
  R      ML_WZ_Greifer_cw_rechts_stop
  R      ML_WZ_Greifer_ccw_links_stop
  R      PN_Fehler_WZ_Spindel_ok
  R      PN_M4542_Platz_Tabelle_fest
  R      O_WZ_Greifer_zu_Mittelstellung
  R      MG_Sn_O_Spindel_ausblasen
  R      O_WZ_Greifer_drehen_cw_rechts
  R      O_WZ_Greifer_drehen_ccw_links

  L      K+0
  =      BG_Schritt_WZW
  =      BL_WZM_Index

  REPEAT
    L      MG_Eins_Merker
    R      STG_WZM[BL_WZM_Index].MG_WZM_Tool_Call

    INC    BL_WZM_Index

    L      BL_WZM_Index
    >=     KG_WZM_max_Anzahl
  UNTILT

  L      K+0
  =      BL_WZM_Index

EM

;----------------------------
LBL WZ_Platz_Time                      ;12

#if WZ_Platz_ausklappen_90_Grad = &aktiv
  CM     WZW_auto_Time
#else
  PS     MG_Eins_Merker
#endif

EM
;----------------------------
LBL WZW_auto_Time                      ;25

  LN     TR_WZW_Timer_allgemein
  =      TS_WZW_Timer_allgemein
  PSL

EM

