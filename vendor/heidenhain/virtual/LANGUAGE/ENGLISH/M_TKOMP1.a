/* Temperature Compensation
   ------------------------
*/
CHARSIZE=AUTO;
"\n";
CHARSIZE=MEDIUM;
"TEMP COMPENSATION";
CHARSIZE=AUTO;
LINEDIST=LINEDIST-1;
CURSOR=ON;
"\n";
"                                      \n";
CURSOR=OFF;
"Temperature machine   : %+6.1F°\n",
$WG_Temperatur_Maschine_Pt100$/n=1/c;
"Temperature spindle   : %+6.1F°\n\n",
$WG_Temperatur_Spindel_Pt100$/n=1/c;
"Temperature difference: %+6.1F°\n\n",
$WG_Temperatur_Differenz$/n=1/c;
"Z-Compensation        :   %+7.4F mm\n\n",
$WG_Temp_Kompensation_Z$/n=4/c;
"Z-Difference (Probe)  :   %+7.4F mm\n",
$NP_D280_FN19_Zahlenwert_1$/n=4/c;

