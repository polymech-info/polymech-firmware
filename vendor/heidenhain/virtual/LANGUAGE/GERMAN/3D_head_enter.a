/* 3D Kopf Eingabe
   ---------------
*/
COLOR= 9;
CHARSIZE= AUTO;
"\n";
CHARSIZE= MEDIUM;
"3D KOPF - EINGABE";
CHARSIZE=AUTO;
LINEDIST=LINEDIST-1;
CURSOR=ON;
"\n";

"ACHSE                %s         %s     \n",
$SG_Kennung_3D_Achse_1$/c,$SG_Kennung_3D_Achse_2$/c;
CURSOR=OFF;

"%s/%s Position  :  %+9.3F %+9.3F\n",
$SG_Kennung_3D_Achse_1$/c,$SG_Kennung_3D_Achse_2$,
$DG_3D_Kopf_Achse_1_Position$/n=4/e=1,$DG_3D_Kopf_Achse_2_Position$/n=4/e=2;

"S Vorposition :  %+9.3F %+9.3F\n",
$DG_3D_Kopf_Achse_1_S_Position$/n=4/e=4,$DG_3D_Kopf_Achse_2_S_Position$/n=4/e=8;

"S min Moment  :  %+9.3F %+9.3F\n\n",
$DG_3D_Kopf_Achse_1_min_Torsionsmoment$/n=3/e=16,$DG_3D_Kopf_Achse_2_min_Torsionsmoment$/n=3/e=32;

"Lösen    [1/0]:      %D         %D\n",
$MG_3D_Kopf_Achse_1_loesen_Service$/e=64,$MG_3D_Kopf_Achse_2_loesen_Service$/e=128;

"O Lösen       :      %D         %D\n",
$MG_3D_Kopf_Achse_1_Klemmung_loesen$/c,$MG_3D_Kopf_Achse_2_Klemmung_loesen$/c;

"I gelöst      :      %D         %D\n",
$MG_3D_Kopf_Achse_1_geloest$/c,$MG_3D_Kopf_Achse_2_geloest$/c;

"I geklemmt    :      %D         %D\n\n",
$MG_3D_Kopf_Achse_1_geklemmt$/c,$MG_3D_Kopf_Achse_2_geklemmt$/c;

"Achs Schritt  :      %1D         %1D  \n",
$BG_Schritt_Achse_1_3D_Kopf$/c,$BG_Schritt_Achse_2_3D_Kopf$/c;

"3D Schritt    :     %2D        %2D  \n",
$MG_3D_Kopf_Achse_1_aktiv$?$BG_Schritt_3D_Kopf$:0./c,$MG_3D_Kopf_Achse_2_aktiv$?$BG_Schritt_3D_Kopf$:0/c;

