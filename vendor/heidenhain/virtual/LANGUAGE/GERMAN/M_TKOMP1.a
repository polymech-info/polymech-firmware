/* Temperatur Kompensation
   -----------------------
*/
CHARSIZE=AUTO;
"\n";
CHARSIZE=MEDIUM;
"TEMP KOMPENSATION";
CHARSIZE=AUTO;
LINEDIST=LINEDIST-1;
CURSOR=ON;
"\n";
"                                      \n";
CURSOR=OFF;
"Temperatur Maschine : %+6.1F°\n",
$WG_Temperatur_Maschine_Pt100$/n=1/c;
"Temperatur Spindel  : %+6.1F°\n\n",
$WG_Temperatur_Spindel_Pt100$/n=1/c;
"Temperatur Differenz: %+6.1F°\n\n",
$WG_Temperatur_Differenz$/n=1/c;
"Z-Kompensation      :   %+7.4F mm\n\n",
$WG_Temp_Kompensation_Z$/n=4/c;
"Z-Differenz (Probe) :   %+7.4F mm\n",
$NP_D280_FN19_Zahlenwert_1$/n=4/c;




