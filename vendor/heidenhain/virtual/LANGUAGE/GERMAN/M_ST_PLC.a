"\nStatus\n";
" 0: keine PLC-Posit gestartet\n";
" 1: Ziel-Position erreicht\n";
" 2: PLC-Posit gestartet\n";
" 3: Ziel-Posit nicht erreicht Abbruch\n";
" 4: Ziel-Posit ausserhalb Endschalter\n";
" 5: Posit nicht möglich (freies Drehen)\n";
" 6: Posit angehalten (NC-Stop)\n\n";

COLOUR=15;CPOS=0,27;"blättern  ab    ";COLOUR=11;"       (Seite 1 von 2)";

