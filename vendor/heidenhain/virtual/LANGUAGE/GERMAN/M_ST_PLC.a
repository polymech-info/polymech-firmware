/* PLC-POSITIONIERUNGEN
   --------------------
*/
KBD;

CHARSIZE=AUTO;
"\n";
CHARSIZE=MEDIUM;
"PLCPOS PLC->NC";
CHARSIZE=AUTO;
LINEDIST=LINEDIST-1;

CURSOR=ON;
"\nAchse aktiv     Ziel   Vorschub  Status\n";
CURSOR=OFF;

" 1-%C    %S %+10.3F %5D       %2D\n",AXISCHAR[0],
  $MG_PLC_Posit_aktiv[0]$?"AKT":"   "/c,
  $DG_Ziel_Pos_Achse[0]$/n=4/c,
  $MG_PLC_Posit_aktiv[0]$?$DG_Vorschub_PLC_Pos[0]$:0/c,
  $BG_Status_PLC_Posit[0]$/c;

