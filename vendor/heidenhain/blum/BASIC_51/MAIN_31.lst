                          3664 ;----------------------------
                          3665 LBL External_sag_compensation
                          3666 
                          3667 * External sagging compensation by push-pull rod hydraulic cylinder
                          3668 * PLC:\CORRECT\EXT_SAG_COMP.TAB compensation table has 3 types of values.  Only 100 compensation values are available.
                          3669 * REF: The machine coordinates (REF) of the sagging axis (unit: mm)
                          3670 *      1. REF value must starting from negative axis direction to positive axis direction
                          3671 *      2. Two adjecent REF values cannot be equal, otherwise alarm occurs.
                          3672 *      3. The last REF value must be greater than axis traverse range.
                          3673 *      4. REF value must be in between +13743.8953 mm and -13743.8953 mm, otherwise calculation will overflow.
                          3674 * PUSH_ROD: The push rod hydraulic cylinder control voltage (0 - 10V) (unit: V) (TNC resolution = 0.01V)
                          3675 * PULL_ROD: The pull rod hydraulic cylinder control voltage (0 - 10V) (unit: V) (TNC resolution = 0.01V)
                          3676 
                          3677 #if MT = &MT_2MV
                          3678   L      MG_M380_ext_sag_comp_off
                          3679   O      MG_M381_ext_sag_comp_on
                          3680   S      PN_M4092_quit_M_function
                          3681 
                          3682   L      MG_M381_ext_sag_comp_on
                          3683   S      MG_ext_sag_comp_active
                          3684 
                          3685   L      MG_M380_ext_sag_comp_off
                          3686   R      MG_ext_sag_comp_active
                          3687 
                          3688   L      MG_ext_sag_comp_active
                          3689   AN     ML_ext_sag_comp_active
                          3690   =      ML_ext_sag_comp_active_p_pulse
                          3691 
                          3692   L      MG_ext_sag_comp_active
                          3693   =      ML_ext_sag_comp_active
                          3694 
                          3695   L      NP_M4173_1st_PLC_run_after_compile
                          3696   O      ML_ext_sag_comp_active_p_pulse
                          3697   R      MG_ext_sag_comp_file_reading_completed
                          3698   CMT    Ext_sag_comp_file_reading
                          3699 
                          3700   L      MG_ext_sag_comp_active
                          3701   A      MG_ext_sag_comp_file_reading_completed
                          3702   IFT
                          3703     L      K-1
                          3704     =      WL_index_ext_sag_comp
                          3705 
                          3706     L      ML_ext_sag_comp_interpolated
                          3707     R      ML_ext_sag_comp_interpolated
                          3708 
                          3709     L      DG_position_axis_Y_ref
                          3710     =      DL_current_ext_sag_comp_REF_pos
                          3711 
                          3712     REPEAT
                          3713       INC    WL_index_ext_sag_comp
                          3714 
                          3715       L      DG_ext_sag_comp_REF_pos[WL_index_ext_sag_comp]
                          3716       =      DL_current_table_REF_pos
                          3717 
                          3718       L      DG_ext_sag_comp_push_rod[WL_index_ext_sag_comp]
                          3719       =      DL_current_table_push_rod
                          3720 
                          3721       L      DG_ext_sag_comp_pull_rod[WL_index_ext_sag_comp]
                          3722       =      DL_current_table_pull_rod
                          3723 
                          3724       L      WL_index_ext_sag_comp
                          3725       >      K+0
                          3726       IFT
                          3727         ;If previous table REF position <= current REF position < current table REF position, push rod voltage & pull rod voltage are interpolated.
                          3728         ;If current table REF position <= previous table REF position -> alarm
                          3729         L      DL_current_ext_sag_comp_REF_pos
                          3730         >=     DL_previous_table_REF_pos
                          3731         A[
                          3732           L      DL_current_ext_sag_comp_REF_pos
                          3733           <      DL_current_table_REF_pos
                          3734         ]
                          3735         AN     MG_error_ext_sag_comp_table_check
                          3736         S      ML_ext_sag_comp_interpolated
                          3737         IFT
                          3738           ;All the calculation trying to prevent from 32 bit data overflow
                          3739           L      DL_current_ext_sag_comp_REF_pos
                          3740           -      DL_previous_table_REF_pos
                          3741           =      DL_variable_A
                          3742 
                          3743           L      DL_current_table_REF_pos
                          3744           -      DL_previous_table_REF_pos
                          3745           =      DL_variable_C
                          3746 
                          3747           L      DL_current_table_push_rod
                          3748           -      DL_previous_table_push_rod
                          3749           =      DL_variable_B_push_rod
                          3750 
                          3751           L      DL_variable_A
                          3752           /      K+64
                          3753           X      DL_variable_B_push_rod
                          3754           =      DL_variable_I_push_rod
                          3755 
                          3756           L      DL_variable_A
                          3757           MOD    K+64
                          3758           =      DL_variable_J_push_rod
                          3759 
                          3760           L      DL_variable_I_push_rod
                          3761           MOD    DL_variable_C
                          3762           =      DL_variable_K_push_rod
                          3763 
                          3764           L      DL_variable_I_push_rod
                          3765           /      DL_variable_C
                          3766           X      K+64
                          3767           =      DL_variable_U_push_rod
                          3768 
                          3769           L      DL_variable_J_push_rod
                          3770           X      DL_variable_B_push_rod
                          3771           =      DL_variable_V_push_rod
                          3772 
                          3773           L      DL_variable_K_push_rod
                          3774           X      K+64
                          3775           =      DL_variable_W_push_rod
                          3776 
                          3777           L      DL_variable_V_push_rod
                          3778           +      DL_variable_W_push_rod
                          3779           /      DL_variable_C
                          3780           +      DL_variable_U_push_rod
                          3781           +      DL_previous_table_push_rod
                          3782           =      OW_push_rod_cylinder_voltage
                          3783 
                          3784           ;All the calculation trying to prevent from 32 bit data overflow
                          3785           L      DL_current_table_pull_rod
                          3786           -      DL_previous_table_pull_rod
                          3787           =      DL_variable_B_pull_rod
                          3788 
                          3789           L      DL_variable_A
                          3790           /      K+64
                          3791           X      DL_variable_B_pull_rod
                          3792           =      DL_variable_I_pull_rod
                          3793 
                          3794           L      DL_variable_A
                          3795           MOD    K+64
                          3796           =      DL_variable_J_pull_rod
                          3797 
                          3798           L      DL_variable_I_pull_rod
                          3799           MOD    DL_variable_C
                          3800           =      DL_variable_K_pull_rod
                          3801 
                          3802           L      DL_variable_I_pull_rod
                          3803           /      DL_variable_C
                          3804           X      K+64
                          3805           =      DL_variable_U_pull_rod
                          3806 
                          3807           L      DL_variable_J_pull_rod
                          3808           X      DL_variable_B_pull_rod
                          3809           =      DL_variable_V_pull_rod
                          3810 
                          3811           L      DL_variable_K_pull_rod
                          3812           X      K+64
                          3813           =      DL_variable_W_pull_rod
                          3814 
                          3815           L      DL_variable_V_pull_rod
                          3816           +      DL_variable_W_pull_rod
                          3817           /      DL_variable_C
                          3818           +      DL_variable_U_pull_rod
                          3819           +      DL_previous_table_pull_rod
                          3820           =      OW_pull_rod_cylinder_voltage
                          3821         ELSE
                          3822           L      DL_current_table_REF_pos
                          3823           <=     DL_previous_table_REF_pos
                          3824           S      MG_error_ext_sag_comp_table_check
                          3825         ENDI
                          3826 
                          3827         ;If current REF position < 1st table REF position (NR0 position), using 1st table PUSH_ROD & PULL_ROD voltage (NR0 value)
                          3828         L      WL_index_ext_sag_comp
                          3829         ==     K+1
                          3830         AN     MG_error_ext_sag_comp_table_check
                          3831         IFT
                          3832           L      DL_current_ext_sag_comp_REF_pos
                          3833           <      DL_previous_table_REF_pos
                          3834           S      ML_ext_sag_comp_interpolated
                          3835           IFT
                          3836             L      DL_previous_table_push_rod
                          3837             =      OW_push_rod_cylinder_voltage
                          3838 
                          3839             L      DL_previous_table_pull_rod
                          3840             =      OW_pull_rod_cylinder_voltage
                          3841           ENDI
                          3842         ENDI
                          3843 
                          3844         ;If current REF position > the very last table REF position (NR99 position) -> alarm
                          3845         L      KL_ext_sag_comp_table_size
                          3846         -      K+1
                          3847         ==     WL_index_ext_sag_comp
                          3848         A[
                          3849           L      DL_current_ext_sag_comp_REF_pos
                          3850           >      DL_current_table_REF_pos
                          3851         ]
                          3852         AN     MG_error_ext_sag_comp_table_check
                          3853         S      MG_error_ext_sag_comp_table_check
                          3854       ENDI
                          3855 
                          3856       L      DL_current_table_REF_pos
                          3857       =      DL_previous_table_REF_pos
                          3858 
                          3859       L      DL_current_table_push_rod
                          3860       =      DL_previous_table_push_rod
                          3861 
                          3862       L      DL_current_table_pull_rod
                          3863       =      DL_previous_table_pull_rod
                          3864 
                          3865       L      ML_ext_sag_comp_interpolated
                          3866       O      MG_error_ext_sag_comp_table_check
                          3867     UNTILT
                          3868   ELSE
                          3869     L      MG_M380_ext_sag_comp_off
                          3870     O      NP_M4173_1st_PLC_run_after_compile
                          3871     IFT
                          3872       L      K+0
                          3873       =      OW_push_rod_cylinder_voltage
                          3874       =      OW_pull_rod_cylinder_voltage
                          3875     ENDI
                          3876   ENDI
                          3877 #endif
                          3878 
