                           556 
                           557 *    CM     9262                        ;Taskwechsel erlauben
                           558 *    M_Modul_Fehler_anzeigen(KG_Fehler_Modul_9262)
                           559 
                           560       L      S"Xn"
                           561       =      SL_string_field_name
