                           570       L      S"Zn"
                           571       =      SL_string_field_name
                           572       CM     Temp_comp_value
                           573       PL     WL_compensation_value_Zn
                           574 
                           575 *    CM     9262                        ;Taskwechsel erlauben
                           576 *    M_Modul_Fehler_anzeigen(KG_Fehler_Modul_9262)
                           577 
                           578 * If no hysteresis in curve or average in table
                           579 * chosen, average will be used
                           580 
                           581       L      K+0
                           582       =X
                           583 
                           584       REPEAT
                           585         L      MG_curve_without_hyst_X[X]
                           586         IFT
                           587           R      MG_hyst_X_after_cool_down[X]
                           588           R      MG_hyst_X_after_warm_up[X]
                           589 
                           590           L      MG_T_compensation_X_active[X]
                           591           IFT
                           592             L      WL_compensation_value_Xp[X]
                           593             +      WL_compensation_value_Xn[X]
                           594             /      K+2
                           595             =      WL_compensation_value_X[X]
                           596             =      WG_W3000_lag_err_comp_X[X]                         *;EUMACH
                           597 ;#if KINEMAT_tempcomp = &inactive                                     *;EUMACH Table clamped -> Z comp
                           598 ;            =      PN_W576_lag_error_compensation_X[X]               *;EUMACH Table clamped -> Z comp
                           599 ;#endif                                                               *;EUMACH Table clamped -> Z comp
                           600           ELSE
                           601             L      K+0
                           602             =      WG_W3000_lag_err_comp_X[X]                         *;EUMACH
                           603 ;#if KINEMAT_tempcomp = &inactive                                     *;EUMACH Table clamped -> Z comp
                           604 ;            =      PN_W576_lag_error_compensation_X[X]               *;EUMACH Table clamped -> Z comp
                           605 ;#endif                                                               *;EUMACH Table clamped -> Z comp
                           606           ENDI
                           607         ELSE
                           608           L      MG_warm_up
                           609           IFT
                           610             L      WL_compensation_value_Xp[X]
                           611             =      WL_compensation_value_X[X]
                           612           ENDI
                           613 
                           614           L      MG_cool_down
                           615           IFT
                           616             L      WL_compensation_value_Xn[X]
                           617             =      WL_compensation_value_X[X]
                           618           ENDI
                           619 
                           620           LN     MG_hyst_X_after_warm_up[X]
                           621           AN     MG_hyst_X_after_cool_down[X]
                           622           IFT
                           623             L      MG_T_compensation_X_active[X]
                           624             IFT
                           625               L      WL_compensation_value_X[X]
                           626               =      WG_W3000_lag_err_comp_X[X]                       *;EUMACH
                           627 ;#if KINEMAT_tempcomp = &inactive                                     *;EUMACH Table clamped -> Z comp
                           628 ;              =      PN_W576_lag_error_compensation_X[X]             *;EUMACH Table clamped -> Z comp
                           629 ;#endif                                                               *;EUMACH Table clamped -> Z comp
                           630             ELSE
                           631               L      K+0
                           632               =      WG_W3000_lag_err_comp_X[X]                       *;EUMACH
                           633 ;#if KINEMAT_tempcomp = &inactive                                     *;EUMACH Table clamped -> Z comp
                           634 ;              =      PN_W576_lag_error_compensation_X[X]             *;EUMACH Table clamped -> Z comp
                           635 ;#endif                                                               *;EUMACH Table clamped -> Z comp
                           636             ENDI
                           637 
                           638             PS     WL_compensation_value_X[X]
                           639             CM     Absolute
                           640             PL     WL_compensation_value_X[X]
                           641 
                           642             L      MG_cool_down
                           643             IFT
                           644               L      WL_compensation_value_X[X]
                           645               =      WL_cool_down_value_X[X]
                           646             ENDI
                           647 
                           648             L      MG_warm_up
                           649             IFT
                           650               L      WL_compensation_value_X[X]
                           651               =      WL_warm_up_value_X[X]
                           652             ENDI
                           653           ENDI
                           654 
                           655           PS     WL_compensation_value_X[X]
                           656           CM     Absolute
                           657           PL     WL_compensation_value_X[X]
                           658 
                           659           PS     WL_compensation_value_Xp[X]
                           660           CM     Absolute
                           661           PL     WL_compensation_value_Xp[X]
                           662 
                           663           PS     WL_compensation_value_Xn[X]
                           664           CM     Absolute
                           665           PL     WL_compensation_value_Xn[X]
                           666 
                           667           L      WL_compensation_value_Xn[X]
                           668           <      WL_compensation_value_Xp[X]
                           669           S      MG_curve_without_hyst_X[X]
                           670           IFT
                           671             PS     DL_file_handle
                           672             LX
                           673             +      KL_line_8
                           674             PSW
                           675             PS     S"Setup"
                           676             PS     K+1
                           677             CM     9256                ;Table write
                           678               M_module_error_display(KG_error_module_9256,MG_win_write_table)
                           679           ENDI
                           680 
                           681           L      MG_cool_down
                           682           IFT
                           683             L      WL_compensation_value_X[X]
                           684             <=     WL_warm_up_value_X[X]
                           685             R      MG_hyst_X_after_warm_up[X]
                           686 
                           687             L      WL_compensation_value_X[X]
                           688             <=     WL_cool_down_value_X[X]
                           689             R      MG_hyst_X_after_cool_down[X]
                           690           ENDI
                           691 
                           692           L      MG_warm_up
                           693           IFT
                           694             L      WL_compensation_value_X[X]
                           695             >=     WL_cool_down_value_X[X]
                           696             R      MG_hyst_X_after_cool_down[X]
                           697 
                           698             L      WL_compensation_value_X[X]
                           699             >=     WL_warm_up_value_X[X]
                           700             R      MG_hyst_X_after_warm_up[X]
                           701           ENDI
                           702         ENDI
                           703 
                           704         INCX
                           705         LX
                           706         >      KG_axis_Z
                           707       UNTILT
                           708 
                           709     ELSE
                           710       L      K+0
                           711       =      WG_W3000_lag_err_comp_X                                  *;EUMACH
                           712       =      WG_W3002_lag_err_comp_Y                                  *;EUMACH
                           713       =      WG_W3004_lag_err_comp_Z                                  *;EUMACH
                           714 *;EUMACH Table clamped -> Z comp
