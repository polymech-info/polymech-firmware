                           513 * system in hysteresis
                           514 
                           515       L      WG_temperature_table
                           516       -      WL_temp_difference_old
                           517       >      K+0
                           518       S      MG_warm_up
                           519       IFT
                           520         L      MG_cool_down
                           521         R      MG_cool_down
                           522         S      MG_hyst_X_after_cool_down
                           523         S      MG_hyst_Y_after_cool_down
                           524         S      MG_hyst_Z_after_cool_down
                           525       ENDI
                           526 
                           527       L      WG_temperature_table
                           528       -      WL_temp_difference_old
                           529       <      K+0
                           530       S      MG_cool_down
                           531       IFT
                           532         L      MG_warm_up
                           533         R      MG_warm_up
                           534         S      MG_hyst_X_after_warm_up
                           535         S      MG_hyst_Y_after_warm_up
                           536         S      MG_hyst_Z_after_warm_up
                           537       ENDI
                           538 
                           539       L      WG_temperature_table
                           540       =      WL_temp_difference_old
                           541 
                           542       L      S"Xp"
                           543       =      SL_string_field_name
                           544       CM     Temp_comp_value
                           545       PL     WL_compensation_value_Xp
                           546 
                           547       L      S"Yp"
                           548       =      SL_string_field_name
                           549       CM     Temp_comp_value
                           550       PL     WL_compensation_value_Yp
                           551 
