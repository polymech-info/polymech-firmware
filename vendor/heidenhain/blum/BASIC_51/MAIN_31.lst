                          4732   L      MG_spindle_warmed_up
                          4733   IFT
                          4734     L      PN_M4005_S_M03_nominal_and_status
                          4735     O      PN_M4006_S_M04_nominal_and_status
                          4736     AN     PN_M4007_S_M05_nominal_0_and_status
                          4737     AN     PN_M4008_S_nominal_off_status_inverse
                          4738     AN     MG_spindle_stand_still
                          4739     IFT
                          4740       L      K+0
                          4741       =      DL_S_standstill_elapsed_min
                          4742     ELSE
                          4743       L      MG_pulse_1_min
                          4744       IFT
                          4745         INC    DL_S_standstill_elapsed_min
                          4746       ENDI
                          4747     ENDI
                          4748 
                          4749     L      NP_MP4231_29_S_rewarming_up_standstill_min
                          4750     /      K+10000
                          4751     <      DL_S_standstill_elapsed_min
                          4752     R      MG_spindle_warmed_up
                          4753     IFT
                          4754       L      K+0
                          4755       =      DL_S_standstill_elapsed_min
                          4756     ENDI
                          4757   ENDI
                          4758 
                          4759  *;Press the spindle warming-up soft key to start the warming-up procedure.
                          4760   L      MG_soft_key_S_warming_up
                          4761   AN     NP_M4176_control_in_operation_on_or_flashes
                          4762   AN     PN_error_safety_mode_2                                       *;CE 2008
                          4763   AN     MG_safety_mode_4                                             *;Safety mode 4
                          4764 #if HSS = &HS_type_299
                          4765   AN     MG_FAEMAT_S_clamped_without_tool
                          4766 #else
                          4767   A[
                          4768     LN     NP_tool_clamped_without_tool_sensor
                          4769     ON     I_tool_clamped_without_tool
                          4770   ]
                          4771 #endif
                          4772   S      MG_S_warming_up_proceeding
                          4773 
                          4774  *;M05 or spindle pause will stop the spindle warming-up procedure.
                          4775   L      ML_S_warming_up_1st_stage_proceeding
                          4776   O      ML_S_warming_up_2nd_stage_proceeding
                          4777   O      ML_S_warming_up_3rd_stage_proceeding
                          4778   A[
                          4779     LN     PN_M4005_S_M03_nominal_and_status
                          4780     AN     PN_M4006_S_M04_nominal_and_status
                          4781     A      PN_M4007_S_M05_nominal_0_and_status
                          4782     O      MG_S_0_volt_status_inverse
                          4783     AN     MG_auto_manu_mode_change
                          4784     O      PN_error_safety_mode_2                                     *;CE 2008
                          4785     O      MG_safety_mode_4                                           *;Safety mode 4
                          4786   ]
                          4787   R      MG_S_warming_up_proceeding
                          4788   R      PN_M4005_S_M03_nominal_and_status
                          4789   R      PN_M4006_S_M04_nominal_and_status
                          4790   S      PN_M4007_S_M05_nominal_0_and_status
                          4791 
                          4792   L      MG_soft_key_S_warming_up
                          4793 #if HSS = &HS_type_299
                          4794   A      MG_FAEMAT_S_clamped_without_tool
                          4795 #else
                          4796   A      NP_tool_clamped_without_tool_sensor
                          4797   A      I_tool_clamped_without_tool
                          4798 #endif
                          4799   S      PN_error_spindle_without_tool
                          4800 
                          4801   L      MG_S_warming_up_proceeding
                          4802   A      MG_automatic_mode
                          4803   =      PN_error_spindle_during_warming_up
                          4804 
                          4805  *;If the spindle warming-up procedure is aborted, it can be resumed within a
                          4806  *;certain time without starting over.
                          4807   L      PN_M4005_S_M03_nominal_and_status
                          4808   O      PN_M4006_S_M04_nominal_and_status
                          4809   AN     PN_M4007_S_M05_nominal_0_and_status
                          4810   AN     PN_M4008_S_nominal_off_status_inverse
                          4811   AN     MG_spindle_stand_still
                          4812   A      MG_S_warming_up_proceeding
                          4813   IFT
                          4814     L      NP_MP4231_28_S_warming_up_max_pause_sec
                          4815     /      K+10000
                          4816     =      WL_S_warming_up_pause_remaining_sec
                          4817   ELSE
                          4818     L      WL_S_warming_up_pause_remaining_sec
                          4819     >=     K+0
                          4820     A[
                          4821       L      WL_S_warming_up_total_duration_sec
                          4822       >      WG_spindle_warming_up_remaining_seconds
                          4823     ]
                          4824     A      MG_pulse_1_s
                          4825     IFT
                          4826       DEC    WL_S_warming_up_pause_remaining_sec
                          4827     ENDI
                          4828 
                          4829     L      WL_S_warming_up_pause_remaining_sec
                          4830     <      K+0
                          4831     IFT
                          4832       L      WL_S_warming_up_total_duration_sec
                          4833       =      WG_spindle_warming_up_remaining_seconds
                          4834 
                          4835       L      NP_MP4231_28_S_warming_up_max_pause_sec
                          4836       /      K+10000
                          4837       =      WL_S_warming_up_pause_remaining_sec
                          4838     ENDI
                          4839   ENDI
                          4840 
                          4841  *;During the spinlde warming-up procedure, the S % override = 100% regardless
                          4842  *;of S % potentiometer.  Three stages for spindle warming-up procedure:
                          4843  *;   1st Stage: Spindle running in 1st stage speed for 1st stage duration
                          4844  *;   2nd Stage: Spindle running in 2nd stage speed for 2nd stage duration
                          4845  *;   3rd Stage: Spindle running in 3rd stage speed for 3rd stage duration
                          4846  *;After the spindle warming-up procedure has been completed,
                          4847  *;MG_spindle_warmed_up is set to 1 and the spindle stops.
                          4848   L      MG_S_warming_up_proceeding
                          4849   AN     PN_M4008_S_nominal_off_status_inverse
                          4850   S      PN_M4005_S_M03_nominal_and_status
                          4851   R      PN_M4006_S_M04_nominal_and_status
                          4852   R      PN_M4007_S_M05_nominal_0_and_status
                          4853   IFT
                          4854     L      WG_MP7620_F_S_override
                          4855     BT     K+3
                          4856     IFT
                          4857       L      K+10000
                          4858       =      PN_W764_S_override_PLC
                          4859     ELSE
                          4860       L      K+100
                          4861       =      PN_W764_S_override_PLC
                          4862     ENDI
                          4863 
                          4864 #if S_warming_up_type = &Step_rpm
                          4865     L      NP_MP4231_25_S_warming_up_2nd_duration_sec
                          4866     +      NP_MP4231_23_S_warming_up_3rd_duration_sec
                          4867     /      K+10000
                          4868     <      WG_spindle_warming_up_remaining_seconds
                          4869     =      ML_S_warming_up_1st_stage_proceeding
                          4870     IFT
                          4871       L      NP_MP4231_26_S_warming_up_1st_stage_rpm
                          4872       /      K+10
                          4873       =      PN_D756_S_nominal_rpm_PLC
                          4874     ELSE
                          4875       L      NP_MP4231_23_S_warming_up_3rd_duration_sec
                          4876       /      K+10000
                          4877       <      WG_spindle_warming_up_remaining_seconds
                          4878       =      ML_S_warming_up_2nd_stage_proceeding
                          4879       =N     ML_S_warming_up_3rd_stage_proceeding
                          4880       IFT
                          4881         L      NP_MP4231_27_S_warming_up_2nd_stage_rpm
                          4882         /      K+10
                          4883         =      PN_D756_S_nominal_rpm_PLC
                          4884       ELSE
                          4885         L      NP_MP4231_30_S_warming_up_3rd_stage_rpm
                          4886         /      K+10
                          4887         =      PN_D756_S_nominal_rpm_PLC
                          4888       ENDI
                          4889     ENDI
                          4890 #endif
                          4891 
                          4892 #if S_warming_up_type = &Stepless_rpm
                          4893     L      K+0
                          4894     <      WG_spindle_warming_up_remaining_seconds
                          4895     =      ML_S_warming_up_1st_stage_proceeding
                          4896     IFT
                          4897       L      DG_MP3510_0_S_1st_gear_rpm
                          4898       /      K+1000
                          4899       -      DG_MP3240_1_S_min_rpm
                          4900       X[
                          4901         L      WL_S_warming_up_total_duration_sec
                          4902         -      WG_spindle_warming_up_remaining_seconds
                          4903       ]
                          4904       /      WL_S_warming_up_total_duration_sec
                          4905       +      DG_MP3240_1_S_min_rpm
                          4906       X      K+1000
                          4907       =      PN_D756_S_nominal_rpm_PLC
                          4908 
                          4909 
                          4910       L      DG_MP3240_1_S_min_rpm
                          4911       X      K+1000
                          4912       >      PN_D756_S_nominal_rpm_PLC
                          4913       IFT
                          4914         L      DG_MP3240_1_S_min_rpm
                          4915         X      K+1000
                          4916         =      PN_D756_S_nominal_rpm_PLC
                          4917       ENDI
                          4918     ENDI
                          4919 #endif
                          4920 
                          4921 #if S_warming_up_type = &Step_stepless_rpm
                          4922     L      NP_MP4231_25_S_warming_up_2nd_duration_sec
                          4923     +      NP_MP4231_23_S_warming_up_3rd_duration_sec
                          4924     /      K+10000
                          4925     <      WG_spindle_warming_up_remaining_seconds
                          4926     =      ML_S_warming_up_1st_stage_proceeding
                          4927     IFT
                          4928       L      NP_MP4231_26_S_warming_up_1st_stage_rpm
                          4929       /      K+10
                          4930       =      PN_D756_S_nominal_rpm_PLC
                          4931     ELSE
                          4932       L      NP_MP4231_23_S_warming_up_3rd_duration_sec
                          4933       /      K+10000
                          4934       <      WG_spindle_warming_up_remaining_seconds
                          4935       =      ML_S_warming_up_2nd_stage_proceeding
                          4936       =N     ML_S_warming_up_3rd_stage_proceeding
                          4937       IFT
                          4938         L      NP_MP4231_30_S_warming_up_3rd_stage_rpm
                          4939         -      NP_MP4231_26_S_warming_up_1st_stage_rpm
                          4940         /      K+10000                                                *;Prevent from overflow
                          4941         X[
                          4942           L      WL_S_warming_up_total_duration_sec
                          4943           -      WG_spindle_warming_up_remaining_seconds
                          4944           -[
                          4945             L      NP_MP4231_24_S_warming_up_1st_duration_sec
                          4946             /      K+10000
                          4947           ]
                          4948         ]
                          4949         /[
                          4950           L      WL_S_warming_up_total_duration_sec
                          4951           -[
                          4952             L      NP_MP4231_24_S_warming_up_1st_duration_sec
                          4953             +      NP_MP4231_23_S_warming_up_3rd_duration_sec
                          4954             /      K+10000
                          4955           ]
                          4956         ]
                          4957         X      K+10000                                                *;Prevent from overflow
                          4958         +      NP_MP4231_26_S_warming_up_1st_stage_rpm
                          4959         /      K+10
                          4960         =      PN_D756_S_nominal_rpm_PLC
                          4961       ELSE
                          4962         L      NP_MP4231_30_S_warming_up_3rd_stage_rpm
                          4963         /      K+10
                          4964         =      PN_D756_S_nominal_rpm_PLC
                          4965       ENDI
                          4966     ENDI
                          4967 #endif
                          4968 
                          4969     L      ML_S_warming_up_1st_stage_proceeding
                          4970     AN     ML_temp_S_warming_up_1st_stage_proceeding
                          4971     =      ML_p_edge_S_warming_up_1st_stage_proceeding
                          4972 
                          4973     L      ML_S_warming_up_1st_stage_proceeding
                          4974     =      ML_temp_S_warming_up_1st_stage_proceeding
                          4975 
                          4976     L      ML_S_warming_up_2nd_stage_proceeding
                          4977     AN     ML_temp_S_warming_up_2nd_stage_proceeding
                          4978     =      ML_p_edge_S_warming_up_2nd_stage_proceeding
                          4979 
                          4980     L      ML_S_warming_up_2nd_stage_proceeding
                          4981     =      ML_temp_S_warming_up_2nd_stage_proceeding
                          4982 
                          4983     L      ML_S_warming_up_3rd_stage_proceeding
                          4984     AN     ML_temp_S_warming_up_3rd_stage_proceeding
                          4985     =      ML_p_edge_S_warming_up_3rd_stage_proceeding
                          4986 
                          4987     L      ML_S_warming_up_3rd_stage_proceeding
                          4988     =      ML_temp_S_warming_up_3rd_stage_proceeding
                          4989 
                          4990 #if S_warming_up_type = &Step_rpm
                          4991     L      ML_p_edge_S_warming_up_1st_stage_proceeding
                          4992     O      ML_p_edge_S_warming_up_2nd_stage_proceeding
                          4993     O      ML_p_edge_S_warming_up_3rd_stage_proceeding
                          4994 #endif
                          4995 #if S_warming_up_type = &Stepless_rpm
                          4996     L      MG_pulse_1_s
                          4997 #endif
                          4998 #if S_warming_up_type = &Step_stepless_rpm
                          4999     L      ML_S_warming_up_2nd_stage_proceeding
                          5000     A      MG_pulse_1_s
                          5001     O      ML_p_edge_S_warming_up_1st_stage_proceeding
                          5002     O      ML_p_edge_S_warming_up_3rd_stage_proceeding
                          5003 #endif
                          5004     S      PN_M4134_strobe_G_range_S_speed
                          5005 
                          5006     L      WG_spindle_warming_up_remaining_seconds
                          5007     >=     K+0
                          5008     A[
                          5009       L      PN_M4005_S_M03_nominal_and_status
                          5010       O      PN_M4006_S_M04_nominal_and_status
                          5011       AN     PN_M4007_S_M05_nominal_0_and_status
                          5012       AN     PN_M4008_S_nominal_off_status_inverse
                          5013     ]
                          5014     A      MG_S_actual_equal_nominal_rpm
                          5015     A      MG_pulse_1_s
                          5016     IFT
                          5017       DEC    WG_spindle_warming_up_remaining_seconds
                          5018     ENDI
                          5019 
                          5020     L      WG_spindle_warming_up_remaining_seconds
                          5021     <      K+0
                          5022     S      MG_spindle_warmed_up
                          5023     R      MG_S_warming_up_proceeding
                          5024     R      PN_M4005_S_M03_nominal_and_status
                          5025     R      PN_M4006_S_M04_nominal_and_status
                          5026     S      PN_M4007_S_M05_nominal_0_and_status
                          5027     IFT
                          5028       L      WL_S_warming_up_total_duration_sec
                          5029       =      WG_spindle_warming_up_remaining_seconds
                          5030     ENDI
                          5031   ELSE
                          5032     L      MG_marker_one
                          5033     R      ML_S_warming_up_1st_stage_proceeding
                          5034     R      ML_temp_S_warming_up_1st_stage_proceeding
                          5035     R      ML_S_warming_up_2nd_stage_proceeding
                          5036     R      ML_temp_S_warming_up_2nd_stage_proceeding
                          5037     R      ML_S_warming_up_3rd_stage_proceeding
                          5038     R      ML_temp_S_warming_up_3rd_stage_proceeding
                          5039   ENDI
                          5040 
                          5041  *;Before the spindle has been warmed up, the spindle maximum speed is limited
                          5042  *;under 1st stage warming-up speed.
                          5043   LN     MG_spindle_warmed_up
                          5044   AN     MG_S_warming_up_proceeding
                          5045   IFT
                          5046     L      NP_MP4231_26_S_warming_up_1st_stage_rpm
                          5047     /      K+10
                          5048     <      PN_D604_max_S_rpm_PLC
                          5049     IFT
                          5050       L      NP_MP4231_26_S_warming_up_1st_stage_rpm
                          5051       /      K+10
                          5052       =      PN_D604_max_S_rpm_PLC
                          5053     ENDI
                          5054   ENDI
                          5055 
                          5056   L      MG_spindle_warmed_up
                          5057   AN     ML_spindle_warmed_up_temp
                          5058   =      MG_spindle_warmed_up_p_pulse
                          5059 
                          5060   L      MG_spindle_warmed_up
                          5061   =      ML_spindle_warmed_up_temp
                          5062 
                          5063   L      MG_spindle_warmed_up_p_pulse
                          5064   S      PN_M4134_strobe_G_range_S_speed
                          5065   IFT
                          5066     L      KL_rpm_after_S_warmed_up
                          5067     =      PN_D756_S_nominal_rpm_PLC
                          5068   ENDI
