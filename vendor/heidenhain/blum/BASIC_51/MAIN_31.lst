                          1232 *;EUMACH Note1
                          1233 *;When axis clamping mode is off (M4x) and front guard is opening/unlocking, BG_step_axes[X] is
                          1234 *;still in case 5 but O_unclamping_xx = 0.  For clamping axis with hydraulic accumulator, the
                          1235 *;hydraulic system reacts very fast, so unclamped sensor = 0 but clamped sensor = 0 while
                          1236 *;BG_step_axes[X] still in case 5.  MG_O_unclamping[X] is introduced to check the clamped/unclamped
                          1237 *;sensor when axis is unclamping.
                          1238 *;EUMACH Note1
                          1239 
                          1240 *;EUMACH
                          1241     ;If standard PLC cannot solve C-axis positioning problem, try to use PLC
                          1242     ;(PLC label with "EUMACH open loop on") to open the position loop earlier
                          1243     ;but still having current loop activating.  Since W1040 = 1, the next NC
                          1244     ;block will be executed.  It is necessary to hold the feed by using
                          1245     ;MG_3D_head_axis_2_feed_not_release and it also needs another marker to hold
                          1246     ;spindle motion until the C-axis is absolutely clamped (this marker not yet
                          1247     ;implemented).
                          1248 *;EUMACH open loop on
                          1249 ;    LX
                          1250 ;    ==     KG_3D_head_axis_2
                          1251 ;    IFT
                          1252 ;      LW     MG_X_in_hirth_position
                          1253 ;      ON     WG_hirth_axes
                          1254 ;      A      WG_activate_control_loop_open
