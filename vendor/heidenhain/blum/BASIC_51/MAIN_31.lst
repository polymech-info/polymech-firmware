                          4142 #if (MT = &MT_2D) or (MT = &MT_31A) or (MT = &MT_31B) or (MT = &MT_32A) or (MT = &MT_36B) or (MT = &MT_37B) or (S_cooling_control_type = &Continuous) or (MT = &MT_39A) or (MT = &MT_3AA) or (MT = &MT_3B) or (MT = &MT_3BA)
