                          2701 LBL DCM_CMO_on_off
                          2702 
                          2703 *;TVMC partition on/off
                          2704 #if MT = &MT_37B
                          2705   LN     NP_partition_DCM_CMO_MACRO
                          2706   EMT
                          2707 
                          2708   LN     MG_alternating_table_on
                          2709   A      NP_M4173_1st_PLC_run_after_compile
                          2710   O[
                          2711     LN     MG_alternating_table_on
                          2712     A      ML_alternating_table_on
                          2713   ]
                          2714   R      ML_partition_CMO_on_request
                          2715   S      ML_partition_CMO_off_request
                          2716 
                          2717   L      MG_alternating_table_on
                          2718   A      NP_M4173_1st_PLC_run_after_compile
                          2719   O[
                          2720     L      MG_alternating_table_on
                          2721     AN     ML_alternating_table_on
                          2722   ]
                          2723   S      ML_partition_CMO_on_request
                          2724   R      ML_partition_CMO_off_request
                          2725 
                          2726   L      MG_alternating_table_on
                          2727   =      ML_alternating_table_on
                          2728 
                          2729   L      ML_partition_CMO_on_request
                          2730   AN     I_alternat_table_partition_removed
                          2731   O[
                          2732     L      ML_partition_CMO_off_request
                          2733     A      I_alternat_table_partition_removed
                          2734   ]
                          2735 ;  A      MG_power_delayed_on                                         *;NOTE 1 original PLC
                          2736   A      MG_delay_of_MG_power_delayed_on                              *;NOTE 1
                          2737   AN     MG_Z_brake_test_active                                       *;NOTE 1
                          2738   A[
                          2739     L      BG_KINEMATICS_assignment
                          2740     ==     K-1
                          2741     O[                                                                *;Wait for KINEMATICS assigned
                          2742       L      BG_KINEMATICS_assignment
                          2743       >=     K+0
                          2744       AN     ML_KINEMATICS_request
                          2745     ]
                          2746   ]
                          2747   A      PN_M4560_NC_stop_0_active
                          2748   AN     NP_M4221_PET_table_NC_stop
                          2749   AN     NP_M4223_PET_table_NC_cancel                                 *;BASIC55
                          2750   IFT
                          2751     RPLY   BL_partition_CMO_on_off_identifier
                          2752     ==     K+0
                          2753     IFT
                          2754       SUBM   Partition_CMO_on_off_submit
                          2755       =      BL_partition_CMO_on_off_identifier
                          2756       ==     K+0
                          2757       S      PN_error_submit_spawn_queue_full
                          2758     ENDI
                          2759   ENDI
                          2760 
                          2761 *;NOTE 1
                          2762 *;    Original PLC was using MG_power_delayed_on and MP2230.2 = 1 (brake test at power-on), but
                          2763 *;    after power-on, error 8330 occurs.  The reason is because brake test is executed right after
                          2764 *;    MG_power_delayed_on and at the same time submit MACRO is executed.  To solve the problem,
                          2765 *;    a delay of PLC marker MG_power_delayed_on and also MG_Z_brake_test_active are used.
                          2766 
