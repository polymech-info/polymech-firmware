                          5077   O      PN_M4006_S_M04_nominal_and_status
                          5078   AN     PN_M4007_S_M05_nominal_0_and_status
                          5079   AN     PN_M4008_S_nominal_off_status_inverse
                          5080   A      I_tool_clamped_without_tool
                          5081   A      NP_tool_clamped_without_tool_sensor
                          5082   AN     NP_M3_M4_for_S_clamped_without_tool
