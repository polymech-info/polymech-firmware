*-----------------------------------------------------------------------------
*  Configuration
*-----------------------------------------------------------------------------
*  Definition of symbols for conditional compilation
*    - Machine configuration
*    - Hardware components (PL410 ...)
*    - Axes configuration
*
*  Conditional check #if <symbol> = <value>
*                ...
*              #endif
*-----------------------------------------------------------------------------

*-----------------------------------------------------------------------------
*  Machine configuration
*
*  EUMACH
*  VMC series with cam-driven arm (double arm) tool changer
*-----------------------------------------------------------------------------

#define       MT                                       &MT_31         *;EUMACH Machine Type

#define       Tool_specific_torque_monitoring          &active
#define       Emergency_end_position_axes_coded        &active
#define       Temp_compensation_table                  &active
#define       Spindle_wye_delta_connection             &inactive
#define       Error_messages_additional                &active
;#define       Working_area_monitoring                  &inactive     *;EUMACH Original PLC
#define       Lubrication_axes                         &active

*$WS will be prepared
#define       2nd_spindle                              &inactive
#define       LSV2_ActiveX_Control                     &inactive

*-----------------------------------------------------------------------------
*  3D Head
*    - Number of the 1./2. 3D head axis [&axis_4 .. &axis_9]
*    - Selection reference value from PLC (non volatile 3D head position)
*      or transfer reference in mode reference (reference dog available)
*      [&active/&inactive]
*    - Torque limitation spindle motor before 3D head clamping
*      [&active/&inactive]
*
*-----------------------------------------------------------------------------

#define       3D_head                                  &inactive
#define       KG_3D_head_axis_1                        &axis_6
#define       KG_3D_head_axis_2                        &axis_7
#define       Reference_value_selection                &inactive
#define       Torque_limitation                        &inactive

*-----------------------------------------------------------------------------
*  Axes configuration
*    - Axes with clamping mode and clamping signal
*    - Axes with central drive or C axes mode
*    - Move axes to 0 degree or mm after traverse reference
*      [%FEDCBA987654ZYX]
*-----------------------------------------------------------------------------
*                                                       FEDCBA987654321
#define       KG_clamping_mode_active                  %000000000011100

*;EUMACH
#if (M44 = &inactive) and (M45 = &inactive) and (M46 = &inactive)                                                      *;EUMACH
*                                                       FEDCBA987654321
#define       KG_power_on_clamping_mode_off            %000000000000100
#endif

#if (M44 = &active) and (M45 = &inactive) and (M46 = &inactive)                                                      *;EUMACH
*                                                       FEDCBA987654321
#define       KG_power_on_clamping_mode_off            %000000000001100
#endif

#if (M44 = &inactive) and (M45 = &active) and (M46 = &inactive)                                                      *;EUMACH
*                                                       FEDCBA987654321
#define       KG_power_on_clamping_mode_off            %000000000010100
#endif

#if (M44 = &inactive) and (M45 = &inactive) and (M46 = &active)                                                      *;EUMACH
*                                                       FEDCBA987654321
#define       KG_power_on_clamping_mode_off            %000000000100100
#endif

#if (M44 = &active) and (M45 = &active) and (M46 = &inactive)                                                      *;EUMACH
*                                                       FEDCBA987654321
#define       KG_power_on_clamping_mode_off            %000000000011100
#endif

#if (M44 = &inactive) and (M45 = &active) and (M46 = &active)                                                      *;EUMACH
*                                                       FEDCBA987654321
#define       KG_power_on_clamping_mode_off            %000000000110100
#endif

#if (M44 = &active) and (M45 = &inactive) and (M46 = &active)                                                      *;EUMACH
*                                                       FEDCBA987654321
#define       KG_power_on_clamping_mode_off            %000000000101100
#endif

#if (M44 = &active) and (M45 = &active) and (M46 = &active)                                                      *;EUMACH
*                                                       FEDCBA987654321
#define       KG_power_on_clamping_mode_off            %000000000111100
#endif
*;EUMACH

*                                                       FEDCBA987654321
#define       KG_axes_with_signal_clamped              %000000000011000
#define       KG_axes_with_signal_unclamped            %000000000011000

#define       KG_axes_use_nominal_value_as_actual      %000000000000000
#define       KG_axes_with_central_drive_mode          %000000000000000
#define       KG_axes_with_c_axis_mode                 %000000000000000
#define       KG_axes_with_common_used_position_ROD    %000000000000000
