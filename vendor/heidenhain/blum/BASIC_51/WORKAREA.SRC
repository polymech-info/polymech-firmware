;    PS     KL_distance_to_go
;    CM     9041
;    M_display_module_error(KG_error_module_9041)

;    L      DG_distance_to_go_Y_axis
;    +      DG_position_axis_Y_ref
;    <      NP_MP4230_2_working_area_auto_Y
;    IFT
;      L      DG_distance_to_go_Z_axis
;      +      DG_position_axis_Z_ref
;      <      NP_MP4230_3_working_area_auto_Z
;      S      PN_error_protection_working_area
;    ENDI
;  ENDI
*;EUMACH Original PLC
#endif

EM
