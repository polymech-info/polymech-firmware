EM

;----------------------------
LBL Tool_manu_unclamping               ;16

  L      MG_marker_one
  R      PN_error_quit_tool_change
  R      PN_error_guard_close_quit_tool_change
  R      PN_error_guard_open
  S      O_lamp_TC_enable

#if Head = &S_head_type_05                                          *;EUMACH
  L      MG_soft_key_S_man_head                                       *;EUMACH
  S      PN_error_guard_open_for_tool_replace                         *;EUMACH
  IFT                                                                 *;EUMACH
    LN     I_guard_1_closed                                           *;EUMACH
    PSL                                                               *;EUMACH
EM                                                                    *;EUMACH
  ENDI                                                                *;EUMACH
#endif                                                                *;EUMACH

  LN     MG_alternating_table_on                                      *;EUMACH
  IFT                                                                 *;EUMACH
    L      I_key_tool_unclamping
    O      I_key_tool_unclamping_foot_switch
    O      MG_soft_key_tool_unclamp
    O      MG_HW_SK_TC_unclamp                                        *;EUMACH MPG tool releasing
    A      I_guard_1_closed
    A      I_guard_2_closed                                           *;EUMACH
    AN     NP_guard_inactive
    S      PN_error_guard_closed
  ELSE                                                                *;EUMACH
    L      I_key_tool_unclamping                                      *;EUMACH
    O      I_key_tool_unclamping_foot_switch                          *;EUMACH
    O      MG_soft_key_tool_unclamp                                   *;EUMACH
    O      MG_HW_SK_TC_unclamp                                        *;EUMACH MPG tool releasing
    A[                                                                *;EUMACH
      L      MG_axis_limit_1                                          *;EUMACH
      A      I_guard_1_closed                                         *;EUMACH
      O[                                                              *;EUMACH
        L      MG_axis_limit_2                                        *;EUMACH
        A      I_guard_2_closed                                       *;EUMACH
      ]                                                               *;EUMACH
    ]                                                                 *;EUMACH
    AN     NP_guard_inactive                                          *;EUMACH
    S      PN_error_guard_closed                                      *;EUMACH
  ENDI                                                                *;EUMACH

  LN     MG_alternating_table_on
  IFT
    LN     I_guard_1_closed
    ON     I_guard_2_closed
    R      PN_error_guard_closed
  ELSE
    L      MG_alternating_table_on
    A      MG_axis_limit_1
;    AN     MG_guard_1_closed_locked                                  *;EUMACH Original PLC
    AN     I_guard_1_closed                                           *;EUMACH
    R      PN_error_guard_closed

    L      MG_alternating_table_on
    A      MG_axis_limit_2
;    AN     MG_guard_2_closed_locked                                  *;EUMACH Original PLC
    AN     I_guard_2_closed                                           *;EUMACH
    R      PN_error_guard_closed
  ENDI

  LN     PN_error_guard_closed
  =      PN_error_tool_unclamping

  L      MG_clock_1_s
  AN     O_tool_unclamping
  =      O_lamp_tool_unclamped

  L      MG_soft_key_tool_unclamp
  O      MG_HW_SK_TC_unclamp                                          *;EUMACH MPG tool releasing
  O      I_key_tool_unclamping
  AN     ML_key_pressed
  O      I_key_tool_unclamping_foot_switch
  AN     PN_error_guard_closed
  S      O_tool_unclamping
  R      O_tool_clamping                                              *;EUMACH

  L      I_key_enable_toolchange
  O      MG_soft_key_enable_toolchange
  O      MG_HW_SK_TC_release                                          *;EUMACH MPG tool releasing
  AN     ML_key_pressed
  A      MG_manual_mode
  CMT    TC_manual_reset

  PS     O_tool_unclamping

EM

;----------------------------
LBL Tool_manu_clamping                 ;17

#if Head = &S_head_type_05                                          *;EUMACH
  L      MG_marker_one                                                *;EUMACH
  R      PN_error_guard_open_for_tool_replace                         *;EUMACH

  L      MG_soft_key_S_man_head                                       *;EUMACH
  S      PN_error_tool_replace_and_guard_close                        *;EUMACH
  IFT                                                                 *;EUMACH
    LN     MG_guard_open                                              *;EUMACH
    PSL                                                               *;EUMACH
EM                                                                    *;EUMACH
  ENDI                                                                *;EUMACH
#endif                                                                *;EUMACH

  L      MG_marker_one
  R      PN_error_tool_unclamping
  S      PN_error_tool_clamping
  R      PN_error_quit_tool_change
  R      PN_error_guard_close_quit_tool_change
  R      PN_error_end_tool_change_NC_start
  R      PN_error_guard_open
  S      O_lamp_TC_enable

  L      MG_clock_1_s
  A      O_tool_unclamping
  =      O_lamp_tool_unclamped

  L      MG_soft_key_tool_unclamp
  O      MG_HW_SK_TC_unclamp                                          *;EUMACH MPG tool releasing
  O      I_key_tool_unclamping
  AN     ML_key_pressed
  O[
    LN     I_key_tool_unclamping_foot_switch
    A      ML_foot_switch_operated
  ]
  R      O_tool_unclamping
  S      O_tool_clamping                                              *;EUMACH

  L      I_key_enable_toolchange
  O      MG_soft_key_enable_toolchange
  O      MG_HW_SK_TC_release                                          *;EUMACH MPG tool releasing
  AN     ML_key_pressed
  A      MG_manual_mode
#if (Solenoid_off_after_tool_clamped = &active) and (CYTEC_CYCON_control = &inactive) *;EUMACH
  AN     O_tool_clamping                                              *;EUMACH
#endif                                                                *;EUMACH
  CMT    TC_manual_reset

  LN     O_tool_unclamping
  PSL

EM

;----------------------------
LBL T_change_disable                   ;18

#if Head = &S_head_type_05                                          *;EUMACH
  L      MG_marker_one                                                *;EUMACH
  R      PN_error_tool_replace_and_guard_close                        *;EUMACH

  L      MG_soft_key_S_man_head                                       *;EUMACH
  S      PN_error_quit_tool_change                                    *;EUMACH
  IFT                                                                 *;EUMACH
    L      I_key_enable_toolchange                                    *;EUMACH
    O      MG_soft_key_enable_toolchange                              *;EUMACH
    O      MG_HW_SK_TC_release                                        *;EUMACH MPG tool releasing
    AN     ML_key_pressed                                             *;EUMACH
    PSL                                                               *;EUMACH

EM                                                                    *;EUMACH
  ENDI                                                                *;EUMACH
#endif                                                                *;EUMACH

  L      MG_marker_one
  R      PN_error_tool_clamping

  L      NP_guard_inactive
  S      PN_error_quit_tool_change
  SN     PN_error_guard_close_quit_tool_change

  L      I_key_tool_unclamping
  O      MG_soft_key_tool_unclamp
  O      MG_HW_SK_TC_unclamp                                          *;EUMACH MPG tool releasing
  AN     ML_key_pressed
  O      I_key_tool_unclamping_foot_switch
  A[
    L      MG_guard_open
    O      NP_guard_inactive
  ]
  S      O_tool_unclamping
  R      O_tool_clamping                                              *;EUMACH
  IFT
    DEC    BL_step_T_change
  ENDI

  L      MG_clock_1_s
  =      O_lamp_TC_enable

  L      I_key_enable_toolchange
  O      MG_soft_key_enable_toolchange
  O      MG_HW_SK_TC_release                                          *;EUMACH MPG tool releasing
  AN     ML_key_pressed
  AN     MG_guard_open
  PSL

EM

;----------------------------
LBL T_change_quit                      ;19

  L      MG_marker_one
  R      PN_error_quit_tool_change
  R      PN_error_guard_close_quit_tool_change
  R      O_lamp_TC_enable                                             *;EUMACH

  L      MG_key_NC_start
  O      MG_manual_mode
  =N     PN_error_end_tool_change_NC_start
  PSL

EM

;----------------------------
LBL Restore_necessary                  ;20

  L      MG_control_in_operation_on
  O      NP_M4157_mode_restore_position
  O      MG_manual_mode
  PSL

EM

;----------------------------
LBL Restore_pos_ok                     ;21

  L      MG_control_in_operation_on
  AN     NP_M4157_mode_restore_position
  O      MG_mode_block_scan_has_been_active
  O      MG_manual_mode
  PSL

EM

;----------------------------
LBL T_Probe_on_off                     ;22

  PS     MG_marker_one

*;EUMACH Original PLC---BASIC 53
;  L      MG_manual_mode
;  EMT

;  L      BG_tool_status_new
;  BT     K+0
;  =      MG_touch_probe_active
*;EUMACH Original PLC---BASIC 53

EM

;----------------------------
LBL Tool_Call_quitt                    ;23

  PS     MG_marker_zero

  L      NP_M4073_strobe_TOOL_CALL
  S      PN_M4093_quit_TOOL_CALL
  IFT
    L      NP_W264_tool_number
    =      WG_tool_in_spindle
  ENDI

  LN     NP_M4073_strobe_TOOL_CALL
  CMT    TC_manual_reset

EM

;----------------------------
LBL TC_manual_reset

  L      MG_marker_one
  R      PN_error_tool_clamping
  R      PN_error_tool_unclamping
  R      PN_error_quit_tool_change
  R      PN_error_guard_close_quit_tool_change
  R      PN_error_end_tool_change_NC_start
  R      MG_TC_manual
  R      MG_TC_manu_interruption
#if (Solenoid_off_after_tool_clamped = &inactive) or (CYTEC_CYCON_control = &active) *;EUMACH
  R      O_tool_unclamping
#endif                                                                *;EUMACH
#if Head = &S_head_type_05                                            *;EUMACH
  R      PN_error_guard_open_for_tool_replace                         *;EUMACH
  R      PN_error_tool_replace_and_guard_close                        *;EUMACH
#endif                                                                *;EUMACH

  L      K+0
  =      BL_step_T_change

EM

