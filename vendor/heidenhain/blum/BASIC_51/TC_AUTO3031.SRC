LBL Tnew_store                         ;25

  PS     MG_marker_one

  L      WG_TC_auto_tool_number
  =      WG_TC_auto_new_tool_number

EM

;----------------------------
LBL T0_in_status                       ;26

  LN     MG_TC_interruption
  AN     MG_tool_status_reading
  S      PN_M4538_tool_selection_from_PLC_W264
  S      PN_M4542_pocket_table_not_update
;  R      MG_touch_probe_active                                       *;EUMACH Original PLC---BASIC 53
  PSL
  EMF

  L      K+0
  =      NP_W264_tool_number

EM

;----------------------------
LBL Tnew_in_status                     ;36 ;46

  LN     MG_tool_status_reading
  AN     MG_TC_interruption
  PSL
  EMF

  L      MG_marker_one
  R      PN_M4542_pocket_table_not_update
  S      PN_M4538_tool_selection_from_PLC_W264

  L      NP_W262_tool_pocket_number
  ==     KL_tool_without_pocket
  IFT
    L      NP_W264_tool_number
    =      WG_TC_auto_tool_number
  ENDI

  L      WG_TC_auto_new_tool_number
  =      NP_W264_tool_number
  =      WG_tool_in_spindle

EM

;----------------------------
LBL T_status_ok                        ;27 ;37 ;47

  LN     PN_M4538_tool_selection_from_PLC_W264
  PSL

  L      NP_W262_tool_pocket_number
  >=     KL_tool_with_pocket
  O      NP_M4520_TOOL_CALL_2nd_strobe
  EMT

  L      WG_TC_auto_tool_number
  =      NP_W264_tool_number

EM

;----------------------------
LBL Tool_Call_2nd                      ;28

#if Middle_position_exchange = &active
  LN     NP_M4520_TOOL_CALL_2nd_strobe
  ON     NP_M4073_strobe_TOOL_CALL
  PSL
  EMT

  L      NP_M4520_TOOL_CALL_2nd_strobe
  AN     MG_TC_interruption
  S      MG_2nd_TOOL_CALL_following
  S      PN_M4093_quit_TOOL_CALL
#else
  PS     MG_marker_one
#endif

EM

;----------------------------
LBL Tool_Call_wait                     ;29

  L      NP_M4073_strobe_TOOL_CALL
  PSL
  EMF

  L      NP_W262_tool_pocket_number
  >=     KL_tool_with_pocket
  IFT
    L      NP_W262_tool_pocket_number
    =      WG_TC_pocket_number
    L      NP_W264_tool_number
    =      WG_TC_auto_tool_number
  ENDI

EM

;----------------------------
LBL TOOL_CALL_quit                     ;46 ;56

  L      NP_W262_tool_pocket_number
  ==     KL_tool_without_pocket
  ON     NP_M4073_strobe_TOOL_CALL
  PSL
  EMT

  L      NP_M4073_strobe_TOOL_CALL
  AN     MG_TC_interruption
  S      PN_M4093_quit_TOOL_CALL

EM

;----------------------------
LBL TC_auto_end                        ;47 ;57

  PS     MG_marker_zero

