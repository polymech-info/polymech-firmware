LBL TC_auto_reset

  L      MG_marker_one
  R      MG_2nd_TOOL_CALL_following
  R      MG_TC_automatic
  R      MG_TC_interruption
  R      MG_TM_started_by_Tool_Call
  R      MG_TC_spindle_orientation_on
  R      MG_win_window_yes_no
  R      ML_TC_arm_cw_stop
  R      ML_TC_arm_ccw_stop
  R      PN_error_tool_spindle_ok
  R      PN_M4542_pocket_table_not_update
  R      O_TC_arm_to_middle_position
  R      MG_spindle_blow_clean                                        *;EUMACH
;  R      O_spindle_blow_clean                                        *;EUMACH Original PLC
  R      O_TC_arm_turn_cw
  R      O_TC_arm_turn_ccw

  L      K+0
  =      BG_step_toolchange

EM
