/* Chip Conveyor Interval Setup
   -----------------------
*/
CHARSIZE=AUTO;
"\n";
CHARSIZE=MEDIUM;
"CHIP CONV INTERVAL";
CHARSIZE=AUTO;
LINEDIST=LINEDIST-1;

CURSOR=ON;
"\n";
"Setup                : Time           \n";
CURSOR=OFF;
"\n";

"Reset    No/Yes - 0/1:   ";
COLOR= 9;
"%d\n",
$MG_chip_conveyor_reset_interval$/e;
COLOR=11;

"Pause           [min]: ";
COLOR= 9;
"%3.0F min\n",
$WG_interval_pause_time_setup$/n=0/e;
COLOR=11;

"Chip conveyor on  [s]: ";
COLOR= 9;
"%3.0F s\n\n",
$WG_interval_on_time_setup$/n=0/e;
COLOR=11;

CURSOR=ON;
"\n";
"actual               : %s\n",
$O_chip_conveyor$?"ON             ":"Pause          "/c;
CURSOR=OFF;

"\n";
"Pause                : %3.0F min\n",
$WG_interval_pause_time$/n=0/c;
"Chip conveyor on     : %3.0F s\n",
$WG_interval_on$/n=0/c;




