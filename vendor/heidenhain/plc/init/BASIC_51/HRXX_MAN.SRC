LBL axes_end_position

#if Emergency_end_position_axes_coded = &active

*;EUMACH Original PLC
;  L      I_emergency_button_unlocked
;  AN     I_X_not_overtravelled
;  =      I_end_posit_axis_X

;  L      I_X_not_overtravelled
;  AN     I_X_Y_not_overtravelled
;  =      I_end_posit_axis_Y

;  L      I_X_Y_not_overtravelled
;  AN     I_X_Y_Z_not_overtravelled
;  =      I_end_posit_axis_Z
*;EUMACH Original PLC

*;EUMACH
;  L      I_emergency_button_unlocked                                 *;HI4xxx and before
;  AN     I_Z_not_overtravelled                                       *;HI4xxx and before
  LN     I_Z_not_overtravelled                                        *;HI5000 and after
  =      I_end_posit_axis_Z

#if Pallet_changer = &Alternat_table
  L      I_alternat_table_partition_removed
  IFT
    L      I_Z_not_overtravelled
    AN     I_X_Z_not_overtravelled
    =      I_end_posit_axis_X
  ELSE
    LN     I_X_Z_not_overtravelled
    ON     I_X_Z_partition_not_overtravelled
    A      I_Z_not_overtravelled
    =      I_end_posit_axis_X
  ENDI
#else
  L      I_Z_not_overtravelled
  AN     I_X_Z_not_overtravelled
  =      I_end_posit_axis_X
#endif

#if Pallet_changer = &Alternat_table
  L      I_X_Z_partition_not_overtravelled
#else
  L      I_X_Z_not_overtravelled
#endif
  AN     I_X_Y_Z_not_overtravelled
  =      I_end_posit_axis_Y
*;EUMACH

  LN     I_X_Y_Z_4_not_overtravelled
  A      I_X_Y_Z_not_overtravelled
  =      I_end_posit_axis_4

  L      NP_5_end_position_by_proximity_sensor                        *;EUMACH
  IFT                                                                 *;EUMACH
    L      I_5_plus_overtravelled                                 *;EUMACH
    O      I_5_minus_overtravelled                                *;EUMACH
    =      I_end_posit_axis_5                                         *;EUMACH
    =      O_end_posit_axis_5                                         *;EUMACH
  ELSE                                                                *;EUMACH
    LN     I_X_Y_Z_4_5_plus_not_overtravelled                         *;EUMACH
    ON     I_X_Y_Z_4_5_minus_not_overtravelled                        *;EUMACH
    A      I_X_Y_Z_4_not_overtravelled
    =      I_end_posit_axis_5
  ENDI                                                                *;EUMACH

#if MT = &MT_2MV                                                      *;EUMACH
  LN     I_X_Y_Z_4_5_7_not_overtravelled                              *;EUMACH
  A      I_X_Y_Z_4_5_plus_not_overtravelled                           *;EUMACH
  A      I_X_Y_Z_4_5_minus_not_overtravelled                          *;EUMACH
  =      I_end_posit_axis_7                                           *;EUMACH
#endif                                                                *;EUMACH
#endif

*;EUMACH
#if Pallet_changer = &Alternat_table
  L      I_end_posit_axis_X
  IFT
    L      I_alternat_table_partition_removed
    IFT
      L      WG_MP1320_direction_traverse_ref_negative
      BT     KG_axis_X
      IFT
        LN     MG_ref_end_position_X
        =      MG_win_end_position_Xp
        R      ML_X_plus

        L      MG_ref_end_position_X
        =      MG_win_end_position_Xn
        R      ML_X_minus
      ELSE
        L      MG_ref_end_position_X
        =      MG_win_end_position_Xp
        R      ML_X_plus

        LN     MG_ref_end_position_X
        =      MG_win_end_position_Xn
        R      ML_X_minus
      ENDI
    ELSE
      L      WG_MP1320_direction_traverse_ref_negative
      BT     KG_axis_X
      IFT
        LN     MG_ref_end_position_X
        AN     I_X_Z_not_overtravelled
        O[
          LN     MG_machine_in_table_1
          A      I_X_Z_not_overtravelled
          AN     I_X_Z_partition_not_overtravelled
        ]
        =      MG_win_end_position_Xp
        R      ML_X_plus

        L      MG_ref_end_position_X
        AN     I_X_Z_not_overtravelled
        O[
          L      MG_machine_in_table_1
          A      I_X_Z_not_overtravelled
          AN     I_X_Z_partition_not_overtravelled
        ]
        =      MG_win_end_position_Xn
        R      ML_X_minus
      ELSE
        L      MG_ref_end_position_X
        AN     I_X_Z_not_overtravelled
        O[
          LN     MG_machine_in_table_1
          A      I_X_Z_not_overtravelled
          AN     I_X_Z_partition_not_overtravelled
        ]
        =      MG_win_end_position_Xp
        R      ML_X_plus

        LN     MG_ref_end_position_X
        AN     I_X_Z_not_overtravelled
        O[
          L      MG_machine_in_table_1
          A      I_X_Z_not_overtravelled
          AN     I_X_Z_partition_not_overtravelled
        ]
        =      MG_win_end_position_Xn
        R      ML_X_minus
      ENDI
    ENDI
  ENDI
*;EUMACH
#else                                                                 *;EUMACH
  L      I_end_posit_axis_X
  IFT
    L      WG_MP1320_direction_traverse_ref_negative
    BT     KG_axis_X
    IFT
      LN     MG_ref_end_position_X
      =      MG_win_end_position_Xp
      R      ML_X_plus

      L      MG_ref_end_position_X
      =      MG_win_end_position_Xn
      R      ML_X_minus
    ELSE
      L      MG_ref_end_position_X
      =      MG_win_end_position_Xp
      R      ML_X_plus

      LN     MG_ref_end_position_X
      =      MG_win_end_position_Xn
      R      ML_X_minus
    ENDI
  ENDI
#endif                                                                *;EUMACH

  L      I_end_posit_axis_Y
  IFT
    L      WG_MP1320_direction_traverse_ref_negative
    BT     KG_axis_Y
    IFT
#if MT ! &MT_3A                                                       *;EUMACH
      LN     MG_ref_end_position_Y
      =      MG_win_end_position_Yp
      R      ML_Y_plus

      L      MG_ref_end_position_Y
      =      MG_win_end_position_Yn
      R      ML_Y_minus
#else                                                                 *;EUMACH
*;EUMACH
      LN     NP_DCM_option_purchased
      O      MG_automatic_V_H_head_installed
      AN     MG_ref_end_position_Y
      =      MG_win_end_position_Yp
      R      ML_Y_plus

      LN     MG_ref_end_position_Y
      A      NP_DCM_option_purchased
      AN     MG_automatic_V_H_head_installed
      =      MG_win_end_position_Zp
      R      ML_Y_plus

      LN     NP_DCM_option_purchased
      O      MG_automatic_V_H_head_installed
      A      MG_ref_end_position_Y
      =      MG_win_end_position_Yn
      R      ML_Y_minus

      L      MG_ref_end_position_Y
      A      NP_DCM_option_purchased
      AN     MG_automatic_V_H_head_installed
      =      MG_win_end_position_Zn
      R      ML_Y_minus
*;EUMACH
#endif                                                                *;EUMACH
    ELSE
#if MT ! &MT_3A                                                       *;EUMACH
      L      MG_ref_end_position_Y
      =      MG_win_end_position_Yp
      R      ML_Y_plus

      LN     MG_ref_end_position_Y
      =      MG_win_end_position_Yn
      R      ML_Y_minus
#else                                                                 *;EUMACH
*;EUMACH
      LN     NP_DCM_option_purchased
      O      MG_automatic_V_H_head_installed
      A      MG_ref_end_position_Y
      =      MG_win_end_position_Yp
      R      ML_Y_plus

      L      MG_ref_end_position_Y
      A      NP_DCM_option_purchased
      AN     MG_automatic_V_H_head_installed
      =      MG_win_end_position_Zp
      R      ML_Y_plus

      LN     NP_DCM_option_purchased
      O      MG_automatic_V_H_head_installed
      AN     MG_ref_end_position_Y
      =      MG_win_end_position_Yn
      R      ML_Y_minus

      LN     MG_ref_end_position_Y
      A      NP_DCM_option_purchased
      AN     MG_automatic_V_H_head_installed
      =      MG_win_end_position_Zn
      R      ML_Y_minus
*;EUMACH
#endif                                                                *;EUMACH
    ENDI
  ENDI

  L      I_end_posit_axis_Z
  IFT
    L      WG_MP1320_direction_traverse_ref_negative
    BT     KG_axis_Z
    IFT
#if MT ! &MT_3A                                                       *;EUMACH
      LN     MG_ref_end_position_Z
      =      MG_win_end_position_Zp
      R      ML_Z_plus

      L      MG_ref_end_position_Z
      =      MG_win_end_position_Zn
      R      ML_Z_minus
#else                                                                 *;EUMACH
*;EUMACH
      LN     NP_DCM_option_purchased
      O      MG_automatic_V_H_head_installed
      AN     MG_ref_end_position_Z
      =      MG_win_end_position_Zp
      R      ML_Z_plus

      LN     MG_ref_end_position_Z
      A      NP_DCM_option_purchased
      AN     MG_automatic_V_H_head_installed
      =      MG_win_end_position_Yp
      R      ML_Z_plus

      LN     NP_DCM_option_purchased
      O      MG_automatic_V_H_head_installed
      A      MG_ref_end_position_Z
      =      MG_win_end_position_Zn
      R      ML_Z_minus

      L      MG_ref_end_position_Z
      A      NP_DCM_option_purchased
      AN     MG_automatic_V_H_head_installed
      =      MG_win_end_position_Yn
      R      ML_Z_minus
*;EUMACH
#endif                                                                *;EUMACH
    ELSE
#if MT ! &MT_3A                                                       *;EUMACH
      L      MG_ref_end_position_Z
      =      MG_win_end_position_Zp
      R      ML_Z_plus

      LN     MG_ref_end_position_Z
      =      MG_win_end_position_Zn
      R      ML_Z_minus
#else                                                                 *;EUMACH
*;EUMACH
      LN     NP_DCM_option_purchased
      O      MG_automatic_V_H_head_installed
      A      MG_ref_end_position_Z
      =      MG_win_end_position_Zp
      R      ML_Z_plus

      L      MG_ref_end_position_Z
      A      NP_DCM_option_purchased
      AN     MG_automatic_V_H_head_installed
      =      MG_win_end_position_Yp
      R      ML_Z_plus

      LN     NP_DCM_option_purchased
      O      MG_automatic_V_H_head_installed
      AN     MG_ref_end_position_Z
      =      MG_win_end_position_Zn
      R      ML_Z_minus

      LN     MG_ref_end_position_Z
      A      NP_DCM_option_purchased
      AN     MG_automatic_V_H_head_installed
      =      MG_win_end_position_Yn
      R      ML_Z_minus
*;EUMACH
