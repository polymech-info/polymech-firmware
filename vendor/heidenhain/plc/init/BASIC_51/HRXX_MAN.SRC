;----------------------------
LBL axes_keys

  L      I_key_axis_1_plus
  =      ML_X_plus
  L      I_key_axis_2_plus
  =      ML_Y_plus
  L      I_key_axis_3_plus
  =      ML_Z_plus

*;EUMACH
;  L      I_key_axis_4_plus                                           *;EUAMCH Original PLC
;  =      ML_4_plus                                                   *;EUAMCH Original PLC
;  L      I_key_axis_5_plus                                           *;EUAMCH Original PLC
;  =      ML_5_plus                                                   *;EUAMCH Original PLC
;  L      I_key_axis_6_plus                                           *;EUAMCH Original PLC
;  =      ML_6_plus                                                   *;EUAMCH Original PLC

  L      WG_hirth_axes
  BT     KG_axis_4
  A      MG_manual_mode
  A      NP_M4579_incremental_jog_posit_on_softkey
  IFT
    L      I_key_axis_4_plus
    AN     ML_I_key_axis_4_plus
    =      ML_4_plus

    L      I_key_axis_4_plus
    =      ML_I_key_axis_4_plus
  ELSE
    L      I_key_axis_4_plus
    =      ML_4_plus
  ENDI

  LN     NP_magazine_servo_commissioning
  IFT
    L      WG_hirth_axes
    BT     KG_axis_5
    A      MG_manual_mode
    A      NP_M4579_incremental_jog_posit_on_softkey
    IFT
      L      I_key_axis_5_plus
      AN     ML_I_key_axis_5_plus
      =      ML_5_plus

      L      I_key_axis_5_plus
      =      ML_I_key_axis_5_plus
    ELSE
      L      I_key_axis_5_plus
      =      ML_5_plus
    ENDI
  ELSE
    L      MG_marker_zero
    =      ML_5_plus
  ENDI

  L      WG_hirth_axes
  BT     KG_axis_6
  A      MG_manual_mode
  A      NP_M4579_incremental_jog_posit_on_softkey
  IFT
    L      I_key_axis_6_plus
    AN     ML_I_key_axis_6_plus
    =      ML_6_plus

    L      I_key_axis_6_plus
    =      ML_I_key_axis_6_plus
  ELSE
    L      I_key_axis_6_plus
    =      ML_6_plus
  ENDI
*;EUMACH

  L      I_key_axis_7_plus
  =      ML_7_plus

  L      I_key_axis_8_plus
  =      ML_8_plus

;  L      I_key_axis_9_plus                                           *;EUMACH Original PLC
;  =      ML_9_plus                                                   *;EUMACH Original PLC
*;EUMACH
  LN     NP_magazine_servo_commissioning
  IFT
    L      MG_marker_zero
    =      ML_9_plus
  ELSE
    L      I_key_axis_5_plus
    =      ML_9_plus
  ENDI
*;EUMACH

  L      I_key_axis_10_plus
  =      ML_10_plus
  L      I_key_axis_11_plus
  =      ML_11_plus
  L      I_key_axis_12_plus
  =      ML_12_plus
  L      I_key_axis_13_plus
  =      ML_13_plus
  L      I_key_axis_14_plus
  =      ML_14_plus
  L      I_key_axis_15_plus
  =      ML_15_plus
  L      I_key_axis_16_plus
  =      ML_16_plus

  L      I_key_axis_1_minus
  =      ML_X_minus

  L      I_key_axis_2_minus
  =      ML_Y_minus

  L      I_key_axis_3_minus
  =      ML_Z_minus

*;EUMACH
;  L      I_key_axis_4_minus                                          *;EUMACH Original PLC
;  =      ML_4_minus                                                  *;EUMACH Original PLC
;  L      I_key_axis_5_minus                                          *;EUMACH Original PLC
;  =      ML_5_minus                                                  *;EUMACH Original PLC
;  L      I_key_axis_6_minus                                          *;EUMACH Original PLC
;  =      ML_6_minus                                                  *;EUMACH Original PLC

  L      WG_hirth_axes
  BT     KG_axis_4
  A      MG_manual_mode
  A      NP_M4579_incremental_jog_posit_on_softkey
  IFT
    L      I_key_axis_4_minus
    AN     ML_I_key_axis_4_minus
    =      ML_4_minus

    L      I_key_axis_4_minus
    =      ML_I_key_axis_4_minus
  ELSE
    L      I_key_axis_4_minus
    =      ML_4_minus
  ENDI

  LN     NP_magazine_servo_commissioning
  IFT
    L      WG_hirth_axes
    BT     KG_axis_5
    A      MG_manual_mode
    A      NP_M4579_incremental_jog_posit_on_softkey
    IFT
      L      I_key_axis_5_minus
      AN     ML_I_key_axis_5_minus
      =      ML_5_minus

      L      I_key_axis_5_minus
      =      ML_I_key_axis_5_minus
    ELSE
      L      I_key_axis_5_minus
      =      ML_5_minus
    ENDI
  ELSE
    L      MG_marker_zero
    =      ML_5_minus
  ENDI

  L      WG_hirth_axes
  BT     KG_axis_6
  A      MG_manual_mode
  A      NP_M4579_incremental_jog_posit_on_softkey
  IFT
    L      I_key_axis_6_minus
    AN     ML_I_key_axis_6_minus
    =      ML_6_minus

    L      I_key_axis_6_minus
    =      ML_I_key_axis_6_minus
  ELSE
    L      I_key_axis_6_minus
    =      ML_6_minus
  ENDI
*;EUMACH

  L      I_key_axis_7_minus
  =      ML_7_minus

  L      I_key_axis_8_minus
  =      ML_8_minus

;  L      I_key_axis_9_minus                                          *;EUMACH Original PLC
;  =      ML_9_minus                                                  *;EUMACH Original PLC
*;EUMACH
  LN     NP_magazine_servo_commissioning
  IFT
    L      MG_marker_zero
    =      ML_9_minus
  ELSE
    L      I_key_axis_5_minus
    =      ML_9_minus
  ENDI
*;EUMACH
  L      I_key_axis_10_minus
  =      ML_10_minus
  L      I_key_axis_11_minus
  =      ML_11_minus
  L      I_key_axis_12_minus
  =      ML_12_minus
  L      I_key_axis_13_minus
  =      ML_13_minus
  L      I_key_axis_14_minus
  =      ML_14_minus
  L      I_key_axis_15_minus
  =      ML_15_minus
  L      I_key_axis_16_minus
  =      ML_16_minus

  PS     KL_active_axis
  CM     9035
  M_display_module_error(KG_error_module_9035)

  PLW
  =X

  L      I_key_axes_plus
  O      I_HR330_key_plus
  O      MG_soft_key_axes_plus
  S      ML_XYZ45_plus[X]

  L      I_key_axes_minus
  O      I_HR330_key_minus
  O      MG_soft_key_axes_minus
  S      ML_XYZ45_minus[X]

*;EUMACH MB720/TE745
  L      I_key_axis_1_minus
  A      MG_manual_mode
  O      MG_test_lamps
  =      O_lamp_axis_1_minus

  L      I_key_axis_2_minus
  A      MG_manual_mode
  O      MG_test_lamps
  =      O_lamp_axis_2_minus

  L      I_key_axis_3_minus
  A      MG_manual_mode
  O      MG_test_lamps
  =      O_lamp_axis_3_minus

  L      I_key_axis_4_minus
  A      MG_manual_mode
  O      MG_test_lamps
  =      O_lamp_axis_4_minus

  L      I_key_axis_5_minus
  A      MG_manual_mode
  O      MG_test_lamps
  =      O_lamp_axis_5_minus

  L      I_key_axis_6_minus
  A      MG_manual_mode
  O      MG_test_lamps
  =      O_lamp_axis_6_minus

  L      I_key_axis_7_minus
  A      MG_manual_mode
  O      MG_test_lamps
  =      O_lamp_axis_7_minus

  L      I_key_axis_1_plus
  A      MG_manual_mode
  O      MG_test_lamps
  =      O_lamp_axis_1_plus

  L      I_key_axis_2_plus
  A      MG_manual_mode
  O      MG_test_lamps
  =      O_lamp_axis_2_plus

  L      I_key_axis_3_plus
  A      MG_manual_mode
  O      MG_test_lamps
  =      O_lamp_axis_3_plus

  L      I_key_axis_4_plus
  A      MG_manual_mode
  O      MG_test_lamps
  =      O_lamp_axis_4_plus

  L      I_key_axis_5_plus
  A      MG_manual_mode
  O      MG_test_lamps
  =      O_lamp_axis_5_plus

  L      I_key_axis_6_plus
  A      MG_manual_mode
