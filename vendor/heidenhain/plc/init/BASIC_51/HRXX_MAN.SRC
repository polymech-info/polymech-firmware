  =      PN_M4562_axes_keys_memory_function

  LN     I_key_NC_stop
  O      I_key_NC_stop_2_axes_spindle
  O      MG_soft_key_NC_stop
#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B) *;EUMACH
  AN[                                                                 *;EUMACH
    L      MG_M61_alternating_table_1                                 *;EUMACH
    O      MG_M62_alternating_table_2                                 *;EUMACH
    O      MG_enable_alternating_table                                *;EUMACH
    A      MG_manual_mode                                             *;EUMACH
  ]                                                                   *;EUMACH
#endif                                                                *;EUMACH
  =      MG_key_NC_stop

  L      I_key_spindle_M3
  O      MG_soft_key_spindle_M3
*;EUMACH
  A[
    L      NP_M4150_mode_manual
    O      NP_M4151_mode_electronic_handwheel
    O      NP_M4155_mode_pass_over_reference
  ]
*;EUMACH
  =      MG_key_spindle_M3

  L      I_key_spindle_M4
*;EUMACH
  A[
    L      NP_M4150_mode_manual
    O      NP_M4151_mode_electronic_handwheel
    O      NP_M4155_mode_pass_over_reference
  ]
*;EUMACH
  =      MG_key_spindle_M4

  L      I_key_spindle_M5
  O      MG_soft_key_spindle_M5
*;EUMACH
  A[
    L      NP_M4150_mode_manual
    O      NP_M4151_mode_electronic_handwheel
    O      NP_M4155_mode_pass_over_reference
  ]
*;EUMACH
  =      MG_key_spindle_M5

EM

;----------------------------
LBL HR410_handwheel

  L      MG_key_NC_start
  O      MG_manual_mode
  A      I_key_rapid_traverse
*;EUMACH CE 2008
  AN     PN_error_safety_mode_2
#if SFM = &DMx
  AN     MG_safety_mode_4
#endif
*;EUMACH CE 2008
  =      PN_M4561_rapid_traverse

*;EUMACH MB720/TE745
  L      MG_key_NC_start
  O      MG_manual_mode
  A      PN_M4561_rapid_traverse
  O      MG_test_lamps
  =      O_lamp_rapid_traverse
*;EUMACH MB720/TE745

  L      I_key_NC_start
#if Door_lock_safety_confirmation_panel ! &active                     *;EUMACH Safety confirmation
  O      I_HR410_key_NC_start
#else                                                                 *;EUMACH Safety confirmation
  O[                                                                  *;EUMACH Safety confirmation
    L      I_HR410_key_NC_start                                       *;EUMACH Safety confirmation
    A      I_1st_panel_key_switch_in_control                          *;EUMACH Safety confirmation
  ]                                                                   *;EUMACH Safety confirmation
#endif                                                                *;EUMACH Safety confirmation
  O      MG_soft_key_NC_start
  =      MG_key_NC_start

  L      PN_W1046_manual_motion_plus
  O      PN_W1048_manual_motion_minus
  >      K+0
  A      MG_key_NC_start
  AN     PN_error_safety_mode_2                                       *;EUMACH CE 2008
  =      PN_M4562_axes_keys_memory_function

  LN     I_key_NC_stop
  O      I_key_NC_stop_2_axes_spindle
  O      I_HR410_key_NC_stop
  O      MG_soft_key_NC_stop
#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B) *;EUMACH
  AN[                                                                 *;EUMACH
    L      MG_M61_alternating_table_1                                 *;EUMACH
    O      MG_M62_alternating_table_2                                 *;EUMACH
    O      MG_enable_alternating_table                                *;EUMACH
    A      MG_manual_mode                                             *;EUMACH
  ]                                                                   *;EUMACH
#endif                                                                *;EUMACH
  =      MG_key_NC_stop

  L      I_key_spindle_M3
  O      I_HR410_key_spindle_M3
  O      MG_soft_key_spindle_M3
*;EUMACH
  A[
    L      NP_M4150_mode_manual
    O      NP_M4151_mode_electronic_handwheel
    O      NP_M4155_mode_pass_over_reference
  ]
*;EUMACH
  =      MG_key_spindle_M3

  L      I_key_spindle_M4
  O      I_HR410_key_spindle_M4
*;EUMACH
  A[
    L      NP_M4150_mode_manual
    O      NP_M4151_mode_electronic_handwheel
    O      NP_M4155_mode_pass_over_reference
  ]
*;EUMACH
  =      MG_key_spindle_M4

  L      I_key_spindle_M5
  O      I_HR410_key_spindle_M5
  O      MG_soft_key_spindle_M5
*;EUMACH
  A[
    L      NP_M4150_mode_manual
    O      NP_M4151_mode_electronic_handwheel
    O      NP_M4155_mode_pass_over_reference
  ]
*;EUMACH
  =      MG_key_spindle_M5

  L      O_lamp_NC_stop
  =      O_HR410_lamp_NC_stop

  L      O_lamp_NC_start
  =      O_HR410_lamp_NC_start

  L      O_lamp_spindle_M3
  =      O_HR410_lamp_spindle_M3

  L      O_lamp_spindle_M4
  =      O_HR410_lamp_spindle_M4

  L      O_lamp_spindle_M5
  =      O_HR410_lamp_spindle_M5

  L      O_lamp_spindle_start                                         *;EUMACH
  =      O_HR410_lamp_spindle_start                                   *;EUMACH

  L      O_lamp_spindle_stop                                          *;EUMACH
  =      O_HR410_lamp_spindle_stop                                    *;EUMACH

EM

;----------------------------
LBL HR420_handwheel

  L      MG_key_NC_start
  O      MG_manual_mode
  A      I_key_rapid_traverse                                         *;EUMACH
;  A[                                                                 *;EUMACH Original PLC
;    L      I_key_rapid_traverse                                      *;EUMACH Original PLC
;    O      NP_M4663_HR420_key_rapid_traverse                         *;EUMACH Original PLC
;  ]                                                                  *;EUMACH Original PLC
*;EUMACH CE 2008
  AN     PN_error_safety_mode_2
#if SFM = &DMx
  AN     MG_safety_mode_4
#endif
*;EUMACH CE 2008
  =      PN_M4561_rapid_traverse

  L      I_key_NC_start
  O      NP_M4661_HR420_key_NC_start
  O      MG_soft_key_NC_start
  =      MG_key_NC_start

  L      PN_W1046_manual_motion_plus
  O      PN_W1048_manual_motion_minus
  >      K+0
  O      NP_M4666_HR420_key_axis_direction_plus
  O      NP_M4667_HR420_key_axis_direction_minus
  A      MG_key_NC_start
  AN     PN_error_safety_mode_2                                       *;EUMACH CE 2008
  =      PN_M4562_axes_keys_memory_function

  LN     I_key_NC_stop
  O      I_key_NC_stop_2_axes_spindle
  O      NP_M4662_HR420_key_NC_stop
  O      MG_soft_key_NC_stop
#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B) *;EUMACH
  AN[                                                                 *;EUMACH
    L      MG_M61_alternating_table_1                                 *;EUMACH
    O      MG_M62_alternating_table_2                                 *;EUMACH
    O      MG_enable_alternating_table                                *;EUMACH
    A      MG_manual_mode                                             *;EUMACH
  ]                                                                   *;EUMACH
#endif                                                                *;EUMACH
  =      MG_key_NC_stop

  L      I_key_spindle_M3
  O      NP_M4664_HR420_key_spindle_start
  O      MG_soft_key_spindle_M3
*;EUMACH
  A[
    L      NP_M4150_mode_manual
    O      NP_M4151_mode_electronic_handwheel
    O      NP_M4155_mode_pass_over_reference
  ]
*;EUMACH
  =      MG_key_spindle_M3

  L      I_key_spindle_M4
*;EUMACH
  A[
    L      NP_M4150_mode_manual
    O      NP_M4151_mode_electronic_handwheel
    O      NP_M4155_mode_pass_over_reference
  ]
*;EUMACH
  =      MG_key_spindle_M4

  L      I_key_spindle_M5
  O      NP_M4665_HR420_key_spindle_stop
  O      MG_soft_key_spindle_M5
*;EUMACH
  A[
    L      NP_M4150_mode_manual
    O      NP_M4151_mode_electronic_handwheel
    O      NP_M4155_mode_pass_over_reference
  ]
*;EUMACH
  =      MG_key_spindle_M5

*;EUMACH BASIC 54
  L      MG_HW_SK_coolant_M07
  XO     PN_M4041_M07_MK_status
  =      PN_M4041_M07_MK_status

  L      MG_HW_SK_coolant_M08
  XO     PN_M4042_M08_MK_status
  =      PN_M4042_M08_MK_status

;  L      MG_HW_SK_lubrication
;  XO     MG_soft_key_lubrication
;  =      MG_soft_key_lubrication

  L      MG_HW_SK_chip_conveyor
  XO     MG_soft_key_chip_conveyor
  =      MG_soft_key_chip_conveyor

;  L      MG_HW_SK_TC_unclamp
;  A      MG_soft_key_enable_tool_unclamp
;  XO     MG_soft_key_tool_unclamp
;  =      MG_soft_key_tool_unclamp

;  L      MG_HW_SK_TC_release
;  A      MG_soft_key_enable_release_toolchange
;  XO     MG_soft_key_release_toolchange
;  =      MG_soft_key_release_toolchange

;  L      MG_HW_SK_TC_load                                            *;EUMACH Cannot use this
;  XO     MG_soft_key_TC_mag_load_active
;  =      MG_soft_key_TC_mag_load_active
*;EUMACH BASIC 54

EM

;----------------------------
LBL HR5x0_handwheel

  L      MG_key_NC_start
  O      MG_manual_mode
;  A      I_key_rapid_traverse                                         *;EUMACH
  A[                                                                 *;EUMACH Original PLC
    L      I_key_rapid_traverse                                      *;EUMACH Original PLC
