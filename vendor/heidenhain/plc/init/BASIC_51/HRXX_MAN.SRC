  IFT
    L      WG_MP1320_direction_traverse_ref_negative
    BT     KG_axis_7
    IFT
      LN     MG_ref_end_position_7
      =      MG_win_end_position_7p
      R      ML_7_plus

      L      MG_ref_end_position_7
      =      MG_win_end_position_7n
      R      ML_7_minus
    ELSE
      L      MG_ref_end_position_7
      =      MG_win_end_position_7p
      R      ML_7_plus

      LN     MG_ref_end_position_7
      =      MG_win_end_position_7n
      R      ML_7_minus
    ENDI
  ENDI
#endif
*;EUMACH

EM

;----------------------------
LBL axes_manu_posit

  LN     NP_magazine_servo_commissioning                              *;EUMACH
  IFT                                                                 *;EUMACH
    LW     ML_XYZ45_plus
    AN     WG_keys_inhibit
    AN     WG_TC_magazine_axis
    =      PN_W1046_manual_motion_plus

    LW     ML_XYZ45_minus
    AN     WG_keys_inhibit
    AN     WG_TC_magazine_axis
    =      PN_W1048_manual_motion_minus
  ELSE                                                                *;EUMACH
    LW     ML_XYZ45_plus                                              *;EUMACH
    AN     WG_keys_inhibit                                            *;EUMACH
    =      PN_W1046_manual_motion_plus                                *;EUMACH

    LW     ML_XYZ45_minus                                             *;EUMACH
    AN     WG_keys_inhibit                                            *;EUMACH
    =      PN_W1048_manual_motion_minus                               *;EUMACH
  ENDI                                                                *;EUMACH

*;EUMACH CE 2008
  L      PN_error_safety_mode_2
  IFT
    LW     ML_XYZ45_plus
    AN     WG_TC_magazine_axis
    ==     K+0
    A[
      LW     ML_XYZ45_minus
      AN     WG_TC_magazine_axis
      ==     K+0
    ]
    R      ML_2_more_axis_dir_key_been_pressed

    L      PN_W1046_manual_motion_plus
    <<     K+16
    O      PN_W1048_manual_motion_minus
    =      DL_W1046_W1048_manual_motion

    L      K+0
    =      BL_axis_dir_key_pressed

    L      K+0
    =      BL_bit_test

    REPEAT
      L      DL_W1046_W1048_manual_motion
      BT     BL_bit_test
      IFT
       INC     BL_axis_dir_key_pressed
      ENDI

      INC    BL_bit_test

      L      BL_bit_test
      >=     K+32
    UNTILT

    L      BL_axis_dir_key_pressed
    >      K+1
    S      ML_2_more_axis_dir_key_been_pressed

    L      ML_2_more_axis_dir_key_been_pressed
    IFT
      L      K+0
      =      PN_W1046_manual_motion_plus
      =      PN_W1048_manual_motion_minus
    ENDI
  ENDI
*;EUMACH CE 2008

EM

