*-----------------------------------------------------------------------------
*  Axes manual and with handwheel positioning
*-----------------------------------------------------------------------------
*  Module Description
*
*    Axes manual (tip) positioning
*    Jogging (incremental) positioning
*    Memory key (conventional) positioning
*    Rapid traverse
*    Handwheel
*    Machine control panel MB 420 (Ident-Nr. 393757-45)
*
*-----------------------------------------------------------------------------
*-----------------------------------------------------------------------------
*  Handwheel HR 330
*-----------------------------------------------------------------------------
*  Module Description
*    MP 7640: 3
*
*    input and output assignment
*    -----     -----
*      +  I160   -  I161
*    -----     -----
*    -----     -----
*      ~  I162   ~  I162
*    -----     -----
*    The input I162 are only set if plus or minus and the rapid traverse key
*    are operated.
*-----------------------------------------------------------------------------
*-----------------------------------------------------------------------------
*  Handwheel HR 410 (Id-No. 296 469-45)
*-----------------------------------------------------------------------------
*  Module Description
*    MP 7640: 6
*    MP 7645: 0
*
*    input and output assignment
*
*    -----               -----
*      X                  IV
*    -----               -----
*    -----               -----
*      Y                   V
*    -----               -----
*    -----               -----
*      Z                  Ist
*    -----               -----
*    -----     -----     -----
*     F1        F2        F3         Ist: actual nominal transfer
*    -----     -----     -----       F1:  low speed
*    -----               -----       F2:  medium speed
*      -                   +         F3:  high speed
*    -----               -----       F/A: function A - spindle start
*    -----     -----     -----       F/B: function B - NC start
*     F/A O109  F/B O110  F/C O111   F/C: function C - NC stop
*    -----I173 -----I174 -----I175
*-----------------------------------------------------------------------------

#define /s    KL_active_axis                           K+8
#define /s    KL_HR_axis                               K+9
#define /s    KL_handwheel_axis_bitcoded               K+10           *;EUMACH

#define /s    ML_XYZ45_plus                            M[16]
#define /c    ML_X_plus                                M &ML_XYZ45_plus + 0
#define /c    ML_Y_plus                                M &ML_XYZ45_plus + 1
#define /c    ML_Z_plus                                M &ML_XYZ45_plus + 2
#define /c    ML_4_plus                                M &ML_XYZ45_plus + 3
#define /c    ML_5_plus                                M &ML_XYZ45_plus + 4
#define /c    ML_6_plus                                M &ML_XYZ45_plus + 5
#define /c    ML_7_plus                                M &ML_XYZ45_plus + 6
#define /c    ML_8_plus                                M &ML_XYZ45_plus + 7
#define /c    ML_9_plus                                M &ML_XYZ45_plus + 8
#define /c    ML_10_plus                               M &ML_XYZ45_plus + 9
#define /c    ML_11_plus                               M &ML_XYZ45_plus + 10
#define /c    ML_12_plus                               M &ML_XYZ45_plus + 11
#define /c    ML_13_plus                               M &ML_XYZ45_plus + 12
#define /c    ML_14_plus                               M &ML_XYZ45_plus + 13
#define /c    ML_15_plus                               M &ML_XYZ45_plus + 14
#define /c    ML_16_plus                               M &ML_XYZ45_plus + 15

#define /s    ML_XYZ45_minus                           M[16]
#define /c    ML_X_minus                               M &ML_XYZ45_minus + 0
#define /c    ML_Y_minus                               M &ML_XYZ45_minus + 1
#define /c    ML_Z_minus                               M &ML_XYZ45_minus + 2
#define /c    ML_4_minus                               M &ML_XYZ45_minus + 3
#define /c    ML_5_minus                               M &ML_XYZ45_minus + 4
#define /c    ML_6_minus                               M &ML_XYZ45_minus + 5
#define /c    ML_7_minus                               M &ML_XYZ45_minus + 6
#define /c    ML_8_minus                               M &ML_XYZ45_minus + 7
#define /c    ML_9_minus                               M &ML_XYZ45_minus + 8
#define /c    ML_10_minus                              M &ML_XYZ45_minus + 9
#define /c    ML_11_minus                              M &ML_XYZ45_minus + 10
#define /c    ML_12_minus                              M &ML_XYZ45_minus + 11
#define /c    ML_13_minus                              M &ML_XYZ45_minus + 12
#define /c    ML_14_minus                              M &ML_XYZ45_minus + 13
#define /c    ML_15_minus                              M &ML_XYZ45_minus + 14
#define /c    ML_16_minus                              M &ML_XYZ45_minus + 15

#define /s    ML_I_key_axis_4_plus                     M              *;EUMACH
#define /s    ML_I_key_axis_5_plus                     M              *;EUMACH
#define /s    ML_I_key_axis_6_plus                     M              *;EUMACH
#define /s    ML_I_key_axis_4_minus                    M              *;EUMACH
#define /s    ML_I_key_axis_5_minus                    M              *;EUMACH
#define /s    ML_I_key_axis_6_minus                    M              *;EUMACH
#define /s    ML_2_more_axis_dir_key_been_pressed      M              *;EUMACH CE 2008
#define /s    BL_axis_dir_key_pressed                  B              *;EUMACH CE 2008
#define /s    BL_bit_test                              B              *;EUMACH CE 2008

#define /s    DL_W1046_W1048_manual_motion             D              *;EUMACH CE 2008

#include Mac_Lib.inc

GLOBAL Manual_handwheel

;----------------------------
LBL Manual_handwheel
;----------------------------

  LN     MG_machine_parameter_are_read
  EMT

  CASE   BG_MP7640_handwheel_type
    CM     Machine_control_panel       ;0  No HR
    CM     Machine_control_panel       ;1  HR330 all keys evaluated by NC
    CM     Machine_control_panel       ;2  HR130 or HR330
    CM     HR330_Handwheel             ;3  HR330 +,- rapid traverse keys
    CM     Machine_control_panel       ;4  HR332 not available
    CM     Machine_control_panel       ;5  HRA110 HR 150 + HRA110
    CM     HR410_handwheel             ;6  HR410 keys FCT A..C evaluated by PLC
    CM     reserved                    ;7  reserved
    CM     reserved                    ;8  reserved
    CM     reserved                    ;9  reserved
    CM     reserved                    ;10 reserved
    CM     HR420_handwheel             ;11 HR420
    CM     HR5x0_handwheel             ;12 HR550
    CM     HR5x0_handwheel             ;13 HR520
  ENDC

  L      MG_manual_mode
  ON     I_control_operational
  CMT    axes_keys
  CMT    axes_end_position
  CMT    axes_manu_posit

  LN     I_HR4x0_key_permissive_mode
  A      MG_automatic_mode
#if Door_lock_safety_confirmation_panel = &active
  O[
    L      MG_TC_auto_active
    AN     I_key_TC_mag_automatic_control_mode
  ]
#endif
  =      PN_M4576_suppress_handwheel_pulses

*;EUMACH
  PS     KL_handwheel_axis_bitcoded
  CM     9035
  PL     WG_selected_handwheel_axis
  M_display_module_error(KG_error_module_9035)
*;EUMACH

  LN     MG_manu_auto_mode_change
  AN     PN_error_key_for_torque_motor_brake_releasing                *;EUMACH
  EMT

  L      K+0
  =      PN_W1046_manual_motion_plus
  =      PN_W1048_manual_motion_minus

EM

;----------------------------
LBL reserved

  L      MG_marker_one
  S      PN_error_check_machine_parameter
  =      MG_win_MP7640_HR_type_not_supported

  CM     Machine_control_panel

EM

;----------------------------
LBL Machine_control_panel

  L      MG_key_NC_start
  O      MG_manual_mode
  A      I_key_rapid_traverse
*;EUMACH CE 2008
  AN     PN_error_safety_mode_2
#if SFM = &DMx
  AN     MG_safety_mode_4
#endif
*;EUMACH CE 2008
  =      PN_M4561_rapid_traverse

*;EUMACH MB720/TE745
  L      MG_key_NC_start
  O      MG_manual_mode
  A      PN_M4561_rapid_traverse
  O      MG_test_lamps
  =      O_lamp_rapid_traverse
*;EUMACH MB720/TE745

  L      I_key_NC_start
  O      MG_soft_key_NC_start
  =      MG_key_NC_start

  L      PN_W1046_manual_motion_plus
  O      PN_W1048_manual_motion_minus
  >      K+0
  A      MG_key_NC_start
  AN     PN_error_safety_mode_2                                       *;EUMACH CE 2008
  =      PN_M4562_axes_keys_memory_function

  LN     I_key_NC_stop
  O      I_key_NC_stop_2_axes_spindle
  O      MG_soft_key_NC_stop
#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B) *;EUMACH
  AN[                                                                 *;EUMACH
    L      MG_M61_alternating_table_1                                 *;EUMACH
    O      MG_M62_alternating_table_2                                 *;EUMACH
    O      MG_enable_alternating_table                                *;EUMACH
    A      MG_manual_mode                                             *;EUMACH
  ]                                                                   *;EUMACH
#endif                                                                *;EUMACH
  =      MG_key_NC_stop

  L      I_key_spindle_M3
  O      MG_soft_key_spindle_M3
*;EUMACH
  A[
    L      NP_M4150_mode_manual
    O      NP_M4151_mode_electronic_handwheel
    O      NP_M4155_mode_pass_over_reference
  ]
*;EUMACH
  =      MG_key_spindle_M3

  L      I_key_spindle_M4
*;EUMACH
  A[
    L      NP_M4150_mode_manual
    O      NP_M4151_mode_electronic_handwheel
    O      NP_M4155_mode_pass_over_reference
  ]
*;EUMACH
  =      MG_key_spindle_M4

  L      I_key_spindle_M5
  O      MG_soft_key_spindle_M5
*;EUMACH
  A[
    L      NP_M4150_mode_manual
    O      NP_M4151_mode_electronic_handwheel
    O      NP_M4155_mode_pass_over_reference
  ]
*;EUMACH
  =      MG_key_spindle_M5

EM

;----------------------------
LBL HR330_Handwheel

  L      MG_key_NC_start
  O      MG_manual_mode
  A[
    L      I_key_rapid_traverse
    O      I_HR330_key_rapid_traverse
  ]
*;EUMACH CE 2008
  AN     PN_error_safety_mode_2
#if SFM = &DMx
