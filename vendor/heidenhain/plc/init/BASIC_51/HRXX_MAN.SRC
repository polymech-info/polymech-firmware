  =      PN_M4041_M07_MK_status

  L      MG_HW_SK_coolant_M08
  XO     PN_M4042_M08_MK_status
  =      PN_M4042_M08_MK_status

;  L      MG_HW_SK_lubrication
;  XO     MG_soft_key_lubrication
;  =      MG_soft_key_lubrication

  L      MG_HW_SK_chip_conveyor
  XO     MG_soft_key_chip_conveyor
  =      MG_soft_key_chip_conveyor

;  L      MG_HW_SK_TC_unclamp
;  A      MG_soft_key_enable_tool_unclamp
;  XO     MG_soft_key_tool_unclamp
;  =      MG_soft_key_tool_unclamp

