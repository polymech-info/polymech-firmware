;#define       KL_max_M_function_decoded                K+89          *;EUMACH Original PLC

*;EUMACH BASIC 54
#define /s    KL_max_M_func_range_1                    K +89
#define /s    KL_max_M_func_range_2                    K +300
#define /s    KL_max_M_func_range_3                    K +999
*;EUMACH BASIC 54

#define /s    ML_auxiliary_marker_M_pulse              M

GLOBAL M_functions

;----------------------------
LBL M_functions
;----------------------------

  L      PN_M4092_quit_M_function
  R      MG_FN19_date_new

  LN     NP_M4072_strobe_M_function
  R      PN_M4092_quit_M_function

  LN     NP_M4072_strobe_M_function
  AN     ML_auxiliary_marker_M_pulse
  EMT

  L      NP_W260_M_code
  =X
;  >      KL_max_M_function_decoded                                   *;EUMACH Original PLC
*;EUMACH BASIC 54
  >      KL_max_M_func_range_1
  A[
    L      NP_W260_M_code
    <      KL_max_M_func_range_2
  ]
*;EUMACH BASIC 54
  S      PN_error_M_function_not_used
  EMT

*;EUMACH BASIC 54
  L      NP_W260_M_code
  >      KL_max_M_func_range_3
  S      PN_error_M_function_not_used
  EMT
*;EUMACH BASIC 54

*;EUMACH BASIC 54
  L      NP_W260_M_code
  <      KL_max_M_func_range_2
  IFT
*;EUMACH BASIC 54
    L      KF M_func_tab[X]
    =X
*;EUMACH BASIC 54
  ELSE
    L      NP_W260_M_code
    -      KL_max_M_func_range_2
    =X

    L      KF M_func_tab_2[X]
    =X
  ENDI
*;EUMACH BASIC 54

  L      NP_M4072_strobe_M_function
  AN     ML_auxiliary_marker_M_pulse
  =      MG_pulse_M_function

  L      NP_M4072_strobe_M_function
  =      M0[X]
  =      ML_auxiliary_marker_M_pulse

EM

