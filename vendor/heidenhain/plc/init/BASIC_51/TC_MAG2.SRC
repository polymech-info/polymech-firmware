*-----------------------------------------------------------------------------
*  TC Magazine controlled by Pulse Counter
*-----------------------------------------------------------------------------
*  Module Description
*    PLC status (tool table):
*    #Bit 1 (%00000010) - pocket in/out control after TOOL DEF
*                       - (defining in Mag_pocket_out of CONFIG_xx.DEF)
*-----------------------------------------------------------------------------

#define /s    KL_nominal_posit_cw                      K-1000
#define /s    KL_nominal_posit_ccw                     K+1000
#define /s    KL_offset_toolmag_2                      K+70
#define /s    KL_magazine_1                            K+0            *;EUMACH Dual TC

#define /s    ML_diff_lower_equal_half_mag             M
#define /s    ML_nominal_greater_actual_posit          M
#define /s    ML_TC_magazine_cw                        M
#define /s    ML_TC_magazine_counter                   M
#define /s    ML_TC_magazine_exact_position            M
#define /s    ML_TC_magazine_reference                 M
#define /s    ML_TC_magazine_turn_manual_active        M
#define /s    ML_TC_magazine_turn_cw                   M
#define /s    ML_TC_magazine_turn_ccw                  M
#define /s    ML_TC_magazine_referencing               M              *;EUMACH Fixed problem of CALL Modul 9091/9093 after magazine reference in automatic operation

;#define /s    WL_Tool_Def_pocket_number                W             *;EUMACH Original PLC --- standby tool loading/unloading
;#define /s    WL_Tool_Def_tool_number                  W             *;EUMACH Original PLC --- standby tool loading/unloading

EXTERN Absolute

GLOBAL Tool_magazine
GLOBAL TC_mag_cw_turn
GLOBAL TC_mag_ccw_turn

;----------------------------
LBL Tool_magazine
;----------------------------

  LN     MG_TC_auto_active
  ON     MG_TC_magazine_1_active                                      *;EUMACH Dual TC
  EMT

*;EUMACH standby tool loading/unloading
*;Original PLC -> moving to T_SELECT.SRC
;  LN     NP_M4074_strobe_TOOL_DEF
;  R      PN_M4094_quit_TOOL_DEF
*;EUMACH standby tool loading/unloading
*;Original PLC -> moving to T_SELECT.SRC

  L      WG_TC_magazine_actual_2_pocket
  ==     K+0
  S      MG_TC_magazine_reference_necessary

  L      MG_TC_magazine_reference_necessary
  A      MG_control_operational
  AN     MG_TC_help
  =      PN_error_TC_magazine_reference
  IFT
    L      O_TC_magazine_cw
    O      O_TC_magazine_ccw
    A      MG_clock_1_s
    R      PN_error_TC_magazine_reference
  ENDI

  L      I_TC_magazine_reference
  AN     ML_TC_magazine_reference
#if TC_magazine_reference_sensor = &active
  A      MG_TC_magazine_reference_necessary
#endif
  IFT
    L      K+0
    =      WG_act_nom_pocket_difference

    L      K+1
    =      WG_TC_magazine_actual_pocket
    =      WG_TC_magazine_actual_2_pocket
    =      WG_TC_magazine_nominal_pocket
  ENDI

  L      I_TC_magazine_reference
  =      ML_TC_magazine_reference

#if TC_magazine_pulse_counting = &Rising_edge                         *;EUMACH
  L      I_TC_magazine_counter
  AN     ML_TC_magazine_counter
#else                                                                 *;EUMACH
  LN     I_TC_magazine_counter                                        *;EUMACH
  A      ML_TC_magazine_counter                                       *;EUMACH
#endif                                                                *;EUMACH
  A      O_TC_magazine_cw
#if TC_magazine_reference_sensor = &active
  AN     MG_TC_magazine_reference_necessary
#endif
  IFT
    INC    WG_TC_magazine_actual_pocket
    DEC    WG_act_nom_pocket_difference

    L      WG_TC_magazine_actual_pocket
    >      WG_MP7261_TC_magazine_max_pocket
    IFT
      L      K+1
      =      WG_TC_magazine_actual_pocket
    ENDI
  ENDI

#if TC_magazine_pulse_counting = &Rising_edge                         *;EUMACH
  L      I_TC_magazine_counter
  AN     ML_TC_magazine_counter
#else                                                                 *;EUMACH
  LN     I_TC_magazine_counter                                        *;EUMACH
  A      ML_TC_magazine_counter                                       *;EUMACH
#endif                                                                *;EUMACH
  A      O_TC_magazine_ccw
#if TC_magazine_reference_sensor = &active
  AN     MG_TC_magazine_reference_necessary
#endif
  IFT
    DEC    WG_TC_magazine_actual_pocket
    DEC    WG_act_nom_pocket_difference

    L      WG_TC_magazine_actual_pocket
    ==     K+0
    IFT
      L      WG_MP7261_TC_magazine_max_pocket
      =      WG_TC_magazine_actual_pocket
    ENDI
  ENDI

  L      I_TC_magazine_counter
  =      ML_TC_magazine_counter

#if TC_magazine_pulse_counting = &Rising_edge                         *;EUMACH
  L      I_TC_magazine_exact_position
  AN     ML_TC_magazine_exact_position
#else                                                                 *;EUMACH
  LN     I_TC_magazine_exact_position                                 *;EUMACH
  A      ML_TC_magazine_exact_position                                *;EUMACH
#endif                                                                *;EUMACH
  A      O_TC_magazine_cw
#if TC_magazine_reference_sensor = &active
  AN     MG_TC_magazine_reference_necessary
#endif
  IFT
    INC    WG_TC_magazine_actual_2_pocket

    L      WG_TC_magazine_actual_2_pocket
    >      WG_MP7261_TC_magazine_max_pocket
    IFT
      L      K+1
      =      WG_TC_magazine_actual_2_pocket
    ENDI
  ENDI

#if TC_magazine_pulse_counting = &Rising_edge                         *;EUMACH
  L      I_TC_magazine_exact_position
  AN     ML_TC_magazine_exact_position
#else                                                                 *;EUMACH
  LN     I_TC_magazine_exact_position                                 *;EUMACH
  A      ML_TC_magazine_exact_position                                *;EUMACH
#endif                                                                *;EUMACH
  A      O_TC_magazine_ccw
#if TC_magazine_reference_sensor = &active
  AN     MG_TC_magazine_reference_necessary
#endif
  IFT
    DEC    WG_TC_magazine_actual_2_pocket

    L      WG_TC_magazine_actual_2_pocket
    ==     K+0
    IFT
      L      WG_MP7261_TC_magazine_max_pocket
      =      WG_TC_magazine_actual_2_pocket
    ENDI
  ENDI

  L      I_TC_magazine_exact_position
  =      ML_TC_magazine_exact_position

*;EUMACH standby tool loading/unloading
*;Original PLC -> moving to T_SELECT.SRC
;#if TC_quit_while_tool_returning = &active                            *;EUMACH
;*;Without the following PLC, the following situation will occur.
;*;1. TOOL CALL XX
;*;2. TOOL DEF YY  <- Wait until tool on arm unit returing back to magazine pocket.
;*;3. L Xxxx Yxxx Fxxx .....
;  L      NP_M4074_strobe_TOOL_DEF                                     *;EUMACH
;  A      MG_TC_automatic                                              *;EUMACH
;  S      PN_M4094_quit_TOOL_DEF                                       *;EUMACH
;#endif                                                                *;EUMACH

;  L      NP_W268_tool_magazine_number                                 *;EUMACH Dual TC
;  DECW                                                                *;EUMACH Dual TC
;  <=     KL_magazine_1                                                *;EUMACH Dual TC
;  A      NP_M4074_strobe_TOOL_DEF
;  AN     MG_T_mag_interruption
;;  AN     MG_soft_key_TC_mag_load_active                              *;EUMACH
;  AN     MG_TM_started_by_Tool_Def
;  AN     MG_TM_loading_active                                         *;EUMACH
;  A      I_TC_magazine_guard_locked_closed                            *;EUMACH
;  S      MG_TM_started_by_Tool_Def
;  IFT
;    L      NP_W262_tool_pocket_number
;    =      WL_Tool_Def_pocket_number
;    L      NP_W264_tool_number
;    =      WL_Tool_Def_tool_number
;  ENDI
*;EUMACH standby tool loading/unloading
*;Original PLC -> moving to T_SELECT.SRC

  L      MG_marker_one
  S      TS_TC_magazine_exact_position

  LN     MG_TC_magazine_start
  =      TS_TC_magazine_timeout

  LN     O_TC_magazine_lock_pin_out
  AN     I_TC_magazine_lock_pin_in
  =      O_TC_magazine_lock_pin_in

  CASE   BG_step_magazine
    CM     Magazine_start              ;00
    CM     Pocket_put_in               ;01
    CM     Pocket_pos_in               ;02
    CM     Magazine_direct             ;03
    CM     Lock_pin_out                ;04
    CM     Lock_pin_pos_out            ;05
    CM     Magazine_nom_pos            ;06
    CM     Time_exact_stop             ;07
    CM     Lock_pin_pos_in             ;08
    CM     Mag_exact_stop              ;09
    CM     Standby_T_read              ;10
    CM     Pocket_in_out               ;11
    CM     Pocket_posit                ;12
    CM     Magazine_end                ;13
  ENDC

  PLL
  AN     MG_T_mag_interruption
  S      TS_TC_magazine_timeout
  IFT
    INC    BG_step_magazine
  ENDI

  L      MG_TC_magazine_diagnosis
  IFT
    L      KL_offset_toolmag_2
    +      BG_step_magazine
    =X

    L      S#D0[X]
    =      S1
    INCX

    L      S#D0[X]
    =      S2
    INCX

    L      S#D0[X]
    =      S3
  ENDI

*;EUMACH
#if Tool_chain_pin = &active
  LN     I_TC_mag_toolchain_pin_in
  O      I_TC_mag_toolchain_pin_out
  AN     O_TC_mag_tool_chain_pin_out
  AN     MG_TC_magazine_start
  =      PN_error_T_chain_pin_in
#endif
*;EUMACH

  LN     MG_TC_magazine_start
  EMT

  L      MG_key_NC_start_p_pulse
  R      MG_T_mag_interruption

  L      MG_key_NC_start
  O      MG_pulse_CE_key
  S      TS_TC_magazine_timeout

  LN     TS_TC_magazine_timeout
  AN     TR_TC_magazine_timeout
  =      PN_error_TC_magazine_timeout
  R      MG_T_back_to_mag_by_Tool_Call                                *;EUMACH TC AUTO replaced tool returning to magazine pocket
  S      MG_T_mag_interruption

*;EUMACH Original PLC --- When the following PLC is deleted, no magazine stop while NC stop
;  L      MG_pulse_external_stop
;  AN     NP_M4157_mode_restore_position
;  O      MG_key_NC_stop
;  S      MG_T_mag_interruption
*;EUMACH Original PLC

*;EUMACH standby tool loading/unloading
*;Original PLC -> moving to T_SELECT.SRC
;  L      MG_T_mag_interruption
;  O      MG_pulse_END_PGM_M02_M30
;  O      MG_guard_open
;  R      MG_TM_started_by_Tool_Def
*;EUMACH standby tool loading/unloading
*;Original PLC -> moving to T_SELECT.SRC

*;Without modifying the following PLC, the following problem will occur.
*;1. TOOL DEF in MDI/SBK mode, switch from automatic mode to manual mode
*;   -> magazine stops.
*;2. TOOL CALL with magazine rotating in SBK mode, switch from automatic mode
*;   to manual mode -> magazine stops.
*;3. Magazine rotating and internal stop
  L      MG_auto_manu_mode_change
  AN     MG_TC_magazine_start                                         *;EUMACH
;  O      MG_pulse_internal_stop                                      *;EUMACH Original PLC
  O      MG_win_TC_arm_mag_motor_overloaded                           *;EUMACH
  ON     MG_control_operational
  CMT    TC_magazine_reset

EM

;----------------------------
LBL Magazine_start                     ;00

  LN     I_TC_magazine_counter
  ON     I_TC_magazine_exact_position
#if TC_lock_pin = &active                                             *;EUMACH
  ON     I_TC_magazine_lock_pin_in                                    *;EUMACH
#endif                                                                *;EUMACH
  AN     MG_TC_automatic
  S      MG_TC_magazine_reference_necessary

#if TC_magazine_reference_sensor = &active
  L      MG_TC_magazine_reference_necessary
  A      MG_key_NC_start_p_pulse
  A      MG_control_operational
  A      MG_TC_standby_position
  AN     MG_TC_help
  AN     MG_TM_loading_active                                         *;EUMACH
  A      I_TC_magazine_guard_locked_closed                            *;EUMACH
  S      MG_TC_magazine_start
#endif

*;EUMACH standby tool loading/unloading
*;Original PLC -> moving to T_SELECT.SRC
;  L      MG_TM_started_by_Tool_Def
;  A      MG_TC_standby_position
;  AN     MG_TC_automatic
;  O      MG_TM_started_by_Tool_Call
;  S      MG_TC_magazine_start
*;EUMACH standby tool loading/unloading
*;Original PLC -> moving to T_SELECT.SRC

  L      MG_TC_STDT_pocket_by_T_select                                *;EUMACH standby tool loading/unloading
  O      MG_TC_nom_pocket_by_T_select                                 *;EUMACH standby tool loading/unloading
  S      MG_TC_magazine_start

#if TC_magazine_load_position_sensor = &active                        *;EUMACH
  L      MG_TC_magazine_start                                         *;EUMACH
;  A      I_TC_magazine_guard_closed                                  *;EUMACH Original PLC
  A      I_TC_magazine_guard_locked_closed                            *;EUMACH
  AN     MG_TM_loading_active                                         *;EUMACH
  AN     I_TC_mag_load_position_locked                                *;EUMACH
  S      PN_error_TC_mag_load_pos_lock_necessary                      *;EUMACH
#endif                                                                *;EUMACH

  L      MG_TC_magazine_start
#if TC_magazine_load_position_sensor = &active                        *;EUMACH
  A      I_TC_mag_load_position_locked                                *;EUMACH
#endif                                                                *;EUMACH
  AN     MG_error_mag_grp_to_standby_pos                              *;EUMACH
  AN     MG_error_mag_grp_to_in_pos                                   *;EUMACH
  PSL
  EMF

*;EUMACH standby tool loading/unloading
*;Original PLC -> moving to T_SELECT.SRC
;  L      MG_TM_started_by_Tool_Def
;  AN     MG_TM_started_by_Tool_Call
;  R      MG_TM_started_by_Tool_Def
;  IFT
;    L      WL_Tool_Def_pocket_number
;    =      WG_TC_magazine_nominal_pocket
;  ENDI

;  L      MG_TM_started_by_Tool_Call
;  R      MG_TM_started_by_Tool_Call
;  IFT
;    L      WG_TC_pocket_number
;    =      WG_TC_magazine_nominal_pocket
;  ENDI
*;EUMACH standby tool loading/unloading
*;Original PLC -> moving to T_SELECT.SRC

  L      WG_TC_magazine_nominal_pocket
  <=     K+0
  A      MG_automatic_mode
*$WS
  AN     MG_edit_pocket_table
  AN     ML_TC_magazine_turn_manual_active                            *;EUMACH
  IFT
    L      WG_TC_magazine_actual_pocket
    =      WG_TC_magazine_nominal_pocket
  ENDI

#if TC_magazine_reference_sensor = &active
  L      MG_TC_magazine_reference_necessary
  IFT
    L      K-1000
    =      WG_TC_magazine_nominal_pocket
  ENDI
#endif

  L      WG_TC_magazine_actual_pocket
  ==     WG_TC_magazine_nominal_pocket
  IFT
;    L      NP_M4074_strobe_TOOL_DEF                                  *;EUMACH Original PLC --- standby tool loading/unloading
;    S      PN_M4094_quit_TOOL_DEF                                    *;EUMACH Original PLC --- standby tool loading/unloading

    PLL
    A      MG_marker_zero
    PSL

;    LN     NP_M4074_strobe_TOOL_DEF                                  *;EUMACH Original PLC --- standby tool loading/unloading
    L      MG_marker_one                                              *;EUMACH standby tool loading/unloading
    JPT    TC_magazine_reset
  ENDI

EM

*;EUMACH standby tool loading/unloading
*;Original PLC -> moving to T_SELECT.SRC
;----------------------------
;LBL Tool_def_quit                      ;01

;  L      NP_TC_mag_guard_and_panel                                    *;EUMACH
;  A      MG_TM_loading_active                                         *;EUMACH
;  IFT                                                                 *;EUMACH
;    PS     MG_marker_one                                              *;EUMACH
;  ELSE                                                                *;EUMACH
;    L      NP_M4074_strobe_TOOL_DEF
;    S      PN_M4094_quit_TOOL_DEF

;    LN     NP_M4074_strobe_TOOL_DEF
;    AN     MG_T_mag_interruption
;    R      MG_TM_started_by_Tool_Def
;    PSL
;  ENDI                                                                *;EUMACH

;EM
*;EUMACH standby tool loading/unloading
*;Original PLC -> moving to T_SELECT.SRC

;----------------------------
LBL Pocket_put_in                      ;01

#if TC_pocket_90_degree_shift = &active
  L      MG_marker_one
  S      O_TC_pocket_put_in
  R      O_TC_pocket_put_out
  PSL
#else
  PS     MG_marker_one
#endif

EM

;----------------------------
LBL Pocket_pos_out

#if TC_pocket_90_degree_shift = &active
  L      I_TC_pocket_out
  AN     I_TC_pocket_in
  AN     MG_T_mag_interruption
  PSL

  L      MG_T_mag_interruption
  =      MG_win_TC_pocket_put_out
#else
  PS     MG_marker_one
#endif

EM

;----------------------------
LBL Pocket_pos_in                      ;02

#if TC_pocket_90_degree_shift = &active
  LN     I_TC_pocket_out
  A      I_TC_pocket_in
  AN     MG_T_mag_interruption
  PSL

  L      MG_T_mag_interruption
  =      MG_win_TC_pocket_put_in
#else
  PS     MG_marker_one
#endif

EM

;----------------------------
LBL Magazine_direct                    ;03

  PS     MG_marker_one

  L      WG_TC_magazine_actual_pocket
  -      WG_TC_magazine_nominal_pocket
  PSW
  CM     Absolute
  PLW
  =      WG_act_nom_pocket_difference
  <=[
    L      WG_MP7261_TC_magazine_max_pocket
    /      K+2
  ]
  =      ML_diff_lower_equal_half_mag
  IFF
    L      WG_MP7261_TC_magazine_max_pocket
    -      WG_act_nom_pocket_difference
    =      WG_act_nom_pocket_difference

    PS     WG_act_nom_pocket_difference
    CM     Absolute
    PL     WG_act_nom_pocket_difference
  ENDI

  L      WG_TC_magazine_actual_pocket
  >      WG_TC_magazine_nominal_pocket
  =      ML_nominal_greater_actual_posit

  L      ML_diff_lower_equal_half_mag
  XO     ML_nominal_greater_actual_posit
  =      ML_TC_magazine_cw

EM

;----------------------------
LBL Lock_pin_out                       ;04

#if (TC_lock_pin = &active) or (Tool_chain_pin = &active)
#if TC_lock_pin = &active
  L      MG_marker_one
  S      O_TC_magazine_lock_pin_out
  PSL
#endif
#if Tool_chain_pin = &active
  L      MG_marker_one
  S      O_TC_mag_tool_chain_pin_out
  PSL
#endif
#else
  PS     MG_marker_one
#endif

EM

;----------------------------
LBL Lock_pin_pos_out                   ;05

#if (TC_lock_pin = &active) and (Tool_chain_pin = &inactive)          *;EUMACH
  LN     I_TC_magazine_lock_pin_in
  A      I_TC_magazine_lock_pin_out
  AN     MG_T_mag_interruption
  PSL

  L      MG_T_mag_interruption
  =      MG_win_TC_mag_lock_pin_out
#else                                                                 *;EUMACH
*;EUMACH
#if (TC_lock_pin = &inactive) and (Tool_chain_pin = &active)
  LN     I_TC_mag_toolchain_pin_in
  A      I_TC_mag_toolchain_pin_out
  AN     MG_T_mag_interruption
  PSL

  L      MG_T_mag_interruption
  =      MG_win_toolchain_pin_out
#else
#if (TC_lock_pin = &active) and (Tool_chain_pin = &active)
  LN     I_TC_magazine_lock_pin_in
  A      I_TC_magazine_lock_pin_out
  AN     I_TC_mag_toolchain_pin_in
  A      I_TC_mag_toolchain_pin_out
  AN     MG_T_mag_interruption
  PSL

  L      MG_T_mag_interruption
  =      MG_win_TC_mag_lock_pin_out
  =      MG_win_toolchain_pin_out
#else
  PS     MG_marker_one
#endif
#endif
#endif
*;EUMACH

EM

;----------------------------
LBL Magazine_nom_pos                   ;06

  L      MG_TC_magazine_start
  A      ML_TC_magazine_cw
  =      O_TC_magazine_cw

  L      MG_TC_magazine_start
  AN     ML_TC_magazine_cw
  =      O_TC_magazine_ccw

  L      I_TC_magazine_counter
  O      I_TC_magazine_exact_position
;  AN     I_TC_magazine_guard_closed                                  *;EUMACH Original PLC
  AN     I_TC_magazine_guard_locked_closed                            *;EUMACH
;  AN     NP_guard_inactive                                           *;EUMACH
  S      MG_T_mag_interruption

  L      I_TC_magazine_counter
  O      I_TC_magazine_exact_position
  A      MG_T_mag_interruption
  R      O_TC_magazine_cw
  R      O_TC_magazine_ccw

#if TC_lock_pin = &active
  L      I_TC_magazine_lock_pin_in
;  ON     I_TC_magazine_lock_pin_out                                  *;EUMACH Original PLC
  R      O_TC_magazine_cw
  R      O_TC_magazine_ccw
#endif

#if Tool_magazine_system ! &Mag_type_03                               *;EUMACH Lock pin in & magazine CW/CCW stops at the same time
  L      WG_TC_magazine_actual_pocket
  <>     WG_TC_magazine_nominal_pocket
  ON     I_TC_magazine_counter
  ON     I_TC_magazine_exact_position
  =      TS_TC_magazine_stop_delay

  LN     TS_TC_magazine_stop_delay
  AN     TR_TC_magazine_stop_delay
  R      O_TC_magazine_cw
  R      O_TC_magazine_ccw
#if TC_lock_pin = &active
  R      O_TC_magazine_lock_pin_out
#endif
#if Tool_chain_pin = &active
  R      O_TC_mag_tool_chain_pin_out                                  *;EUMACH
#endif
  PSL
#endif                                                                *;EUMACH Lock pin in & magazine CW/CCW stops at the same time

*;EUMACH Lock pin in but magazine CW/CCW still on
#if Tool_magazine_system = &Mag_type_03
  L      WG_TC_magazine_actual_pocket
  <>     WG_TC_magazine_nominal_pocket
  =      TS_TC_magazine_stop_delay

  LN     TS_TC_magazine_stop_delay
  AN     TR_TC_magazine_stop_delay
  R      O_TC_magazine_lock_pin_out

  LN     O_TC_magazine_cw
  AN     O_TC_magazine_ccw
  AN     O_TC_magazine_lock_pin_out
  PSL
#endif
*;EUMACH Lock pin in but magazine CW/CCW still on

#if (MT = &MT_2C)                                                     *;EUMACH
  L      WG_act_nom_pocket_difference                                 *;EUMACH
  >=     K+1                                                          *;EUMACH
#else                                                                 *;EUMACH
  L      WG_act_nom_pocket_difference
  >      K+1                                                          *;EUMACH
#endif                                                                *;EUMACH
  AN     MG_T_mag_interruption
#if TC_lock_pin = &active
  AN     I_TC_magazine_lock_pin_in
  A      I_TC_magazine_lock_pin_out
  A      O_TC_magazine_lock_pin_out
  AN     I_TC_magazine_lock_pin_middle                                *;EUMACH
#endif
  =      O_TC_magazine_rapid_traverse

  L      O_TC_magazine_cw
  O      O_TC_magazine_ccw
  AN     O_TC_magazine_rapid_traverse
*;EUMACH Original PLC
;#if TC_lock_pin = &active
;  AN     I_TC_magazine_lock_pin_in
;  A      I_TC_magazine_lock_pin_out
;  A      O_TC_magazine_lock_pin_out
;#endif
*;EUMACH Original PLC
  =      O_TC_magazine_slow_motion

#if TC_lock_pin = &active
  L      I_TC_magazine_lock_pin_in
  ON     I_TC_magazine_lock_pin_out
  A      O_TC_magazine_lock_pin_out
  A      MG_T_mag_interruption
  =      MG_win_TC_mag_lock_pin_out
#endif

  LN     ML_TC_magazine_turn_manual_active
  A      I_TC_magazine_counter
  A      ML_TC_magazine_turn_cw
  R      ML_TC_magazine_turn_cw
  CMT    Magazine_cw_stop

  LN     ML_TC_magazine_turn_manual_active
  A      I_TC_magazine_counter
  A      ML_TC_magazine_turn_ccw
  R      ML_TC_magazine_turn_ccw
  CMT    Magazine_ccw_stop

  L      MG_marker_one
  R      ML_TC_magazine_turn_manual_active

EM

;----------------------------
LBL Time_exact_stop                    ;07

  L      MG_marker_one
  R      TS_TC_magazine_exact_position

#if Tool_changing_arm = &Single_arm                                   *;EUMACH
  L      NP_mag_motor_with_internal_braking                           *;EUMACH
  IFT                                                                 *;EUMACH
    LN     TR_TC_magazine_exact_position                              *;EUMACH
    PSL                                                               *;EUMACH
  ELSE                                                                *;EUMACH
    LN     TR_TC_magazine_exact_position                              *;EUMACH
    AN     O_TC_magazine_cw_on                                        *;EUMACH
    AN     O_TC_magazine_ccw_on                                       *;EUMACH
    PSL                                                               *;EUMACH
  ENDI                                                                *;EUMACH
#else                                                                 *;EUMACH
  LN     TR_TC_magazine_exact_position
  PSL
#endif                                                                *;EUMACH

EM

;----------------------------
LBL Lock_pin_pos_in                    ;08

#if (TC_lock_pin = &active) and (Tool_chain_pin = &inactive)          *;EUMACH
  L      I_TC_magazine_lock_pin_in
  AN     I_TC_magazine_lock_pin_out
  AN     I_TC_magazine_lock_pin_middle                                *;EUMACH
  AN     MG_T_mag_interruption
  PSL

  L      MG_T_mag_interruption
  =      MG_win_TC_mag_lock_pin_in
#else                                                                 *;EUMACH
*;EUMACH
#if (TC_lock_pin = &inactive) and (Tool_chain_pin = &active)
  L      I_TC_mag_toolchain_pin_in
  AN     I_TC_mag_toolchain_pin_out
  AN     MG_T_mag_interruption
  PSL

  L      MG_T_mag_interruption
  =      MG_win_toolchain_pin_in
#else
#if (TC_lock_pin = &active) and (Tool_chain_pin = &active)
  L      I_TC_magazine_lock_pin_in
  AN     I_TC_magazine_lock_pin_out
  AN     I_TC_magazine_lock_pin_middle
  A      I_TC_mag_toolchain_pin_in
  AN     I_TC_mag_toolchain_pin_out
  AN     MG_T_mag_interruption
  PSL

  L      MG_T_mag_interruption
  =      MG_win_TC_mag_lock_pin_in

  L      MG_T_mag_interruption
  =      MG_win_toolchain_pin_in
#else
  PS     MG_marker_one
#endif
#endif
#endif
*;EUMACH

EM

;----------------------------
LBL Mag_exact_stop                     ;09

  L      ML_TC_magazine_referencing                                   *;EUMACH Fixed problem of CALL Modul 9091/9093 after magazine reference in automatic operation
  R      ML_TC_magazine_referencing                                   *;EUMACH Fixed problem of CALL Modul 9091/9093 after magazine reference in automatic operation

  L      MG_TC_magazine_reference_necessary                           *;EUMACH Fixed problem of CALL Modul 9091/9093 after magazine reference in automatic operation
  S      ML_TC_magazine_referencing                                   *;EUMACH Fixed problem of CALL Modul 9091/9093 after magazine reference in automatic operation

  L      WG_TC_magazine_actual_pocket
  <>     WG_TC_magazine_actual_2_pocket
  ON     I_TC_magazine_counter
  ON     I_TC_magazine_exact_position
  =      MG_TC_magazine_reference_necessary

  PS     MG_marker_one

EM

;----------------------------
LBL Standby_T_read                     ;10

  PS     MG_marker_one

#if TC_pocket_90_degree_shift = &active
  L      MG_automatic_mode
  AN     MG_TC_magazine_reference_necessary
  AN     MG_TM_loading_active                                         *;EUMACH
  AN     ML_TC_magazine_referencing                                   *;EUMACH Fixed problem of CALL Modul 9091/9093 after magazine reference in automatic operation
#if (Tool_magazine_system_2 ! &inactive) or (Tool_changing_arm_2 ! &inactive) *;EUMACH Dual TC
  S      MG_TC1_standby_tool_status_reading                           *;EUMACH Dual TC
#else                                                                 *;EUMACH Dual TC
  S      MG_standby_tool_status_reading                               *;EUMACH magazine standby pocket tool status
#endif                                                                *;EUMACH Dual TC
#endif

EM

;----------------------------
LBL Pocket_in_out                      ;11

#if (Tool_magazine_system_2 ! &inactive) or (Tool_changing_arm_2 ! &inactive) *;EUMACH Dual TC
  LN     MG_TC1_standby_tool_status_reading                           *;EUMACH Dual TC
#else                                                                 *;EUMACH Dual TC
  LN     MG_standby_tool_status_reading                               *;EUMACH magazine standby pocket tool status
#endif                                                                *;EUMACH Dual TC
  PSL
  EMF

#if TC_pocket_90_degree_shift = &active
  L      MG_manual_mode
  O      NP_commissioning
  O      MG_TC_magazine_reference_necessary
  O      MG_TM_loading_active                                         *;EUMACH
  O      ML_TC_magazine_referencing                                   *;EUMACH Fixed problem of CALL Modul 9091/9093 after magazine reference in automatic operation
  EMT

#if (Tool_magazine_system_2 ! &inactive) or (Tool_changing_arm_2 ! &inactive) *;EUMACH Dual TC
  L      BG_TC1_standby_tool_status                                   *;EUMACH Dual TC
#else                                                                 *;EUMACH Dual TC
  L      BG_standby_tool_status
#endif                                                                *;EUMACH Dual TC
  BT     K+1
#if Mag_pocket_out = &active                                          *;EUMACH
  =      MG_tool_oversized
#else                                                                 *;EUMACH
  =N     MG_tool_oversized                                            *;EUMACH
#endif                                                                *;EUMACH

  LN     MG_tool_oversized
  R      O_TC_pocket_put_in
  S      O_TC_pocket_put_out
#endif

EM

;----------------------------
LBL Pocket_posit                       ;12

  L      MG_tool_oversized
  O      MG_manual_mode
  O      NP_commissioning
  O      MG_TC_magazine_reference_necessary
  O      MG_TM_loading_active                                         *;EUMACH
  O      ML_TC_magazine_referencing                                   *;EUMACH Fixed problem of CALL Modul 9091/9093 after magazine reference in automatic operation
  CMT    Pocket_pos_in
  CMF    Pocket_pos_out

EM

;----------------------------
LBL Magazine_end                       ;14

  PS     MG_marker_zero

LBL TC_magazine_reset

  L      MG_marker_one
  R      MG_TC_magazine_start
  R      MG_T_mag_interruption
  R      ML_TC_magazine_turn_manual_active
  R      ML_TC_magazine_turn_ccw
  R      ML_TC_magazine_turn_cw
  R      O_TC_magazine_cw
  R      O_TC_magazine_ccw
  R      O_TC_magazine_rapid_traverse
  R      O_TC_magazine_slow_motion
  R      MG_TC_STDT_pocket_by_T_select                                *;EUMACH standby tool loading/unloading
  R      MG_TC_nom_pocket_by_T_select                                 *;EUMACH standby tool loading/unloading
  R      ML_TC_magazine_referencing                                   *;EUMACH Fixed problem of CALL Modul 9091/9093 after magazine reference in automatic operation

  L      K+0
  =      BG_step_magazine

EM

;----------------------------
LBL TC_mag_cw_turn

#if TC_magazine_reference_sensor = &active
  L      MG_TC_magazine_reference_necessary
  EMT
#endif

  L      MG_T_unload_from_mag_start                                   *;EUMACH standby tool loading/unloading
  O      MG_T_load_to_mag_start                                       *;EUMACH standby tool loading/unloading
  EMT                                                                 *;EUMACH standby tool loading/unloading

  L      MG_manual_mode
  O      MG_edit_pocket_table
  AN     NP_TC_mag_guard_and_panel                                    *;EUMACH
  O[                                                                  *;EUMACH
    LN     I_key_TC_mag_automatic_control_mode                        *;EUMACH
    AN     MG_TC_help                                                 *;EUMACH
    O      MG_TC_help                                                 *;EUMACH
    A      NP_TC_mag_guard_and_panel                                  *;EUMACH
  ]                                                                   *;EUMACH
  =      ML_TC_magazine_turn_manual_active
  S      ML_TC_magazine_turn_cw

  LN     MG_TC_magazine_start
  S      MG_TC_magazine_start
  IFT
    L      KL_nominal_posit_cw
    =      WG_TC_magazine_nominal_pocket
  ENDI

EM

;----------------------------
LBL Magazine_cw_stop

  L      WG_TC_magazine_actual_pocket
  +      K+1
  =      WG_TC_magazine_nominal_pocket

  L      WG_TC_magazine_nominal_pocket
  >      WG_MP7261_TC_magazine_max_pocket
  IFT
    L      K+1
    =      WG_TC_magazine_nominal_pocket
  ENDI

  L      K+1
  =      WG_act_nom_pocket_difference

EM

;----------------------------
LBL TC_mag_ccw_turn

#if TC_magazine_reference_sensor = &active
  L      MG_TC_magazine_reference_necessary
  EMT
#endif

  L      MG_T_unload_from_mag_start                                   *;EUMACH standby tool loading/unloading
  O      MG_T_load_to_mag_start                                       *;EUMACH standby tool loading/unloading
  EMT                                                                 *;EUMACH standby tool loading/unloading

  L      MG_manual_mode
  O      MG_edit_pocket_table
  AN     NP_TC_mag_guard_and_panel                                    *;EUMACH
  O[                                                                  *;EUMACH
    LN     I_key_TC_mag_automatic_control_mode                        *;EUMACH
    AN     MG_TC_help                                                 *;EUMACH
    O      MG_TC_help                                                 *;EUMACH
    A      NP_TC_mag_guard_and_panel                                  *;EUMACH
  ]                                                                   *;EUMACH
  =      ML_TC_magazine_turn_manual_active
  S      ML_TC_magazine_turn_ccw

  LN     MG_TC_magazine_start
  S      MG_TC_magazine_start
  IFT
    L      KL_nominal_posit_ccw
    =      WG_TC_magazine_nominal_pocket
  ENDI

EM

;----------------------------
LBL Magazine_ccw_stop

  L      WG_TC_magazine_actual_pocket
  -      K+1
  =      WG_TC_magazine_nominal_pocket

  L      WG_TC_magazine_nominal_pocket
  ==     K+0
  IFT
    L      WG_MP7261_TC_magazine_max_pocket
    =      WG_TC_magazine_nominal_pocket
  ENDI

  L      K+1
  =      WG_act_nom_pocket_difference

EM
