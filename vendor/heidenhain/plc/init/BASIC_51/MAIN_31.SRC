*-----------------------------------------------------------------------------
*  PLC Basic Program for iTNC 530 and BF150
*-----------------------------------------------------------------------------
*  Contents
*
*  EUMACH
*  VMC series with cam-driven arm (double arm) tool changer
*-----------------------------------------------------------------------------
*  Version / last issue
*
*  51     / 2003-07-26
*
*-----------------------------------------------------------------------------

*-----------------------------------------------------------------------------
*  Definition of Compiler Assignable Memory
*-----------------------------------------------------------------------------

*Volatile marker assignment
* --- M1000...M1089 reserved for standard M-functions (M00 - M89)
* --- M1200...M1299 reserved for package device PLC (BLUM, RENISHAW, etc.)
* --- M1300...M1999 reserved for additional M-functions (M300 - M999)
* --- M2000...M2799 reserved for EUMACH
* --- M2800...M2989 reserved for additional PLC error messages (error 800 - 989)
* --- M4000...M4999 reserved for NC/PLC interface
* --- M4800...M4999 reserved for standard PLC error messages (error 0 - 200)
* --- M5000...M5999 reserved for NC/PLC interface

*Non-volatile marker assignment
* --- M0...M39 reserved for original BASIC program
* --- M40...M99 reserved for EUMACH

#define /mn   7000 9999              *Marker volatile     max. 1000 - 9999
#define /mr   200  999               *Marker non volatile max.    0 -  999 (1)

*Volatile byte/word/double-word assignment
* --- B256...B2047 reserved for NC/PLC interface
* --- B2048...B2299 reserved for original BASIC program
* --- B3000...B3199 reserved for EUMACH

*Non-volatile byte/word/double-word assignment
* --- B0...B39 reserved for original BASIC program
* --- B40...B55 reserved for EUMACH

#define /bn   6000 9999              *Byte volatile       max. 2048 - 9999
#define /br   56   255               *Byte non volatile   max.    0 -  255 (1)

* Legend:
*   (1) - can be modified in oem.cfg

*-----------------------------------------------------------------------------
*  Definition of Global Symbols
*-----------------------------------------------------------------------------

#define /g    System.Def
#define /g    Config_31.Def                                           *;EUMACH
#define /g    ASCIICod.Def
#define /g    GLB_NC.Def
#define /g    Intern.Def
#define /g    GLB_TCMB.Def
#define /g    NC_mig.Def

#if SPG = &inactive
#define /g    GLB_IO_31.Def                                           *;EUMACH
#else
#define /g    GLB_SPG.Def
#endif

#define /g    Soft_key_BMX.def
#define /g    Profibus.Def

*-----------------------------------------------------------------------------
*  Pragma instruction
*-----------------------------------------------------------------------------

#pragma symsort
#pragma nsc
#pragma dl 0

*#pragma srcpath c:\PLC\OemPGM\Standard
*#pragma migtest
*#pragma nsw

