*-----------------------------------------------------------------------------
*  Mainprogram
*-----------------------------------------------------------------------------

  CM     OEM_function_begin

#if Tool_changing_arm ! &inactive
  CM     Output_Restore
#endif

#if Pallet_changer = &2_PC_linear
  CM     PC_output_restore
#endif

  L      NP_M4172_1st_PLC_run_after_power_on
  O      NP_M4173_1st_PLC_run_after_compile
  O      NP_M4174_1st_PLC_run_after_MP_edit
  CMT    Init_after_Reset
  CMT    MP_read

  CM     SPG_simulation_begin
  CM     MP_part_file

*;EUMACH The original MP_read module is before MP_part_file module, so some of
*;       MP statuses don't take care the MP part file setting.  Therefore, it
*;       is necessary to call MP_read module after MP part file has been activated.
  L      MG_MP_read_after_part_files
  R      MG_MP_read_after_part_files
  CMT    MP_read
*;EUMACH

#if Tool_magazine = &PLC_axis
  CM     Status_axis
#endif

  CM     Manual_handwheel
  CM     Library
  CM     Hydraulic
  CM     Diagnostic
  CM     FN19
  CM     M_functions
  CM     IPC_61x0                                                     *;EUMACH

;  CM     Temperature_comp                                            *;EUMACH Original PLC
  CM     Temp_comp1
  CM     Temp_comp_PMC
  CM     Temp_comp2

  CM     PLC_Preset

  CM     Axis_limit
  CM     Guard
  CM     NC_start_stop

#if 3D_head = &active
  CM     3D_head
#endif

*#if 3D_head_exchange = &active
  CM     3D_head_exchange
*#endif

  CM     Ref_End_Position
  CM     Hirth
  CM     NC_Axes
  CM     Index_table

#if Lubrication_axes = &active
  CM     Lubrication
  CM     Lubrication_2                                                *;EUMACH
  CM     Lubrication_3                                                *;EUMACH
  CM     Nut_lubrication                                              *;EUMACH
#endif

  CM     Spindle_gear
  CM     Spindle_reference
  CM     Spindle
  CM     Touch_probe
  CM     Spindle_Orient
  CM     Coolant
  CM     CTS_tank                                                     *;EUMACH
  CM     Chip_conveyor
  CM     TC_manual

#if Tool_changing_arm ! &inactive
  CM     TC_Help
  CM     T_selection                                                  *;EUMACH standby tool loading/unloading
  CM     Tool_magazine
#if Tool_changing_arm_2 ! &inactive                                   *;EUMACH Dual TC
  CM     Tool_magazine_2                                              *;EUMACH Dual TC
#endif                                                                *;EUMACH Dual TC
  CM     TC_mag_loading
#if Tool_magazine_2 ! &inactive                                       *;EUMACH Dual TC
  CM     TC_mag_2_loading                                             *;EUMACH Dual TC
#endif                                                                *;EUMACH Dual TC
  CM     TC_auto
#if TC_shifting_pocket_random_selection = &active                     *;EUMACH Shifting pocket
  CM     Shift_P_to_TC_pos                                            *;EUMACH Shifting pocket
  CM     Shift_P_to_magazine_pos                                      *;EUMACH Shifting pocket
#endif                                                                *;EUMACH Shifting pocket
#endif

  CM     BLUM_LASER                                                   *;EUMACH
  CM     Automatic_door                                               *;EUMACH

  CM     Tool_status

#if Pallet_changer = &Alternat_table
  CM     Alternat_table
#endif

#if Pallet_changer = &2_PC_linear
  CM     PC_help
  CM     Pal_changer
#endif

#if Pallet_changer = &3R_system
  CM     Pal_changer
#endif

  CM     Feed_release
  CM     Work_area_monitor
  CM     PLC_Window

#if Error_messages_additional = &active
  CM     Error
#endif

*#if LSV2_ActiveX_Control = &active
*  CM     LSV2_OCX_Modul_0
*#endif

  CM     Logbook
  CM     SPG_simulation_end

#if Pallet_changer = &2_PC_linear
  CM     PC_output_backup
#endif

#if Tool_changing_arm ! &inactive
  CM     Output_Backup
#endif

  CM     OEM_function_end
  CM     End_PLC_Cycle

EM
