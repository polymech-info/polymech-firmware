/* Temperatur Compensation
   -----------------------
*/
CHARSIZE=AUTO;
"\n";
CHARSIZE=MEDIUM;
"T-COMPENSATION";
CHARSIZE=AUTO;
LINEDIST=LINEDIST-1;
CURSOR=ON;
"\n";
"Compensation        :  %s\n",
$MG_T_compensation_active$?"active          ":"inactive       "/c;
CURSOR=OFF;
"\n";

"Temperature spindle : %+5.1F Degree\n",
$WG_temperature_spindle$/n=1/c         ;

"Temperature machine : %+5.1F Degree\n",
$WG_temperature_machine$/n=1/c         ;
"Offset machine      : %+5.1F Degree\n",
$WG_temperature_machine_offset$/n=1/c  ;
"Temperature table   : %+5.1F Degree\n\n",
$WG_temperature_table$/n=1/c           ;

"X-compensation      :  %+5.4F mm\n",
$WG_W3000_lag_err_comp_X$/n=4/c ;
"Y-compensation      :  %+5.4F mm\n",
$WG_W3002_lag_err_comp_Y$/n=4/c ;
"Z-compensation      :  %+5.4F mm\n\n",
$WG_W3004_lag_err_comp_Z$/n=4/c ;

CURSOR=ON;
"Compensation table  : %s  X   Y   Z  \n",
$MG_T_compensation_on$?"on ":"off"/c     ;
CURSOR=OFF;

"inactive/active-0/1 :      %d   %d   %d\n",
$MG_T_compensation_X_active$/c,
$MG_T_compensation_Y_active$/c,
$MG_T_compensation_Z_active$/c;

"Warming up          :      %d   %d   %d\n",
$MG_warm_up$/c,$MG_warm_up$/c,$MG_warm_up$/c ;

"Cooling down        :      %d   %d   %d\n",
$MG_cool_down$/c,$MG_cool_down$/c,$MG_cool_down$/c ;

"Hysteresis warm up      :  %d   %d   %d\n",
$MG_hyst_X_after_warm_up$/c,
$MG_hyst_Y_after_warm_up$/c,
$MG_hyst_Z_after_warm_up$/c           ;

"Hysteresis cool down    :  %d   %d   %d\n",
$MG_hyst_X_after_cool_down$/c,
$MG_hyst_Y_after_cool_down$/c,
$MG_hyst_Z_after_cool_down$/c           ;

"Curve without hysteresis:  %d   %d   %d\n",
$MG_curve_without_hyst_X$/c,
$MG_curve_without_hyst_Y$/c,
$MG_curve_without_hyst_Z$/c           ;

/*
"Z-Differenz (Probe) : %+5.4F mm\n",
$NP_D280_FN19_1st_value$/n=4/c      ;
*/
