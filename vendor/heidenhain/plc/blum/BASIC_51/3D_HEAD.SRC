  =      BG_step_axis_2_3D_head
#endif

#if KG_3D_head_axis_2 = &axis_14
  L      O_unclamping_14
  =      MG_3D_head_axis_2_output_unclamping

  L      I_unclamped_axis_14
  =      MG_3D_head_axis_2_unclamped

  L      I_clamped_axis_14
  =      MG_3D_head_axis_2_clamped

  L      MG_3D_head_axis_2_service_unclamping
  =      MG_3D_head_unclamp_14

  L      BG_step_axis_14
  =      BG_step_axis_2_3D_head
#endif

#if KG_3D_head_axis_2 = &axis_15
  L      O_unclamping_15
  =      MG_3D_head_axis_2_output_unclamping

  L      I_unclamped_axis_15
  =      MG_3D_head_axis_2_unclamped

  L      I_clamped_axis_15
  =      MG_3D_head_axis_2_clamped

  L      MG_3D_head_axis_2_service_unclamping
  =      MG_3D_head_unclamp_15

  L      BG_step_axis_15
  =      BG_step_axis_2_3D_head
#endif

#if KG_3D_head_axis_2 = &axis_16
  L      O_unclamping_16
  =      MG_3D_head_axis_2_output_unclamping

  L      I_unclamped_axis_16
  =      MG_3D_head_axis_2_unclamped

  L      I_clamped_axis_16
  =      MG_3D_head_axis_2_clamped

  L      MG_3D_head_axis_2_service_unclamping
  =      MG_3D_head_unclamp_16

  L      BG_step_axis_16
  =      BG_step_axis_2_3D_head
#endif

EM

;----------------------------
LBL Save_axis_position

  L      BL_active_3D_head_axis
  =X
  ==     KG_3D_head_axis_1
  IFT
    L      DG_position_axis_X_ref[X]
    =      DG_3D_head_axis_1_position
  ELSE
    L      DG_position_axis_X_ref[X]
    =      DG_3D_head_axis_2_position
  ENDI

#if KG_3D_head_axis_2 ! &inactive
  LN     WG_controlled_axes
  BT     KG_3D_head_axis_2
  IFT
    L      K+0
    =      DG_3D_head_axis_2_position
  ENDI
#endif

EM

#if (MT = &MT_22) or (MT = &MT_25B) or (MT = &MT_2MV) or (MT = &MT_32B) or (MT = &MT_35B) *;EUMACH
;----------------------------
LBL Save_spindle_position

  L      MG_marker_one
  R      ML_selection_head_position

  L      KG_3D_head_axis_1
  =X

  L      WG_hirth_axes
  BTX
  IFT
    L      DG_MP430_hirth_increm_X[X]
    /      K+2
    +      K+3600000
    +      DG_position_axis_X_ref[X]
    /      DG_MP430_hirth_increm_X[X]
    X      DG_MP430_hirth_increm_X[X]
    MOD    K+3600000
    =      DL_3D_head_axis_1_position                                 *;EUMACH
;    =      DG_3D_head_axis_1_S_position                              *;EUMACH Original PLC
  ELSE
    L      DG_position_axis_S_actual
    =      DG_3D_head_axis_1_S_position
    =      DG_3D_head_axis_2_S_position
  ENDI

#if KG_3D_head_axis_2 ! &inactive
  L      KG_3D_head_axis_2
  =X

  L      WG_hirth_axes
  BTX
  IFT
    L      DG_MP430_hirth_increm_X[X]
    /      K+2
    +      K+3600000
    +      DG_position_axis_X_ref[X]
    /      DG_MP430_hirth_increm_X[X]
    X      DG_MP430_hirth_increm_X[X]
    MOD    K+3600000
    =      DL_3D_head_axis_2_position                                 *;EUMACH
;    =      DG_3D_head_axis_2_S_position                              *;EUMACH Original PLC
  ELSE
    L      DG_position_axis_S_actual
    =      DG_3D_head_axis_1_S_position
    =      DG_3D_head_axis_2_S_position
  ENDI
#endif

#if KG_3D_head_axis_2 ! &inactive
  LN     WG_controlled_axes
  BT     KG_3D_head_axis_2
  AN     ML_save_spindle_position                                     *;EUMACH
  IFT
    L      K+0
    =      DG_3D_head_axis_2_S_position
  ENDI
#endif

* If counting direction of the spindle and the head axis do not
* correspond please use minus sign for DG_3D_head_axis_x_S_position.

*;EUMACH
;  L      K+3600000
;  -      DG_3D_head_axis_1_S_position
;  MOD    K+3600000
;  PSW
;  +      NP_MP4230_10_3D_head_offset_axis_1_S_position
;  MOD    K+3600000
;  =      DG_3D_head_axis_1_S_position

;  PLW
;  +      K+3600000
;  +      DG_3D_head_axis_2_S_position
;  +      NP_MP4230_11_3D_head_offset_axis_2_S_position
;  MOD    K+3600000
;  =      DG_3D_head_axis_2_S_position

  L      K+3600000
  -      DL_3D_head_axis_1_position
  MOD    K+3600000
  PSW
  +      NP_MP4230_10_3D_head_offset_axis_1_S_position
  MOD    K+3600000
  =      DG_3D_head_axis_1_S_position

  PLW
  +      K+3600000
  +      DL_3D_head_axis_2_position
  +      NP_MP4230_11_3D_head_offset_axis_2_S_position
  MOD    K+3600000
  =      DG_3D_head_axis_2_S_position
*;EUMACH

*;EUMACH Original PLC
;  L      K+7200000
;  -      DG_3D_head_axis_1_S_position
;  +      DG_3D_head_axis_2_S_position
;  MOD    K+3600000
;  PSW
;  +      NP_MP4230_10_3D_head_offset_axis_1_S_position
;  =      DG_3D_head_axis_1_S_position

;  PLW
;  +      NP_MP4230_11_3D_head_offset_axis_2_S_position
;  =      DG_3D_head_axis_2_S_position
*;EUMACH Original PLC

#if KG_3D_head_axis_2 ! &inactive
  LN     WG_controlled_axes
  BT     KG_3D_head_axis_2
  AN     ML_save_spindle_position                                     *;EUMACH
  IFT
    L      K+0
    =      DG_3D_head_axis_2_S_position
  ENDI
#endif

  L      MG_marker_one                                                *;EUMACH
  R      ML_save_spindle_position                                     *;EUMACH

EM
#endif                                                                *;EUMACH
