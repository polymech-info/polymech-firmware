#define /c    ML_unclamped_axis_9                      M &ML_unclamped_axes + 8
#define /c    ML_unclamped_axis_10                     M &ML_unclamped_axes + 9
#define /c    ML_unclamped_axis_11                     M &ML_unclamped_axes + 10
#define /c    ML_unclamped_axis_12                     M &ML_unclamped_axes + 11
#define /c    ML_unclamped_axis_13                     M &ML_unclamped_axes + 12
#define /c    ML_unclamped_axis_14                     M &ML_unclamped_axes + 13
#define /c    ML_unclamped_axis_15                     M &ML_unclamped_axes + 14
#define /c    ML_unclamped_axis_16                     M &ML_unclamped_axes + 15

#define /s    ML_clamping_mode_on                      M[16]
#define /c    ML_clamping_mode_on_X                    M &ML_clamping_mode_on + 0
#define /c    ML_clamping_mode_on_Y                    M &ML_clamping_mode_on + 1
#define /c    ML_clamping_mode_on_Z                    M &ML_clamping_mode_on + 2
