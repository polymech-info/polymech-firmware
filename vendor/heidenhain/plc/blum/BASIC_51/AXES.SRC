#define /c    ML_clamping_mode_on_8                    M &ML_clamping_mode_on + 7
#define /c    ML_clamping_mode_on_9                    M &ML_clamping_mode_on + 8
#define /c    ML_clamping_mode_on_10                   M &ML_clamping_mode_on + 9
