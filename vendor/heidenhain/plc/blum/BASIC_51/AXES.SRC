#define /c    ML_clamping_mode_off_12                  M &ML_clamping_mode_off + 11
#define /c    ML_clamping_mode_off_13                  M &ML_clamping_mode_off + 12
#define /c    ML_clamping_mode_off_14                  M &ML_clamping_mode_off + 13
#define /c    ML_clamping_mode_off_15                  M &ML_clamping_mode_off + 14
#define /c    ML_clamping_mode_off_16                  M &ML_clamping_mode_off + 15

#define /s    ML_standstill_from_CCU                   M[16]
#define /c    ML_X_standstill_from_CCU                 M &ML_standstill_from_CCU + 0
#define /c    ML_Y_standstill_from_CCU                 M &ML_standstill_from_CCU + 1
#define /c    ML_Z_standstill_from_CCU                 M &ML_standstill_from_CCU + 2
#define /c    ML_4_standstill_from_CCU                 M &ML_standstill_from_CCU + 3
#define /c    ML_5_standstill_from_CCU                 M &ML_standstill_from_CCU + 4
#define /c    ML_6_standstill_from_CCU                 M &ML_standstill_from_CCU + 5
#define /c    ML_7_standstill_from_CCU                 M &ML_standstill_from_CCU + 6
#define /c    ML_8_standstill_from_CCU                 M &ML_standstill_from_CCU + 7
