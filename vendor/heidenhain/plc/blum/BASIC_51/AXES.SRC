*;EUMACH MP12
  L      WG_MP12_simulated_axes
  ==     K+0
  EMT

  L      K+0
  =X

  REPEAT
    L      WG_MP12_simulated_axes
    BTX
    IFT
      L      ML_unclamping[X]
      =      ML_unclamped_axes[X]
      =N     ML_clamped_axes[X]
    ENDI

    INCX

    LX
    >=     KG_max_number_axes
  UNTILT
*;EUMACH MP12

EM

;----------------------------
LBL Clamping_mode

    L      NP_M4075_strobe_transfer_FN19
    RN     ML_FN19_clamping_axes
    RN     ML_FN19_unclamping_axes
    IFT
      L      NP_D280_FN19_1st_value
      /      K+10000
      ==     K+99990
      =      ML_FN19_clamping_axes
      IFT
        L      NP_D284_FN19_2st_value
        /      K+10000
        =      WL_axes_selection_clamping_mode
      ENDI

      L      NP_D280_FN19_1st_value
      /      K+10000
      ==     K+99991
      =      ML_FN19_unclamping_axes
      IFT
        L      NP_D284_FN19_2st_value
        /      K+10000
        =      WL_axes_selection_clamping_mode
      ENDI
    ENDI

    L      MG_M11_unclamping_axes
    O      ML_FN19_unclamping_axes
    IFT
      L      WL_axes_selection_clamping_mode
      W=     ML_clamping_mode_off
    ELSE
      L      K+0
      W=     ML_clamping_mode_off

      L      MG_M44_unclamping_axis_4
      O[
        L      KG_clamping_mode_active                                *;EUMACH
        A      KG_power_on_clamping_mode_off                          *;EUMACH
        BT     KG_axis_4                                              *;EUMACH
        A      MG_M401_feed_enable_axis_4                             *;EUMACH
      ]
      =      ML_clamping_mode_off_4

      L      MG_M45_unclamping_axis_5
#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37B)
      O[                                                              *;EUMACH
        L      KG_clamping_mode_active                                *;EUMACH
        A      KG_power_on_clamping_mode_off                          *;EUMACH
        BT     KG_axis_5                                              *;EUMACH
        A      MG_M501_feed_enable_axis_5                             *;EUMACH
      ]                                                               *;EUMACH
#endif                                                                *;EUMACH
      =      ML_clamping_mode_off_5

      L      MG_M46_unclamping_axis_6
      =      ML_clamping_mode_off_6
    ENDI

    L      MG_M10_clamping_axes
    O      ML_FN19_clamping_axes
    IFT
      L      WL_axes_selection_clamping_mode
      W=     ML_clamping_mode_on
    ELSE
      L      K+0
      W=     ML_clamping_mode_on

      L      MG_M64_clamping_axis_4
      O      MG_M400_feed_disable_axis_4                              *;EUMACH
      =      ML_clamping_mode_on_4

      L      MG_M65_clamping_axis_5
#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37B)
      O      MG_M500_feed_disable_axis_5                              *;EUMACH
#endif                                                                *;EUMACH
      =      ML_clamping_mode_on_5

      L      MG_M66_clamping_axis_6
      =      ML_clamping_mode_on_6
    ENDI

    L      KG_axes_group_1_gantry_or_master_slave
    >      K+0
    IFT
      LW     ML_clamping_mode_on
      A      KG_axes_group_1_gantry_or_master_slave
      >      K+0
      IFT
        L      KG_axes_group_1_gantry_or_master_slave
        W=     ML_clamping_mode_on
      ENDI

      LW     ML_clamping_mode_off
      A      KG_axes_group_1_gantry_or_master_slave
      >      K+0
      IFT
        L      KG_axes_group_1_gantry_or_master_slave
        W=     ML_clamping_mode_off
      ENDI
    ENDI

    L      KG_axes_group_2_gantry_or_master_slave
    >      K+0
    IFT
      LW     ML_clamping_mode_on
      A      KG_axes_group_2_gantry_or_master_slave
      >      K+0
      IFT
        L      KG_axes_group_2_gantry_or_master_slave
        W=     ML_clamping_mode_on
      ENDI

      LW     ML_clamping_mode_off
      A      KG_axes_group_2_gantry_or_master_slave
      >      K+0
      IFT
        L      KG_axes_group_2_gantry_or_master_slave
        W=     ML_clamping_mode_off
      ENDI
    ENDI

    LW     ML_clamping_mode_on
    A      WG_controlled_axes
    A      KG_clamping_mode_active
    W=     ML_clamping_mode_on
    =      WL_clamping_mode_on

    LW     ML_clamping_mode_off
    A      WG_controlled_axes
    A      KG_clamping_mode_active
    W=     ML_clamping_mode_off
    =      WG_clamping_mode_off

    L      WL_clamping_mode_on
    <>     K+0
    IFT
      LN     NP_W1024_axes_release
      A      WL_clamping_mode_on
      ==     WL_clamping_mode_on
      IFT
        L      NP_M4072_strobe_M_function
        S      PN_M4092_quit_M_function

        L      NP_M4075_strobe_transfer_FN19
        S      PN_M4095_quit_transfer_FN19
      ENDI
    ENDI

    L      WG_clamping_mode_off
    <>     K+0
    IFT
      L      NP_W1024_axes_release
      O      WG_MP12_simulated_axes                                   *;EUMACH MP12
      A      WG_clamping_mode_off
      ==     WG_clamping_mode_off
      IFT
        L      NP_M4072_strobe_M_function
        S      PN_M4092_quit_M_function

        L      NP_M4075_strobe_transfer_FN19
        S      PN_M4095_quit_transfer_FN19
      ENDI
    ENDI

    L      NP_M4072_strobe_M_function
    O      NP_M4075_strobe_transfer_FN19
    =      ML_auxiliary_marker_clamping_mode

EM

;----------------------------
LBL Timer_unclamping

    L      TS_unclamping_X[X]
    R      TS_unclamping_X[X]
    IFT
      LX
      +      K&TR_unclamping_X
      PSW
      PS     KL_runtime_from_MP
      CM     9006
      M_display_module_error(KG_error_module_9006)
    ENDI

EM

;----------------------------
LBL Timer_clamping

    L      TS_clamping_X[X]
    R      TS_clamping_X[X]
    IFT
      LX
      +      K&TR_clamping_X
      PSW
      PS     KL_runtime_from_MP
      CM     9006
      M_display_module_error(KG_error_module_9006)
    ENDI

EM

;----------------------------
LBL Timer_timeout_function

    L      TS_clamping_timeout_X[X]
    R      TS_clamping_timeout_X[X]
    IFT
      LX
      +      K&TR_clamping_timeout_X
      PSW
      PS     KL_runtime_from_MP
      CM     9006
      M_display_module_error(KG_error_module_9006)
    ENDI

EM

;----------------------------
LBL Timer_wait

    L      TS_waiting_in_posit_X[X]
    R      TS_waiting_in_posit_X[X]
    IFT
      LX
      +      K&TR_waiting_in_posit_X
      PSW
      PS     KL_runtime_from_MP
      CM     9006
      M_display_module_error(KG_error_module_9006)
    ENDI

EM

;----------------------------
LBL Motion_from_end_position

    LN     I_end_posit_axis_X
    AN     I_end_posit_axis_Y
    AN     I_end_posit_axis_Z
    AN     I_end_posit_axis_4
    AN     I_end_posit_axis_5
#if MT = &MT_2MV                                                      *;EUMACH
    AN     I_end_posit_axis_7                                         *;EUMACH
#endif                                                                *;EUMACH
    AN     O_axes_motion_from_end_position
    EMT

    L      MG_clock_1_s
    O      O_axes_motion_from_end_position
    =      O_lamp_axes_motion_from_end_position

    L      I_key_axes_motion_from_end_position
    S      MG_soft_key_axes_motion_from_end_pos

    L      MG_soft_key_axes_motion_from_end_pos
    S      O_axes_motion_from_end_position

    L      MG_automatic_mode
    O      NP_M4151_mode_electronic_handwheel
    AN     NP_commissioning
    ON     ML_axes_motion_from_end_position
;    ON     I_emergency_button_unlocked                               *;EUMACH HI4xxx and before
    R      MG_soft_key_axes_motion_from_end_pos
    R      O_axes_motion_from_end_position
    R      O_lamp_axes_motion_from_end_position

    L      O_axes_motion_from_end_position
    =      PN_error_axes_motion_from_end_position

    LN     O_axes_motion_from_end_position
    AN     ML_axes_motion_from_end_position
    R      MG_win_end_position_Xp
    R      MG_win_end_position_Xn
    R      MG_win_end_position_Yp
    R      MG_win_end_position_Yn
    R      MG_win_end_position_Zp
    R      MG_win_end_position_Zn
    R      MG_win_end_position_4p
    R      MG_win_end_position_4n
    R      MG_win_end_position_5p
    R      MG_win_end_position_5n

    L      I_end_posit_axis_X
    O      I_end_posit_axis_Y
    O      I_end_posit_axis_Z
    O      I_end_posit_axis_4
    O      I_end_posit_axis_5
#if MT = &MT_2MV                                                      *;EUMACH
    O      I_end_posit_axis_7                                         *;EUMACH
#endif                                                                *;EUMACH
    =      ML_axes_motion_from_end_position

EM

*;EUMACH BASIC 53
;Servo drive release axes group X150/X151

;----------------------------
LBL Servo_release

  L      MG_servo_drive_release_axis_groups_X150_active
  IFT
    PS     KL_servo_drive_release_axis_coded
    CM     9157
    PL     WG_release_axes_X150_X151
    M_display_module_error(KG_error_module_9157)

    PS     KL_servo_drive_release_input_level
    CM     9157
    PL     BL_servo_drive_release_input_level
    M_display_module_error(KG_error_module_9157)

    L      BL_servo_drive_release_input_level
    B=     MG_servo_drive_release_1st_axes_group

    L      WG_release_axes_X150_X151
    BT     KG_spindle
    =      MG_servo_drive_release_spindle

    LN     MG_guard_open
    O      NP_guard_inactive
#if &I_HR4x0_key_permissive_mode < 1000
*;EUMACH CE 2008
#if SFM = &inactive
    O      I_HR4x0_key_permissive_mode
#else
    O[
      L      I_safety_mode_2
      AN     I_safety_mode_4
      A      I_HR4x0_key_permissive_mode
    ]
    O        I_safety_mode_4
#endif
*;EUMACH CE 2008
#endif
#if Light_beam_protection = &active                                   *;EUMACH Safety confirmation
    AN     PN_error_light_beam_blocked                                *;EUMACH Safety confirmation
#endif                                                                *;EUMACH Safety confirmation
#if Door_lock_safety_confirmation_panel = &active                     *;EUMACH Safety confirmation
    AN     PN_error_power_on_safety_confirmation                      *;EUMACH Safety confirmation
#endif                                                                *;EUMACH Safety confirmation
    A      MG_power_delayed_on
    =      ML_servo_drive_1_test

#if Tool_magazine = &PLC_axis                                         *;EUMACH 5XT
    L      I_TC_magazine_guard_locked_closed
    O      NP_guard_inactive
    A      MG_power_delayed_on
    A[                                                                *;EUMACH
      L      WG_controlled_axes                                       *;EUMACH
      BT     KG_Tool_magazine_axis                                    *;EUMACH
    ]                                                                 *;EUMACH
    =      ML_servo_drive_2_test
#else                                                                 *;EUMACH
    L      MG_marker_one                                              *;EUMACH
    S      MG_servo_drive_release_2nd_axes_group                      *;EUMACH
#endif                                                                *;EUMACH 5XT

*;EUMACH 5XT
#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
    L      I_guard_1_closed_locked                                    *;Rotary table (IV axis) in machining area I
    O      NP_guard_inactive
    A      MG_axis_limit_1
    O[
      L      I_guard_1_closed_locked
      A      I_guard_2_closed_locked
      O      NP_guard_inactive
      A      MG_axis_limit_3
    ]
    O[
      L      I_axis_4_key_permissive_mode
      A      MG_axis_limit_2
    ]
;#if SFM = &inactive
;    O      I_axis_4_key_permissive_mode
;#else
;    O[
;      L      I_safety_mode_2
;      AN     I_safety_mode_4
;      A      I_axis_4_key_permissive_mode
;    ]
;    O        I_safety_mode_4
;#endif
    A      MG_power_delayed_on
    A[
      L      WG_controlled_axes
      BT     KG_axis_4
    ]
    AN     MG_enable_alternating_table
    AN     PN_error_alternat_table_separation
    =      ML_servo_drive_3_test

    L      I_guard_2_closed_locked                                    *;Rotary table (V axis) in machining area II
    O      NP_guard_inactive
    A      MG_axis_limit_2
    O[
      L      I_guard_1_closed_locked
      A      I_guard_2_closed_locked
      O      NP_guard_inactive
      A      MG_axis_limit_3
    ]
    O[
      L      I_axis_5_key_permissive_mode
      A      MG_axis_limit_1
    ]
;#if SFM = &inactive
;    O      I_axis_5_key_permissive_mode
;#else
;    O[
;      L      I_safety_mode_2
;      AN     I_safety_mode_4
;      A      I_axis_5_key_permissive_mode
;    ]
;    O        I_safety_mode_4
;#endif
    A      MG_power_delayed_on
    A[
      L      WG_controlled_axes
      BT     KG_axis_5
    ]
    AN     MG_enable_alternating_table
    AN     PN_error_alternat_table_separation
    =      ML_servo_drive_4_test
#endif
*;EUMACH 5XT

    L      ML_servo_drive_1_test
    A      ML_servo_drive_1_has_been_off
    O[                                                                *;EUMACH Before: rising edge of ML_servo_drive_1_test -> TS_servo_drive_releases
      LN     ML_servo_drive_1_test                                    *;EUMACH Now: also falling edge of ML_servo_drive_1_test -> TS_servo_drive_releases
      AN     ML_servo_drive_1_has_been_off                            *;EUMACH
    ]                                                                 *;EUMACH
    O[
      L      ML_servo_drive_2_test
      A      ML_servo_drive_2_has_been_off
    ]
    O[                                                                *;EUMACH Before: rising edge of ML_servo_drive_2_test -> TS_servo_drive_releases
      LN     ML_servo_drive_2_test                                    *;EUMACH Now: also falling edge of ML_servo_drive_2_test -> TS_servo_drive_releases
      AN     ML_servo_drive_2_has_been_off                            *;EUMACH
    ]                                                                 *;EUMACH
    O[                                                                *;EUMACH Rising edge of MG_servo_drive_release_1st_axes_group -> TS_servo_drive_releases
      L      MG_servo_drive_release_1st_axes_group                    *;EUMACH
      A      ML_servo_drive_release_1_has_been_off                    *;EUMACH
    ]                                                                 *;EUMACH
    O[                                                                *;EUMACH Falling edge of MG_servo_drive_release_1st_axes_group -> TS_servo_drive_releases
      LN     MG_servo_drive_release_1st_axes_group                    *;EUMACH
      AN     ML_servo_drive_release_1_has_been_off                    *;EUMACH
    ]                                                                 *;EUMACH
    O[                                                                *;EUMACH Rising edge of MG_servo_drive_release_2nd_axes_group -> TS_servo_drive_releases
      L      MG_servo_drive_release_2nd_axes_group                    *;EUMACH
      A      ML_servo_drive_release_2_has_been_off                    *;EUMACH
    ]                                                                 *;EUMACH
    O[                                                                *;EUMACH Falling edge of MG_servo_drive_release_2nd_axes_group -> TS_servo_drive_releases
      LN     MG_servo_drive_release_2nd_axes_group                    *;EUMACH
      AN     ML_servo_drive_release_2_has_been_off                    *;EUMACH
    ]                                                                 *;EUMACH
*;EUMACH 5XT
#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
    O[
      L      ML_servo_drive_3_test
      A      ML_servo_drive_3_has_been_off
    ]
    O[                                                                *;EUMACH Before: rising edge of ML_servo_drive_3_test -> TS_servo_drive_releases
      LN     ML_servo_drive_3_test                                    *;EUMACH Now: also falling edge of ML_servo_drive_3_test -> TS_servo_drive_releases
      AN     ML_servo_drive_3_has_been_off                            *;EUMACH
    ]                                                                 *;EUMACH
    O[
      L      ML_servo_drive_4_test
      A      ML_servo_drive_4_has_been_off
    ]
    O[                                                                *;EUMACH Before: rising edge of ML_servo_drive_4_test -> TS_servo_drive_releases
      LN     ML_servo_drive_4_test                                    *;EUMACH Now: also falling edge of ML_servo_drive_4_test -> TS_servo_drive_releases
      AN     ML_servo_drive_4_has_been_off                            *;EUMACH
    ]                                                                 *;EUMACH
    O[                                                                *;EUMACH Rising edge of MG_servo_drive_release_3rd_axes_group -> TS_servo_drive_releases
      L      MG_servo_drive_release_3rd_axes_group                    *;EUMACH
      A      ML_servo_drive_release_3_has_been_off                    *;EUMACH
    ]                                                                 *;EUMACH
    O[                                                                *;EUMACH Falling edge of MG_servo_drive_release_3rd_axes_group -> TS_servo_drive_releases
      LN     MG_servo_drive_release_3rd_axes_group                    *;EUMACH
      AN     ML_servo_drive_release_3_has_been_off                    *;EUMACH
    ]                                                                 *;EUMACH
    O[                                                                *;EUMACH Rising edge of MG_servo_drive_release_4th_axes_group -> TS_servo_drive_releases
      L      MG_servo_drive_release_4th_axes_group                    *;EUMACH
      A      ML_servo_drive_release_4_has_been_off                    *;EUMACH
    ]                                                                 *;EUMACH
    O[                                                                *;EUMACH Falling edge of MG_servo_drive_release_4th_axes_group -> TS_servo_drive_releases
      LN     MG_servo_drive_release_4th_axes_group                    *;EUMACH
      AN     ML_servo_drive_release_4_has_been_off                    *;EUMACH
    ]                                                                 *;EUMACH
#endif
*;EUMACH 5XT
    O      MG_pulse_CE_key
    =      TS_servo_drive_releases

    LN     ML_servo_drive_1_test
    =      ML_servo_drive_1_has_been_off

    LN     ML_servo_drive_2_test
    =      ML_servo_drive_2_has_been_off

    LN     MG_servo_drive_release_1st_axes_group                      *;EUMACH
    =      ML_servo_drive_release_1_has_been_off                      *;EUMACH

    LN     MG_servo_drive_release_2nd_axes_group                      *;EUMACH
    =      ML_servo_drive_release_2_has_been_off                      *;EUMACH
*;EUMACH 5XT
#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
    LN     ML_servo_drive_3_test
    =      ML_servo_drive_3_has_been_off

    LN     ML_servo_drive_4_test
    =      ML_servo_drive_4_has_been_off

    LN     MG_servo_drive_release_3rd_axes_group                      *;EUMACH
    =      ML_servo_drive_release_3_has_been_off                      *;EUMACH

    LN     MG_servo_drive_release_4th_axes_group                      *;EUMACH
    =      ML_servo_drive_release_4_has_been_off                      *;EUMACH
#endif
*;EUMACH 5XT
    LN     MG_servo_drive_release_1st_axes_group
    A      ML_servo_drive_1_test
    O[
      LN     MG_servo_drive_release_2nd_axes_group
      A      ML_servo_drive_2_test
    ]
*;EUMACH 5XT
#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
    O[
      LN     MG_servo_drive_release_3rd_axes_group
      A      ML_servo_drive_3_test
    ]
    O[
      LN     MG_servo_drive_release_4th_axes_group
      A      ML_servo_drive_4_test
    ]
#endif
*;EUMACH 5XT
    AN     TS_servo_drive_releases
    AN     TR_servo_drive_releases
    S      PN_error_X15x_servo_drive_release

    L      MG_power_delayed_on
;    AN     I_servo_drive_release                                     *;EUMACH Original PLC
    AN     ML_I_servo_drive_release_1_scan_delay                      *;EUMACH
    S      PN_error_ESB_servo_drive_release

    L      I_servo_drive_release                                      *;EUMACH
    =      ML_I_servo_drive_release_1_scan_delay                      *;EUMACH
  ELSE
    L      MG_marker_one
    S      MG_servo_drive_release_1st_axes_group
    S      MG_servo_drive_release_2nd_axes_group
    S      MG_servo_drive_release_3rd_axes_group
    S      MG_servo_drive_release_4th_axes_group                      *;EUMACH 5XT
    S      MG_servo_drive_release_spindle

    L      MG_guard_open
    AN     NP_guard_inactive
#if &I_HR4x0_key_permissive_mode < 1000
*;EUMACH CE 2008
#if SFM = &inactive
    AN     I_HR4x0_key_permissive_mode
#else
    AN[
      L      I_safety_mode_2
      AN     I_safety_mode_4
      A      I_HR4x0_key_permissive_mode
    ]
#endif
*;EUMACH CE 2008
#endif
    ON     MG_power_delayed_on
    O      PN_error_power_on_safety_confirmation                      *;EUMACH Safety confirmation
    =      TS_servo_drive_releases

    LN     I_servo_drive_release
    AN     TS_servo_drive_releases
    AN     TR_servo_drive_releases
    S      PN_error_ESB_servo_drive_release
  ENDI

EM
