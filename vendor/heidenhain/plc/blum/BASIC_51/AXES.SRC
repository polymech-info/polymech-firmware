#define /c    ML_clamped_axis_16                       M &ML_clamped_axes + 15

#define /s    ML_unclamped_axes                        M[16]
#define /c    ML_unclamped_axis_X                      M &ML_unclamped_axes + 0
#define /c    ML_unclamped_axis_Y                      M &ML_unclamped_axes + 1
#define /c    ML_unclamped_axis_Z                      M &ML_unclamped_axes + 2
