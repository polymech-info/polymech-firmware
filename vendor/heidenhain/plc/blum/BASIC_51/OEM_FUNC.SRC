  ENDI

  L      BG_KINEMATICS_assignment
  ==     KL_C2_configuration
  IFT
    PS      KL_C2_KINEMATICS
    PS      K+0
    CM      9097
    M_display_module_error(KG_error_module_9097)
  ENDI

  L      BG_KINEMATICS_assignment
  ==     KL_A1_C2_configuration
  A      MG_axis_limit_1
  IFT
    PS     KL_PLCC2_A1_KINEMATICS
    PS     K+0
    CM     9097
    M_display_module_error(KG_error_module_9097)
  ENDI

  L      BG_KINEMATICS_assignment
  ==     KL_C1_C2_configuration
  A      MG_axis_limit_1
  IFT
    PS     KL_PLCC2_C1_KINEMATICS
    PS     K+0
    CM     9097
    M_display_module_error(KG_error_module_9097)
  ENDI

  L      BG_KINEMATICS_assignment
  ==     KL_A1_C2_configuration
  A      MG_axis_limit_2
  IFT
    PS      KL_PLCA1_C2_KINEMATICS
    PS      K+0
    CM      9097
    M_display_module_error(KG_error_module_9097)
  ENDI

  L      BG_KINEMATICS_assignment
  ==     KL_C1_C2_configuration
  A      MG_axis_limit_2
  IFT
    PS      KL_PLCC1_C2_KINEMATICS
    PS      K+0
    CM      9097
    M_display_module_error(KG_error_module_9097)
  ENDI

  L      BG_KINEMATICS_assignment
  ==     KL_A1_configuration
  IFT
    PS      KL_A1_KINEMATICS
    PS      K+0
    CM      9097
    M_display_module_error(KG_error_module_9097)
  ENDI

  L      BG_KINEMATICS_assignment
  ==     KL_C1_configuration
  IFT
    PS      KL_C1_KINEMATICS
    PS      K+0
    CM      9097
    M_display_module_error(KG_error_module_9097)
  ENDI
#endif

  L      MG_marker_one
  R      ML_KINEMATICS_request

EM

