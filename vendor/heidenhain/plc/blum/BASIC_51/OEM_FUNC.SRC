LBL ATC_door

#if (MT = &MT_12) or (MT = &MT_13) or (MT = &MT_15) or (MT = &MT_15A) or (MT = &MT_16) or (MT = &MT_17)
  L      MG_M390_ATC_door_closing
  A      O_ATC_door_closing
  A      I_ATC_door_closed
  AN     I_ATC_door_open
#if TLM_protected_by_ATC_door = &active
  A[
    L      MG_axis_limit_1
    AN     PN_M4135_strobe_axes_limit
    ON     MG_NP_BLUM_CYCLE_ACTIVE
  ]
#endif
  O[
    L      MG_M391_ATC_door_opening
    A      O_ATC_door_opening
    AN     I_ATC_door_closed
    A      I_ATC_door_open
#if TLM_protected_by_ATC_door = &active
    A[
      L      MG_axis_limit_3
      AN     PN_M4135_strobe_axes_limit
      ON     MG_NP_BLUM_CYCLE_ACTIVE
    ]
#endif
  ]
  S      PN_M4092_quit_M_function

  L      MG_M390_ATC_door_closing
#if MT = &MT_12
  AN     I_machine_in_TC_area
#endif
#if (MT = &MT_13) or (MT = &MT_15) or (MT = &MT_15A) or (MT = &MT_16) or (MT = &MT_17)
  AN     I_TC_magazine_in_spindle_position
  A      I_TC_magazine_in_basic_position
  AN     I_machine_in_TC_area
#endif
  A      I_servo_drive_release
  A      MG_servo_drive_release_1st_axes_group
  R      O_ATC_door_opening
  S      O_ATC_door_closing

#if (MT = &MT_13) or (MT = &MT_15) or (MT = &MT_15A) or (MT = &MT_16) or (MT = &MT_17)
  L      I_TC_magazine_in_spindle_position
  ON     I_TC_magazine_in_basic_position
#endif
  A      MG_M390_ATC_door_closing
  =      MG_win_TC_magazine_to_basic_position

  L      I_machine_in_TC_area
  A      MG_M390_ATC_door_closing
  S      MG_win_machine_out_of_TC_area

  L      MG_M391_ATC_door_opening
  A      I_servo_drive_release
  A      MG_servo_drive_release_1st_axes_group
  S      O_ATC_door_opening
  R      O_ATC_door_closing
#endif

#if (MT = &MT_21) or (MT = &MT_32) or (MT = &MT_32A) or (MT = &MT_32B)
  L      MG_M390_ATC_door_closing
  A      O_ATC_door_closing
  A      I_ATC_door_closed
  AN     I_ATC_door_open
#if TLM_protected_by_ATC_door = &active
  A      MG_axis_limit_1
  AN     PN_M4135_strobe_axes_limit
#endif
  O[
    L      MG_M391_ATC_door_opening
    A      O_ATC_door_opening
    AN     I_ATC_door_closed
    A      I_ATC_door_open
#if TLM_protected_by_ATC_door = &active
    A      MG_axis_limit_3
    AN     PN_M4135_strobe_axes_limit
#endif
  ]
  S      PN_M4092_quit_M_function

  L      MG_M390_ATC_door_closing
#if (MT = &MT_21)
  A[
    L      I_TC_arm_basic_pos
    O      I_TC_arm_magazine_pos
  ]
  AN     I_TC_arm_spindle_pos
  AN     I_machine_in_TC_area
#endif
#if (MT = &MT_32) or (MT = &MT_32A) or (MT = &MT_32B)
  A      I_TC_arm_basic_pos
  AN     I_TC_arm_spindle_pos
  A      I_TC_arm_brake_pos
  AN     I_machine_in_TC_area
#endif
  A      I_servo_drive_release
  A      MG_servo_drive_release_1st_axes_group
  R      O_ATC_door_opening
  S      O_ATC_door_closing

#if (MT = &MT_21)
  LN     I_TC_arm_basic_pos
  AN     I_TC_arm_magazine_pos
  O      I_TC_arm_spindle_pos
  A      MG_M390_ATC_door_closing
  =      MG_win_TC_magazine_to_basic_position
#endif

#if (MT = &MT_32) or (MT = &MT_32A) or (MT = &MT_32B)
  LN     I_TC_arm_basic_pos
  O      I_TC_arm_spindle_pos
  ON     I_TC_arm_brake_pos
  A      MG_M390_ATC_door_closing
  =      MG_win_TC_arm_standby
#endif

  L      I_machine_in_TC_area
  A      MG_M390_ATC_door_closing
  S      MG_win_machine_out_of_TC_area

  L      MG_M391_ATC_door_opening
  A      I_servo_drive_release
  A      MG_servo_drive_release_1st_axes_group
  S      O_ATC_door_opening
  R      O_ATC_door_closing
#endif

EM

;----------------------------
LBL Coolant_chip_flush

  L      MG_M15_coolant_chip_flush_on
  O      MG_M25_coolant_chip_flush_off
  S      PN_M4092_quit_M_function

  L      MG_M15_coolant_chip_flush_on
  S      MG_soft_key_coolant_chip_flush

  L      MG_M25_coolant_chip_flush_off
  O      MG_pulse_END_PGM_M02_M30
  O      MG_M09_coolant_off
  O      MG_auto_manu_mode_change
  O      MG_win_chip_conveyor_motor_overloaded
*;EUMACH CE 2008
#if SFM = &Standard
  O[
    L      PN_error_safety_mode_2
    ON     MG_NC_program_operating                                    *;EUMACH CE Sep 06 2008
    A      PN_error_guard_open
  ]
#endif
#if SFM = &DMx
  O      PN_error_safety_mode_2
  O      MG_safety_mode_4
#endif
*;EUMACH CE 2008
  ON     MG_control_operational
  R      MG_soft_key_coolant_chip_flush

  L      NP_chip_flush_intermittent_control
  IFT
    L      MG_soft_key_coolant_chip_flush
    A      I_servo_drive_release
    A      MG_servo_drive_release_1st_axes_group
    AN     PN_error_coolant_level_low
    AN     MG_guard_open_operation_hold                               *;EUMACH CE Sep 06 2008
    =      ML_chip_flush_intermittent_control_on

    L      MG_soft_key_coolant_chip_flush
    AN     ML_soft_key_coolant_chip_flush
    =      ML_soft_key_chip_flush_p_pulse

    L      MG_soft_key_coolant_chip_flush
    =      ML_soft_key_coolant_chip_flush

    L      ML_soft_key_chip_flush_p_pulse
    O      ML_CR_chip_flush_off_n_pulse
    =      CS_chip_flush_on_duration

    L      ML_chip_flush_intermittent_control_on
    =      CD_chip_flush_on_duration

    L      CR_chip_flush_on_duration
    A      CD_chip_flush_on_duration
    AN     CR_chip_flush_off_duration
    =      O_coolant_chip_flush_on

    LN     CR_chip_flush_on_duration
    A      ML_CR_chip_flush_on_duration
    =      ML_CR_chip_flush_on_n_pulse

    L      CR_chip_flush_on_duration
    =      ML_CR_chip_flush_on_duration

    L      ML_CR_chip_flush_on_n_pulse
    =      CS_chip_flush_off_duration

    LN     O_coolant_chip_flush_on
    =      CD_chip_flush_off_duration

    LN     CR_chip_flush_off_duration
    A      ML_CR_chip_flush_off_duration
    =      ML_CR_chip_flush_off_n_pulse

    L      CR_chip_flush_off_duration
    =      ML_CR_chip_flush_off_duration
  ELSE
    L      MG_soft_key_coolant_chip_flush
    A      I_servo_drive_release
    A      MG_servo_drive_release_1st_axes_group
    AN     PN_error_coolant_level_low
    AN     MG_guard_open_operation_hold                               *;EUMACH CE Sep 06 2008
    =      O_coolant_chip_flush_on
  ENDI

EM

;----------------------------
LBL Pneumatic_chip_flush

  LN     NP_pneumatic_chip_flush_active
  R      O_pneumatic_chip_flush_on
  EMT

#if 3D_head = &active
  L      NP_W1032_reference_nesessary
  BT     KG_axis_Y
  AN[                                                                 *;EUMACH MP1352
    L      WG_MP1352_power_off_pos_saved                              *;EUMACH MP1352
    BT     KG_axis_Y                                                  *;EUMACH MP1352
  ]                                                                   *;EUMACH MP1352
  A[
    L      NP_MP4231_10_3D_head_axis_1_motion_Yp_limit
    +      DG_MP1030_pos_window_Y
    <      DG_position_axis_Y_ref_accumulator
  ]
  O[
    LN     NP_W1032_reference_nesessary
    BT     KG_axis_Y
    O[                                                                *;EUMACH MP1352
      L      WG_MP1352_power_off_pos_saved                            *;EUMACH MP1352
      BT     KG_axis_Y                                                *;EUMACH MP1352
    ]                                                                 *;EUMACH MP1352
    A[
      L      NP_MP4231_10_3D_head_axis_1_motion_Yp_limit
      +      DG_MP1030_pos_window_Y
      <      DG_position_axis_Y_ref
    ]
  ]
;  A      I_servo_drive_release
;  A      MG_servo_drive_release_1st_axes_group
  AN     MG_guard_open                                                *;CE 2008
  S      O_pneumatic_chip_flush_on

  L      NP_W1032_reference_nesessary
  BT     KG_axis_Y
  AN[                                                                 *;EUMACH MP1352
    L      WG_MP1352_power_off_pos_saved                              *;EUMACH MP1352
    BT     KG_axis_Y                                                  *;EUMACH MP1352
  ]                                                                   *;EUMACH MP1352
  A[
    L      NP_MP4231_10_3D_head_axis_1_motion_Yp_limit
    -      DG_MP1030_pos_window_Y
    >      DG_position_axis_Y_ref_accumulator
  ]
  O[
    LN     NP_W1032_reference_nesessary
    BT     KG_axis_Y
    O[                                                                *;EUMACH MP1352
      L      WG_MP1352_power_off_pos_saved                            *;EUMACH MP1352
      BT     KG_axis_Y                                                *;EUMACH MP1352
    ]                                                                 *;EUMACH MP1352
    A[
      L      NP_MP4231_10_3D_head_axis_1_motion_Yp_limit
      -      DG_MP1030_pos_window_Y
      >      DG_position_axis_Y_ref
    ]
  ]
  R      O_pneumatic_chip_flush_on
#else
  L      NP_W1028_axes_in_motion
  BT     KG_axis_X
  O[
    L      NP_W1028_axes_in_motion
    BT     KG_axis_Y
  ]
  O[
    L      NP_W1028_axes_in_motion
    BT     KG_axis_Z
  ]
  O[
    L      NP_W1028_axes_in_motion
    BT     KG_axis_4
  ]
  O[
    L      NP_W1028_axes_in_motion
    BT     KG_axis_5
  ]
;  A      I_servo_drive_release
;  A      MG_servo_drive_release_1st_axes_group
  AN     MG_guard_open                                                *;CE 2008
  =      TS_pneumatic_chip_flush

  L      TR_pneumatic_chip_flush
  AN     MG_guard_open
  =      O_pneumatic_chip_flush_on
#endif

EM

;----------------------------
LBL Coolant_water_gun

  L      MG_M16_coolant_water_gun_active
  O      MG_M26_coolant_water_gun_inactive
  S      PN_M4092_quit_M_function

  L      MG_M16_coolant_water_gun_active
  S      MG_soft_key_coolant_water_gun

  L      MG_M26_coolant_water_gun_inactive
  R      MG_soft_key_coolant_water_gun

  LN     NP_independent_water_gun_motor
  ON     MG_win_coolant_motor_overloaded
  A      MG_soft_key_coolant_water_gun
  A[
    LN     I_guard_1_closed
    ON     I_guard_2_closed
    O      NP_guard_inactive
  ]
  AN     PN_error_coolant_level_low
  =      O_coolant_water_gun_on

EM

