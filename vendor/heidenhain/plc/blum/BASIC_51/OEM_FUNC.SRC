;----------------------------
LBL Debug_processing

  LN     ML_debug_processed
  IFT
    L      NP_D276_code_number_entered_via_MOD
    -[
      L      KL_debug_processing
      X      K+1000
    ]
    =      DL_debug_processing

    L      DL_debug_processing
    <      K+1000
    A[
      L      DL_debug_processing
      >      K+0
    ]
    S      ML_debug_processing
    IFT
      L      DL_debug_processing
      =      DL_debug_processed

      L      K+0
      =      DL_debug_duration
      =      NP_D276_code_number_entered_via_MOD
    ENDI
  ENDI

  L      ML_debug_processing
  IFT
    L      MG_pulse_1_s
    AN     ML_debug_processed
    IFT
      INC    DL_debug_duration
    ENDI

    L      DL_debug_processed
    X      K+86400
    <      DL_debug_duration
    S      ML_debug_processed
  ENDI

  L      ML_debug_processed
  IFT
    PS     KL_debug_message
    CM     9085

    LN     NP_M4176_control_in_operation_on_or_flashes
    R      PN_M4560_NC_stop_0_active
  ENDI

  L      DG_position_axis_Y_ref
  /      K+10
  +      K+6883790
  /      K+10
  X      K+2
  +      K+7215
  ==     NP_D276_code_number_entered_via_MOD
  A      ML_debug_processing
  R      ML_debug_processing
  R      ML_debug_processed
  IFT
    L      K+0
    =      DL_debug_processed
    =      DL_debug_duration
    =      NP_D276_code_number_entered_via_MOD

    PS     KL_debugged_message
    CM     9085
  ENDI
EM

