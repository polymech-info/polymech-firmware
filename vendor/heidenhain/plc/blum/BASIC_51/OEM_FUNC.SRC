  O      MG_axis_limit_3
  A      O_coolant_chip_flush_on
  =      O_area2_coolant_chip_flush_on
#endif

 *;O_coolant_chip_flush_motor
  L      O_coolant_chip_flush_on
  O[
    L      O_coolant_water_gun_on
    AN     NP_independent_water_gun_motor
    A      NP_water_gun_solenoid_on_chip_flush_motor
  ]
  =      O_coolant_chip_flush_motor

#if (Head = &S_head_type_01) or (Head = &S_head_type_02)
 *;O_V_H_head_clamping, O_V_H_head_unclamping
  L      O_V_H_head_clamping
  O      I_V_H_head_clamped
  ON     I_V_H_head_unclamped
  =      TS_V_H_head_unclamping

  LN     TS_V_H_head_unclamping
  AN     TR_V_H_head_unclamping
  A      O_V_H_head_unclamping
  R      O_V_H_head_unclamping

  L      NP_M4172_1st_PLC_run_after_power_on
  O      NP_M4173_1st_PLC_run_after_compile
  AN     I_spindle_without_3D_head
  A      I_V_H_head_clamped
  AN     I_V_H_head_unclamped
  S      O_V_H_head_clamping
  R      O_V_H_head_unclamping
#endif

 *;O_S_blow_clean, O_CTS_blow_clean
  L      NP_S_and_CTS_blow_clean_valve_separated
  IFT
    L      MG_spindle_blow_clean
    =      O_spindle_blow_clean                                       ;HSK taper tool change air blow (not from spindle center)

    L      MG_S_blow_clean_after_CTS
    O      MG_air_through_S_on
    =      O_CTS_blow_clean                                           ;Air through spindle center

    LN     O_CTS_blow_clean
    A      ML_O_CTS_blow_clean
    =      MG_O_CTS_blow_clean_n_pulse

    L      O_CTS_blow_clean
    =      ML_O_CTS_blow_clean
  ELSE
    L      MG_spindle_blow_clean
    O      MG_S_blow_clean_after_CTS
    O      MG_air_through_S_on
    =      O_spindle_blow_clean                                       ;SK/BT taper tool change air blow (from spindle center)

    LN     O_spindle_blow_clean
    A      ML_O_CTS_blow_clean
    =      MG_O_CTS_blow_clean_n_pulse

    L      O_spindle_blow_clean
    =      ML_O_CTS_blow_clean
  ENDI

#if (MT = &MT_2C) or (Head = &S_head_type_01) or (Head = &S_head_type_02) or (Head = &S_head_type_06) or (Head = &S_head_type_10)
 *;O_S_blow_clean_without_V_H_head, O_S_blow_clean_with_V_H_head
  L      I_spindle_without_3D_head
  IFT
    L      O_spindle_blow_clean
    =      O_S_blow_clean_without_V_H_head
  ELSE
    L      O_spindle_blow_clean
    =      O_S_blow_clean_with_V_H_head
  ENDI
#endif

 *;O_stretching_operation_cabinet_support, O_folding_operation_cabinet_support
  L      MG_soft_key_OP_cabinet_foldinging
  AN     O_stretching_operation_cabinet_support
  AN     I_guard_1_closed
  S      ML_OP_cabinet_support_foldinging

  L      MG_soft_key_OP_cabinet_stretching
  AN     O_folding_operation_cabinet_support
  AN     I_guard_1_closed
  S      ML_OP_cabinet_support_stretching

  L      O_stretching_operation_cabinet_support
  O      O_folding_operation_cabinet_support
  IFT
    INC    BL_OP_cabinet_support_output_duration
  ENDI

  L      BL_OP_cabinet_support_output_duration
  <      KL_OP_cabinet_support_output_duration
  A      ML_OP_cabinet_support_foldinging
  =      O_folding_operation_cabinet_support

  L      BL_OP_cabinet_support_output_duration
  <      KL_OP_cabinet_support_output_duration
  A      ML_OP_cabinet_support_stretching
  =      O_stretching_operation_cabinet_support

  L      BL_OP_cabinet_support_output_duration
  >=     KL_OP_cabinet_support_output_duration
  R      ML_OP_cabinet_support_foldinging
  R      ML_OP_cabinet_support_stretching
  IFT
    L      K+0
    =      BL_OP_cabinet_support_output_duration
  ENDI

  L      MG_soft_key_OP_cabinet_foldinging
  AN     O_stretching_operation_cabinet_support
  O[
    L      MG_soft_key_OP_cabinet_stretching
    AN     O_folding_operation_cabinet_support
  ]
  A      I_guard_1_closed
  S      PN_error_guard_closed

  L      NP_magazine_servo_commissioning
  S      O_TC_mag_tool_chain_pin_out
  S      PN_error_mag_servo_tuning_mode

EM

