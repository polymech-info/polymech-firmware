LBL TLM_unit

*; TLM cover opening/closing
  L      MG_M341_TLM_cover_opening
  S      O_TLM_cover_opening
  R      O_TLM_cover_closing

  L      MG_M340_TLM_cover_closing
  R      O_TLM_cover_opening
  S      O_TLM_cover_closing

  L      MG_M341_TLM_cover_opening
  A      I_TLM_cover_open
  AN     I_TLM_cover_closed
  O[
    L      MG_M340_TLM_cover_closing
    AN     I_TLM_cover_open
    A      I_TLM_cover_closed
  ]
  S      PN_M4092_quit_M_function

  LN     O_TLM_cover_opening
  O      I_TLM_cover_open
  A[
    LN     O_TLM_cover_closing
    O      I_TLM_cover_closed
  ]
  ON     MG_power_delayed_on
  =      TS_TLM_cover_open_close_timeout

  L      O_TLM_cover_opening
  AN     I_TLM_cover_open
  O[
    L      O_TLM_cover_closing
    AN     I_TLM_cover_closed
  ]
  AN     TS_TLM_cover_open_close_timeout
  AN     TR_TLM_cover_open_close_timeout
  A      MG_power_delayed_on
  =      MG_error_TLM_cover_open_close

*; RENISHAW laser
#if TLM_type = &RENISHAW_NC
  L      MG_M310_fast_broken_tool_off
  O      MG_M311_fast_broken_tool_on
  O      MG_M320_latch_mode_off
  O      MG_M321_latch_mode_on
  O      MG_M331_TLM_air_blast_on
  O      MG_M330_TLM_air_blast_off
  S      PN_M4092_quit_M_function

  L      MG_M331_TLM_air_blast_on
  S      O_TLM_TOOL_CLEANING

  L      MG_M330_TLM_air_blast_off
  R      O_TLM_TOOL_CLEANING

  L      MG_M321_latch_mode_on
  S      O_latch_mode

  L      MG_M320_latch_mode_off
  R      O_latch_mode

  L      MG_M311_fast_broken_tool_on
  S      O_fast_broken_tool

  L      MG_M310_fast_broken_tool_off
  R      O_fast_broken_tool
#else
  L      MG_marker_one
  R      O_latch_mode
  R      O_fast_broken_tool
#endif

*;MG_traverse_range_M_codes_prohibited is used in M72.MH/M73.MH
#if TLM_out_of_machining_traverse = &active
#if (MT = &MT_15) or (MT = &MT_15A) or (MT = &MT_16)
  L      MG_marker_one
  =      MG_traverse_range_M_codes_prohibited
#endif
#endif

EM

