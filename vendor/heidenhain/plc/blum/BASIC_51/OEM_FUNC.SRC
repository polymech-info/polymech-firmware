  AN     MG_T_select_start                                            *;EUMACH standby tool loading/unloading
  AN     MG_TC_magazine_start
  AN     MG_TM_started_by_Tool_Call
  =      I_TC_magazine_counter
  =      I_TC_magazine_exact_position
#endif

#if Tool_magazine = &Pulse
  L      NP_TC_mag_in_pos_while_counter=1
  IFT
    L      I_TC_magazine_counter_sensor
    =      I_TC_magazine_counter
  ELSE
    LN     I_TC_magazine_counter_sensor
    =      I_TC_magazine_counter
  ENDI

  LN     NP_magazine_with_2_counters
  IFT
    L      I_TC_magazine_counter
    =      I_TC_magazine_exact_position
  ELSE
    L      NP_TC_mag_in_pos_while_2nd_counter=1
    IFT
      L      I_TC_magazine_2nd_counter_sensor
      =      I_TC_magazine_exact_position
    ELSE
