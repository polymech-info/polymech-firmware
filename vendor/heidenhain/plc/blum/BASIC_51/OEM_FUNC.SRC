  S      ML_VMC_axes_error_comp_request
  R      ML_HMC_axes_error_comp_request

  LN     MG_automatic_V_H_head_installed
  A      NP_M4173_1st_PLC_run_after_compile
  O      ML_V_H_head_installed_n_pulse
  R      ML_VMC_axes_error_comp_request
  S      ML_HMC_axes_error_comp_request

  L      ML_VMC_axes_error_comp_request
  O      ML_HMC_axes_error_comp_request
  IFT
    RPLY   BL_axes_error_comp_identifier
    ==     K+0
    IFT
      SUBM   Axes_error_comp_submit
      =      BL_axes_error_comp_identifier
      ==     K+0
      S      PN_error_submit_spawn_queue_full
    ENDI
  ENDI
#endif

EM

