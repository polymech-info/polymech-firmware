*; Spindle override = 100%
*;EUMACH S% knob -> FMAX% knob --- PLC moves to SPINDLE.SRC.
;  L      MG_soft_key_S100_percent
;  IFT
;    L      WG_MP7620_F_S_override
;    BT     K+3
;    IFT
;      L      K+10000
;      =      PN_W764_S_override_PLC

;      L      NP_W492_S_override_NC
;      -      WL_factor_S_override
;      PSW
;      CM     Absolute
;      PLW
;      >=     K+1000
;      R      MG_soft_key_S100_percent
;    ELSE
;      L      K+100
;      =      PN_W764_S_override_PLC

;      L      NP_W492_S_override_NC
;      -      WL_factor_S_override
;      PSW
;      CM     Absolute
;      PLW
;      >=     K+10
;      R      MG_soft_key_S100_percent
;    ENDI
;  ELSE
;    L      NP_W492_S_override_NC
;    =      WL_factor_S_override
;  ENDI
*;EUMACH S% knob -> FMAX% knob

*; Feed rate override = 100%
  L      MG_soft_key_F100_percent
  IFT
    L      WG_MP7620_F_S_override
    BT     K+3
    IFT
      L      K+10000
      =      PN_W766_factor_feed_override_PLC
;#if Override_knobs = &2_knobs                                        *;EUMACH S% knob -> FMAX% knob
;      =      NP_W752_rapid_traverse_override_PLC                     *;EUMACH S% knob -> FMAX% knob
;#endif                                                               *;EUMACH S% knob -> FMAX% knob

      L      NP_W494_factor_feed_override_NC
      -      WL_factor_feed_override
      PSW
      CM     Absolute
      PLW
      >=     K+1000
      R      MG_soft_key_F100_percent
    ELSE
      L      K+100
      =      PN_W766_factor_feed_override_PLC
;#if Override_knobs = &2_knobs                                        *;EUMACH S% knob -> FMAX% knob
;      =      NP_W752_rapid_traverse_override_PLC                     *;EUMACH S% knob -> FMAX% knob
;#endif                                                               *;EUMACH S% knob -> FMAX% knob

      L      NP_W494_factor_feed_override_NC
      -      WL_factor_feed_override
      PSW
      CM     Absolute
      PLW
      >=     K+10
      R      MG_soft_key_F100_percent
    ENDI
  ELSE
    L      NP_W494_factor_feed_override_NC
    =      WL_factor_feed_override
  ENDI

*; Tilting axis position before referenced
#if (REF = &REF_type_51) or (REF = &REF_type_52)
  L      NP_W1032_reference_nesessary
  BT     KG_axis_5
  A[
    L      WG_controlled_axes
    BT     KG_axis_5
  ]
  A      MG_control_operational
  =      PN_error_tilting_axis_pos_before_REF

  L      WG_MP1320_direction_traverse_ref_negative
  BT     KG_axis_5
  IFT
#if REF = &REF_type_51
    L      PN_error_tilting_axis_pos_before_REF
    =      MG_win_A_to_plus_pos
#endif

#if REF = &REF_type_52
    L      PN_error_tilting_axis_pos_before_REF
    =      MG_win_B_to_plus_pos
#endif
  ELSE
#if REF = &REF_type_51
    L      PN_error_tilting_axis_pos_before_REF
    =      MG_win_A_to_minus_pos
#endif

#if REF = &REF_type_52
    L      PN_error_tilting_axis_pos_before_REF
    =      MG_win_B_to_minus_pos
#endif
  ENDI
#endif
*; Tilting axis position before referenced

  LN     I_air_to_hydraulic_unit_oil_level_ok
  A      NP_air_to_hydraulic_unit
  S      PN_error_air_hydraulic_unit_oil_level

*;EUMACH G00% override
  L      WG_MP7620_F_S_override
  BT     KL_Bit_9_TE_with_Fmax_override
  =      MG_MP7620_TE_with_Fmax_override

#if Override_knobs = &3_knobs
  LN     MG_MP7620_TE_with_Fmax_override
  A      MG_machine_parameter_are_read
  S      PN_error_check_machine_parameter
  =      MG_win_MP7620_bit_9_not_assigned
#else
  L      MG_MP7620_TE_with_Fmax_override
  A      MG_machine_parameter_are_read
  S      PN_error_check_machine_parameter
  =      MG_win_MP7620_bit_9_assigned
#endif
*;EUMACH G00% override

*;EUMACH S% knob -> FMAX% knob
  L      WG_MP7620_F_S_override
  BT     KL_Bit_5_TE_Fmax_instead_S_override
  =      MG_MP7620_TE_Fmax_instead_S_override

#if (Override_knobs = &2_knobs) and (Override_FMAX_instead_S = &active)
  LN     MG_MP7620_TE_Fmax_instead_S_override
  A      MG_machine_parameter_are_read
  S      PN_error_check_machine_parameter
  =      MG_win_MP7620_bit_5_not_assigned
#else
  L      MG_MP7620_TE_Fmax_instead_S_override
  A      MG_machine_parameter_are_read
  S      PN_error_check_machine_parameter
  =      MG_win_MP7620_bit_5_assigned
#endif
*;EUMACH S% knob -> FMAX% knob

  LN     I_cabinet_cooler_unit_ok
  A      MG_power_delayed_on
  S      PN_error_cabinet_cooler_unit

*;EUMACH Power-on safety confirmation
#if Door_lock_safety_confirmation_panel = &active
  L      NP_M4172_1st_PLC_run_after_power_on
  O      NP_M4173_1st_PLC_run_after_compile
  S      ML_power_on_safety_confirmation

  L      I_guard_1_closed_locked
  A      I_guard_2_closed_locked
#if Light_beam_protection = &active
  A      I_light_beam_ok
#endif
  A      MG_guard_test_ok
  A      ML_power_on_safety_confirmation
  =      PN_error_power_on_safety_confirmation

  L      PN_error_power_on_safety_confirmation
  A      I_key_safety_confirmation
  R      ML_power_on_safety_confirmation
#endif

*;EUMACH Light beam protection
#if Light_beam_protection = &active
  LN     I_light_beam_ok
  S      ML_light_beam_ever_turned_off

  L      I_key_safety_confirmation
  R      ML_light_beam_ever_turned_off

  L      ML_light_beam_ever_turned_off
  =      PN_error_light_beam_blocked
#endif

EM

;----------------------------
LBL External_sag_compensation

* External sagging compensation by push-pull rod hydraulic cylinder
* PLC:\CORRECT\EXT_SAG_COMP.TAB compensation table has 3 types of values.  Only 100 compensation values are available.
* REF: The machine coordinates (REF) of the sagging axis (unit: mm)
*      1. REF value must starting from negative axis direction to positive axis direction
*      2. Two adjecent REF values cannot be equal, otherwise alarm occurs.
*      3. The last REF value must be greater than axis traverse range.
*      4. REF value must be in between +13743.8953 mm and -13743.8953 mm, otherwise calculation will overflow.
* PUSH_ROD: The push rod hydraulic cylinder control voltage (0 - 10V) (unit: V) (TNC resolution = 0.01V)
* PULL_ROD: The pull rod hydraulic cylinder control voltage (0 - 10V) (unit: V) (TNC resolution = 0.01V)

#if MT = &MT_2MV
  L      MG_M380_ext_sag_comp_off
  O      MG_M381_ext_sag_comp_on
  S      PN_M4092_quit_M_function

  L      MG_M381_ext_sag_comp_on
  S      MG_ext_sag_comp_active

  L      MG_M380_ext_sag_comp_off
  R      MG_ext_sag_comp_active

  L      MG_ext_sag_comp_active
  AN     ML_ext_sag_comp_active
  =      ML_ext_sag_comp_active_p_pulse

  L      MG_ext_sag_comp_active
  =      ML_ext_sag_comp_active

  L      NP_M4173_1st_PLC_run_after_compile
  O      ML_ext_sag_comp_active_p_pulse
  R      MG_ext_sag_comp_file_reading_completed
  CMT    Ext_sag_comp_file_reading

  L      MG_ext_sag_comp_active
  A      MG_ext_sag_comp_file_reading_completed
  IFT
    L      K-1
    =      WL_index_ext_sag_comp

    L      ML_ext_sag_comp_interpolated
    R      ML_ext_sag_comp_interpolated

    L      DG_position_axis_Y_ref
    =      DL_current_ext_sag_comp_REF_pos

    REPEAT
      INC    WL_index_ext_sag_comp

      L      DG_ext_sag_comp_REF_pos[WL_index_ext_sag_comp]
      =      DL_current_table_REF_pos

      L      DG_ext_sag_comp_push_rod[WL_index_ext_sag_comp]
      =      DL_current_table_push_rod

      L      DG_ext_sag_comp_pull_rod[WL_index_ext_sag_comp]
      =      DL_current_table_pull_rod

      L      WL_index_ext_sag_comp
      >      K+0
      IFT
        ;If previous table REF position <= current REF position < current table REF position, push rod voltage & pull rod voltage are interpolated.
        ;If current table REF position <= previous table REF position -> alarm
        L      DL_current_ext_sag_comp_REF_pos
        >=     DL_previous_table_REF_pos
        A[
          L      DL_current_ext_sag_comp_REF_pos
          <      DL_current_table_REF_pos
        ]
        AN     MG_error_ext_sag_comp_table_check
        S      ML_ext_sag_comp_interpolated
        IFT
          ;All the calculation trying to prevent from 32 bit data overflow
          L      DL_current_ext_sag_comp_REF_pos
          -      DL_previous_table_REF_pos
          =      DL_variable_A

          L      DL_current_table_REF_pos
          -      DL_previous_table_REF_pos
          =      DL_variable_C

          L      DL_current_table_push_rod
          -      DL_previous_table_push_rod
          =      DL_variable_B_push_rod

          L      DL_variable_A
          /      K+64
          X      DL_variable_B_push_rod
          =      DL_variable_I_push_rod

          L      DL_variable_A
          MOD    K+64
          =      DL_variable_J_push_rod

          L      DL_variable_I_push_rod
          MOD    DL_variable_C
          =      DL_variable_K_push_rod

          L      DL_variable_I_push_rod
          /      DL_variable_C
          X      K+64
          =      DL_variable_U_push_rod

          L      DL_variable_J_push_rod
          X      DL_variable_B_push_rod
          =      DL_variable_V_push_rod

          L      DL_variable_K_push_rod
          X      K+64
          =      DL_variable_W_push_rod

          L      DL_variable_V_push_rod
          +      DL_variable_W_push_rod
          /      DL_variable_C
          +      DL_variable_U_push_rod
          +      DL_previous_table_push_rod
          =      OW_push_rod_cylinder_voltage

          ;All the calculation trying to prevent from 32 bit data overflow
          L      DL_current_table_pull_rod
          -      DL_previous_table_pull_rod
          =      DL_variable_B_pull_rod

          L      DL_variable_A
          /      K+64
          X      DL_variable_B_pull_rod
          =      DL_variable_I_pull_rod

          L      DL_variable_A
          MOD    K+64
          =      DL_variable_J_pull_rod

          L      DL_variable_I_pull_rod
          MOD    DL_variable_C
          =      DL_variable_K_pull_rod

          L      DL_variable_I_pull_rod
          /      DL_variable_C
          X      K+64
          =      DL_variable_U_pull_rod

          L      DL_variable_J_pull_rod
          X      DL_variable_B_pull_rod
          =      DL_variable_V_pull_rod

          L      DL_variable_K_pull_rod
          X      K+64
          =      DL_variable_W_pull_rod

          L      DL_variable_V_pull_rod
          +      DL_variable_W_pull_rod
          /      DL_variable_C
          +      DL_variable_U_pull_rod
          +      DL_previous_table_pull_rod
          =      OW_pull_rod_cylinder_voltage
        ELSE
          L      DL_current_table_REF_pos
          <=     DL_previous_table_REF_pos
          S      MG_error_ext_sag_comp_table_check
        ENDI

        ;If current REF position < 1st table REF position (NR0 position), using 1st table PUSH_ROD & PULL_ROD voltage (NR0 value)
        L      WL_index_ext_sag_comp
        ==     K+1
        AN     MG_error_ext_sag_comp_table_check
        IFT
          L      DL_current_ext_sag_comp_REF_pos
          <      DL_previous_table_REF_pos
          S      ML_ext_sag_comp_interpolated
          IFT
            L      DL_previous_table_push_rod
            =      OW_push_rod_cylinder_voltage

            L      DL_previous_table_pull_rod
            =      OW_pull_rod_cylinder_voltage
          ENDI
        ENDI

        ;If current REF position > the very last table REF position (NR99 position) -> alarm
        L      KL_ext_sag_comp_table_size
        -      K+1
        ==     WL_index_ext_sag_comp
        A[
          L      DL_current_ext_sag_comp_REF_pos
          >      DL_current_table_REF_pos
        ]
        AN     MG_error_ext_sag_comp_table_check
        S      MG_error_ext_sag_comp_table_check
      ENDI

      L      DL_current_table_REF_pos
      =      DL_previous_table_REF_pos

      L      DL_current_table_push_rod
      =      DL_previous_table_push_rod

      L      DL_current_table_pull_rod
      =      DL_previous_table_pull_rod

      L      ML_ext_sag_comp_interpolated
      O      MG_error_ext_sag_comp_table_check
    UNTILT
  ELSE
    L      MG_M380_ext_sag_comp_off
    O      NP_M4173_1st_PLC_run_after_compile
    IFT
      L      K+0
      =      OW_push_rod_cylinder_voltage
      =      OW_pull_rod_cylinder_voltage
    ENDI
  ENDI
#endif

*;EUMACH Protection for both magazine door open & ATC door open
#if MT = &MT_39A
  LN     I_ATC_door_closed
  O      I_ATC_door_open
  AN     I_TC_magazine_guard_locked_closed
  S      MG_error_Mag_ATC_doors_open

  L      MG_error_Mag_ATC_doors_open
#if SFM ! &inactive
  AN[
    L      PN_error_safety_mode_2
    A      I_HR4x0_key_permissive_mode
    O      MG_safety_mode_4
  ]
#endif
  =      MG_both_mag_and_ATC_doors_open_protection
#endif
*;EUMACH Protection for both magazine door open & ATC door open

EM

;----------------------------
LBL Ball_screw_cooling_system

  LN     NP_ball_screw_cooling_active
  R      O_ball_screw_cooling_unit
  EMT

  LN     TR_extern_DC_voltage_off_on
  =      O_ball_screw_cooling_unit

 *;After the ball screw cooling unit has been turned on for a certain time,
 *;the alarm sensor of ball screw cooling unit starts to be checked by PLC.
  LN     O_ball_screw_cooling_unit
  O      PN_error_ball_screw_cooling_unit
  IFT
    L      K+0
    =      BL_screw_cooling_on_delay_timer_sec
  ENDI

  L      BL_screw_cooling_on_delay_timer_sec
  <=     KL_screw_cooling_turned_on_delay_sec
  A      O_ball_screw_cooling_unit
  AN     PN_error_ball_screw_cooling_unit
  A      MG_pulse_1_s
  IFT
    INC    BL_screw_cooling_on_delay_timer_sec
  ENDI

  L      BL_screw_cooling_on_delay_timer_sec
  >      KL_screw_cooling_turned_on_delay_sec
  AN     I_ball_screw_cooling_unit_ok
  S      PN_error_ball_screw_cooling_unit

EM

;----------------------------
LBL Lubrication_pneumatic_spray

  LN     NP_lubrication_pneumatic_spray
  R      O_lubrication_pneumatic_spray_on
  EMT

  L      NP_W1028_axes_in_motion
  BT     KG_axis_X
  O[
    L      NP_W1028_axes_in_motion
    BT     KG_axis_Y
  ]
  O[
    L      NP_W1028_axes_in_motion
    BT     KG_axis_Z
  ]
  A      MG_control_operational
  =      TS_lubrication_pneumatic_spray

  L      TR_lubrication_pneumatic_spray
  =      O_lubrication_pneumatic_spray_on

EM

;----------------------------
LBL Manual_lubrication_message

*;X-axis
  L      NP_MP4230_60_X_manual_lubrication
  >      K+0
  IFT
    L      NP_MP4230_60_X_manual_lubrication
    <>     DL_last_MP4230_60_X_manual_lubrication
    O      ML_X_manual_lubricated
    IFT
      L      NP_MP4230_60_X_manual_lubrication                        ;Integer portion calculation for data overflow
      /      K+10000
      X      K+3600
      =      DL_next_X_manual_lubrication

      L      NP_MP4230_60_X_manual_lubrication                        ;Decimal portion calculation for data overflow
      MOD    K+10000
      X      K+3600
      /      K+10000
      +      DL_next_X_manual_lubrication
      =      DL_next_X_manual_lubrication
    ENDI

    L      NP_MP4230_60_X_manual_lubrication
    =      DL_last_MP4230_60_X_manual_lubrication

    L      DL_next_X_manual_lubrication
    <      K+0
    S      MG_error_manual_lubrication_message
    S      MG_win_axis_X

    L      NP_D276_code_number_entered_via_MOD
    ==     KL_X_manual_lubricated
    A      MG_error_manual_lubrication_message
    A      MG_win_axis_X
    =      ML_X_manual_lubricated
    R      MG_error_manual_lubrication_message
    R      MG_win_axis_X
    IFT
      L      K+0
      =      NP_D276_code_number_entered_via_MOD
    ENDI

    L      DL_next_X_manual_lubrication
    >=     K+0
;    A[
;      L      NP_W1028_axes_in_motion
;      BT     KG_axis_X
;    ]
    A      MG_pulse_1_s
    IFT
      DEC    DL_next_X_manual_lubrication
    ENDI
  ELSE
    L      K+0
    =      DL_next_X_manual_lubrication
    =      DL_last_MP4230_60_X_manual_lubrication
  ENDI

*;Y-axis
  L      NP_MP4230_61_Y_manual_lubrication
  >      K+0
  IFT
    L      NP_MP4230_61_Y_manual_lubrication
    <>     DL_last_MP4230_61_Y_manual_lubrication
    O      ML_Y_manual_lubricated
    IFT
      L      NP_MP4230_61_Y_manual_lubrication                        ;Integer portion calculation for data overflow
      /      K+10000
      X      K+3600
      =      DL_next_Y_manual_lubrication

      L      NP_MP4230_61_Y_manual_lubrication                        ;Decimal portion calculation for data overflow
      MOD    K+10000
      X      K+3600
      /      K+10000
      +      DL_next_Y_manual_lubrication
      =      DL_next_Y_manual_lubrication
    ENDI

    L      NP_MP4230_61_Y_manual_lubrication
    =      DL_last_MP4230_61_Y_manual_lubrication

    L      DL_next_Y_manual_lubrication
    <      K+0
    S      MG_error_manual_lubrication_message
    S      MG_win_axis_Y

    L      NP_D276_code_number_entered_via_MOD
    ==     KL_Y_manual_lubricated
    A      MG_error_manual_lubrication_message
    A      MG_win_axis_Y
    =      ML_Y_manual_lubricated
    R      MG_error_manual_lubrication_message
    R      MG_win_axis_Y
    IFT
      L      K+0
      =      NP_D276_code_number_entered_via_MOD
    ENDI

    L      DL_next_Y_manual_lubrication
    >=     K+0
;    A[
;      L      NP_W1028_axes_in_motion
;      BT     KG_axis_Y
;    ]
    A      MG_pulse_1_s
    IFT
      DEC    DL_next_Y_manual_lubrication
    ENDI
  ELSE
    L      K+0
    =      DL_next_Y_manual_lubrication
    =      DL_last_MP4230_61_Y_manual_lubrication
  ENDI

*;Z-axis
  L      NP_MP4230_62_Z_manual_lubrication
  >      K+0
  IFT
    L      NP_MP4230_62_Z_manual_lubrication
    <>     DL_last_MP4230_62_Z_manual_lubrication
    O      ML_Z_manual_lubricated
    IFT
      L      NP_MP4230_62_Z_manual_lubrication
      X      K+3600
      /      K+10000
      =      DL_next_Z_manual_lubrication
    ENDI

    L      NP_MP4230_62_Z_manual_lubrication
    =      DL_last_MP4230_62_Z_manual_lubrication

    L      DL_next_Z_manual_lubrication
    <      K+0
    S      MG_error_manual_lubrication_message
    S      MG_win_axis_Z

    L      NP_D276_code_number_entered_via_MOD
    ==     KL_Z_manual_lubricated
    A      MG_error_manual_lubrication_message
    A      MG_win_axis_Z
    =      ML_Z_manual_lubricated
    R      MG_error_manual_lubrication_message
    R      MG_win_axis_Z
    IFT
      L      K+0
      =      NP_D276_code_number_entered_via_MOD
    ENDI

    L      DL_next_Z_manual_lubrication
    >=     K+0
;    A[
;      L      NP_W1028_axes_in_motion
;      BT     KG_axis_Z
;    ]
    A      MG_pulse_1_s
    IFT
      DEC    DL_next_Z_manual_lubrication
    ENDI
  ELSE
    L      K+0
    =      DL_next_Z_manual_lubrication
    =      DL_last_MP4230_62_Z_manual_lubrication
  ENDI

EM

;----------------------------
LBL Spindle_cooling_system

  LN     NP_spindle_cooling_active
  R      O_spindle_cooling_unit
  EMT

 *;Without High-speed Spindle ==============
 *;SIEMENS torque motor 1FW6130-0PA15-1JC2 =
 *;CYTEC CS/SK040/021W/120F-0537 ===========
 *;INDRAMAT 1MB160F-4B =====================
 *;INDRAMAT MBS162 B/D/F/J =================

#if (MT = &MT_2D) or (MT = &MT_31A) or (MT = &MT_31B) or (MT = &MT_32A) or (MT = &MT_36B) or (MT = &MT_37B) or (S_cooling_control_type = &Continuous) or (MT = &MT_39A) or (MT = &MT_3AA) or (MT = &MT_3B) or (MT = &MT_3BA)
  LN     TR_extern_DC_voltage_off_on
  =      O_spindle_cooling_unit
#endif

 *;FAEMAT FA 160 C.U.V. =====================
 *;FAEMAT FAI 250 C.U.V. =====================
 *;FAEMAT FA 110 CUS Analog Spindle ==============
 *;SIEMENS 2SP1204-1HB01-2DF2 ==============
 *;After the spindle has been stopped for a certain time, the spindle cooling
 *;unit is shut off.
#if S_cooling_control_type = &M05_delay
#if (MT ! &MT_2D) and (MT ! &MT_31A) and (MT ! &MT_31B) and (MT ! &MT_32A) and (MT ! &MT_36B) and (MT ! &MT_37B) and (MT ! &MT_39A) and (MT ! &MT_3B) and (MT ! &MT_3BA)
#if MT ! &MT_3AA
#if HSS = &HS_type_299
  L      I_S_actual_not_0_rpm
  O      O_Spindle_inverter_M3
#else
  L      PN_M4012_S_open_control_loop
  O      NP_M4030_tapping_cycle_active
  O      NP_M4031_tapping_cycle_controlled
  A      O_servo_drive_release_S
  A[
    LN     NP_tool_clamped_without_tool_sensor
    ON     I_tool_clamped_without_tool
    O      NP_M3_M4_for_S_clamped_without_tool
  ]
#endif
  AN     TR_extern_DC_voltage_off_on
  =      TS_S_cooling_unit_off_delay

  L      TS_S_cooling_unit_off_delay
  O      TR_S_cooling_unit_off_delay
  A      I_control_operational
  =      O_spindle_cooling_unit
#endif
#endif
#endif

 *;After the spindle cooling unit has been turned on for a certain time, the
 *;alarm sensor of spindle cooling unit starts to be checked by PLC.
  LN     O_spindle_cooling_unit
  O      PN_error_spindle_cooling_unit
  IFT
    L      K+0
    =      BL_S_cooling_on_delay_timer_sec
  ENDI

  L      BL_S_cooling_on_delay_timer_sec
  <=     KL_S_cooling_turned_on_delay_sec
  A      O_spindle_cooling_unit
  AN     PN_error_spindle_cooling_unit
  A      MG_pulse_1_s
  IFT
    INC    BL_S_cooling_on_delay_timer_sec
  ENDI

  L      BL_S_cooling_on_delay_timer_sec
  >      KL_S_cooling_turned_on_delay_sec
  AN     I_spindle_cooling_unit_ok
  S      PN_error_spindle_cooling_unit

*;Spindle cooling liquid pressure detection
  LN     O_spindle_cooling_unit
  O      I_S_cooling_pressure_ok
  ON     NP_S_cooling_pressure_snesor_active
  =      TS_S_cooling_pressure

  LN     TS_S_cooling_pressure
  AN     TR_S_cooling_pressure
  A      MG_control_operational
  S      PN_error_S_cooling_liquid_flow

EM

;----------------------------
LBL Spindle_gear_cooling_system

  LN     NP_spindle_gear_cooling_active
  R      O_spindle_gear_cooling_unit
  EMT

  LN     TR_extern_DC_voltage_off_on
  =      O_spindle_gear_cooling_unit

 *;After the spindle gear cooling unit has been turned on for a certain time,
 *;the alarm sensor of spindle gear cooling unit starts to be checked by PLC.
  LN     O_spindle_gear_cooling_unit
  O      PN_error_spindle_gear_cooling
  IFT
    L      K+0
    =      BL_S_gear_cooling_on_delay_timer_sec
  ENDI

  L      BL_S_gear_cooling_on_delay_timer_sec
  <=     KL_S_gear_cooling_turned_on_delay_sec
  A      O_spindle_gear_cooling_unit
  AN     PN_error_spindle_gear_cooling
  A      MG_pulse_1_s
  IFT
    INC    BL_S_gear_cooling_on_delay_timer_sec
  ENDI

  L      BL_S_gear_cooling_on_delay_timer_sec
  >      KL_S_gear_cooling_turned_on_delay_sec
  AN     I_spindle_gear_cooling_unit_ok
  S      PN_error_spindle_gear_cooling

EM

;----------------------------
LBL Scale_S_bearing_air_clean

  LN     NP_scale_S_bearing_air_clean
  R      O_scale_S_bearing_air_clean
  R      PN_error_scale_S_bearing_air_clean
  EMT

  L      O_pneumatic_inlet_valve_on
  AN     ML_O_pneumatic_inlet_valve_on
  =      ML_p_pulse_O_pneumatic_inlet_valve_on

  L      O_pneumatic_inlet_valve_on
  =      ML_O_pneumatic_inlet_valve_on

#if S_oil_air_lube_type = &MIXAIR2
*;Previous PLC
;  L      NP_W1028_axes_in_motion
;  BT     KG_axis_X
;  O[
;    L      NP_W1028_axes_in_motion
;    BT     KG_axis_Y
;  ]
;  O[
;    L      NP_W1028_axes_in_motion
;    BT     KG_axis_Z
;  ]
;  O      O_servo_drive_release_S
;  =      TS_scale_S_bearing_air_clean
;  S      O_scale_S_bearing_air_clean

;  LN     TR_scale_S_bearing_air_clean
;  A      O_scale_S_bearing_air_clean
;  R      O_scale_S_bearing_air_clean

;  L      O_scale_S_bearing_air_clean
;  AN     ML_O_scale_S_bearing_air_clean
;  =      ML_p_pulse_O_scale_S_bearing_air_clean

;  L      O_scale_S_bearing_air_clean
;  =      ML_O_scale_S_bearing_air_clean

;  L      I_scale_and_S_bearing_air_clean_ok
;  O      ML_p_pulse_O_scale_S_bearing_air_clean
;  O      ML_p_pulse_O_pneumatic_inlet_valve_on
;  =      TS_sensor_for_scale_S_bearing_air_clean

;  LN     TS_sensor_for_scale_S_bearing_air_clean
;  AN     TR_sensor_for_scale_S_bearing_air_clean
;  A      O_scale_S_bearing_air_clean
;  A      MG_power_delayed_on
;  S      PN_error_scale_S_bearing_air_clean

;  LN     O_scale_S_bearing_air_clean
;  R      PN_error_scale_S_bearing_air_clean

;  L      MG_spindle_active
;  A      PN_error_scale_S_bearing_air_clean
;  AN     MG_axes_in_motion
;  R      PN_M4005_S_M03_nominal_and_status
;  R      PN_M4006_S_M04_nominal_and_status
;  S      PN_M4007_S_M05_nominal_0_and_status

;  L      MG_spindle_active
;  A      PN_error_scale_S_bearing_air_clean
;  A      MG_automatic_mode
;  R      PN_M4560_NC_stop_0_active
*;Previous PLC

  L      I_scale_and_S_bearing_air_clean_ok
  O      ML_p_pulse_O_pneumatic_inlet_valve_on
  =      TS_sensor_for_scale_S_bearing_air_clean

  LN     TS_sensor_for_scale_S_bearing_air_clean
  AN     TR_sensor_for_scale_S_bearing_air_clean
  A      MG_power_delayed_on
  S      PN_error_scale_S_bearing_air_clean
#else                                                                 *; S_oil_air_lube_type not = &MIXAIR2
  L      I_scale_and_S_bearing_air_clean_ok
;  O      ML_p_pulse_O_scale_S_bearing_air_clean
  O      ML_p_pulse_O_pneumatic_inlet_valve_on
  =      TS_sensor_for_scale_S_bearing_air_clean

  LN     TS_sensor_for_scale_S_bearing_air_clean
  AN     TR_sensor_for_scale_S_bearing_air_clean
  A      O_pneumatic_inlet_valve_on
  A      MG_power_delayed_on
#if (HSS = &HS_type_61) or (HSS = &HS_type_62) or (HSS = &HS_type_80) or (HSS = &HS_type_81)
  AN[                                                                 *;CYTEC HSK taper motor spindle uses the same channel for tool change air blow (107.21) & spindle bearing seal air clean (107.23).
    L      NP_S_and_CTS_blow_clean_valve_separated                    *;Without tool change air blow, no air to docking seal channel (107.1) and 0.5 bar air to spindle bearing seal air clean channel (107.21).
    A      O_spindle_blow_clean                                       *;During tool change air blow, 6 bar air to docking seal channel (107.1) and also 6 bar air to spindle bearing seal air clean channel (107.21).
  ]                                                                   *;At this moment, I_scale_and_S_bearing_air_clean_ok will be ignored.
#endif
  S      PN_error_scale_S_bearing_air_clean

  LN     O_pneumatic_inlet_valve_on
  O      PN_error_pneumatic_pressure
  R      PN_error_scale_S_bearing_air_clean
#endif

  L      MG_spindle_active
  A      PN_error_scale_S_bearing_air_clean
  AN     MG_axes_in_motion
  R      PN_M4005_S_M03_nominal_and_status
  R      PN_M4006_S_M04_nominal_and_status
  S      PN_M4007_S_M05_nominal_0_and_status

  L      MG_spindle_active
  A      PN_error_scale_S_bearing_air_clean
  A      MG_automatic_mode
  R      PN_M4560_NC_stop_0_active

EM

;----------------------------
LBL S_bearing_temperature

#if S_bearing_temperature_type = &PT100
  L      NP_S_bearing_relative_temperature
  IFT
*;EUMACH HSCI PT100 resolution = 0.01 degree
    L      IW_temp_S_front_bearing_Pt100
    +      K+5
    /      KL_fitting_HSCI_resolution
    =      WG_S_front_bearing_temperature                             *; unit:0.1 degree

#if S_rear_bearing_temperature_monitoring = &active
    L      IW_temp_S_rear_bearing_Pt100
    +      K+5
    /      KL_fitting_HSCI_resolution
    =      WG_S_rear_bearing_temperature                              *; unit:0.1 degree
#endif

    L      IW_temperature_machine_Pt100
    +      K+5
    /      KL_fitting_HSCI_resolution
    =      WG_machine_base_temperature                                *; unit:0.1 degree
*;EUMACH HSCI PT100 resolution = 0.01 degree

    L      WG_S_front_bearing_temperature
    >      K+1000
    O[
      L      WG_S_front_bearing_temperature
      <      K-1000
    ]
#if S_rear_bearing_temperature_monitoring = &active
    O[
      L      WG_S_rear_bearing_temperature
      >      K+1000
      O[
        L      WG_S_rear_bearing_temperature
        <      K-1000
      ]
    ]
#endif
    O[
      L      WG_machine_base_temperature
      >      K+1000
    ]
    O[
      L      WG_machine_base_temperature
      <      K-1000
    ]
    O[
      L      WG_S_front_bearing_temperature
      -      WG_machine_base_temperature
      <      K-100
    ]
#if S_rear_bearing_temperature_monitoring = &active
    O[
      L      WG_S_rear_bearing_temperature
      -      WG_machine_base_temperature
      <      K-100
    ]
#endif
    A      MG_power_delayed_on
    A      MG_spindle_active
    A[
      L      NP_MP4231_22_S_front_bearing_T_limit
      /      K+1000
      <      K+99999
#if S_rear_bearing_temperature_monitoring = &active
      O[
        L      NP_MP4230_47_S_rear_bearing_T_limit
        /      K+1000
        <      K+99999
      ]
#endif
    ]
    S      PN_error_S_bearing_temp_sensor

    L      WG_S_front_bearing_temperature
    -      WG_machine_base_temperature
    >[
      L      NP_MP4231_22_S_front_bearing_T_limit
      /      K+1000
    ]
    AN     PN_error_S_bearing_temp_sensor
    A[
      L      NP_MP4231_22_S_front_bearing_T_limit
      /      K+1000
      <      K+99999
    ]
#if S_rear_bearing_temperature_monitoring = &active
    O[
      L      WG_S_rear_bearing_temperature
      -      WG_machine_base_temperature
      >[
        L      NP_MP4230_47_S_rear_bearing_T_limit
        /      K+1000
      ]
      AN     PN_error_S_bearing_temp_sensor
      A[
        L      NP_MP4230_47_S_rear_bearing_T_limit
        /      K+1000
        <      K+99999
      ]
    ]
#endif
    A      MG_power_delayed_on
    A      MG_spindle_active
    S      PN_error_S_bearing_temperature_too_high
  ELSE
*;EUMACH HSCI PT100 resolution = 0.01 degree
    L      IW_temp_S_front_bearing_Pt100
    +      K+5
    /      KL_fitting_HSCI_resolution
    =      WG_S_front_bearing_temperature                             *; unit:0.1 degree

#if S_rear_bearing_temperature_monitoring = &active
    L      IW_temp_S_rear_bearing_Pt100
    +      K+5
    /      KL_fitting_HSCI_resolution
    =      WG_S_rear_bearing_temperature                              *; unit:0.1 degree
#endif
*;EUMACH HSCI PT100 resolution = 0.01 degree

    L      WG_S_front_bearing_temperature
    >      K+1000
    O[
      L      WG_S_front_bearing_temperature
      <      K-1000
    ]
#if S_rear_bearing_temperature_monitoring = &active
    O[
      L      WG_S_rear_bearing_temperature
      >      K+1000
      O[
        L      WG_S_rear_bearing_temperature
        <      K-1000
      ]
    ]
#endif
    A[
      L      NP_MP4231_22_S_front_bearing_T_limit
      /      K+1000
      <      K+99999
#if S_rear_bearing_temperature_monitoring = &active
      O[
        L      NP_MP4230_47_S_rear_bearing_T_limit
        /      K+1000
        <      K+99999
      ]
#endif
    ]
    A      MG_power_delayed_on
    A      MG_spindle_active
    S      PN_error_S_bearing_temp_sensor

    L      WG_S_front_bearing_temperature
    >[
      L      NP_MP4231_22_S_front_bearing_T_limit
      /      K+1000
    ]
    AN     PN_error_S_bearing_temp_sensor
    A[
      L      NP_MP4231_22_S_front_bearing_T_limit
      /      K+1000
      <      K+99999
    ]
#if S_rear_bearing_temperature_monitoring = &active
    O[
      L      WG_S_rear_bearing_temperature
      >[
        L      NP_MP4230_47_S_rear_bearing_T_limit
        /      K+1000
      ]
      AN     PN_error_S_bearing_temp_sensor
      A[
        L      NP_MP4230_47_S_rear_bearing_T_limit
        /      K+1000
        <      K+99999
      ]
    ]
#endif
    A      MG_power_delayed_on
    A      MG_spindle_active
    S      PN_error_S_bearing_temperature_too_high
  ENDI
#else
  L      K+2550
  =      WG_S_front_bearing_temperature
  =      WG_S_rear_bearing_temperature
  =      WG_machine_base_temperature
#endif

EM

#if S_oil_air_lube_type ! &inactive
;----------------------------
LBL S_oil_air_lubrication

#if S_oil_air_lube_type = &Simple
  LN     I_S_oil_air_lube_pressure_ok
  A      MG_spindle_active
  A      MG_control_operational
  S      PN_error_pressure_S_oil_air_lube
#endif

#if S_oil_air_lube_type = &MIXAIR2
  L      MG_spindle_active
  IFT
    L      O_servo_drive_release_S
    AN     TS_MG_S_orientation_active_off_delay
    AN     TR_MG_S_orientation_active_off_delay
    A      MG_control_operational
    =      TS_S_oil_air_lube_pneumatic

    LN     PN_error_unit_error_S_oil_air_lube
    AN     PN_error_pressure_S_oil_air_lube
    AN     PN_error_MIXER_pressure_S_oil_air_lube
    AN     PN_error_alarm_level_S_oil_air_lubricant
    A      TR_S_oil_air_lube_pneumatic
    O      O_S_oil_air_lube_unit_reset
    =      O_S_oil_air_lube_pneumatic_on

    L      O_S_oil_air_lube_pneumatic_on
    AN     ML_S_oil_air_lube_pneumatic_on
    =      ML_p_pulse_S_oil_air_lube_pneumatic_on

    L      O_S_oil_air_lube_pneumatic_on
    =      ML_S_oil_air_lube_pneumatic_on

    LN     O_S_oil_air_lube_pneumatic_on
    =      TS_on_delay_S_oil_air_lube_pneumatic_on

    L      I_S_oil_air_lube_pressure_ok
    =      TS_I_S_oil_air_lube_pressure_ok

    LN     TS_I_S_oil_air_lube_pressure_ok
    AN     TR_I_S_oil_air_lube_pressure_ok
    AN     TR_on_delay_S_oil_air_lube_pneumatic_on
    A      O_S_oil_air_lube_pneumatic_on
    S      PN_error_pressure_S_oil_air_lube

    LN     I_S_oil_air_lube_unit_ok
    AN     TR_on_delay_S_oil_air_lube_pneumatic_on
    A      O_S_oil_air_lube_pneumatic_on
    AN     PN_error_pressure_S_oil_air_lube
    S      PN_error_unit_error_S_oil_air_lube

    L      I_S_oil_air_lube_MIXER_pressure_ok
    =      TS_I_S_oil_air_lube_MIXER_pressure_ok

    LN     TS_I_S_oil_air_lube_MIXER_pressure_ok
    AN     TR_I_S_oil_air_lube_MIXER_pressure_ok
    AN     TR_on_delay_S_oil_air_lube_pneumatic_on
    A      O_S_oil_air_lube_pneumatic_on
    AN     PN_error_pressure_S_oil_air_lube
    S      PN_error_MIXER_pressure_S_oil_air_lube

    LN     I_S_oil_air_lube_warning_level_ok
    =      PN_error_warning_level_S_oil_air_lubricant

    LN     I_S_oil_air_lube_alarm_level_ok
    S      PN_error_alarm_level_S_oil_air_lubricant

    L      ML_p_pulse_S_oil_air_lube_pneumatic_on
    O      MG_soft_key_S_oil_air_lube_unit_reset
    =      TS_S_oil_air_lube_reset

    L      TS_S_oil_air_lube_reset
    O      TR_S_oil_air_lube_reset
    =      O_S_oil_air_lube_unit_reset
    R      PN_error_unit_error_S_oil_air_lube
    R      PN_error_pressure_S_oil_air_lube
    R      PN_error_MIXER_pressure_S_oil_air_lube
    R      PN_error_alarm_level_S_oil_air_lubricant
    R      PN_error_warning_level_S_oil_air_lubricant
  ELSE
    L      MG_marker_one
    R      TS_S_oil_air_lube_reset
    R      TS_S_oil_air_lube_pneumatic
    R      PN_error_unit_error_S_oil_air_lube
    R      PN_error_pressure_S_oil_air_lube
    R      PN_error_MIXER_pressure_S_oil_air_lube
    R      PN_error_alarm_level_S_oil_air_lubricant
    R      PN_error_warning_level_S_oil_air_lubricant
    R      O_S_oil_air_lube_unit_reset
    R      O_S_oil_air_lube_pneumatic_on
  ENDI
#endif

  L      PN_error_unit_error_S_oil_air_lube
  O      PN_error_pressure_S_oil_air_lube
  O      PN_error_MIXER_pressure_S_oil_air_lube
  O      PN_error_alarm_level_S_oil_air_lubricant
  A      MG_spindle_active
  AN     MG_axes_in_motion
  R      PN_M4005_S_M03_nominal_and_status
  R      PN_M4006_S_M04_nominal_and_status
  S      PN_M4007_S_M05_nominal_0_and_status

  L      PN_error_unit_error_S_oil_air_lube
  O      PN_error_pressure_S_oil_air_lube
  O      PN_error_MIXER_pressure_S_oil_air_lube
  O      PN_error_alarm_level_S_oil_air_lubricant
  A      MG_spindle_active
  A      MG_automatic_mode
  R      PN_M4560_NC_stop_0_active

EM
#endif

#if HSS ! &inactive
;----------------------------
LBL High_speed_S_warming_up

 *;Adding the NC power-off time duration to DL_S_standstill_elapsed_min
 *;(memorized from last time NC power-off)
  L      NP_M4172_1st_PLC_run_after_power_on
  A      MG_spindle_warmed_up
  IFT
    L      DL_TNC_power_off_duration_sec
    /      K+60
    PSW
    CM     Absolute
    PLW
    +      DL_S_standstill_elapsed_min
    =      DL_S_standstill_elapsed_min
  ENDI

  LN     MG_spindle_active
  ON     MG_machine_parameter_are_read
  EMT

  L      NP_MP4231_24_S_warming_up_1st_duration_sec
  /      K+10000
  +[
    L      NP_MP4231_25_S_warming_up_2nd_duration_sec
    /      K+10000
  ]
  +[
    L      NP_MP4231_23_S_warming_up_3rd_duration_sec
    /      K+10000
  ]
  =      WL_S_warming_up_total_duration_sec

  L      WL_S_warming_up_total_duration_sec
  ==     K+0
  O      MG_S_warmed_up_service
  S      MG_spindle_warmed_up
  EMT

  L      MG_MP_are_read_p_pulse
  IFT
    L      WL_S_warming_up_total_duration_sec
    =      WG_spindle_warming_up_remaining_seconds
  ENDI

  L      NP_M4153_mode_program_run_single_block
  O      NP_M4154_mode_program_run_full_sequence
  AN     NP_M4156_mode_soft_key_manual_operation
  AN     MG_spindle_warmed_up
  AN     PN_error_spindle_during_warming_up
  AN     PN_error_anti_backlash_motion
  =      PN_error_spindle_warming_up_necessary

 *;After the spindle has been warmed up, if the spindle is in standstill for a
 *;certain time, the spindle warming-up has to be started over again.
  L      MG_spindle_warmed_up
  IFT
    L      PN_M4005_S_M03_nominal_and_status
    O      PN_M4006_S_M04_nominal_and_status
    AN     PN_M4007_S_M05_nominal_0_and_status
    AN     PN_M4008_S_nominal_off_status_inverse
    AN     MG_spindle_stand_still
    IFT
      L      K+0
      =      DL_S_standstill_elapsed_min
    ELSE
      L      MG_pulse_1_min
      IFT
        INC    DL_S_standstill_elapsed_min
      ENDI
    ENDI

    L      NP_MP4231_29_S_rewarming_up_standstill_min
    /      K+10000
    <      DL_S_standstill_elapsed_min
    R      MG_spindle_warmed_up
    IFT
      L      K+0
      =      DL_S_standstill_elapsed_min
    ENDI
  ENDI

 *;Press the spindle warming-up soft key to start the warming-up procedure.
  L      MG_soft_key_S_warming_up
  AN     NP_M4176_control_in_operation_on_or_flashes
  AN     PN_error_safety_mode_2                                       *;CE 2008
  AN     MG_safety_mode_4                                             *;Safety mode 4
#if HSS = &HS_type_299
  AN     MG_FAEMAT_S_clamped_without_tool
#else
  A[
    LN     NP_tool_clamped_without_tool_sensor
    ON     I_tool_clamped_without_tool
  ]
#endif
  S      MG_S_warming_up_proceeding

 *;M05 or spindle pause will stop the spindle warming-up procedure.
  L      ML_S_warming_up_1st_stage_proceeding
  O      ML_S_warming_up_2nd_stage_proceeding
  O      ML_S_warming_up_3rd_stage_proceeding
  A[
    LN     PN_M4005_S_M03_nominal_and_status
    AN     PN_M4006_S_M04_nominal_and_status
    A      PN_M4007_S_M05_nominal_0_and_status
    O      MG_S_0_volt_status_inverse
    AN     MG_auto_manu_mode_change
    O      PN_error_safety_mode_2                                     *;CE 2008
    O      MG_safety_mode_4                                           *;Safety mode 4
  ]
  R      MG_S_warming_up_proceeding
  R      PN_M4005_S_M03_nominal_and_status
  R      PN_M4006_S_M04_nominal_and_status
  S      PN_M4007_S_M05_nominal_0_and_status

  L      MG_soft_key_S_warming_up
#if HSS = &HS_type_299
  A      MG_FAEMAT_S_clamped_without_tool
#else
  A      NP_tool_clamped_without_tool_sensor
  A      I_tool_clamped_without_tool
#endif
  S      PN_error_spindle_without_tool

  L      MG_S_warming_up_proceeding
  A      MG_automatic_mode
  =      PN_error_spindle_during_warming_up

 *;If the spindle warming-up procedure is aborted, it can be resumed within a
 *;certain time without starting over.
  L      PN_M4005_S_M03_nominal_and_status
  O      PN_M4006_S_M04_nominal_and_status
  AN     PN_M4007_S_M05_nominal_0_and_status
  AN     PN_M4008_S_nominal_off_status_inverse
  AN     MG_spindle_stand_still
  A      MG_S_warming_up_proceeding
  IFT
    L      NP_MP4231_28_S_warming_up_max_pause_sec
    /      K+10000
    =      WL_S_warming_up_pause_remaining_sec
  ELSE
    L      WL_S_warming_up_pause_remaining_sec
    >=     K+0
    A[
      L      WL_S_warming_up_total_duration_sec
      >      WG_spindle_warming_up_remaining_seconds
    ]
    A      MG_pulse_1_s
    IFT
      DEC    WL_S_warming_up_pause_remaining_sec
    ENDI

    L      WL_S_warming_up_pause_remaining_sec
    <      K+0
    IFT
      L      WL_S_warming_up_total_duration_sec
      =      WG_spindle_warming_up_remaining_seconds

      L      NP_MP4231_28_S_warming_up_max_pause_sec
      /      K+10000
      =      WL_S_warming_up_pause_remaining_sec
    ENDI
  ENDI

 *;During the spinlde warming-up procedure, the S % override = 100% regardless
 *;of S % potentiometer.  Three stages for spindle warming-up procedure:
 *;   1st Stage: Spindle running in 1st stage speed for 1st stage duration
 *;   2nd Stage: Spindle running in 2nd stage speed for 2nd stage duration
 *;   3rd Stage: Spindle running in 3rd stage speed for 3rd stage duration
 *;After the spindle warming-up procedure has been completed,
 *;MG_spindle_warmed_up is set to 1 and the spindle stops.
  L      MG_S_warming_up_proceeding
  AN     PN_M4008_S_nominal_off_status_inverse
  S      PN_M4005_S_M03_nominal_and_status
  R      PN_M4006_S_M04_nominal_and_status
  R      PN_M4007_S_M05_nominal_0_and_status
  IFT
    L      WG_MP7620_F_S_override
    BT     K+3
    IFT
      L      K+10000
      =      PN_W764_S_override_PLC
    ELSE
      L      K+100
      =      PN_W764_S_override_PLC
    ENDI

#if S_warming_up_type = &Step_rpm
    L      NP_MP4231_25_S_warming_up_2nd_duration_sec
    +      NP_MP4231_23_S_warming_up_3rd_duration_sec
    /      K+10000
    <      WG_spindle_warming_up_remaining_seconds
    =      ML_S_warming_up_1st_stage_proceeding
    IFT
      L      NP_MP4231_26_S_warming_up_1st_stage_rpm
      /      K+10
      =      PN_D756_S_nominal_rpm_PLC
    ELSE
      L      NP_MP4231_23_S_warming_up_3rd_duration_sec
      /      K+10000
      <      WG_spindle_warming_up_remaining_seconds
      =      ML_S_warming_up_2nd_stage_proceeding
      =N     ML_S_warming_up_3rd_stage_proceeding
      IFT
        L      NP_MP4231_27_S_warming_up_2nd_stage_rpm
        /      K+10
        =      PN_D756_S_nominal_rpm_PLC
      ELSE
        L      NP_MP4231_30_S_warming_up_3rd_stage_rpm
        /      K+10
        =      PN_D756_S_nominal_rpm_PLC
      ENDI
    ENDI
#endif

#if S_warming_up_type = &Stepless_rpm
    L      K+0
    <      WG_spindle_warming_up_remaining_seconds
    =      ML_S_warming_up_1st_stage_proceeding
    IFT
      L      DG_MP3510_0_S_1st_gear_rpm
      /      K+1000
      -      DG_MP3240_1_S_min_rpm
      X[
        L      WL_S_warming_up_total_duration_sec
        -      WG_spindle_warming_up_remaining_seconds
      ]
      /      WL_S_warming_up_total_duration_sec
      +      DG_MP3240_1_S_min_rpm
      X      K+1000
      =      PN_D756_S_nominal_rpm_PLC


      L      DG_MP3240_1_S_min_rpm
      X      K+1000
      >      PN_D756_S_nominal_rpm_PLC
      IFT
        L      DG_MP3240_1_S_min_rpm
        X      K+1000
        =      PN_D756_S_nominal_rpm_PLC
      ENDI
    ENDI
#endif

#if S_warming_up_type = &Step_stepless_rpm
    L      NP_MP4231_25_S_warming_up_2nd_duration_sec
    +      NP_MP4231_23_S_warming_up_3rd_duration_sec
    /      K+10000
    <      WG_spindle_warming_up_remaining_seconds
    =      ML_S_warming_up_1st_stage_proceeding
    IFT
      L      NP_MP4231_26_S_warming_up_1st_stage_rpm
      /      K+10
      =      PN_D756_S_nominal_rpm_PLC
    ELSE
      L      NP_MP4231_23_S_warming_up_3rd_duration_sec
      /      K+10000
      <      WG_spindle_warming_up_remaining_seconds
      =      ML_S_warming_up_2nd_stage_proceeding
      =N     ML_S_warming_up_3rd_stage_proceeding
      IFT
        L      NP_MP4231_30_S_warming_up_3rd_stage_rpm
        -      NP_MP4231_26_S_warming_up_1st_stage_rpm
        /      K+10000                                                *;Prevent from overflow
        X[
          L      WL_S_warming_up_total_duration_sec
          -      WG_spindle_warming_up_remaining_seconds
          -[
            L      NP_MP4231_24_S_warming_up_1st_duration_sec
            /      K+10000
          ]
        ]
        /[
          L      WL_S_warming_up_total_duration_sec
          -[
            L      NP_MP4231_24_S_warming_up_1st_duration_sec
            +      NP_MP4231_23_S_warming_up_3rd_duration_sec
            /      K+10000
          ]
        ]
        X      K+10000                                                *;Prevent from overflow
        +      NP_MP4231_26_S_warming_up_1st_stage_rpm
        /      K+10
        =      PN_D756_S_nominal_rpm_PLC
      ELSE
        L      NP_MP4231_30_S_warming_up_3rd_stage_rpm
        /      K+10
        =      PN_D756_S_nominal_rpm_PLC
      ENDI
    ENDI
#endif

    L      ML_S_warming_up_1st_stage_proceeding
    AN     ML_temp_S_warming_up_1st_stage_proceeding
    =      ML_p_edge_S_warming_up_1st_stage_proceeding

    L      ML_S_warming_up_1st_stage_proceeding
    =      ML_temp_S_warming_up_1st_stage_proceeding

    L      ML_S_warming_up_2nd_stage_proceeding
    AN     ML_temp_S_warming_up_2nd_stage_proceeding
    =      ML_p_edge_S_warming_up_2nd_stage_proceeding

    L      ML_S_warming_up_2nd_stage_proceeding
    =      ML_temp_S_warming_up_2nd_stage_proceeding

    L      ML_S_warming_up_3rd_stage_proceeding
    AN     ML_temp_S_warming_up_3rd_stage_proceeding
    =      ML_p_edge_S_warming_up_3rd_stage_proceeding

    L      ML_S_warming_up_3rd_stage_proceeding
    =      ML_temp_S_warming_up_3rd_stage_proceeding

#if S_warming_up_type = &Step_rpm
    L      ML_p_edge_S_warming_up_1st_stage_proceeding
    O      ML_p_edge_S_warming_up_2nd_stage_proceeding
    O      ML_p_edge_S_warming_up_3rd_stage_proceeding
#endif
#if S_warming_up_type = &Stepless_rpm
    L      MG_pulse_1_s
#endif
#if S_warming_up_type = &Step_stepless_rpm
    L      ML_S_warming_up_2nd_stage_proceeding
    A      MG_pulse_1_s
    O      ML_p_edge_S_warming_up_1st_stage_proceeding
    O      ML_p_edge_S_warming_up_3rd_stage_proceeding
#endif
    S      PN_M4134_strobe_G_range_S_speed

    L      WG_spindle_warming_up_remaining_seconds
    >=     K+0
    A[
      L      PN_M4005_S_M03_nominal_and_status
      O      PN_M4006_S_M04_nominal_and_status
      AN     PN_M4007_S_M05_nominal_0_and_status
      AN     PN_M4008_S_nominal_off_status_inverse
    ]
    A      MG_S_actual_equal_nominal_rpm
    A      MG_pulse_1_s
    IFT
      DEC    WG_spindle_warming_up_remaining_seconds
    ENDI

    L      WG_spindle_warming_up_remaining_seconds
    <      K+0
    S      MG_spindle_warmed_up
    R      MG_S_warming_up_proceeding
    R      PN_M4005_S_M03_nominal_and_status
    R      PN_M4006_S_M04_nominal_and_status
    S      PN_M4007_S_M05_nominal_0_and_status
    IFT
      L      WL_S_warming_up_total_duration_sec
      =      WG_spindle_warming_up_remaining_seconds
    ENDI
  ELSE
    L      MG_marker_one
    R      ML_S_warming_up_1st_stage_proceeding
    R      ML_temp_S_warming_up_1st_stage_proceeding
    R      ML_S_warming_up_2nd_stage_proceeding
    R      ML_temp_S_warming_up_2nd_stage_proceeding
    R      ML_S_warming_up_3rd_stage_proceeding
    R      ML_temp_S_warming_up_3rd_stage_proceeding
  ENDI

 *;Before the spindle has been warmed up, the spindle maximum speed is limited
 *;under 1st stage warming-up speed.
  LN     MG_spindle_warmed_up
  AN     MG_S_warming_up_proceeding
  IFT
    L      NP_MP4231_26_S_warming_up_1st_stage_rpm
    /      K+10
    <      PN_D604_max_S_rpm_PLC
    IFT
      L      NP_MP4231_26_S_warming_up_1st_stage_rpm
      /      K+10
      =      PN_D604_max_S_rpm_PLC
    ENDI
  ENDI

  L      MG_spindle_warmed_up
  AN     ML_spindle_warmed_up_temp
  =      MG_spindle_warmed_up_p_pulse

  L      MG_spindle_warmed_up
  =      ML_spindle_warmed_up_temp

  L      MG_spindle_warmed_up_p_pulse
  S      PN_M4134_strobe_G_range_S_speed
  IFT
    L      KL_rpm_after_S_warmed_up
    =      PN_D756_S_nominal_rpm_PLC
  ENDI

EM

;----------------------------
LBL High_speed_S_operation

 *;No tool in spindle -> M05
  L      PN_M4005_S_M03_nominal_and_status
  O      PN_M4006_S_M04_nominal_and_status
  AN     PN_M4007_S_M05_nominal_0_and_status
  AN     PN_M4008_S_nominal_off_status_inverse
  A      I_tool_clamped_without_tool
  A      NP_tool_clamped_without_tool_sensor
  AN     NP_M3_M4_for_S_clamped_without_tool
  S      PN_error_spindle_without_tool
  R      PN_M4005_S_M03_nominal_and_status
  R      PN_M4006_S_M04_nominal_and_status
  S      PN_M4007_S_M05_nominal_0_and_status

 *;No tool in spindle -> spindle rpm < MP4231.21.
#if HSS = &HS_type_299
  L      MG_FAEMAT_S_clamped_without_tool
#else
  L      NP_tool_clamped_without_tool_sensor
  A      I_tool_clamped_without_tool
  A      NP_M3_M4_for_S_clamped_without_tool
#endif
  IFT
    L      NP_MP4231_21_S_without_tool_max_rpm
    /      K+10
    <      PN_D604_max_S_rpm_PLC
    IFT
      L      NP_MP4231_21_S_without_tool_max_rpm
      /      K+10
      =      PN_D604_max_S_rpm_PLC
    ENDI
  ENDI

 *;FAEMAT FA 110 CUS Analog Spindle ==============
#if HSS = &HS_type_299
  LN     O_tool_unclamping
  A      O_tool_clamping
  AN     I_tool_clamped_without_tool
  AN     I_tool_clamped_sensor
  O      I_tool_clamped_without_tool
  =      MG_FAEMAT_S_clamped_without_tool

  L      PN_error_spindle_operational
  R      PN_M4005_S_M03_nominal_and_status
  R      PN_M4006_S_M04_nominal_and_status
  S      PN_M4007_S_M05_nominal_0_and_status

  L      PN_error_spindle_operational
  O      PN_error_spindle_warming_up_necessary
  A      MG_automatic_mode
  R      PN_M4560_NC_stop_0_active

  L      PN_M4005_S_M03_nominal_and_status
  O      PN_M4006_S_M04_nominal_and_status
  AN     PN_M4007_S_M05_nominal_0_and_status
  AN     PN_M4008_S_nominal_off_status_inverse
  =      O_Spindle_inverter_M3
#endif

 *;CYTEC CS/SK040/021W/120F-0537 Digtal Spindle ===================
;#if HSS = &HS_type_61
; *;When there is no tool in spindle, the spindle maximum speed is limited by
; *;MP4231.21.
;  L      I_tool_clamped_without_tool
;  A      NP_tool_clamped_without_tool_sensor
;  IFT
;    L      NP_MP4231_21_S_without_tool_max_rpm
;    /      K+10
;    <      PN_D604_max_S_rpm_PLC
;    IFT
;      L      NP_MP4231_21_S_without_tool_max_rpm
;      /      K+10
;      =      PN_D604_max_S_rpm_PLC
;    ENDI
;  ENDI

;  L      PN_M4012_S_open_control_loop
;  O      NP_M4030_tapping_cycle_active
;  O      NP_M4031_tapping_cycle_controlled
;  A      O_servo_drive_release_S
;  =      O_CYTEC_S_rotary_union_cooling_on

;  L      PN_M4012_S_open_control_loop
;  O      NP_M4030_tapping_cycle_active
;  O      NP_M4031_tapping_cycle_controlled
;  A      O_servo_drive_release_S
;  AN     O_coolant_M07_on
;  =      O_CYTEC_S_rotary_union_cooling_on
;#endif

EM
#endif

;----------------------------
LBL S_rotary_joint_cooling

#if Rotary_joint_cooling_circulation = &active
  L     O_coolant_M07_on
  O[
    L      NP_S_and_CTS_blow_clean_valve_separated
    A      O_CTS_blow_clean
  ]
  O[
    LN     NP_S_and_CTS_blow_clean_valve_separated
    A      O_spindle_blow_clean
  ]
  =      ML_fluid_through_spindle

  L      MG_servo_drive_ready_S
  O      O_servo_drive_release_S
  AN     ML_fluid_through_spindle
  AN     TR_extern_DC_voltage_off_on
  =      TS_S_rotary_joint_cooling_off_delay

  L      WG_drive_temperature_S
  >=     K+50
  O      TS_S_rotary_joint_cooling_off_delay
  O      TR_S_rotary_joint_cooling_off_delay
  AN     ML_fluid_through_spindle
  AN     MG_TC_manual
  A      I_control_operational
  A      MG_spindle_active
  =      O_S_rotary_joint_cooling_circulation

  LN     O_S_rotary_joint_cooling_circulation
  AN[
    L      NP_S_and_CTS_blow_clean_valve_separated
    A      O_CTS_blow_clean
  ]
  AN[
    LN     NP_S_and_CTS_blow_clean_valve_separated
    A      O_spindle_blow_clean
  ]
  O      I_S_rotary_joint_cooling_circulation_ok
  =      TS_timeout_S_rotary_joint_cooling

  LN     TS_timeout_S_rotary_joint_cooling
  AN     TR_timeout_S_rotary_joint_cooling
  AN     I_S_rotary_joint_cooling_circulation_ok
  S      PN_error_S_rotary_joint_cooling_circulation
#else
  L      MG_spindle_active
  =      O_S_rotary_joint_cooling_circulation
#endif

EM

#if (Head = &S_head_type_01) or (Head = &S_head_type_02) or (Head = &S_head_type_05) or (Head = &S_head_type_06) or (Head = &S_head_type_09)
;----------------------------
LBL S_head

#if Head = &S_head_type_05
  L      MG_soft_key_S_man_head
  R      O_tool_unclamping
  S      O_tool_clamping
#endif

#if (MT = &MT_12) or (MT = &MT_13) or (MT = &MT_21) or (MT = &MT_32)  *;EUMACH
  L      WG_tool_in_spindle
  <>     K+0
  A      MG_soft_key_S_man_head
  AN     ML_soft_key_S_man_head
  R      MG_soft_key_S_man_head
  S      PN_error_TOOL_CALL_T0_necessary

  L      MG_soft_key_S_man_head
  =      ML_soft_key_S_man_head

  L      MG_soft_key_S_man_head
  A      MG_TC_automatic
#if Tool_changing_arm_2 ! &inactive                                   *;EUMACH Dual TC
  O      MG_TC2_automatic                                             *;EUMACH Dual TC
#endif                                                                *;EUMACH Dual TC
  S      PN_error_TC_automatic_prohibited

  L      MG_soft_key_S_man_head
  IFT
    L      NP_MP4231_31_S_head_S_limit_rpm
    /      K+10
    <      PN_D604_max_S_rpm_PLC
    IFT
      L      NP_MP4231_31_S_head_S_limit_rpm
      /      K+10
      =      PN_D604_max_S_rpm_PLC
    ENDI
  ENDI
#else
  LN     I_spindle_without_3D_head
  IFT
    L      NP_MP4231_31_S_head_S_limit_rpm
    /      K+10
    <      PN_D604_max_S_rpm_PLC
    IFT
      L      NP_MP4231_31_S_head_S_limit_rpm
      /      K+10
      =      PN_D604_max_S_rpm_PLC
    ENDI
  ENDI
#endif
EM
#endif

#if Head = &S_head_type_05
;----------------------------
LBL S_head_coupling

  L      MG_soft_key_S_man_head
  A      MG_soft_key_S_man_head_unclamp
  A      MG_spindle_stand_still
  AN     O_S_head_coupling_unclamping
  AN     MG_control_in_operation_on
  AN     MG_gear_change_active
  A      MG_control_operational
  S      O_S_head_coupling_unclamping

  L      MG_soft_key_S_man_head
  A      MG_soft_key_S_man_head_unclamp
  AN     O_S_head_coupling_clamping
  ON     MG_soft_key_S_man_head
  A      MG_control_operational
  S      O_S_head_coupling_clamping
  R      O_S_head_coupling_unclamping

  L      O_S_head_coupling_unclamping
  R      O_S_head_coupling_clamping

  L      MG_soft_key_S_man_head
  A      O_S_head_coupling_unclamping
  =      PN_error_S_head_coupling_not_clamped

EM
#endif

