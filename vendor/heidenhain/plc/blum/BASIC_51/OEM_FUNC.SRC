  LN     I_TC_magazine_lock_pin_in
  =      I_TC_magazine_lock_pin_out
#endif

 *;I_TC_magazine_guard_closed & I_TC_magazine_guard_locked_closed
 *;Machine with magazine guard
 *;1. The guard sensor but without lock device (non-servo magazine);
 *    the guard sensor with lock device (servo magazine)
 *;2. Operation panel on magazine side with magazine CW/CCW buttons, magazine
 *;   automatic/manual control mode switch (in automatic control mode, signal
 *;   = 1), and maybe a emergency stop button
 *;3. MP4310.4 = $4000 (NP_TC_mag_guard_and_panel = 1)
  LN     NP_TC_mag_guard_and_panel
  IFT
#if Tool_magazine ! &PLC_axis
    L      MG_marker_one
    =      I_TC_magazine_guard_closed
    =      I_TC_magazine_guard_locked_closed
;    =      I_TC_mag_2_guard_closed
;    =      I_TC_mag_2_guard_locked_closed
#else
    L      I_guard_1_closed
    =      I_TC_magazine_guard_closed
;    =      I_TC_mag_2_guard_closed

    L      I_guard_1_closed_locked
    =      I_TC_magazine_guard_locked_closed
;    =      I_TC_mag_2_guard_locked_closed
#endif
  ENDI

#if Tool_magazine ! &PLC_axis
  LN     NP_non_servo_mag_guard_with_lock_device
  IFT
    L      I_TC_magazine_guard_closed
    =      I_TC_magazine_guard_locked_closed
  ENDI
#else
  L      NP_TC_mag_guard_and_panel
  IFT
    LN     I_TC_magazine_guard_open_or_unlock
    =      I_TC_magazine_guard_locked_closed
  ENDI
#endif

#if Tool_magazine_2 ! &PLC_axis
  LN     NP_non_servo_mag2_guard_with_lock_device
  IFT
    L      I_TC_mag_2_guard_closed
    =      I_TC_mag_2_guard_locked_closed
  ENDI
#endif

 *;I_TC_arm_basic_pos, I_TC_arm_spindle_pos, & I_TC_arm_brake_pos
#if Tool_changing_arm = &Cam_driven_arm
  L      NP_TC_arm_in_pos_while_sensor=1
  IFT
    L      I_TC_arm_basic_pos_sensor
    =      I_TC_arm_basic_pos

    L      I_TC_arm_spindle_pos_sensor
    =      I_TC_arm_spindle_pos

    L      I_TC_arm_brake_pos_sensor
    =      I_TC_arm_brake_pos
  ELSE
    LN     I_TC_arm_basic_pos_sensor
    =      I_TC_arm_basic_pos

    LN     I_TC_arm_spindle_pos_sensor
    =      I_TC_arm_spindle_pos

    LN     I_TC_arm_brake_pos_sensor
    =      I_TC_arm_brake_pos
  ENDI
#endif

#if (MT = &MT_3B) and (Tool_magazine_system = &Mag_type_12)
  L      I_mag_grp_standby_pos_standby_cylinder
  AN     I_mag_grp_mag_pos_standby_cylinder
  A      I_mag_grp_magazine_pos_mag_cylinder
  AN     I_mag_grp_STDT_pocket_pos_mag_cylinder
  =      I_mag_gripper_on_standby_position

  LN     I_mag_grp_standby_pos_standby_cylinder
  A      I_mag_grp_mag_pos_standby_cylinder
  A      I_mag_grp_magazine_pos_mag_cylinder
  AN     I_mag_grp_STDT_pocket_pos_mag_cylinder
  =      I_mag_gripper_on_magazine_position

  LN     I_mag_grp_standby_pos_standby_cylinder
  A      I_mag_grp_mag_pos_standby_cylinder
  AN     I_mag_grp_magazine_pos_mag_cylinder
  A      I_mag_grp_STDT_pocket_pos_mag_cylinder
  =      I_mag_gripper_on_TC_STDT_pocket_position
#endif

 *;I_tool_clamped, I_tool_unclamped, I_tool_clamped_without_tool, I_tool_located_in_spindle
  LN     MG_spindle_active
  IFT
    L      MG_marker_one
    =      I_tool_clamped

    L      MG_marker_zero
    =      I_tool_unclamped
    =      I_tool_clamped_without_tool
    =      I_tool_located_in_spindle
  ELSE
#if Tool_clamping_sensor_type = &Digital *;===== digital sensor =====
#if (HSS = &inactive) and (Head ! &S_head_type_01) and (Head ! &S_head_type_02) and (Head ! &S_head_type_06) and (Head ! &S_head_type_09) and (Head ! &S_head_type_10)
#if (MT = &MT_22) or (MT = &MT_25A) or (MT = &MT_25B) or (MT = &MT_2MV) or (MT = &MT_32A) or (MT = &MT_32B) or (MT = &MT_35A) or (MT = &MT_35B)
    LN     I_tool_unclamped_sensor
    =      I_tool_clamped

    L      I_tool_unclamped_sensor
    =      I_tool_unclamped
#else
    L      I_tool_clamped_sensor
    =      I_tool_clamped

    L      I_tool_unclamped_sensor
    =      I_tool_unclamped
#endif
#endif

#if (HSS = &HS_type_01) or (HSS = &HS_type_19) or (HSS = &HS_type_42) or (HSS = &HS_type_43)  or (HSS = &HS_type_60) or (HSS = &HS_type_61) or (HSS = &HS_type_62) or (HSS = &HS_type_80) or (HSS = &HS_type_81) or (HSS = &HS_type_100)
    L      I_without_tool_clamped_sensor
    =      I_tool_clamped_without_tool

    L      I_tool_clamped_sensor
    O      I_tool_clamped_without_tool
    =      I_tool_clamped

#if (HSS = &HS_type_62) or (HSS = &HS_type_80)
    LN     I_tool_unclamped_sensor
    =      I_tool_unclamped
#else
    L      I_tool_unclamped_sensor
    =      I_tool_unclamped
#endif

    L      I_tool_clamped_sensor
    AN     I_tool_clamped_without_tool
    AN     I_tool_unclamped
    A      NP_tool_clamped_without_tool_sensor
    =      I_tool_located_in_spindle
#endif

#if (HSS = &HS_type_191) or (HSS = &HS_type_296) or (HSS = &HS_type_299)
    L      I_without_tool_clamped_sensor
    =      I_tool_clamped_without_tool

    L      I_tool_clamped_sensor
    O      I_tool_clamped_without_tool
    =      I_tool_clamped

    L      I_tool_unclamped_sensor
    =      I_tool_unclamped

    L      I_tool_clamped_sensor
    AN     I_tool_clamped_without_tool
    AN     I_tool_unclamped_sensor
    A      NP_tool_clamped_without_tool_sensor
    =      I_tool_located_in_spindle
#endif

#if HSS = &HS_type_298
    LN     I_tool_clamped_sensor
    A      I_without_tool_clamped_sensor
    =      I_tool_clamped_without_tool

    L      I_tool_clamped_sensor
    A      I_without_tool_clamped_sensor
    O      I_tool_clamped_without_tool
    =      I_tool_clamped

    L      I_tool_unclamped_sensor
    =      I_tool_unclamped

    L      I_tool_clamped_sensor
    A      I_without_tool_clamped_sensor
    AN     I_tool_unclamped_sensor
    A      NP_tool_clamped_without_tool_sensor
    =      I_tool_located_in_spindle
#endif

#if HSS = &HS_type_39
    L      I_tool_clamped_sensor
    A      I_without_tool_clamped_sensor
    =      I_tool_clamped_without_tool

    L      I_tool_clamped_sensor
    AN     I_without_tool_clamped_sensor
    O      I_tool_clamped_without_tool
    =      I_tool_clamped

    L      I_tool_unclamped_sensor
    =      I_tool_unclamped

    L      I_tool_clamped_sensor
    AN     I_without_tool_clamped_sensor
    AN     I_tool_unclamped_sensor
    A      NP_tool_clamped_without_tool_sensor
    =      I_tool_located_in_spindle
#endif

#if (Head = &S_head_type_01) or (Head = &S_head_type_02) or (Head = &S_head_type_10)
    L      I_spindle_without_3D_head
    IFT
      L      I_tool_unclamped_without_V_H_head
      =      I_tool_unclamped

      L      I_tool_clamped_without_V_H_head
      =      I_tool_clamped
    ENDI

    LN     I_spindle_without_3D_head
    IFT
      LN     NP_ITRI_head_without_tool_clamped_sensor
      IFT
        L      I_tool_unclamped_with_V_H_head
        =      I_tool_unclamped

        L      I_tool_clamped_with_V_H_head
        =      I_tool_clamped
      ELSE
        L      I_tool_unclamped_with_V_H_head
        =      I_tool_unclamped

        LN     I_tool_unclamped_with_V_H_head
        =      I_tool_clamped
      ENDI
    ENDI
#endif

#if Head = &S_head_type_06
#if (MT = &MT_12) or (MT = &MT_13) or (MT = &MT_21) or (MT = &MT_32)  *;EMACH
    L      MG_soft_key_S_man_head
    IFT
      LN     O_tool_unclamping
      =      I_tool_clamped

      L      O_tool_unclamping
      =      I_tool_unclamped
    ENDI

    LN     MG_soft_key_S_man_head
    IFT
      L      I_tool_clamped_sensor
      =      I_tool_clamped

      L      I_tool_unclamped_sensor
      =      I_tool_unclamped
    ENDI
#else                                                                 *;EUMACH
    L      I_spindle_without_3D_head                                    *;EUMACH
    IFT                                                                 *;EUMACH
      L      I_tool_unclamped_without_V_H_head                          *;EUMACH
      =      I_tool_unclamped                                           *;EUMACH
                                                                      *;EUMACH
      L      I_tool_clamped_without_V_H_head                            *;EUMACH
      =      I_tool_clamped                                             *;EUMACH
    ENDI                                                                *;EUMACH

    LN     I_spindle_without_3D_head                                    *;EUMACH
    IFT                                                                 *;EUMACH
      L      I_tool_unclamped_with_V_H_head                             *;EUMACH
      =      I_tool_unclamped                                           *;EUMACH

      LN     I_tool_unclamped_with_V_H_head                             *;EUMACH
      =      I_tool_clamped                                             *;EUMACH
    ENDI                                                                *;EUMACH
#endif                                                                *;EUMACH
#endif

#if Head = &S_head_type_09
    L      I_spindle_without_3D_head
    IFT
      L      I_tool_unclamped_without_V_H_head
      =      I_tool_unclamped

      L      I_tool_clamped_without_V_H_head
      =      I_tool_clamped
    ENDI

    LN     I_spindle_without_3D_head
    IFT
      L      I_tool_unclamped_with_V_H_head
      =      I_tool_unclamped

      LN     I_tool_unclamped_with_V_H_head
      =      I_tool_clamped
    ENDI
#endif
#endif                                   *;===== digital sensor =====

#if (Tool_clamping_sensor_type = &Analog) or (Tool_unclamping_sensor_type = &Analog)  *;===== analog sensor =====
*;EUMACH HSCI not required
;    PS     KL_voltage_input_0
;    CM     9003
;    PL     WG_voltage_input_0_on_MC
;    M_display_module_error(KG_error_module_9003)
*;EUMACH HSCI not required

    L      WL_T_clamp_unclamp_voltage_counter
    =X

;    L      WG_voltage_input_0_on_MC                                     *;EUMACH non-HSCI
    L      IW_S_tool_clamp_unclamp_sensor_voltage                       *;EUMACH HSCI
    =      WL_T_clamp_unclamp_sensor_voltage[X]

    INC    WL_T_clamp_unclamp_voltage_counter

    L      WL_T_clamp_unclamp_voltage_counter
    >=     KL_T_clamp_unclamp_voltage_counter
    IFT
      L      K+0
      =      WL_T_clamp_unclamp_voltage_counter
    ENDI

    L      K+0
    =      DL_T_clamp_unclamp_average_voltage
    =X

    REPEAT
      L      WL_T_clamp_unclamp_sensor_voltage[X]
      +      DL_T_clamp_unclamp_average_voltage
      =      DL_T_clamp_unclamp_average_voltage

      INCX

      LX
      >=     KL_T_clamp_unclamp_voltage_counter
    UNTILT

    L      DL_T_clamp_unclamp_average_voltage
    /      KL_T_clamp_unclamp_voltage_counter
    =      DL_T_clamp_unclamp_average_voltage

    L      DL_T_clamp_unclamp_average_voltage
    X      K+100
    <=     NP_MP4230_28_no_tool_clamped_V_upper_lim
    A[
      L      DL_T_clamp_unclamp_average_voltage
      X      K+100
      >=     NP_MP4230_29_no_tool_clamped_V_lower_lim
    ]
    =      I_tool_clamped_without_tool

    L      DL_T_clamp_unclamp_average_voltage
    X      K+100
    <=     NP_MP4230_26_tool_clamped_V_upper_lim
    A[
      L      DL_T_clamp_unclamp_average_voltage
      X      K+100
      >=     NP_MP4230_27_tool_clamped_V_lower_lim
    ]
    O      I_tool_clamped_without_tool
    =      I_tool_clamped

#if Tool_unclamping_sensor_type = &Analog
    L      DL_T_clamp_unclamp_average_voltage
    X      K+100
    <=     NP_MP4230_24_tool_unclamped_V_upper_lim
    A[
      L      DL_T_clamp_unclamp_average_voltage
      X      K+100
      >=     NP_MP4230_25_tool_unclamped_V_lower_lim
    ]
    =      I_tool_unclamped
#else
#if (HSS = &HS_type_62) or (HSS = &HS_type_80)
    LN     I_tool_unclamped_sensor_inverse
    =      I_tool_unclamped
#endif
#endif

    L      I_tool_clamped
    AN     I_tool_clamped_without_tool
    AN     I_tool_unclamped
    A      NP_tool_clamped_without_tool_sensor
    =      I_tool_located_in_spindle
#endif                                   *;===== analog sensor =====
  ENDI

 *;I_machine_in_TC_area
#if (MT = &MT_17) or (MT = &MT_22) or (MT = &MT_32B)
  L      NP_TC_within_machining_area
  IFT
    L      MG_marker_zero
    =      I_machine_in_TC_area
  ELSE
    L      NP_W1032_reference_nesessary
    BT     KG_axis_X
    AN[                                                               *;EUMACH MP1352
      L      WG_MP1352_power_off_pos_saved                            *;EUMACH MP1352
      BT     KG_axis_X                                                *;EUMACH MP1352
    ]                                                                 *;EUMACH MP1352
    IFT
      L      DG_position_axis_X_ref_accumulator
      <>     K+0
      A      NP_M4172_1st_PLC_run_after_power_on
      IFT
        L      DG_position_axis_X_ref_accumulator
        =      DG_position_axis_X_ref_power_off
      ENDI

      L      DG_position_axis_X_ref_power_off
      +      DG_position_axis_X_ref
      =      DG_position_axis_X_ref_accumulator

#if MT = &MT_17
      L      DG_MP920_X_limit_switch
#endif
#if (MT = &MT_22) or (MT = &MT_32B)
      L      DG_MP922_X_limit_switch
#endif
      -      K+1000
      >      DG_position_axis_X_ref_accumulator
      AN     I_not_ref_end_posit_X
      =      I_machine_in_TC_area
    ELSE
      L      K+0
      =      DG_position_axis_X_ref_accumulator

      L      DG_position_axis_X_ref
      =      DG_position_axis_X_ref_power_off

#if MT = &MT_17
      L      DG_MP920_X_limit_switch
#endif
#if (MT = &MT_22) or (MT = &MT_32B)
      L      DG_MP922_X_limit_switch
#endif
      -      K+1000
      >      DG_position_axis_X_ref
      AN     I_not_ref_end_posit_X
      =      I_machine_in_TC_area
    ENDI
  ENDI
#endif

#if (MT = &MT_12) or (MT = &MT_13) or (MT = &MT_15) or (MT = &MT_15A) or (MT = &MT_16) or (MT = &MT_21) or (MT = &MT_2D) or (MT = &MT_32) or (MT = &MT_32A)
  L      NP_TC_within_machining_area
  IFT
    L      MG_marker_zero
    =      I_machine_in_TC_area
  ELSE
    L      NP_W1032_reference_nesessary
    BT     KG_axis_Y
    AN[                                                               *;EUMACH MP1352
      L      WG_MP1352_power_off_pos_saved                            *;EUMACH MP1352
      BT     KG_axis_Y                                                *;EUMACH MP1352
    ]                                                                 *;EUMACH MP1352
    IFT
      L      DG_position_axis_Y_ref_accumulator
      <>     K+0
      A      NP_M4172_1st_PLC_run_after_power_on
      IFT
        L      DG_position_axis_Y_ref_accumulator
        =      DG_position_axis_Y_ref_power_off
      ENDI

      L      DG_position_axis_Y_ref_power_off
      +      DG_position_axis_Y_ref
      =      DG_position_axis_Y_ref_accumulator

      L      DG_MP910_Y_limit_switch
      +      K+1000
      <      DG_position_axis_Y_ref_accumulator
      AN     I_not_ref_end_posit_Y
      =      I_machine_in_TC_area
    ELSE
      L      K+0
      =      DG_position_axis_Y_ref_accumulator

      L      DG_position_axis_Y_ref
      =      DG_position_axis_Y_ref_power_off

      L      DG_MP910_Y_limit_switch
      +      K+1000
      <      DG_position_axis_Y_ref
      AN     I_not_ref_end_posit_Y
      =      I_machine_in_TC_area
    ENDI
  ENDI
#endif

#if (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
  LN     I_Y_within_travel_range
  =      I_machine_in_TC_area
#endif

 *;I_spindle_without_3D_head
#if (Head = &S_head_type_01) or (Head = &S_head_type_02) or (Head = &S_head_type_06) or (Head = &S_head_type_09) or (Head = &S_head_type_10)
#if MT = &MT_3A
  LN     I_spindle_with_3D_head
  =      I_spindle_without_3D_head
#endif
#endif

 *;I_S_actual_equal_nominal_rpm & I_S_actual_lower_nominal_rpm
#if HSS = &HS_type_299
  L      I_S_rpm_ok
  ON     I_S_actual_not_0_rpm
  =      I_S_actual_equal_nominal_rpm
  =      NP_M4001_S_nominal_not_in_ramp

  LN     I_S_actual_not_0_rpm
  =      I_S_actual_lower_nominal_rpm
#endif

 *;I_CTS_tank_high_level_ok
#if (M7TK = &CTS_tank_01) or (M7TK = &CTS_tank_02) or (M7TK = &CTS_tank_04) or (M7TK = &CTS_tank_05) or (M7TK = &CTS_tank_06) or (M7TK = &CTS_tank_07)
  LN     I_CTS_tank_high_level_sensor
  =      I_CTS_tank_high_level_ok
#endif

 *;I_CTS_tank_low_level_ok
#if (M7TK = &CTS_tank_01) or (M7TK = &CTS_tank_02) or (M7TK = &CTS_tank_04)
  L      I_CTS_tank_low_level_sensor
  =      I_CTS_tank_low_level_ok
#endif

#if (M7TK = &CTS_tank_05) or (M7TK = &CTS_tank_06) or (M7TK = &CTS_tank_07)
  LN     I_CTS_tank_low_level_sensor
  =      I_CTS_tank_low_level_ok
#endif

 *;I_CTS_tank_level_overflow
#if (M7TK = &CTS_tank_05) or (M7TK = &CTS_tank_06) or (M7TK = &CTS_tank_07)
  LN     I_CTS_tank_overflow_level_sensor
  =      I_CTS_tank_level_overflow
#endif

 *;I_alternat_table_partition_removed
#if MT = &MT_2D
  L      NP_D276_code_number_entered_via_MOD
  ==     KL_partition_removed_code
  S      I_alternat_table_partition_removed
  RN     I_alternat_table_partition_removed
  R      MG_alternating_table_on
  SN     MG_alternating_table_on
#endif

  L      NP_air_to_hydraulic_unit
  IFT
    LN     I_air_to_hydraulic_oil_level_sensor
    =      I_air_to_hydraulic_unit_oil_level_ok
  ELSE
    L      MG_marker_one
    =      I_air_to_hydraulic_unit_oil_level_ok
  ENDI

 *;I_TC_pocket_clamped, I_TC_pocket_unclamped
  LN     I_TC_pocket_clamped
  =      I_TC_pocket_unclamped

EM

;----------------------------
LBL Maker_reassignment

  L      NP_D276_code_number_entered_via_MOD
  ==     KL_service_code
  S      MG_service_operation

  L      NP_D276_code_number_entered_via_MOD
  ==     KL_service_code_inactive
  R      MG_service_operation

  L      NP_D276_code_number_entered_via_MOD
  ==     KL_sensor_calibration_active
  S      MG_sensor_calibration_active

  L      NP_D276_code_number_entered_via_MOD
  ==     KL_sensor_calibration_inactive
  R      MG_sensor_calibration_active

  L      NP_D276_code_number_entered_via_MOD
  ==     KL_spindle_warmed_up_active
  S      MG_S_warmed_up_service

  L      NP_D276_code_number_entered_via_MOD
  ==     KL_spindle_warmed_up_inactive
  R      MG_S_warmed_up_service

 *;MG_MP_are_read_p_pulse
  L      MG_machine_parameter_are_read
  AN     ML_machine_parameter_are_read
  =      MG_MP_are_read_p_pulse

  L      MG_machine_parameter_are_read
  =      ML_machine_parameter_are_read

 *;MG_key_spindle_start, MG_key_spindle_stop
#if Panel_S_start_stop = &active                                      *;EUMACH
  L      I_key_spindle_start
  O      I_HR410_key_spindle_start
#endif                                                                *;EUMACH
#if Panel_M03_M04_M05 = &active                                       *;EUMACH
  L      I_key_spindle_M3                                             *;EUMACH
  O      MG_soft_key_spindle_M3                                       *;EUMACH
  A      PN_M4005_S_M03_nominal_and_status                            *;EUMACH
  O[                                                                  *;EUMACH
    L      I_key_spindle_M4                                           *;EUMACH
    A      PN_M4006_S_M04_nominal_and_status                          *;EUMACH
  ]                                                                   *;EUMACH
  A      PN_M4008_S_nominal_off_status_inverse                        *;EUMACH
  AN     NP_M4150_mode_manual                                         *;EUMACH
  AN     NP_M4151_mode_electronic_handwheel                           *;EUMACH
  AN     NP_M4155_mode_pass_over_reference                            *;EUMACH
  O      I_key_spindle_start                                          *;EUMACH
  O      I_HR410_key_spindle_start                                    *;EUMACH
  O[                                                                  *;EUMACH
    L      NP_M4150_mode_manual                                       *;EUMACH
    O      NP_M4151_mode_electronic_handwheel                         *;EUMACH
    O      NP_M4155_mode_pass_over_reference                          *;EUMACH
    A      I_HR410_key_NC_start                                       *;EUMACH
  ]                                                                   *;EUMACH
#endif                                                                *;EUMACH
  =      MG_key_spindle_start

#if Panel_S_start_stop = &active                                      *;EUMACH
  L      I_key_spindle_stop
  O      I_HR410_key_NC_stop
#endif                                                                *;EUMACH
#if Panel_M03_M04_M05 = &active                                       *;EUMACH
  L      I_key_spindle_M5                                             *;EUMACH
  O      MG_soft_key_spindle_M5                                       *;EUMACH
  AN     NP_M4150_mode_manual                                         *;EUMACH
  AN     NP_M4151_mode_electronic_handwheel                           *;EUMACH
  AN     NP_M4155_mode_pass_over_reference                            *;EUMACH
  O      I_key_spindle_stop                                           *;EUMACH
  O      I_HR410_key_spindle_stop                                     *;EUMACH
#endif                                                                *;EUMACH
  =      MG_key_spindle_stop

 *;MG_manual_spindle_head_installed
#if (Head = &S_head_type_06) or (Head = &S_head_type_09) or (Head = &S_head_type_10)
  LN     I_spindle_without_3D_head
  =      MG_manual_V_H_head_installed
#endif

*; For manual heads with rotational direction reversed:
*; Without the following PLC, it can happen: M19 -> manual head on/off (by soft key or sensor) -> spindle out of control
#if (Head = &S_head_type_06) or (Head = &S_head_type_09)
#if Head = &S_head_type_06
#if (MT = &MT_12) or (MT = &MT_13) or (MT = &MT_21) or (MT = &MT_32)
  L      MG_soft_key_S_man_head
#else
  L      MG_manual_V_H_head_installed
#endif
  =      ML_manual_head_on
#endif

#if Head = &S_head_type_09
  L      MG_manual_V_H_head_installed
  =      ML_manual_head_on
#endif

  L      ML_manual_head_on
  AN     ML_manual_head_on_temp
  =      ML_manual_head_on_p_pulse

  LN     ML_manual_head_on
  A      ML_manual_head_on_temp
  =      ML_manual_head_on_n_pulse

  L      ML_manual_head_on
  =      ML_manual_head_on_temp

  L      ML_manual_head_on_p_pulse
  O      ML_manual_head_on_n_pulse
  IFT
    L      K+0
    =      BL_manual_head_on_off_delay_timer_sec
  ENDI

  L      BL_manual_head_on_off_delay_timer_sec
  <=     KL_manual_head_on_off_delay_timer_sec
  S      MG_manual_head_on_off_processing

  L      MG_manual_head_on_off_processing
  A      MG_pulse_1_s
  IFT
    INC    BL_manual_head_on_off_delay_timer_sec
  ENDI

  L      BL_manual_head_on_off_delay_timer_sec
  >      KL_manual_head_on_off_delay_timer_sec
  R      MG_manual_head_on_off_processing
#endif

#if (Head = &S_head_type_01) or (Head = &S_head_type_02)
 *;MG_automatic_V_H_head_installed is also used in M73.MH
  LN     I_spindle_without_3D_head
  =      MG_automatic_V_H_head_installed

 *;MG_traverse_range_M_codes_prohibited is used in M71.MH/M72.MH/M73.MH
  L      I_spindle_without_3D_head
  =      MG_traverse_range_M_codes_prohibited

 *;MG_spindle_head_in_vertical_pos is used in BS_INIT.MH/M71.MH
  LN     I_spindle_without_3D_head
  A      I_V_H_head_in_vertical_pos
  AN     I_V_H_head_in_horizontal_pos
  =      MG_V_H_head_in_vertical_pos

 *;MG_spindle_head_in_horizontal_pos is used in BS_INIT.MH/M72.MH
  LN     I_spindle_without_3D_head
  AN     I_V_H_head_in_vertical_pos
  A      I_V_H_head_in_horizontal_pos
  =      MG_V_H_head_in_horizontal_pos

 *;MG_DCM_coordinates_configuration is used in BS_INIT.MH/M71.MH/M72.MH
#if MT = &MT_3A
  L      MG_automatic_V_H_head_installed
  A      NP_DCM_option_purchased
  =      MG_DCM_coordinates_configuration
#else
  L      MG_marker_zero
  =      MG_DCM_coordinates_configuration
#endif

#endif

#if (Head = &S_head_type_06) or (Head = &S_head_type_09)
 *;MG_traverse_range_M_codes_prohibited is used in M71.MH/M72.MH/M73.MH
  L      NP_manual_head_rear_axis_0_pos_sensor
  =      MG_traverse_range_M_codes_prohibited
#endif

#if Head = &S_head_type_10
 *;MG_traverse_range_M_codes_prohibited is used in M71.MH/M72.MH/M73.MH
  L      MG_marker_one
  =      MG_traverse_range_M_codes_prohibited
#endif

#if (Head = &S_head_type_01) or (Head = &S_head_type_02)
 *;MG_S_head_clamped_and_in_pos
  L      I_V_H_head_in_vertical_pos
  XO     I_V_H_head_in_horizontal_pos
  A      I_V_H_head_clamped
  AN     I_V_H_head_unclamped
  A      MG_automatic_V_H_head_installed
  ON     MG_automatic_V_H_head_installed
  =      MG_V_H_head_clamped_and_in_pos
#endif

#if Pallet_changer = &Alternat_table
 *;MG_machine_in_table_1
  L      NP_W1032_reference_nesessary
  BT     KG_axis_X
  AN[                                                                 *;EUMACH MP1352
    L      WG_MP1352_power_off_pos_saved                              *;EUMACH MP1352
    BT     KG_axis_X                                                  *;EUMACH MP1352
  ]                                                                   *;EUMACH MP1352
  IFT
    L      DG_position_axis_X_ref_accumulator
    <>     K+0
    A      NP_M4172_1st_PLC_run_after_power_on
    IFT
      L      DG_position_axis_X_ref_accumulator
      =      DG_position_axis_X_ref_power_off
    ENDI

    L      DG_position_axis_X_ref_power_off
    +      DG_position_axis_X_ref
    =      DG_position_axis_X_ref_accumulator

    L      NP_D940_limit_X_alternating_table
    <      DG_position_axis_X_ref_accumulator
    =      MG_machine_in_table_1
  ELSE
    L      K+0
    =      DG_position_axis_X_ref_accumulator

    L      DG_position_axis_X_ref
    =      DG_position_axis_X_ref_power_off

    L      NP_D940_limit_X_alternating_table
    <      DG_position_axis_X_ref
    =      MG_machine_in_table_1
  ENDI

 *;MG_alt_table_automatic_workpiece_loaded
  L      NP_D276_code_number_entered_via_MOD
  ==     KL_alt_table_automatic_workpiece_loaded
  S      MG_alt_table_automatic_workpiece_loaded

  L      NP_D276_code_number_entered_via_MOD
  ==     KL_alt_table_manual_workpiece_loaded
  R      MG_alt_table_automatic_workpiece_loaded

 *;MG_TOOL_CALL_0_before_M61_M62
#if MT = &MT_2D
  L      MG_marker_one
  =      MG_TOOL_CALL_0_before_M61_M62
#endif

 *;MG_kinematic_table_switching
#if MT = &MT_2D
  L      MG_marker_one
  =      MG_kinematic_table_switching
#endif
#endif

#if (MT = &MT_25A) or (MT = &MT_25B) or (MT = &MT_2MV) or (MT = &MT_35A) or (MT = &MT_35B) or (Working_area_monitoring = &active)
#if Working_area_monitoring = &active
  L      KG_clamping_mode_active
  BT     KG_axis_Z
  IFT
#endif
    L      NP_W1032_reference_nesessary
    BT     KG_axis_Y
    AN[                                                                 *;EUMACH MP1352
      L      WG_MP1352_power_off_pos_saved                              *;EUMACH MP1352
      BT     KG_axis_Y                                                  *;EUMACH MP1352
    ]                                                                   *;EUMACH MP1352
    IFT
      L      DG_position_axis_Y_ref_accumulator
      <>     K+0
      A      NP_M4172_1st_PLC_run_after_power_on
      IFT
        L      DG_position_axis_Y_ref_accumulator
        =      DG_position_axis_Y_ref_power_off
      ENDI

      L      DG_position_axis_Y_ref_power_off
      +      DG_position_axis_Y_ref
      =      DG_position_axis_Y_ref_accumulator
#if Working_area_monitoring = &active
      =      DG_pos_axis_Y_ref_working_area
#endif
    ELSE
      L      K+0
      =      DG_position_axis_Y_ref_accumulator

      L      DG_position_axis_Y_ref
      =      DG_position_axis_Y_ref_power_off
#if Working_area_monitoring = &active
      =      DG_pos_axis_Y_ref_working_area
#endif
    ENDI
#if Working_area_monitoring = &active
  ENDI
#endif
#endif

#if (MT = &MT_25A) or (MT = &MT_25B) or (MT = &MT_2MV) or (MT = &MT_35A) or (MT = &MT_35B)
  L      MG_marker_one
  S      MG_head_angle_protected_by_traverse_range
#endif

#if (MT = &MT_31A) or (MT = &MT_31B) or (MT = &MT_32A) or (MT = &MT_36B) or (MT = &MT_37B) or (MT = &MT_39A) or (MT = &MT_3AA) or (MT = &MT_3B) or (MT = &MT_3BA)
  L      MG_marker_one
  S      MG_head_angle_protected_by_traverse_range
#endif

#if Pallet_changer ! &Alternat_table
  L      MG_marker_one
  R      MG_alternating_table_on
#endif

#if Working_area_monitoring = &active
  L      KG_clamping_mode_active
  BT     KG_axis_Y
#if MT = &MT_3A
  O[
    L      KG_clamping_mode_active
    BT     KG_axis_Z
    A      NP_DCM_option_purchased
  ]
#endif
  IFT
    L      NP_W1032_reference_nesessary
    BT     KG_axis_Z
    AN[                                                                 *;EUMACH MP1352
      L      WG_MP1352_power_off_pos_saved                              *;EUMACH MP1352
      BT     KG_axis_Z                                                  *;EUMACH MP1352
    ]                                                                   *;EUMACH MP1352
    IFT
      L      DG_position_axis_Z_ref_accumulator
      <>     K+0
      A      NP_M4172_1st_PLC_run_after_power_on
      IFT
        L      DG_position_axis_Z_ref_accumulator
        =      DG_position_axis_Z_ref_power_off
      ENDI

      L      DG_position_axis_Z_ref_power_off
      +      DG_position_axis_Z_ref
      =      DG_position_axis_Z_ref_accumulator
      =      DG_pos_axis_Z_ref_working_area
    ELSE
      L      K+0
      =      DG_position_axis_Z_ref_accumulator

      L      DG_position_axis_Z_ref
      =      DG_position_axis_Z_ref_power_off
      =      DG_pos_axis_Z_ref_working_area
    ENDI
  ENDI

  L      NP_W1032_reference_nesessary
  BT     KG_axis_4
  AN[                                                                 *;EUMACH MP1352
    L      WG_MP1352_power_off_pos_saved                              *;EUMACH MP1352
    BT     KG_axis_4                                                  *;EUMACH MP1352
  ]                                                                   *;EUMACH MP1352
  IFT
    L      DG_position_axis_4_ref_accumulator
    <>     K+0
    A      NP_M4172_1st_PLC_run_after_power_on
    IFT
      L      DG_position_axis_4_ref_accumulator
      =      DG_position_axis_4_ref_power_off
    ENDI

    L      DG_position_axis_4_ref_power_off
    +      DG_position_axis_4_ref
    MOD    K+3600000
    =      DG_position_axis_4_ref_accumulator
    =      DG_pos_axis_4_ref_working_area
  ELSE
    L      K+0
    =      DG_position_axis_4_ref_accumulator

    L      DG_position_axis_4_ref
    =      DG_position_axis_4_ref_power_off
    =      DG_pos_axis_4_ref_working_area
  ENDI
#endif

  L      NP_M4172_1st_PLC_run_after_power_on
  O      NP_M4173_1st_PLC_run_after_compile
  S      MG_soft_key_fluid_flow_valve

#if KC = &KC_type_inactive
  L      K-1
  =      BG_KINEMATICS_assignment
#endif
#if KC = &KC_type_service_mode
  L      K+0
  =      BG_KINEMATICS_assignment
#endif
#if KC = &KC_type_01
  L      K+1
  =      BG_KINEMATICS_assignment
#endif
#if KC = &KC_type_02
  L      K+2
  =      BG_KINEMATICS_assignment
#endif
#if KC = &KC_type_03
  L      K+3
  =      BG_KINEMATICS_assignment
#endif
#if KC = &KC_type_04
  L      K+4
  =      BG_KINEMATICS_assignment
#endif
#if KC = &KC_type_05
  L      K+5
  =      BG_KINEMATICS_assignment
#endif

  L      NP_M4172_1st_PLC_run_after_power_on
  O      NP_M4173_1st_PLC_run_after_compile
  S      MG_magazine_pos_backlash_ignored_at_power_on

  L      MG_mag_axis_encoder_incremental
  O      MG_posit_active_TC_magazine
  R      MG_magazine_pos_backlash_ignored_at_power_on

EM

;----------------------------
LBL Datum_shifting

#if (Head = &S_head_type_01) or (Head = &S_head_type_02)
  L      I_spindle_without_3D_head
  AN     I_V_H_head_in_vertical_pos
  AN     I_V_H_head_in_horizontal_pos
  ON     NP_V_H_head_geometry_compensation
#if MT = &MT_3A
  O      NP_DCM_option_purchased
#endif
  AN     MG_V_H_head_no_geometry_datum_shift
  AN     PN_M4132_strobe_datum_correction
  S      MG_V_H_head_no_geometry_datum_shift
  R      MG_V_H_head_H_to_V_geometry_datum_shift
  R      MG_V_H_head_V_to_H_geometry_datum_shift
  S      PN_M4132_strobe_datum_correction
  IFT
    L      K+0
    =      PN_D528_PLC_posit_datum_correction_X
    =      PN_D532_PLC_posit_datum_correction_Y
    =      PN_D536_PLC_posit_datum_correction_Z
  ENDI

  L      MG_MP_are_read_p_pulse
  R      MG_V_H_head_H_to_V_geometry_datum_shift
  R      MG_V_H_head_V_to_H_geometry_datum_shift

  L      I_V_H_head_in_vertical_pos
  AN     I_V_H_head_in_horizontal_pos
  AN     I_spindle_without_3D_head
  AN     MG_V_H_head_H_to_V_geometry_datum_shift
#if MT = &MT_3A
  AN     NP_DCM_option_purchased
#endif
  AN     PN_M4132_strobe_datum_correction
  A      NP_V_H_head_geometry_compensation
  A      MG_machine_parameter_are_read
  R      MG_V_H_head_no_geometry_datum_shift
  S      MG_V_H_head_H_to_V_geometry_datum_shift
  R      MG_V_H_head_V_to_H_geometry_datum_shift
  S      PN_M4132_strobe_datum_correction
  IFT
    L      K+0
    =      PN_D528_PLC_posit_datum_correction_X
    =      PN_D532_PLC_posit_datum_correction_Y
    =      PN_D536_PLC_posit_datum_correction_Z
  ENDI

  LN     I_V_H_head_in_vertical_pos
  A      I_V_H_head_in_horizontal_pos
  AN     I_spindle_without_3D_head
  AN     MG_V_H_head_V_to_H_geometry_datum_shift
#if MT = &MT_3A
  AN     NP_DCM_option_purchased
#endif
  AN     PN_M4132_strobe_datum_correction
  A      NP_V_H_head_geometry_compensation
  A      MG_machine_parameter_are_read
  R      MG_V_H_head_no_geometry_datum_shift
  R      MG_V_H_head_H_to_V_geometry_datum_shift
  S      MG_V_H_head_V_to_H_geometry_datum_shift
  S      PN_M4132_strobe_datum_correction
  IFT
    L      NP_MP4231_7_V_H_head_geometric_X_offset
    =      PN_D528_PLC_posit_datum_correction_X

    L      NP_MP4231_8_V_H_head_geometric_Y_offset
    =      PN_D532_PLC_posit_datum_correction_Y

    L      NP_MP4231_9_V_H_head_geometric_Z_offset
    =      PN_D536_PLC_posit_datum_correction_Z
  ENDI
#endif

EM

;----------------------------
LBL REF_position_initialization

#if Head = &S_head_type_02
  L      NP_M4172_1st_PLC_run_after_power_on
  IFT
    PS     KG_axis_5
    PS     DG_position_axis_5_ref_power_off
    CM     9147
  ENDI

  L      ML_V_H_head_B_pos_initialized
  AN     ML_temp_V_H_head_B_pos_initialized
  R      ML_V_H_head_B_pos_initialized
  IFT
    PS     KG_axis_5
    PS     DG_V_H_head_B_initial_pos_REF
    CM     9147
  ENDI

  L      ML_V_H_head_B_pos_initialized
  =      ML_temp_V_H_head_B_pos_initialized

  L      MG_soft_key_S_head_pos_display
  O      MG_soft_key_S_head_pos_reset
  IFT
    L      MG_soft_key_S_head_pos_display
    AN     ML_S_head_pos_display_has_been_active
    R      MG_soft_key_S_head_pos_reset

    L      MG_soft_key_S_head_pos_display
    =      ML_S_head_pos_display_has_been_active

    L      MG_soft_key_S_head_pos_reset
    AN     ML_S_head_pos_reset_has_been_active
    R      MG_soft_key_S_head_pos_display

    L      MG_soft_key_S_head_pos_reset
    =      ML_S_head_pos_reset_has_been_active

    L      NP_W274_code_pushed_key
    ==     KG_key_enter
    A      MG_soft_key_S_head_pos_reset
    S      ML_V_H_head_B_pos_initialized
    S      ML_V_H_head_B_pos_confirmed
    R      MG_soft_key_S_head_pos_reset
    S      MG_soft_key_S_head_pos_display
  ENDI

  L      MG_reference_axes_traversed
  AN     ML_V_H_head_B_pos_confirmed
  =      PN_error_3D_head_pos_confirmation

  L      MG_soft_key_S_head_pos_confirm
  S      ML_V_H_head_B_pos_confirmed

  L      DG_position_axis_5_ref
  =      DG_position_axis_5_ref_power_off
#endif

#if (MT = &MT_25A) or (MT = &MT_35A)
  L      KG_axes_with_common_used_position_ROD
  BT     KG_3D_head_axis_2
  A      NP_M4172_1st_PLC_run_after_power_on
  A      MG_3D_head_setup_ok
  S      PN_error_3D_head_pos_confirmation
#endif

#if (MT = &MT_22) or (MT = &MT_25B) or (MT = &MT_2MV) or (MT = &MT_32B) or (MT = &MT_35B)
  L      KG_axes_with_common_used_position_ROD
  BT     KG_3D_head_axis_1
  A      NP_M4172_1st_PLC_run_after_power_on
  A      MG_3D_head_setup_ok
  S      ML_3D_head_axis_1_pos_confirmation

  L      KG_axes_with_common_used_position_ROD
  BT     KG_3D_head_axis_2
  A      NP_M4172_1st_PLC_run_after_power_on
  A      MG_3D_head_setup_ok
  S      ML_3D_head_axis_2_pos_confirmation

  L      WG_controlled_axes
  BT     KG_3D_head_axis_1
  A      ML_3D_head_axis_1_pos_confirmation
  O[
    L      WG_controlled_axes
    BT     KG_3D_head_axis_2
    A      ML_3D_head_axis_2_pos_confirmation
  ]
  S      PN_error_3D_head_pos_confirmation
  R      ML_3D_head_axis_1_pos_confirmation
  R      ML_3D_head_axis_2_pos_confirmation
#endif

#if MT = &MT_3A
  L      NP_M4172_1st_PLC_run_after_power_on
  A      MG_automatic_V_H_head_installed
  A      NP_DCM_option_purchased
  IFT
    PS     KG_axis_5
    PS     DG_position_axis_5_ref_power_off
    CM     9147

    PS     KG_axis_6
    PS     DG_position_axis_6_ref_power_off
    CM     9147
  ENDI

  L      DG_position_axis_5_ref
  =      DG_position_axis_5_ref_power_off

  L      DG_position_axis_6_ref
  =      DG_position_axis_6_ref_power_off
#endif

EM

;----------------------------
LBL KINEMATICS_assignment

#if MT = &MT_3A
  LN     NP_DCM_option_purchased
  EMT

  *;V/H head in vertical position
  L      MG_V_H_head_in_vertical_pos
  A      NP_M4173_1st_PLC_run_after_compile
  O[
    L      MG_V_H_head_in_vertical_pos
    AN     ML_V_H_head_was_in_vertical_pos
    AN     NP_M4176_control_in_operation_on_or_flashes
  ]
  S      ML_VMC_KINEMATICS_A0_request
  R      ML_VMC_KINEMATICS_A180_request
  R      ML_HMC_KINEMATICS_request

  L      MG_V_H_head_in_vertical_pos
  =      ML_V_H_head_was_in_vertical_pos

  *;V/H head in horizontal position
  L      MG_V_H_head_in_horizontal_pos
  A      NP_M4173_1st_PLC_run_after_compile
  O[
    L      MG_V_H_head_in_horizontal_pos
    AN     ML_V_H_head_was_in_horizontal_pos
    AN     NP_M4176_control_in_operation_on_or_flashes
  ]
  R      ML_VMC_KINEMATICS_A0_request
  S      ML_VMC_KINEMATICS_A180_request
  R      ML_HMC_KINEMATICS_request

  L      MG_V_H_head_in_horizontal_pos
  =      ML_V_H_head_was_in_horizontal_pos

  *;V/H head removed
  L      MG_automatic_V_H_head_installed
  AN     ML_automatic_V_H_head_was_installed
  =      ML_V_H_head_installed_p_pulse

  LN     MG_automatic_V_H_head_installed
  A      ML_automatic_V_H_head_was_installed
  =      ML_V_H_head_installed_n_pulse

  L      MG_automatic_V_H_head_installed
  =      ML_automatic_V_H_head_was_installed

  LN     MG_automatic_V_H_head_installed
  A      NP_M4173_1st_PLC_run_after_compile
  O      ML_V_H_head_installed_n_pulse
  R      ML_VMC_KINEMATICS_A0_request
  R      ML_VMC_KINEMATICS_A180_request
  S      ML_HMC_KINEMATICS_request

  L      ML_VMC_KINEMATICS_A0_request
  O      ML_VMC_KINEMATICS_A180_request
  O      ML_HMC_KINEMATICS_request
  A      MG_power_delayed_on                                         *;NOTE 1 original PLC
  A      MG_delay_of_MG_power_delayed_on                              *;NOTE 1 of LBL DCM_CMO_on_off
  AN     MG_Z_brake_test_active                                       *;NOTE 1 of LBL DCM_CMO_on_off
  A      PN_M4560_NC_stop_0_active
  AN     NP_M4221_PET_table_NC_stop
  AN     NP_M4223_PET_table_NC_cancel                                 *;BASIC55
  IFT
    RPLY   BL_KINEMATICS_identifier
    ==     K+0
    IFT
      SUBM   KINEMATICS_request_submit
      =      BL_KINEMATICS_identifier
      ==     K+0
      S      PN_error_submit_spawn_queue_full
    ENDI
  ENDI
#endif

#if MT = &MT_37B                                                      *;Kinematic table assigned at 1st power-on
  L      BG_KINEMATICS_assignment
  >=     K+0
  A      NP_M4173_1st_PLC_run_after_compile
  S      ML_KINEMATICS_request

  L      ML_KINEMATICS_request
  A      MG_power_delayed_on
  A      MG_power_on_axis_limit_selected                              *;wait for MG_axis_limit_1/MG_axis_limit_2/MG_axis_limit_3
  IFT
    RPLY   BL_KINEMATICS_identifier
    ==     K+0
    IFT
      SUBM   KINEMATICS_request_submit
      =      BL_KINEMATICS_identifier
      ==     K+0
      S      PN_error_submit_spawn_queue_full
    ENDI
  ENDI
#endif

EM

;----------------------------
LBL DCM_CMO_on_off

*;TVMC partition on/off
#if MT = &MT_37B
  LN     NP_partition_DCM_CMO_MACRO
  EMT

  LN     MG_alternating_table_on
  A      NP_M4173_1st_PLC_run_after_compile
  O[
    LN     MG_alternating_table_on
    A      ML_alternating_table_on
  ]
  R      ML_partition_CMO_on_request
  S      ML_partition_CMO_off_request

  L      MG_alternating_table_on
  A      NP_M4173_1st_PLC_run_after_compile
  O[
    L      MG_alternating_table_on
    AN     ML_alternating_table_on
  ]
  S      ML_partition_CMO_on_request
  R      ML_partition_CMO_off_request

  L      MG_alternating_table_on
  =      ML_alternating_table_on

  L      ML_partition_CMO_on_request
  AN     I_alternat_table_partition_removed
  O[
    L      ML_partition_CMO_off_request
    A      I_alternat_table_partition_removed
  ]
;  A      MG_power_delayed_on                                         *;NOTE 1 original PLC
  A      MG_delay_of_MG_power_delayed_on                              *;NOTE 1
  AN     MG_Z_brake_test_active                                       *;NOTE 1
  A[
    L      BG_KINEMATICS_assignment
    ==     K-1
    O[                                                                *;Wait for KINEMATICS assigned
      L      BG_KINEMATICS_assignment
      >=     K+0
      AN     ML_KINEMATICS_request
    ]
  ]
  A      PN_M4560_NC_stop_0_active
  AN     NP_M4221_PET_table_NC_stop
  AN     NP_M4223_PET_table_NC_cancel                                 *;BASIC55
  IFT
    RPLY   BL_partition_CMO_on_off_identifier
    ==     K+0
    IFT
      SUBM   Partition_CMO_on_off_submit
      =      BL_partition_CMO_on_off_identifier
      ==     K+0
      S      PN_error_submit_spawn_queue_full
    ENDI
  ENDI

*;NOTE 1
*;    Original PLC was using MG_power_delayed_on and MP2230.2 = 1 (brake test at power-on), but
*;    after power-on, error 8330 occurs.  The reason is because brake test is executed right after
*;    MG_power_delayed_on and at the same time submit MACRO is executed.  To solve the problem,
*;    a delay of PLC marker MG_power_delayed_on and also MG_Z_brake_test_active are used.

#endif

EM

