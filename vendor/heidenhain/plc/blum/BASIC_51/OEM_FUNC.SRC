;----------------------------
LBL Input_reassignment

 *;I_not_ref_end_position_4
  L      NP_ref_end_position_4
  IFT
    LN     I_ref_end_position_4
    =      I_not_ref_end_posit_4
  ELSE
    L      I_ref_end_position_4
    =      I_not_ref_end_posit_4
  ENDI

 *;I_5_plus_overtravelled, I_5_minus_overtravelled
  L      NP_5_overtravel_while_sensor=1
  IFT
    L      I_5_plus_overtravel_sensor
    =      I_5_plus_overtravelled

    L      I_5_minus_overtravel_sensor
    =      I_5_minus_overtravelled
  ELSE
    LN     I_5_plus_overtravel_sensor
    =      I_5_plus_overtravelled

    LN     I_5_minus_overtravel_sensor
    =      I_5_minus_overtravelled
  ENDI

 *;I_guard_1_closed, I_guard_1_closed_locked, I_guard_2_closed, I_guard_2_closed_locked
#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
#if GDSW = &ELAN
  LN     I_guard_1_open
  =      I_guard_1_closed

  L      I_guard_1_closed
  A      I_guard_1_locked
  =      I_guard_1_closed_locked

  LN     I_guard_2_open
  =      I_guard_2_closed

  L      I_guard_2_closed
  A      I_guard_2_locked
  =      I_guard_2_closed_locked
#endif
#if GDSW = &EUCHNER
  LN     I_guard_1_open_or_unlock
  =      I_guard_1_closed_locked

  LN     I_guard_2_open_or_unlock
  =      I_guard_2_closed_locked
#endif
#endif

  L      NP_4_clamp_unclamp_high_low_pressure
  IFT
    L      I_clamped_axis_4_sensor
    A      I_unclamped_axis_4_sensor                  *;4th axis unclamping line low pressure inverse signal
    =      I_clamped_axis_4

    L      I_unclamping_axis_4_high_pressure
    A      I_clamping_axis_4_low_pressure_inverse
    =      I_unclamped_axis_4
  ELSE
    L      I_clamped_axis_4_sensor
    =      I_clamped_axis_4

    L      I_unclamped_axis_4_sensor
    =      I_unclamped_axis_4
  ENDI

#if MT = &MT_39
  L      I_clamped_unclamped_axis_5
  A      I_unclamped_clamped_axis_5
  =      I_clamped_axis_5

  LN     I_clamped_unclamped_axis_5
  AN     I_unclamped_clamped_axis_5
  =      I_unclamped_axis_5
#else
  L      NP_5_clamp_unclamp_high_low_pressure
  IFT
    L      I_clamped_axis_5_sensor
    A      I_unclamped_axis_5_sensor                  *;5th axis unclamping line low pressure inverse signal
    =      I_clamped_axis_5

    L      I_unclamping_axis_5_high_pressure
    A      I_clamping_axis_5_low_pressure_inverse
    =      I_unclamped_axis_5
  ELSE
    L      I_clamped_axis_5_sensor
    =      I_clamped_axis_5

    L      I_unclamped_axis_5_sensor
    =      I_unclamped_axis_5
  ENDI
#endif

 *;I_hydraulic_motor_circuit_breaker_ok
#if (Hydraulic_motor_overload = &inactive) and (Hydraulic_2_motor_overload = &inactive)
  L      MG_marker_one
  =      I_hydraulic_motor_circuit_breaker_ok
#endif

 *;I_hydraulic_pressure_ok
#if Hydraulic_oil_pressure_or_level = &inactive
  L      MG_marker_one
  =      I_hydraulic_pressure_ok
#endif

 *;I_hydraulic_temperature_ok
#if Hydraulic_oil_temperature = &inactive
  L      MG_marker_one
  =      I_hydraulic_temperature_ok
#endif

 *;I_spindle_fan_motor_circuit_breaker_ok
#if HSS ! &inactive
  L      MG_marker_one
  =      I_spindle_fan_motor_circuit_breaker_ok
#else
  LN     MG_spindle_active
  S      I_spindle_fan_motor_circuit_breaker_ok
#endif

 *;I_S_gear_cooling_pump_circuit_breaker_ok
;  LN     NP_spindle_gear_cooling_active
;  S      I_S_gear_cooling_pump_circuit_breaker_ok

 *;I_TC_arm_mag_motor_circuit_breaker_ok
  LN     MG_TC_auto_active
  S      I_TC_arm_mag_motor_circuit_breaker_ok

 *;I_TC_arm_mag_2_motor_circuit_breaker_ok            Dual TC
#if (Tool_magazine_2 ! &inactive) or (Tool_changing_arm_2 ! &inactive)
  LN     MG_TC_auto_active
  S      I_TC_arm_mag_2_motor_circuit_breaker_ok
#endif

 *;I_paper_filter_motor_circuit_breaker_ok
  LN     NP_paper_filter_device_active
  S      I_paper_filter_motor_circuit_breaker_ok

 *;I_paper_filter_motor_circuit_breaker_ok and I_CTS_tank_inlet_pressure_ok
  L      NP_paper_filter_device_active
  IFT
    L   I_paper_filter_CTS_tank_inlet_sensor
    =   I_paper_filter_motor_circuit_breaker_ok
  ELSE
    L   I_paper_filter_CTS_tank_inlet_sensor
    =   I_CTS_tank_inlet_pressure_ok
  ENDI

 *;I_dust_mist_collector_circuit_breaker_ok
  LN     NP_dust_mist_collector_active
  S      I_dust_mist_collector_circuit_breaker_ok

 *;I_cabinet_cooler_unit_ok
  LN     NP_cabinet_cooler_active
  S      I_cabinet_cooler_unit_ok

 *;I_circuit_breaker_ok
  L      I_hydraulic_motor_circuit_breaker_ok
  A      I_spindle_fan_motor_circuit_breaker_ok
  A      I_coolant_motor_circuit_breaker_ok
  A      I_chip_conveyor_motor_circuit_breaker_ok
  A      I_TC_arm_mag_motor_circuit_breaker_ok
#if (Tool_magazine_2 ! &inactive) or (Tool_changing_arm_2 ! &inactive)
  A      I_TC_arm_mag_2_motor_circuit_breaker_ok
#endif
  A      I_paper_filter_motor_circuit_breaker_ok
  A      I_dust_mist_collector_circuit_breaker_ok
;  A      I_S_gear_cooling_pump_circuit_breaker_ok
  =      I_circuit_breaker_ok

  L      MG_power_delayed_on
  IFT
    LN     I_hydraulic_motor_circuit_breaker_ok
    S      MG_win_hydraulic_motor_overloaded

    LN     I_spindle_fan_motor_circuit_breaker_ok
    S      MG_win_spindle_fan_motor_overloaded

;    LN     I_S_gear_cooling_pump_circuit_breaker_ok
;    S      MG_win_S_gear_cooling_pump_overloaded

    LN     I_coolant_motor_circuit_breaker_ok
    S      MG_win_coolant_motor_overloaded

    LN     I_chip_conveyor_motor_circuit_breaker_ok
    S      MG_win_chip_conveyor_motor_overloaded

    LN     I_TC_arm_mag_motor_circuit_breaker_ok
    S      MG_win_TC_arm_mag_motor_overloaded

