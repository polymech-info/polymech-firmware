#if (MT = &MT_39A) or (MT = &MT_3AA) or (MT = &MT_3B) or (MT = &MT_3BA)
  L      MG_anti_backlash_4_start
  IFT
    L      K+8
    =      WL_C_plus_motion_lock
    =      WL_C_minus_motion_lock
  ELSE
    L      K+0
    =      WL_C_plus_motion_lock
    =      WL_C_minus_motion_lock
  ENDI

  L      MG_anti_backlash_5_start
  IFT
    L      K+16
    =      WL_B_plus_motion_lock
    =      WL_B_minus_motion_lock
  ELSE
    L      K+0
    =      WL_B_plus_motion_lock
    =      WL_B_minus_motion_lock
  ENDI
#endif

#if Door_lock_safety_confirmation_panel = &active                     *;EUMACH Safety confirmation
#if MT = &MT_2MV                                                       *;EUMACH Safety confirmation
  L      MG_TC_auto_active                                            *;EUMACH Safety confirmation
  AN     I_key_TC_mag_automatic_control_mode                          *;EUMACH Safety confirmation
  IFT                                                                 *;EUMACH Safety confirmation
    L      K+1                                                        *;EUMACH Safety confirmation
    =      WL_X_plus_motion_lock                                      *;EUMACH Safety confirmation
    =      WL_X_minus_motion_lock                                     *;EUMACH Safety confirmation
  ELSE                                                                *;EUMACH Safety confirmation
    L      K+0                                                        *;EUMACH Safety confirmation
    =      WL_X_plus_motion_lock                                      *;EUMACH Safety confirmation
    =      WL_X_minus_motion_lock                                     *;EUMACH Safety confirmation
  ENDI                                                                *;EUMACH Safety confirmation
#endif                                                                *;EUMACH Safety confirmation
#endif                                                                *;EUMACH Safety confirmation

  L      PN_W1046_manual_motion_plus
#if (MT = &MT_12) or (MT = &MT_13) or (MT = &MT_15) or (MT = &MT_15A)
  AN     WL_Y_plus_lock_before_referenced
#endif
#if (MT = &MT_21) or (MT = &MT_25A) or (MT = &MT_25B) or (MT = &MT_2MV) or (MT = &MT_32) or (MT = &MT_32A)
  AN     WL_Y_plus_lock_before_referenced
#endif
#if (MT = &MT_35) or (MT = &MT_35A) or (MT = &MT_35B)
  AN     WL_Y_plus_lock_before_referenced
#endif
#if ((MT = &MT_25) or (MT = &MT_35)) and ((Head = &S_head_type_01) or (Head = &S_head_type_02) or (Head = &S_head_type_10))
  AN     WL_Y_plus_lock_while_S_head_turning
#endif
#if MT = &MT_2B
  AN     WL_IV_plus_motion_lock
#endif
#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
  AN     WL_Y_plus_motion_lock
#endif
#if MT = &MT_39
  AN     WL_B_plus_motion_lock
#endif
#if (MT = &MT_39A) or (MT = &MT_3B) or (MT = &MT_3BA)
  AN     WL_C_plus_motion_lock
  AN     WL_B_plus_motion_lock
#endif
#if MT = &MT_3A
  AN     WL_Y_plus_motion_lock
  AN     WL_Z_plus_motion_lock
  AN     WL_IV_plus_motion_lock
#endif
#if MT = &MT_3AA
  AN     WL_C_plus_motion_lock
  AN     WL_B_plus_motion_lock
  AN     WL_IV_plus_motion_lock
#endif
#if Door_lock_safety_confirmation_panel = &active                     *;EUMACH Safety confirmation
#if MT = &MT_2MV                                                       *;EUMACH Safety confirmation
  AN      WL_X_plus_motion_lock                                       *;EUMACH Safety confirmation
#endif                                                                *;EUMACH Safety confirmation
#endif                                                                *;EUMACH Safety confirmation
  =      PN_W1046_manual_motion_plus

  L      PN_W1048_manual_motion_minus
#if (MT = &MT_15) or (MT = &MT_15A)
  AN     WL_Z_minus_motion_lock
#endif
#if (MT = &MT_22) or (MT = &MT_32B)
  AN     WL_X_minus_lock_before_referenced
#endif
#if ((MT = &MT_25) or (MT = &MT_35)) and ((Head = &S_head_type_01) or (Head = &S_head_type_02) or (Head = &S_head_type_10))
  AN     WL_Z_minus_motion_lock
#endif
#if MT = &MT_2B
  AN     WL_Y_minus_motion_lock
  AN     WL_Z_minus_motion_lock
  AN     WL_IV_minus_motion_lock
#endif
#if (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
  AN     WL_Z_minus_motion_lock
#endif
#if (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
  AN     WL_Y_minus_motion_lock
#endif
#if MT = &MT_39
  AN     WL_B_minus_motion_lock
#endif
#if (MT = &MT_39A) or (MT = &MT_3AA) or (MT = &MT_3B) or (MT = &MT_3BA)
  AN     WL_C_minus_motion_lock
  AN     WL_B_minus_motion_lock
#endif
#if MT = &MT_3A
  AN     WL_Y_minus_motion_lock
  AN     WL_Z_minus_motion_lock
  AN     WL_IV_minus_motion_lock
#endif
#if MT = &MT_3AA
  AN     WL_Y_minus_motion_lock
  AN     WL_Z_minus_motion_lock
  AN     WL_IV_minus_motion_lock
#endif
#if Door_lock_safety_confirmation_panel = &active                     *;EUMACH Safety confirmation
#if MT = &MT_2MV                                                      *;EUMACH Safety confirmation
  AN      WL_X_minus_motion_lock                                      *;EUMACH Safety confirmation
#endif                                                                *;EUMACH Safety confirmation
#endif                                                                *;EUMACH Safety confirmation
  =      PN_W1048_manual_motion_minus

  L      ML_Y_plus_lock_while_S_head_turning
  O      ML_Y_plus_motion_lock
  O      ML_Y_minus_motion_lock
  IFT
    L      PN_W1062_handwheel_pulse_inhibit
    BS     KG_axis_Y
    =      PN_W1062_handwheel_pulse_inhibit
  ELSE
    L      PN_W1062_handwheel_pulse_inhibit
    BC     KG_axis_Y
    =      PN_W1062_handwheel_pulse_inhibit
  ENDI

  L      ML_Z_minus_motion_lock
  O      MG_working_area_Z_minus_motion_lock
  IFT
    L      PN_W1062_handwheel_pulse_inhibit
    BS     KG_axis_Z
    =      PN_W1062_handwheel_pulse_inhibit
  ELSE
    L      PN_W1062_handwheel_pulse_inhibit
    BC     KG_axis_Z
    =      PN_W1062_handwheel_pulse_inhibit
  ENDI

  L      MG_working_area_IV_motion_lock
  O      MG_anti_backlash_4_start
  IFT
    L      PN_W1062_handwheel_pulse_inhibit
    BS     KG_axis_4
    =      PN_W1062_handwheel_pulse_inhibit
  ELSE
    L      PN_W1062_handwheel_pulse_inhibit
    BC     KG_axis_4
    =      PN_W1062_handwheel_pulse_inhibit
  ENDI

  L      ML_B_plus_motion_lock
  O      ML_B_minus_motion_lock
  O      MG_anti_backlash_5_start
  IFT
    L      PN_W1062_handwheel_pulse_inhibit
    BS     KG_axis_5
    =      PN_W1062_handwheel_pulse_inhibit
  ELSE
    L      PN_W1062_handwheel_pulse_inhibit
    BC     KG_axis_5
    =      PN_W1062_handwheel_pulse_inhibit
  ENDI

*;Original PLC
;  L      PN_M4576_suppress_handwheel_pulses
;#if (MT = &MT_15) or (MT = &MT_15A)
;  O      ML_Z_minus_motion_lock
;#endif
;#if ((MT = &MT_25) or (MT = &MT_35)) and ((Head = &S_head_type_01) or (Head = &S_head_type_02) or (Head = &S_head_type_10))
;  O      ML_Y_plus_lock_while_S_head_turning
;  O      ML_Z_minus_motion_lock
;#endif
;#if (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
