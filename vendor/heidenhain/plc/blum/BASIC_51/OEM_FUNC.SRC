LBL Air_blast

  L      MG_M23_air_blast_on
  O      MG_M24_air_blast_off
  S      PN_M4092_quit_M_function

  L      MG_M23_air_blast_on
  S      MG_soft_key_air_blast

  L      MG_M09_coolant_off
  O      MG_M24_air_blast_off
  O      MG_pulse_END_PGM_M02_M30
  O      MG_auto_manu_mode_change
  O[
    L      MG_soft_key_air_blast
    A      MG_M4042_M08_MK_status_p_pulse
    A      NP_coolant_and_air_blast_in_same_nozzle
  ]
*;EUMACH CE 2008
#if SFM = &Standard
  O[
    L      PN_error_safety_mode_2
    ON     MG_NC_program_operating                                    *;EUMACH CE Sep 06 2008
    A      PN_error_guard_open
  ]
#endif
#if SFM = &DMx
  O      PN_error_safety_mode_2
  O      MG_safety_mode_4
#endif
*;EUMACH CE 2008
  ON     MG_control_operational
  R      MG_soft_key_air_blast

  L      NP_M4002_S_nominal_0
  O      PN_M4008_S_nominal_off_status_inverse
  AN     NP_M4030_tapping_cycle_active
  AN     NP_coolant_without_spindle_turning
  O      NP_M4158_mode_block_scan
  O      MG_TC_automatic
  O      MG_TC_manual
#if Tool_changing_arm_2 ! &inactive                                   *;EUMACH Dual TC
  O      MG_TC2_automatic                                             *;EUMACH Dual TC
#endif                                                                *;EUMACH Dual TC
  ON     I_servo_drive_release
  ON     MG_servo_drive_release_1st_axes_group
  O      MG_both_mag_and_ATC_doors_open_protection                    *;EUMACH Protection for both magazine door open & ATC door open
  O      MG_enable_alternating_table
  O      MG_guard_open_operation_hold                                 *;EUMACH CE Sep 06 2008
  =      ML_air_blast_status_inverse

  L      MG_soft_key_air_blast
  AN     ML_air_blast_status_inverse
  AN     TS_coolant_air_blast_switching
  AN     TR_coolant_air_blast_switching
  A      MG_soft_key_fluid_flow_valve
  =      O_air_blast

  LN     MG_soft_key_air_blast
  R      ML_air_blast_status_inverse

EM

;----------------------------
LBL Oil_mist

  LN     NP_oil_mist_active
  A      ML_NP_oil_mist_active
  =      ML_n_pulse_NP_oil_mist_active

  L      NP_oil_mist_active
  =      ML_NP_oil_mist_active

  L      NP_oil_mist_active
  IFT
    L      MG_M27_oil_mist_on
    O      MG_M28_oil_mist_off
    S      PN_M4092_quit_M_function

    L      MG_M27_oil_mist_on
    S      MG_soft_key_oil_mist

    L      MG_M09_coolant_off
    O      MG_M28_oil_mist_off
    O      MG_pulse_END_PGM_M02_M30
    O      MG_auto_manu_mode_change
*;EUMACH CE 2008
  #if SFM = &Standard
    O[
      L      PN_error_safety_mode_2
      ON     MG_NC_program_operating                                  *;EUMACH CE Sep 06 2008
      A      PN_error_guard_open
    ]
#endif
#if SFM = &DMx
    O      PN_error_safety_mode_2
    O      MG_safety_mode_4
#endif
*;EUMACH CE 2008
    ON     MG_control_operational
    R      MG_soft_key_oil_mist

    L      NP_M4002_S_nominal_0
    O      PN_M4008_S_nominal_off_status_inverse
    AN     NP_M4030_tapping_cycle_active
    AN     NP_coolant_without_spindle_turning
    O      NP_M4158_mode_block_scan
    O      MG_TC_automatic
    O      MG_TC_manual
#if Tool_changing_arm_2 ! &inactive                                   *;EUMACH Dual TC
    O      MG_TC2_automatic                                           *;EUMACH Dual TC
#endif                                                                *;EUMACH Dual TC
    ON     I_servo_drive_release
    ON     MG_servo_drive_release_1st_axes_group
    O      MG_both_mag_and_ATC_doors_open_protection                  *;EUMACH Protection for both magazine door open & ATC door open
    O      MG_enable_alternating_table
    O      PN_error_oil_mist_unit_level_low
    O      MG_guard_open_operation_hold                               *;EUMACH CE Sep 06 2008
    =      ML_oil_mist_status_inverse

    L      MG_soft_key_oil_mist
    AN     ML_oil_mist_status_inverse
    A      MG_soft_key_fluid_flow_valve
    =      O_oil_mist

    LN     MG_soft_key_oil_mist
    R      ML_oil_mist_status_inverse

    LN     I_oil_mist_unit_level_ok
    S      PN_error_oil_mist_unit_level_low
  ELSE
    L      ML_n_pulse_NP_oil_mist_active
    R      MG_soft_key_oil_mist
    R      ML_oil_mist_status_inverse
    R      O_oil_mist
    R      PN_error_oil_mist_unit_level_low
  ENDI

EM

;----------------------------
LBL Dust_mist_collector

  LN     NP_dust_mist_collector_active
  A      ML_NP_dust_mist_collector_active
  =      ML_n_pulse_NP_dust_mist_collector_active

  L      NP_oil_mist_active
  =      ML_NP_dust_mist_collector_active

  L      NP_dust_mist_collector_active
  IFT
    L      MG_M370_dust_mist_collector_off
    O      MG_M371_dust_mist_collector_on
    S      PN_M4092_quit_M_function

    L      I_key_dust_mist_collector
    AN     ML_key_dust_mist_collector_pressed
    XO     ML_dust_mist_collector
    =      ML_dust_mist_collector

    L      MG_M371_dust_mist_collector_on
    S      ML_dust_mist_collector

    L      MG_M370_dust_mist_collector_off
    R      ML_dust_mist_collector

    L      I_key_dust_mist_collector
    =      ML_key_dust_mist_collector_pressed

    L      ML_dust_mist_collector
    =      O_dust_mist_collector
    =      O_lamp_dust_mist_collector
  ELSE
    L      ML_n_pulse_NP_dust_mist_collector_active
    R      ML_dust_mist_collector
    R      O_dust_mist_collector
    R      O_lamp_dust_mist_collector
  ENDI

EM

;----------------------------
LBL Buzzer

 *;Can be improved further (maybe softkey for buzzer active/inactive, alarm
 *;turning the buzzer on etc.).
  L	     MG_M75_buzzer_active
  O	     MG_M76_buzzer_inactive
  S	     PN_M4092_quit_M_function

  L	     MG_M75_buzzer_active
  S      ML_buzzer_active

  L	     MG_M76_buzzer_inactive
  ON     MG_control_operational
  R      ML_buzzer_active

  LN     ML_buzzer_active
  EMT

  LN     NP_M4170_END_PGM_M02_M30_executed
  =      TS_buzzer_on

  LN     TS_buzzer_on
  A      TR_buzzer_on
  A      MG_clock_1_s
  =      O_buzzer_on

  LN     TS_buzzer_on
  AN     TR_buzzer_on
  A      ML_buzzer_active
  R      ML_buzzer_active

EM

;----------------------------
LBL Secondary_guards

  L      I_guard_1_closed_locked
  AN     I_secondary_guard_closed
  A      NP_secondary_guards_active
  =      PN_error_secondary_guards_open

  L      I_servo_drive_release
  A      MG_servo_drive_release_1st_axes_group
  O      MG_TC_manual
  AN     MG_TNC_programming_station_with_PLC_active
  R      PN_error_secondary_guards_open

  LN     I_secondary_guard_closed
  A      I_guard_1_closed_locked
  AN     O_guard_1_unlock
  A      NP_secondary_guards_active
  R      PN_error_guard_open

EM

;----------------------------
LBL Aux_axis_motion_jog

#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
*; Without following PLC, when machine in area 1, you cannot use aux axis motion to move C-II axis due
*; to feed not released (unless M31 or MP4310.2 bit 2 = 1).
  L      MG_axis_limit_2
  A[
    L      WG_controlled_axes
    BT     KG_axis_4
  ]
  IFT
    L      PN_W1060_feed_release_axis_specific
    O      K%0000000000001000
    =      PN_W1060_feed_release_axis_specific
  ENDI

  L      MG_axis_limit_1
  A[
    L      WG_controlled_axes
    BT     KG_axis_5
  ]
  IFT
    L      PN_W1060_feed_release_axis_specific
    O      K%0000000000010000
    =      PN_W1060_feed_release_axis_specific
  ENDI
*;

  L      I_key_area1_axis_C_plus
  XO     I_key_area1_axis_C_minus
  A      MG_axis_limit_2
  A[
    L      WG_controlled_axes
    BT     KG_axis_4
  ]
  O[
    L      I_key_area2_axis_C_plus
    XO     I_key_area2_axis_C_minus
    A      MG_axis_limit_1
    A[
      L      WG_controlled_axes
      BT     KG_axis_5
    ]
  ]
  AN     MG_enable_alternating_table
  AN     PN_error_alternat_table_separation
  IFT
    L      MG_axis_limit_1
    IFT
      PS     KG_axis_5
    ELSE
      PS     KG_axis_4
    ENDI
    CM     9122
    PLW
    B=     MG_aux_axis_of_aux_axis_jog
    M_display_module_error(KG_error_module_9122)

    L      MG_axis_limit_1
    A      I_key_area2_axis_C_plus
    AN     I_key_area2_axis_C_minus
    A      MG_servo_drive_release_4th_axes_group
    O[
      L      MG_axis_limit_2
      A      I_key_area1_axis_C_plus
      AN     I_key_area1_axis_C_minus
      A      MG_servo_drive_release_3rd_axes_group
    ]
    A      MG_power_delayed_on
    A      I_servo_drive_release
    AN     MG_posit_active_aux_axis_jog
    IFT
      L      MG_axis_limit_1
      IFT
        PS     KG_axis_5
      ELSE
        PS     KG_axis_4
      ENDI
      PS     KL_max_plus_traverse
      PS     K+500
      PS     KL_incremental
      CM     9120
      PLW
      <>     K+0
      M_error_display(KG_error_module_9120)
    ENDI

    L      MG_axis_limit_1
    AN     I_key_area2_axis_C_plus
    A      I_key_area2_axis_C_minus
    A      MG_servo_drive_release_4th_axes_group
    O[
      L      MG_axis_limit_2
      AN     I_key_area1_axis_C_plus
      A      I_key_area1_axis_C_minus
      A      MG_servo_drive_release_3rd_axes_group
    ]
    A      MG_power_delayed_on
    A      I_servo_drive_release
    AN     MG_posit_active_aux_axis_jog
    IFT
      L      MG_axis_limit_1
      IFT
        PS     KG_axis_5
      ELSE
        PS     KG_axis_4
      ENDI
      PS     KL_max_minus_traverse
      PS     K+500
      PS     KL_incremental
      CM     9120
      PLW
      <>     K+0
      M_error_display(KG_error_module_9120)
    ENDI
  ENDI

  LN     I_key_area1_axis_C_plus
  XO     I_key_area1_axis_C_minus
  A      MG_axis_limit_2
  O      MG_enable_alternating_table
  A[
    L      WG_controlled_axes
    BT     KG_axis_4
  ]
  O[
    LN     I_key_area2_axis_C_plus
    XO     I_key_area2_axis_C_minus
    A      MG_axis_limit_1
    O      MG_enable_alternating_table
    A[
      L      WG_controlled_axes
      BT     KG_axis_5
    ]
  ]
  AN     PN_error_alternat_table_separation
  IFT
    L      MG_axis_limit_1
    IFT
      PS     KG_axis_5
    ELSE
      PS     KG_axis_4
    ENDI
    CM     9122
    PLW
    B=     MG_aux_axis_of_aux_axis_jog
    M_display_module_error(KG_error_module_9122)

    L      MG_posit_active_aux_axis_jog
    IFT
      L      MG_axis_limit_1
      IFT
        PS     KG_axis_5
      ELSE
        PS     KG_axis_4
      ENDI
      CM     9121
      PLW
      <>     K+0
      M_error_display(KG_error_module_9121)
    ENDI
  ENDI
#endif

EM

;----------------------------
LBL NC_stop

#if (Hydraulic_gravity_balance = &active) or (Hydraulic_2_gravity_balance_valve = &active)
  L      PN_error_hydraulic_pressure
#if Hydraulic_valve_pressure = &active
  O      PN_error_hydraulic_valve_pressure
#endif
  R      PN_M4560_NC_stop_0_active
#endif

  L      PN_M4041_M07_MK_status
  O      PN_M4042_M08_MK_status
  A      MG_control_in_operation_on
  A      PN_error_coolant_level_low
  AN     MG_3D_head_active
  AN     MG_V_H_head_turning_proceeding
  AN     MG_TC_automatic
  AN     MG_TC2_automatic                                           *;EUMACH Dual TC
  AN     MG_enable_alternating_table
#if (M7TK = &CTS_tank_01) or (M7TK = &CTS_tank_02) or (M7TK = &CTS_tank_04) or (M7TK = &CTS_tank_05) or (M7TK = &CTS_tank_06) or (M7TK = &CTS_tank_07)
  O[
    L      PN_error_CTS_tank_level
    O      PN_error_CTS_tank_level_low
    O      PN_error_CTS_tank_overflow
    O      PN_error_CTS_tank_inlet_pressure
    A      PN_M4041_M07_MK_status
    A      MG_control_in_operation_on
  ]
#endif
  O[
    L      PN_error_CTS_filter
    A      PN_M4041_M07_MK_status
    A      MG_control_in_operation_on
    A      NP_CTS_filter_active
  ]
  O[
    L      PN_error_CTS_motor_pressure
    A      PN_M4041_M07_MK_status
    A      MG_control_in_operation_on
    A      NP_CTS_motor_pressure_sensor_active
  ]
#if M7TK = &CTS_tank_06
  O[
    L      MG_error_M08_motor_pressure
    A      PN_M4042_M08_MK_status
    A      MG_control_in_operation_on
    A      NP_coolant_motor_pressure_sensor_active
  ]
#endif
  O[
    L      MG_soft_key_air_blast
    A      MG_control_in_operation_on
    A      PN_error_pneumatic_pressure
  ]
  O[
    L      MG_soft_key_oil_mist
    A      MG_control_in_operation_on
    A      PN_error_oil_mist_unit_level_low
  ]
  O[
    L      O_lubrication_on
    A      PN_error_lubricant_level_low
    O[
      L      O_lubrication_2_on
      A      MG_error_lubricant_2_level_low
    ]
    O[
      L      O_lubrication_3_on
      A      MG_error_lubricant_3_level_low
    ]
    AN     MG_3D_head_active
    AN     MG_V_H_head_turning_proceeding
    AN     MG_TC_automatic
    AN     MG_TC2_automatic                                           *;EUMACH Dual TC
    AN     MG_enable_alternating_table
  ]
  O[
    L      O_nut_lubrication_on
    A      PN_error_nut_lubricant_level_low
  ]
  O      PN_error_spindle_cooling_unit
  O      PN_error_S_cooling_liquid_flow
  O      PN_error_spindle_gear_cooling
  AN     NP_M4030_tapping_cycle_active
  AN     NP_M4031_tapping_cycle_controlled
  O[
    L      NP_pneumatic_error_M05_NC_STOP
    A      PN_error_pneumatic_pressure
  ]
  O[
    L      NP_hydraulic_error_M05_NC_STOP
    A      PN_error_hydraulic_pressure
  ]
  O[
    L      NP_tool_clamping_pneumatic_sensor
    A      PN_error_tool_clamping_pneumatic
  ]
  O[
    L      NP_tool_clamping_hydraulic_sensor
    A      PN_error_tool_clamping_hydraulic
  ]
  O      PN_error_hirth_position
  O      PN_error_clamping
  O      PN_error_reference_necessary
  O      PN_error_S_head_coupling_not_clamped
  O      PN_error_S_bearing_temp_sensor
  O      PN_error_S_bearing_temperature_too_high
  O      PN_error_SM1xx_temperature_too_high
  O      PN_error_S_rotary_joint_cooling_circulation
#if CYTEC_CYCON_control = &active                                     *;EUMACH CYCON K11
  O      PN_error_tool_clamping_unclamping
#endif
#if (HSS = &HS_type_01) or (HSS = &HS_type_191) or (HSS = &HS_type_19) or (HSS = &HS_type_20) or (HSS = &HS_type_100)
  O      PN_error_pneumatic_pressure
#endif
#if (Head = &S_head_type_01) or (Head = &S_head_type_02)
  O      PN_error_check_Tool_Call_axis
  O      PN_error_V_H_head_timeout
  O      PN_error_V_H_no_head_tool_not_clamped
#endif
#if (Head = &S_head_type_06) or (Head = &S_head_type_09) or (Head = &S_head_type_10)
  O      PN_error_V_H_no_head_tool_not_clamped
#endif
#if (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
  O      PN_error_cover_interference_area
#endif
#if MT = &MT_39
  O      PN_error_B_axis_plus_end_position
  O      PN_error_B_axis_minus_end_position
#endif
  O      PN_error_protection_working_area
  O[
    L      PN_error_S_head_transmission_lubrication
    O      PN_error_S_head_bearing_lubrication
    O      MG_error_manual_lubrication_message
    AN     NP_M4176_control_in_operation_on_or_flashes
  ]
  O      MG_error_pneumatic_counter_weight_balancing
  O      PN_error_tool_unclamp_rod_gap
  O      PN_error_spindle_warming_up_necessary
  O      PN_error_safety_mode_2                                       *;CE 2008
#if ADS ! &inactive                                                   *;Auto door
  O[
    L      PN_error_auto_door_1_open_closed
    O      PN_error_auto_door_2_open_closed
    AN     MG_alternating_table_on
  ]
  O[
    L      MG_axis_limit_1
    A      PN_error_auto_door_1_open_closed
    O[
      L      MG_axis_limit_2
      A      PN_error_auto_door_2_open_closed
    ]
    A      MG_alternating_table_on
  ]
#endif                                                                *;Auto door
#if Hydraulic_2_gravity_over_pressure_valve = &active
  O[
    L      MG_error_balance_over_max_pressure
    AN     NP_M4176_control_in_operation_on_or_flashes
  ]
#endif
  A      MG_automatic_mode
#if (Rotary_table_protection = &Square) or (Rotary_table_protection = &Rectangular)
  O[
    LN     NP_W1032_reference_nesessary
    BT     KG_axis_Z
    A[
      LN     NP_W1032_reference_nesessary
      BT     KG_axis_Y
    ]
    A[
      LN     NP_W1032_reference_nesessary
      BT     KG_axis_X
    ]
    A      NP_M4155_mode_pass_over_reference
    A      PN_error_protection_working_area
    A      PN_M4564_NC_start
  ]
#endif
#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
  O[
    L      MG_axis_limit_1
    AN     MG_servo_drive_release_4th_axes_group
    O[
      L      MG_axis_limit_2
      AN     MG_servo_drive_release_3rd_axes_group
    ]
    O      MG_axis_limit_3
    A      PN_error_guard_open
  ]
#else
  O      PN_error_guard_open
#endif
  O      PN_error_ATS_S_rpm_error
  O[
    LN     NP_error_tool_life_max_without_NC_STOP
    A      PN_error_tool_life_max
  ]
  O      MG_both_mag_and_ATC_doors_open_protection                    *;EUMACH Protection for both magazine door open & ATC door open
  R      PN_M4560_NC_stop_0_active

EM

;----------------------------
LBL Spindle_stop_and_rpm_limitation

*;If PN_error does not cause NC STOP in PET table, add PN_error in LBL NC_stop.

  L      NP_pneumatic_error_M05_NC_STOP
  A      PN_error_pneumatic_pressure
  O[
    L      NP_hydraulic_error_M05_NC_STOP
    A      PN_error_hydraulic_pressure
  ]
  O      PN_error_spindle_cooling_unit
  O      PN_error_S_cooling_liquid_flow
  O      PN_error_spindle_gear_cooling
  O[
    L      NP_tool_clamping_pneumatic_sensor
    A      PN_error_tool_clamping_pneumatic
  ]
  O[
    L      NP_tool_clamping_hydraulic_sensor
    A      PN_error_tool_clamping_hydraulic
  ]
#if CYTEC_CYCON_control = &active                                     *;EUMACH CYCON K11
  O      PN_error_tool_clamping_unclamping
#endif
#if (HSS = &HS_type_01) or (HSS = &HS_type_191) or (HSS = &HS_type_19) or (HSS = &HS_type_20) or (HSS = &HS_type_100)
  O      PN_error_pneumatic_pressure
#endif
#if (Head = &S_head_type_01) or (Head = &S_head_type_02)
  O      PN_error_V_H_no_head_tool_not_clamped
  O      PN_error_V_H_head_pos
  O      PN_error_V_H_head_clamping
#endif
#if (Head = &S_head_type_06) or (Head = &S_head_type_09) or (Head = &S_head_type_10)
  O      PN_error_V_H_no_head_tool_not_clamped
#endif
  O      MG_error_S_head_transmission_lube_p_pulse
  O      MG_error_S_head_bearing_lube_p_pulse
  O      PN_error_S_bearing_temp_sensor
  O      PN_error_S_bearing_temperature_too_high
  O      PN_error_S_rotary_joint_cooling_circulation
  O      PN_error_tool_unclamp_rod_gap
  O      PN_error_SM1xx_temperature_too_high
  O      MG_error_pneumatic_counter_weight_balancing
#if S_PTC_sensor = &active
  O      PN_error_thermal_sensor_temperature
#endif
#if SFM = &Standard
  O      MG_safety_mode_2_p_pulse                                     *;CE 2008
#endif
  AN     MG_axes_in_motion
  R      PN_M4005_S_M03_nominal_and_status
  R      PN_M4006_S_M04_nominal_and_status
  S      PN_M4007_S_M05_nominal_0_and_status

#if (Head = &S_head_type_01) or (Head = &S_head_type_02)
  LN     I_V_H_head_in_vertical_pos
  XO     I_V_H_head_in_horizontal_pos
  O[
    LN     I_V_H_head_clamped
    O      I_V_H_head_unclamped
  ]
  A      MG_automatic_V_H_head_installed
  IFT
    L      NP_MP4231_19_V_H_head_turning_rpm
    /      K+10
    <      PN_D604_max_S_rpm_PLC
    IFT
      L      NP_MP4231_19_V_H_head_turning_rpm
      /      K+10
      =      PN_D604_max_S_rpm_PLC
    ENDI
  ENDI
#endif

#if SFM ! &inactive
*;Safety mode 4
  L      MG_safety_mode_4
  IFT
    L      NP_D884_special_mode_rpm
    /      K+10
    <      PN_D604_max_S_rpm_PLC
    IFT
      L      NP_D884_special_mode_rpm
      /      K+10
      =      PN_D604_max_S_rpm_PLC
    ENDI
  ENDI
*;Safety mode 4

*;Safety mode 2 CE 2008
  L      PN_error_safety_mode_2
  IFT
    L      NP_D876_S_service_rpm
    /      K+10
    <      PN_D604_max_S_rpm_PLC
    IFT
      L      NP_D876_S_service_rpm
      /      K+10
      =      PN_D604_max_S_rpm_PLC
    ENDI
  ENDI
*;Safety mode 2 CE 2008
#endif

EM

;----------------------------
LBL M03_M04_direction

#if (Head = &S_head_type_01) or (Head = &S_head_type_02)
  L      MG_V_H_head_Help_jog_ccw
  =      PN_M4014_S_reverse_direction_of_rotation
#endif

#if Head = &S_head_type_06
  LN     MG_manual_head_on_off_processing
  IFT
#if (MT = &MT_12) or (MT = &MT_13) or (MT = &MT_21) or (MT = &MT_32)
    L      MG_soft_key_S_man_head
#else
    L      MG_manual_V_H_head_installed
#endif
    IFT
      L      MG_soft_key_S_jog_right_cw
      O      MG_soft_key_S_jog_left_ccw
      =      PN_M4011_S_speed_from_MP3520.0

      LN     PN_M4011_S_speed_from_MP3520.0
      ON     MG_soft_key_S_jog_left_ccw
      =      PN_M4014_S_reverse_direction_of_rotation
    ENDI

    L      MG_manual_V_H_head_installed
    =      PN_M4019_S_reverse_direction_of_counting
  ENDI
#endif

#if Head = &S_head_type_09
  LN     MG_manual_head_on_off_processing
  IFT
    L      MG_manual_V_H_head_installed
    IFT
      L      MG_soft_key_S_jog_right_cw
      O      MG_soft_key_S_jog_left_ccw
      =      PN_M4011_S_speed_from_MP3520.0

      LN     PN_M4011_S_speed_from_MP3520.0
      ON     MG_soft_key_S_jog_left_ccw
      =      PN_M4014_S_reverse_direction_of_rotation
    ENDI

    L      MG_manual_V_H_head_installed
    =      PN_M4019_S_reverse_direction_of_counting
  ENDI
#endif

EM

;----------------------------
LBL TC_mag_motor_control

#if Tool_changing_arm = &Single_arm
 *;The rotational motor control of carrousel magazine
  L      NP_mag_motor_with_internal_braking
  IFT
    L      O_TC_magazine_cw
    =      O_TC_magazine_cw_on

    L      O_TC_magazine_ccw
    =      O_TC_magazine_ccw_on
  ELSE
    L      O_TC_magazine_cw
    O      O_TC_magazine_ccw
    =      O_TC_magazine_rotation_on

    L	   O_TC_magazine_rotation_on
    =      TS_mag_braking_DC_voltage_injection

    L      TS_mag_braking_DC_voltage_injection
    O      TR_mag_braking_DC_voltage_injection
    A      O_TC_magazine_cw
    =      O_TC_magazine_cw_on

    L      TS_mag_braking_DC_voltage_injection
    O      TR_mag_braking_DC_voltage_injection
    A      O_TC_magazine_ccw
    =      O_TC_magazine_ccw_on
  ENDI

 *;The shifting motor control of carrousel (single arm) tool changer
  L      NP_single_arm_motor_shifting
  IFT
    L      O_TC_magazine_to_spindle_position
    AN     I_TC_magazine_in_spindle_position
    =      O_TC_mag_to_spindle_position

    L      O_TC_magazine_to_basic_position
    AN     I_TC_magazine_in_basic_position
    =      O_TC_mag_to_basic_position
  ELSE
    L      O_TC_magazine_to_spindle_position
    =      O_TC_mag_to_spindle_position

    L      O_TC_magazine_to_basic_position
    =      O_TC_mag_to_basic_position
  ENDI
#else
  L      O_TC_magazine_cw
  =      O_TC_magazine_cw_on

  L      O_TC_magazine_ccw
  =      O_TC_magazine_ccw_on
#endif

EM

;----------------------------
LBL Motion_lock

#if (MT = &MT_22) or (MT = &MT_32B)
 *;X- motion lock for ATC door or HURON head protection before reference traversed
  L      NP_W1032_reference_nesessary
  BT     KG_axis_X
  AN     I_not_ref_end_posit_X
  AN     MG_TC_help
  A[
    LN     MG_NC_start_from_reference
    A      NP_M4155_mode_pass_over_reference
    O      NP_M4150_mode_manual
    O      NP_M4151_mode_electronic_handwheel
  ]
  IFT
    L      K+1
    =      WL_X_minus_lock_before_referenced
  ELSE
    L      K+0
    =      WL_X_minus_lock_before_referenced
  ENDI
#endif

#if (MT = &MT_12) or (MT = &MT_13) or (MT = &MT_15) or (MT = &MT_15A)
 *;Y+ motion lock for ATC door or HURON head protection before reference traversed
  L      NP_W1032_reference_nesessary
  BT     KG_axis_Y
  AN     I_not_ref_end_posit_Y
  AN     MG_TC_help
  A[
    LN     MG_NC_start_from_reference
    A      NP_M4155_mode_pass_over_reference
    O      NP_M4150_mode_manual
    O      NP_M4151_mode_electronic_handwheel
  ]
  IFT
    L      K+2
    =      WL_Y_plus_lock_before_referenced
  ELSE
    L      K+0
    =      WL_Y_plus_lock_before_referenced
  ENDI
#endif

#if (MT = &MT_21) or (MT = &MT_25) or (MT = &MT_25A) or (MT = &MT_25B) or (MT = &MT_2MV) or (MT = &MT_32) or (MT = &MT_32A) or (MT = &MT_35) or (MT = &MT_35A) or (MT = &MT_35B)
 *;Y+ motion lock for ATC door or HURON head protection before reference traversed
  L      NP_W1032_reference_nesessary
  BT     KG_axis_Y
  AN     I_not_ref_end_posit_Y
  A[
    LN     MG_NC_start_from_reference
    A      NP_M4155_mode_pass_over_reference
    O      NP_M4150_mode_manual
    O      NP_M4151_mode_electronic_handwheel
  ]
  IFT
    L      K+2
    =      WL_Y_plus_lock_before_referenced
  ELSE
    L      K+0
    =      WL_Y_plus_lock_before_referenced
  ENDI
#endif

#if (MT = &MT_15) or (MT = &MT_15A)
 *;Y in TC Area, Z- Motion Lock
  L      NP_W1032_reference_nesessary
  BT     KG_axis_Z
  AN[                                                                 *;EUMACH MP1352
    L      WG_MP1352_power_off_pos_saved                              *;EUMACH MP1352
    BT     KG_axis_Z                                                  *;EUMACH MP1352
  ]                                                                   *;EUMACH MP1352
  IFT
    L      DG_position_axis_Z_ref_accumulator
    <>     K+0
    A      NP_M4172_1st_PLC_run_after_power_on
    IFT
      L      DG_position_axis_Z_ref_accumulator
      =      DG_position_axis_Z_ref_power_off
    ENDI

    L      DG_position_axis_Z_ref_power_off
    +      DG_position_axis_Z_ref
    =      DG_position_axis_Z_ref_accumulator

    L      NP_D824_TC_position_Z_put_in
    -      K+500000
    >      DG_position_axis_Z_ref_accumulator
    A      I_machine_in_TC_area
    IFT
      L      K+4
      =      WL_Z_minus_motion_lock

      L      MG_marker_one
      =      ML_Z_minus_motion_lock
    ELSE
      L      K+0
      =      WL_Z_minus_motion_lock

      L      MG_marker_zero
      =      ML_Z_minus_motion_lock
    ENDI
  ELSE
    L      K+0
    =      DG_position_axis_Z_ref_accumulator

    L      DG_position_axis_Z_ref
    =      DG_position_axis_Z_ref_power_off

    L      NP_D824_TC_position_Z_put_in
    -      K+500000
    >      DG_position_axis_Z_ref
    A      I_machine_in_TC_area
    IFT
      L      K+4
      =      WL_Z_minus_motion_lock

      L      MG_marker_one
      =      ML_Z_minus_motion_lock
    ELSE
      L      K+0
      =      WL_Z_minus_motion_lock

      L      MG_marker_zero
      =      ML_Z_minus_motion_lock
    ENDI
  ENDI
#endif

#if ((MT = &MT_25) or (MT = &MT_35)) and ((Head = &S_head_type_01) or (Head = &S_head_type_02) or (Head = &S_head_type_10))
 *;Y+ motion lock for V/H head
  L      MG_SHC_turning_S_orient_on
  O      MG_V_H_head_Help_jog_ccw
  O      MG_V_H_head_Help_jog_cw
  IFT
    L      K+2
    =      WL_Y_plus_lock_while_S_head_turning

    L      MG_marker_one
    =      ML_Y_plus_lock_while_S_head_turning
  ELSE
    L      K+0
    =      WL_Y_plus_lock_while_S_head_turning

    L      MG_marker_zero
    =      ML_Y_plus_lock_while_S_head_turning
  ENDI

 *;Z- Motion Lock
  L      NP_W1032_reference_nesessary
  BT     KG_axis_Z
  AN[                                                                 *;EUMACH MP1352
    L      WG_MP1352_power_off_pos_saved                              *;EUMACH MP1352
    BT     KG_axis_Z                                                  *;EUMACH MP1352
  ]                                                                   *;EUMACH MP1352
  IFT
    L      DG_position_axis_Z_ref_accumulator
    <>     K+0
    A      NP_M4172_1st_PLC_run_after_power_on
    IFT
      L      DG_position_axis_Z_ref_accumulator
      =      DG_position_axis_Z_ref_power_off
    ENDI

    L      DG_position_axis_Z_ref_power_off
    +      DG_position_axis_Z_ref
    =      DG_position_axis_Z_ref_accumulator

    L      DG_MP920_Z_limit_switch
    +      K+1000
    >      DG_position_axis_Z_ref_accumulator
    AN     I_spindle_without_3D_head
    A      I_V_H_head_in_vertical_pos
    AN     I_V_H_head_in_horizontal_pos
    O[
      L      DG_MP921_Z_limit_switch
      +      K+1000
      >      DG_position_axis_Z_ref_accumulator
      AN     I_spindle_without_3D_head
      AN     I_V_H_head_in_vertical_pos
      A      I_V_H_head_in_horizontal_pos
    ]
    IFT
      L      K+4
      =      WL_Z_minus_motion_lock

      L      MG_marker_one
      =      ML_Z_minus_motion_lock
    ELSE
      L      K+0
      =      WL_Z_minus_motion_lock

      L      MG_marker_zero
      =      ML_Z_minus_motion_lock
    ENDI
  ELSE
    L      K+0
    =      DG_position_axis_Z_ref_accumulator

    L      DG_position_axis_Z_ref
    =      DG_position_axis_Z_ref_power_off

    L      K+0
    =      WL_Z_minus_motion_lock

    L      MG_marker_zero
    =      ML_Z_minus_motion_lock
  ENDI
#endif

#if (MT = &MT_2B) or (MT = &MT_3A) or (MT = &MT_3AA)
 *;Y+ Motion Lock
  L      MG_working_area_Y_plus_motion_lock
  IFT
    L      K+2
    =      WL_Y_plus_motion_lock
  ELSE
    L      K+0
    =      WL_Y_plus_motion_lock
  ENDI

 *;Y- Motion Lock
  L      MG_working_area_Y_minus_motion_lock
  IFT
    L      K+2
    =      WL_Y_minus_motion_lock
  ELSE
    L      K+0
    =      WL_Y_minus_motion_lock
  ENDI

 *;Z+ Motion Lock
  L      MG_working_area_Z_plus_motion_lock
  IFT
    L      K+4
    =      WL_Z_plus_motion_lock
  ELSE
    L      K+0
    =      WL_Z_minus_motion_lock
  ENDI

 *;Z- Motion Lock
  L      MG_working_area_Z_minus_motion_lock
  IFT
    L      K+4
    =      WL_Z_minus_motion_lock
  ELSE
    L      K+0
    =      WL_Z_minus_motion_lock
  ENDI

 *;IV+/IV- Motion Lock
  L      MG_working_area_IV_motion_lock
  IFT
    L      K+8
    =      WL_IV_plus_motion_lock
    =      WL_IV_minus_motion_lock
  ELSE
    L      K+0
    =      WL_IV_plus_motion_lock
    =      WL_IV_minus_motion_lock
  ENDI
#endif

#if (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
  LN     I_Y_within_travel_range
  AN     I_Z_not_in_cover_interference_area
  AN     MG_service_operation
  IFT
    L      K+2
    =      WL_Y_plus_motion_lock

    L      MG_marker_one
    =      ML_Y_plus_motion_lock

    L      K+4
    =      WL_Z_minus_motion_lock

    L      MG_marker_one
    =      ML_Z_minus_motion_lock
  ELSE
    L      K+0
    =      WL_Y_plus_motion_lock

    L      MG_marker_zero
    =      ML_Y_plus_motion_lock

    L      K+0
    =      WL_Z_minus_motion_lock

    L      MG_marker_zero
    =      ML_Z_minus_motion_lock
  ENDI
#endif

#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
  LN     I_alternating_table_zone_overtravel
  ON     MG_alternating_table_on
  O      MG_service_operation
  IFT
    L      K+0
    =      WL_Y_minus_motion_lock

    L      MG_marker_zero
    =      ML_Y_minus_motion_lock
  ELSE
    L      K+2
    =      WL_Y_minus_motion_lock

    L      MG_marker_one
    =      ML_Y_minus_motion_lock
  ENDI
#endif

#if MT = &MT_39
 *;B+ motion lock for 45 degree head
;  L      NP_W1032_reference_nesessary
;  BT     KG_axis_5
;  IFT
;    L      K+2700000
;    -      DG_position_axis_6_ref
