;  O      ML_B_minus_motion_lock
;#endif
;#if (MT = &MT_39A) or (MT = &MT_3AA) or (MT = &MT_3B) or (MT = &MT_3BA)
;  O      MG_anti_backlash_4_start
;  O      MG_anti_backlash_5_start
;#endif
;  =      PN_M4576_suppress_handwheel_pulses

;  L      NP_W1032_reference_nesessary
;  BT     KG_axis_Y
;  AN     I_spindle_without_3D_head
;  AN     I_V_H_head_in_vertical_pos
;  A      I_V_H_head_in_horizontal_pos
;  AN     I_not_ref_end_position_Y
;  A[
;    LN     MG_NC_start_from_reference
;    A      NP_M4155_mode_pass_over_reference
;    O      NP_M4150_mode_manual
;    O      NP_M4151_mode_electronic_handwheel
;  ]
;  IFT
;    L      K+2
;    =      WL_Y_plus_REF_lock_in_S_head_horizontal
;
;    L      MG_marker_one
;    =      ML_Y_plus_REF_lock_in_S_head_horizontal
;  ELSE
;    L      K+0
;    =      WL_Y_plus_REF_lock_in_S_head_horizontal
;
;    L      MG_marker_zero
;    =      ML_Y_plus_REF_lock_in_S_head_horizontal
;  ENDI
;
;  L      PN_W1046_manual_motion_plus
;  AN     WL_Y_plus_REF_lock_in_S_head_horizontal
;  =      PN_W1046_manual_motion_plus
;
;  L      PN_M4576_suppress_handwheel_pulses
;  O      ML_Y_plus_REF_lock_in_S_head_horizontal
;  =      PN_M4576_suppress_handwheel_pulses

EM

;----------------------------
LBL Feed_enable_disable

  L      K%1111111111111111
  =      WG_Mx01_feed_enable

*;M400 always set clamping mode on, so PN_M4092_quit_M_function will be taken care in AXES.SRC.
*;M401 will set clamping mode off only when KG_power_on_clamping_mode_off = %xx1xxx and
*;PN_M4092_quit_M_function will also be taken care in AXES.SRC.
*;M401 will not set clamping mode off when KG_power_on_clamping_mode_off = %xx0xxx, so
*;PN_M4092_quit_M_function must be taken care as follows.
  L      KG_clamping_mode_active
  AN     KG_power_on_clamping_mode_off
  BT     KG_axis_4
  A      MG_M401_feed_enable_axis_4
  S      PN_M4092_quit_M_function

  L      MG_MP_are_read_p_pulse
  AN[
    L      WG_axis_encoder_EnDat
    BT     KG_axis_4
  ]
  O      MG_M401_feed_enable_axis_4
  R      MG_feed_disable_axis_4

  L      MG_M400_feed_disable_axis_4
  S      MG_feed_disable_axis_4

  L      MG_feed_disable_axis_4
  IFT
    L      PN_W1060_feed_release_axis_specific
    A      K%1111111111110111
    =      PN_W1060_feed_release_axis_specific

    L      WG_Mx01_feed_enable
    A      K%1111111111110111
    =      WG_Mx01_feed_enable
  ELSE
    L      WG_Mx01_feed_enable
    O      K%0000000000001000
    =      WG_Mx01_feed_enable
  ENDI

  LN     NP_W1026_axes_in_position
  BT     KG_axis_4
  A      NP_M4151_mode_electronic_handwheel
  O[
    L      NP_W1028_axes_in_motion
    BT     KG_axis_4
    AN     NP_M4151_mode_electronic_handwheel
  ]
  A      MG_feed_disable_axis_4
  S      PN_error_feed_disable_C_axis

  L      NP_M4151_mode_electronic_handwheel
  AN[
    L      WG_selected_handwheel_axis
    BT     KG_axis_4
  ]
  A      MG_feed_disable_axis_4
  O      MG_M401_feed_enable_axis_4
  R      PN_error_feed_disable_C_axis

#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
*;M500 always set clamping mode on, so PN_M4092_quit_M_function will be taken care in AXES.SRC.
*;M501 will set clamping mode off only when KG_power_on_clamping_mode_off = %x1xxxx and
*;PN_M4092_quit_M_function will also be taken care in AXES.SRC.
*;M501 will not set clamping mode off when KG_power_on_clamping_mode_off = %x0xxxx, so
*;PN_M4092_quit_M_function must be taken care as follows.
  L      KG_clamping_mode_active
  AN     KG_power_on_clamping_mode_off
  BT     KG_axis_5
  A      MG_M501_feed_enable_axis_5
  S      PN_M4092_quit_M_function

  L      MG_MP_are_read_p_pulse
  AN[
    L      WG_axis_encoder_EnDat
    BT     KG_axis_5
  ]
  O      MG_M501_feed_enable_axis_5
  R      MG_feed_disable_axis_5

  L      MG_M500_feed_disable_axis_5
  S      MG_feed_disable_axis_5

  L      MG_feed_disable_axis_5
  IFT
    L      PN_W1060_feed_release_axis_specific
    A      K%1111111111101111
    =      PN_W1060_feed_release_axis_specific

    L      WG_Mx01_feed_enable
    A      K%1111111111101111
    =      WG_Mx01_feed_enable
  ELSE
    L      WG_Mx01_feed_enable
    O      K%0000000000010000
    =      WG_Mx01_feed_enable
  ENDI

  LN     NP_W1026_axes_in_position
  BT     KG_axis_5
  A      NP_M4151_mode_electronic_handwheel
  O[
    L      NP_W1028_axes_in_motion
    BT     KG_axis_5
    AN     NP_M4151_mode_electronic_handwheel
  ]
  A      MG_feed_disable_axis_5
  S      PN_error_feed_disable_C_axis

  L      NP_M4151_mode_electronic_handwheel
  AN[
    L      WG_selected_handwheel_axis
    BT     KG_axis_5
  ]
  A      MG_feed_disable_axis_5
  O      MG_M501_feed_enable_axis_5
  R      PN_error_feed_disable_C_axis
#endif

*;Simulated axes feed enabling/disabling
  L      MG_M74_simulated_axes_feed_enable
  S      MG_simulated_axes_feed_enable
  R      MG_simulated_axes_in_motion
  R      MG_simulated_axes_feed_disable_delay
  S      PN_M4092_quit_M_function
  IFT
    L      K+0
    =      BL_simulated_axes_feed_disable_delay
  ENDI

  *; For MACRO calling from PLC module 9291 after power-on, no information from
  *; NP_W1026_axes_in_position & NP_W1028_axes_in_motion.  Therefore, feed releasing in
  *; Traverse reference point mode.
  L      MG_simulated_axes_feed_enable
  O      NP_M4155_mode_pass_over_reference
  IFT
    L      PN_W1060_feed_release_axis_specific
    O      WG_MP12_simulated_axes
    =      PN_W1060_feed_release_axis_specific
  ELSE
    L      PN_W1060_feed_release_axis_specific
    AN     WG_MP12_simulated_axes
    =      PN_W1060_feed_release_axis_specific
  ENDI

  L      WG_controlled_axes
  A      WG_MP12_simulated_axes
  AN     NP_W1026_axes_in_position
  A      NP_W1028_axes_in_motion
  >      K+0
  A      MG_simulated_axes_feed_enable
  S      MG_simulated_axes_in_motion

  L      WG_controlled_axes
  A      WG_MP12_simulated_axes
  A      NP_W1026_axes_in_position
  AN     NP_W1028_axes_in_motion
  AN     PN_W1040_control_loop_open
  >      K+0
  A      MG_simulated_axes_in_motion
  S      MG_simulated_axes_feed_disable_delay

  L      MG_simulated_axes_feed_disable_delay
  IFT
    INC    BL_simulated_axes_feed_disable_delay
  ENDI

  L      BL_simulated_axes_feed_disable_delay
  ==     K+25
  A      MG_simulated_axes_feed_disable_delay
  O      MG_pulse_internal_stop
  ON     I_control_operational
  R      MG_simulated_axes_feed_enable
  R      MG_simulated_axes_in_motion
  R      MG_simulated_axes_feed_disable_delay
  IFT
    L      K+0
    =      BL_simulated_axes_feed_disable_delay
  ENDI

EM

;----------------------------
LBL Torque_rotary_axes_monitoring

  L      WG_controlled_axes
  BT     KG_axis_4
  A[
    L      DG_MP2256_3_field_angle_4
    >      K+0
  ]
  A      NP_4_clamping_while_output=1
  AN     I_control_operational
  =      ML_axis_4_no_monitoring_torque_rotary_axis

  L      ML_axis_4_no_monitoring_torque_rotary_axis
  IFT
    L    PN_W1042_no_axes_monitoring
    BS   KG_axis_4
    =    WG_axis_4_monitoring_off_torque_rotary
  ELSE
    L    PN_W1042_no_axes_monitoring
    BC   KG_axis_4
    =    WG_axis_4_monitoring_off_torque_rotary
  ENDI

  L      WG_controlled_axes
  BT     KG_axis_5
  A[
    L      DG_MP2256_4_field_angle_5
    >      K+0
  ]
  A      NP_5_clamping_while_output=1
  AN     I_control_operational
  =      ML_axis_5_no_monitoring_torque_rotary_axis

  L      ML_axis_5_no_monitoring_torque_rotary_axis
  IFT
    L    PN_W1042_no_axes_monitoring
    BS   KG_axis_5
    =    WG_axis_5_monitoring_off_torque_rotary
  ELSE
    L    PN_W1042_no_axes_monitoring
    BC   KG_axis_5
    =    WG_axis_5_monitoring_off_torque_rotary
  ENDI

  L      WG_controlled_axes
  BT     KG_axis_6
  A[
    L      DG_MP2256_5_field_angle_6
    >      K+0
  ]
  A      NP_6_clamping_while_output=1
  AN     I_control_operational
  =      ML_axis_6_no_monitoring_torque_rotary_axis

  L      ML_axis_6_no_monitoring_torque_rotary_axis
  IFT
    L    PN_W1042_no_axes_monitoring
    BS   KG_axis_6
    =    WG_axis_6_monitoring_off_torque_rotary
  ELSE
    L    PN_W1042_no_axes_monitoring
    BC   KG_axis_6
    =    WG_axis_6_monitoring_off_torque_rotary
  ENDI

EM

;----------------------------
LBL Axes_monitoring

  L    WG_axis_4_monitoring_off_torque_rotary
  O    WG_3D_head_axis_5_monitoring_off
  O    WG_axis_5_monitoring_off_torque_rotary
  O    WG_axis_6_monitoring_off_torque_rotary
  =    PN_W1042_no_axes_monitoring

EM

;----------------------------
LBL Output_reassignment

 *;O_clamping_unclamping_4, O_clamping_4_output
  L      WG_controlled_axes
  BT     KG_axis_4
  AN     MG_FN19_4_clamping_on_off_active
  IFT
    L      WG_hirth_axes
    BT     KG_axis_4
    IFT
#if MT = &MT_39
      LN     TS_unclamping_4
      A      TR_unclamping_4
      ON     I_unclamped_axis_4
      A      O_unclamping_4
      =      O_clamping_unclamping_4
#else
      L      O_unclamping_4
      =      O_clamping_unclamping_4
#endif
    ELSE
      L      NP_4_clamping_while_output=1
      IFT
#if (MT = &MT_2D) or (MT = &MT_31A) or (MT = &MT_31B) or (MT = &MT_36B) or (MT = &MT_37B) or (MT = &MT_39A) or (MT = &MT_3AA) or (MT = &MT_3B) or (MT = &MT_3BA)
        L      NP_key_for_torque_motor_brake_releasing
        IFT
          L      I_key_axis_4_plus
          O      I_key_axis_4_minus
          A      I_key_axes_motion_from_end_position
          =N     O_clamping_unclamping_4

          L      MG_marker_one
          S      PN_error_key_for_torque_motor_brake_releasing
        ELSE
          LN     O_unclamping_4
          =      O_clamping_unclamping_4
        ENDI
#else
        LN     O_unclamping_4
        =      O_clamping_unclamping_4
#endif
      ELSE
#if (MT = &MT_2D) or (MT = &MT_31A) or (MT = &MT_31B) or (MT = &MT_36B) or (MT = &MT_37B) or (MT = &MT_39A) or (MT = &MT_3AA) or (MT = &MT_3B) or (MT = &MT_3BA)
        L      NP_key_for_torque_motor_brake_releasing
        IFT
          L      I_key_axis_4_plus
          O      I_key_axis_4_minus
          A      I_key_axes_motion_from_end_position
          =      O_clamping_unclamping_4

          L      MG_marker_one
          S      PN_error_key_for_torque_motor_brake_releasing
        ELSE
          L      O_unclamping_4
          =      O_clamping_unclamping_4
        ENDI
#else
        L      O_unclamping_4
        =      O_clamping_unclamping_4
#endif
      ENDI
    ENDI
  ENDI

  L      WG_controlled_axes
  BT     KG_axis_4
  AN     MG_FN19_4_clamping_on_off_active
  IFT
    L      WG_hirth_axes
    BT     KG_axis_4
    IFT
      L      I_servo_drive_release
      A      MG_servo_drive_release_1st_axes_group
      =      TS_I_servo_drive_release

      LN     TS_I_servo_drive_release
      AN     TR_I_servo_drive_release
      O[
        L      I_servo_drive_release
        A      MG_servo_drive_release_1st_axes_group
      ]
      A[
        LN     NP_W1024_axes_release
        BT     KG_axis_4
        A      MG_4_in_hirth_position
        O[
          L      NP_W1024_axes_release
          BT     KG_axis_4
        ]
      ]
      AN     O_unclamping_4
      =      O_clamping_4_output
    ELSE
      LN     O_unclamping_4
      =      O_clamping_4_output
    ENDI
  ENDI

 *;O_clamping_unclamping_5, O_clamping_5_output
  L      WG_controlled_axes
  BT     KG_axis_5
  AN     MG_FN19_5_clamping_on_off_active
  IFT
    L      WG_hirth_axes
    BT     KG_axis_5
    IFT
*;EUMACH For FBE ITRI HURON head series, if C-axis unclamping does not have
;        pressure reduction valve, the following PLC can release the C-axis
;        unclamping valve after C-axis has been unclamped.
;#if (MT = &MT_25A) or (MT = &MT_35A)
;      LN     I_unclamped_axis_5
;      =      TS_unclamping_5

;      LN     TS_unclamping_5
;      A      TR_unclamping_5
;      ON     I_unclamped_axis_5
;      A      O_unclamping_5
;      =      O_clamping_unclamping_5
;#else
      L      O_unclamping_5
      =      O_clamping_unclamping_5
;#endif
    ELSE
      L      NP_5_clamping_while_output=1
      IFT
#if (MT = &MT_2D) or (MT = &MT_31A) or (MT = &MT_31B) or (MT = &MT_36B) or (MT = &MT_37B) or (MT = &MT_39A) or (MT = &MT_3AA) or (MT = &MT_3B) or (MT = &MT_3BA)
        L      NP_key_for_torque_motor_brake_releasing
        IFT
          L      I_key_axis_5_plus
          O      I_key_axis_5_minus
          A      I_key_axes_motion_from_end_position
          =N     O_clamping_unclamping_5

          L      MG_marker_one
          S      PN_error_key_for_torque_motor_brake_releasing
        ELSE
          LN     O_unclamping_5
          =      O_clamping_unclamping_5
        ENDI
#else
        LN     O_unclamping_5
        =      O_clamping_unclamping_5
#endif
      ELSE
#if (MT = &MT_2D) or (MT = &MT_31A) or (MT = &MT_31B) or (MT = &MT_36B) or (MT = &MT_37B) or (MT = &MT_39A) or (MT = &MT_3AA) or (MT = &MT_3B) or (MT = &MT_3BA)
        L      NP_key_for_torque_motor_brake_releasing
        IFT
          L      I_key_axis_5_plus
          O      I_key_axis_5_minus
          A      I_key_axes_motion_from_end_position
          =      O_clamping_unclamping_5

          L      MG_marker_one
          S      PN_error_key_for_torque_motor_brake_releasing
        ELSE
          L      O_unclamping_5
          =      O_clamping_unclamping_5
        ENDI
#else
        L      O_unclamping_5
        =      O_clamping_unclamping_5
#endif
      ENDI
    ENDI
  ENDI

  L      WG_controlled_axes
  BT     KG_axis_5
  AN     MG_FN19_5_clamping_on_off_active
  IFT
    L      WG_hirth_axes
    BT     KG_axis_5
    IFT
#if MT = &MT_39
      L      I_servo_drive_release
      A      MG_servo_drive_release_1st_axes_group
      A      MG_control_operational
      AN     O_unclamping_5
      A      MG_5_in_hirth_position
      =      O_clamping_5_output
#else
      L      I_servo_drive_release
      A      MG_servo_drive_release_1st_axes_group
      =      TS_I_servo_drive_release

      LN     TS_I_servo_drive_release
      AN     TR_I_servo_drive_release
      O[
        L      I_servo_drive_release
        A      MG_servo_drive_release_1st_axes_group
      ]
      A[
        LN     NP_W1024_axes_release
        BT     KG_axis_5
        A      MG_5_in_hirth_position
        O[
          L      NP_W1024_axes_release
          BT     KG_axis_5
        ]
      ]
      AN     O_unclamping_5
      =      O_clamping_5_output
#endif
    ELSE
      LN     O_unclamping_5
      =      O_clamping_5_output
    ENDI
  ENDI

 *;O_clamping_unclamping_6, O_clamping_6_output
  L      WG_controlled_axes
  BT     KG_axis_6
  AN     MG_FN19_6_clamping_on_off_active
  IFT
    L      WG_hirth_axes
    BT     KG_axis_6
    IFT
      L      O_unclamping_6
      =      O_clamping_unclamping_6
    ELSE
      L      NP_6_clamping_while_output=1
      IFT
#if (MT = &MT_2D) or (MT = &MT_36B) or (MT = &MT_37B)
        L      NP_key_for_torque_motor_brake_releasing
        IFT
          L      I_key_axis_6_plus
          O      I_key_axis_6_minus
          A      I_key_axes_motion_from_end_position
          =N     O_clamping_unclamping_6

          L      MG_marker_one
          S      PN_error_key_for_torque_motor_brake_releasing
        ELSE
          LN     O_unclamping_6
          =      O_clamping_unclamping_6
        ENDI
#else
        LN     O_unclamping_6
        =      O_clamping_unclamping_6
#endif
      ELSE
#if (MT = &MT_2D) or (MT = &MT_36B) or (MT = &MT_37B)
        L      NP_key_for_torque_motor_brake_releasing
        IFT
          L      I_key_axis_6_plus
          O      I_key_axis_6_minus
          A      I_key_axes_motion_from_end_position
          =      O_clamping_unclamping_6

          L      MG_marker_one
          S      PN_error_key_for_torque_motor_brake_releasing
        ELSE
          L      O_unclamping_6
          =      O_clamping_unclamping_6
        ENDI
#else
        L      O_unclamping_6
        =      O_clamping_unclamping_6
#endif
      ENDI
    ENDI
  ENDI

  L      WG_controlled_axes
  BT     KG_axis_6
  AN     MG_FN19_6_clamping_on_off_active
  IFT
    L      WG_hirth_axes
    BT     KG_axis_6
    IFT
      L      I_servo_drive_release
      A      MG_servo_drive_release_1st_axes_group
      =      TS_I_servo_drive_release

      LN     TS_I_servo_drive_release
      AN     TR_I_servo_drive_release
      O[
        L      I_servo_drive_release
        A      MG_servo_drive_release_1st_axes_group
      ]
      A[
        LN     NP_W1024_axes_release
        BT     KG_axis_6
        A      MG_6_in_hirth_position
        O[
          L      NP_W1024_axes_release
          BT     KG_axis_6
        ]
      ]
      AN     O_unclamping_6
      =      O_clamping_6_output
    ELSE
      LN     O_unclamping_6
      =      O_clamping_6_output
    ENDI
  ENDI

 *;MG_O_unclamping[X]
  L      O_unclamping_X
  =      MG_O_unclamping_X

  L      O_unclamping_Y
  =      MG_O_unclamping_Y

  L      O_unclamping_Z
  =      MG_O_unclamping_Z

  L      O_unclamping_4
  =      MG_O_unclamping_4

  L      O_unclamping_5
  =      MG_O_unclamping_5

  L      O_unclamping_6
  =      MG_O_unclamping_6

  L      O_unclamping_7
  =      MG_O_unclamping_7

  L      O_unclamping_8
  =      MG_O_unclamping_8

  L      O_unclamping_9
  =      MG_O_unclamping_9

  L      O_unclamping_10
  =      MG_O_unclamping_10

  L      O_unclamping_11
  =      MG_O_unclamping_11

  L      O_unclamping_12
  =      MG_O_unclamping_12

  L      O_unclamping_13
  =      MG_O_unclamping_13

  L      O_unclamping_14
  =      MG_O_unclamping_14

  L      O_unclamping_15
  =      MG_O_unclamping_15

  L      O_unclamping_16
  =      MG_O_unclamping_16

 *;O_3D_head_unclamping_pressure_increasing
#if (MT = &MT_22) or (MT = &MT_25B) or (MT = &MT_2MV) or (MT = &MT_32B) or (MT = &MT_35B)
  LN     I_unclamped_axis_5
  AN     I_unclamped_axis_6
  =      TS_3D_head_unclamping

  L      O_clamping_unclamping_5
  O      O_clamping_unclamping_6
  A      TR_3D_head_unclamping
  =      O_3D_head_unclamping_pressure_increasing
#endif

 *;O_tool_unclamping_valve & O_tool_clamping_valve
  LN     MG_FN19_tool_clamping_on_off_active
  IFT
    L      O_tool_unclamping
    =      O_tool_unclamping_valve
    =      O_tool_unclamping_pneumatic_valve ;=0->pneumatic to help tool clamping
#if Head = &inactive
  =      O_tool_unclamping_without_head
#endif

    L      O_tool_clamping
    =      O_tool_clamping_valve
#if Head = &inactive
    =      O_tool_clamping_without_head
#endif
  ENDI

#if (Head = &S_head_type_01) or (Head = &S_head_type_02) or (Head = &S_head_type_09) or (Head = &S_head_type_10)
  L      I_spindle_without_3D_head
  IFT
    L      O_tool_clamping
    =      O_tool_clamping_without_head

    L      O_tool_unclamping
    =      O_tool_unclamping_without_head
  ELSE
    LN     O_tool_unclamping
    =      O_tool_clamping_with_head

    L      O_tool_unclamping
    =      O_tool_unclamping_with_head

    LN     I_tool_clamped_without_V_H_head
