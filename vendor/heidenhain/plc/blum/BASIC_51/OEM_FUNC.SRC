;----------------------------
LBL Axes_clamped_compensation                                         *;EUMACH Table clamped -> Z comp

  L      WG_controlled_axes
  BT     KG_axis_4
  IFT
    L      WG_activate_control_loop_open
    BT     KG_axis_4
    A      NP_4_clamped_Z_comp
    A[
      L      NP_M401_4_clamped_Z_comp
      AN     MG_feed_disable_axis_4
      ON     NP_M401_4_clamped_Z_comp
    ]
    =      MG_Z_comp_axis_4_clamped
  ELSE
    L      MG_marker_one
    R      MG_Z_comp_axis_4_clamped
  ENDI

  L      MG_Z_comp_axis_4_clamped
  IFT
      L      NP_MP4230_34_4_clamped_Z_comp
      =      DG_4_clamped_Z_comp
  ELSE
      L      K+0
      =      DG_4_clamped_Z_comp
  ENDI

EM

;----------------------------
LBL Thermal_compensation                                              *;EUMACH Table clamped -> Z comp

#if KINEMAT_tempcomp = &inactive
  L      WG_W3000_lag_err_comp_X
  +      WG_PMC_temp_comp_axis_X
#else
  L      K+0
#endif
  =      PN_W576_lag_error_compensation_X

#if KINEMAT_tempcomp = &inactive
  L      WG_W3002_lag_err_comp_Y
  +      WG_PMC_temp_comp_axis_Y
#else
  L      K+0
#endif
  =      PN_W578_lag_error_compensation_Y

#if KINEMAT_tempcomp = &inactive
  L      WG_W3004_lag_err_comp_Z
  +      WG_PMC_temp_comp_axis_Z
#else
  L      K+0
#endif
  +      DG_4_clamped_Z_comp
  =      PN_W580_lag_error_compensation_Z

EM

