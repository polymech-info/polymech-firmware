  LN     MG_soft_key_S_man_head
  IFT
    L      O_tool_clamping
    =      O_tool_clamping_without_head

    L      O_tool_unclamping
    =      O_tool_unclamping_without_head
  ELSE
    LN     O_tool_unclamping
    =      O_tool_clamping_with_head

    L      O_tool_unclamping
    =      O_tool_unclamping_with_head

    L      MG_marker_one
    =      O_tool_clamping_without_head
  ENDI
#else
  L      I_spindle_without_3D_head
  IFT
    L      O_tool_clamping
    =      O_tool_clamping_without_head

    L      O_tool_unclamping
    =      O_tool_unclamping_without_head
  ELSE
    LN     O_tool_unclamping
    =      O_tool_clamping_with_head

    L      O_tool_unclamping
    =      O_tool_unclamping_with_head

    LN     I_tool_clamped_without_V_H_head
    AN     O_tool_unclamping_without_head
    =      O_tool_clamping_without_head
  ENDI
#endif
