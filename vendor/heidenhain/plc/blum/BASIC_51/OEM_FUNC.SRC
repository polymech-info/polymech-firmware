LBL Safety_modes                                                      *;CE 2008

#if SFM ! &inactive
*; Safety mode 2
  L      I_safety_mode_2
  AN     I_safety_mode_4
#if SFM = &DMx
  A      MG_guard_open
#endif
  =      PN_error_safety_mode_2                                       *;Using in M code MACRO

  L      PN_error_safety_mode_2
  AN     ML_safety_mode_2
  =      MG_safety_mode_2_p_pulse

  L      PN_error_safety_mode_2
  =      ML_safety_mode_2

*; Safety mode 4
#if SFM = &DMx
  LN     I_safety_mode_2
  A      I_safety_mode_4
  =      MG_safety_mode_4

  L      MG_safety_mode_4
  AN     MG_guard_open
  =      PN_error_safety_mode_4_1                                     *;Using in M code MACRO

  L      MG_safety_mode_4
  A      MG_guard_open
  =      PN_error_safety_mode_4_2                                     *;Using in M code MACRO

  L      MG_safety_mode_4
  AN     ML_safety_mode_4
  =      MG_safety_mode_4_p_pulse

  L      MG_safety_mode_4
  =      ML_safety_mode_4
#endif

*; Safety mode error
#if SFM = &Standard
  L      PN_error_safety_mode_2
  A      NP_M4176_control_in_operation_on_or_flashes
  A      MG_automatic_mode
  S      PN_error_safety_mode_switching
#endif

  L      I_safety_mode_2
  A      I_safety_mode_4
#if SFM = &DMx
  A      MG_guard_open
#endif
  S      PN_error_safety_mode_error
#endif

EM

;----------------------------
LBL Miscellaneous_functions

  L      NP_M4189_emergency_stop_test_complete
  S      O_NC_self_test_completed

 *;Time duration calculation from last time NC power-off to this time NC
 *;power-on
  L      NP_M4172_1st_PLC_run_after_power_on
  IFT
    L      DG_real_time
    -      DG_TNC_power_off_real_time_sec
    =      DL_TNC_power_off_duration_sec
  ENDI

  L      DG_real_time
  =      DG_TNC_power_off_real_time_sec

#if (MT = &MT_2D) or (MT = &MT_31A) or (MT = &MT_31B) or (MT = &MT_36B) or (MT = &MT_37B)
  L      WG_controlled_axes
  BT     KG_axis_4
  A[
    L      DG_MP2256_3_field_angle_4
    >      K+0
  ]
  AN     I_IV_thermal_sensor_temperature_ok
  S      PN_error_thermal_sensor_temperature
  S      MG_win_axis_4
#endif

#if (MT = &MT_2D) or (MT = &MT_31A) or (MT = &MT_31B) or (MT = &MT_36B) or (MT = &MT_37B) or (MT = &MT_39A) or (MT = &MT_3AA) or (MT = &MT_3B) or (MT = &MT_3BA)
  L      WG_controlled_axes
  BT     KG_axis_5
  A[
    L      DG_MP2256_4_field_angle_5
    >      K+0
  ]
  AN     I_V_thermal_sensor_temperature_ok
  S      PN_error_thermal_sensor_temperature
  S      MG_win_axis_5
#endif

#if (MT = &MT_2D) or (MT = &MT_36B) or (MT = &MT_37B)
  L      WG_controlled_axes
  BT     KG_axis_6
  A[
    L      DG_MP2256_5_field_angle_6
    >      K+0
  ]
  AN     I_VI_thermal_sensor_temperature_ok
  S      PN_error_thermal_sensor_temperature
  S      MG_win_axis_6
#endif

#if S_PTC_sensor = &active
  L      MG_spindle_active
  A[
    L      DG_MP2256_12_field_angle_S
    >      K+0
  ]
  AN     I_S_PTC_sensor_temperature_ok
  S      PN_error_thermal_sensor_temperature
  S      MG_win_spindle
#endif

  L      MG_spindle_active
  A[
    L      BG_MP2160_S_SM1xx_voltage_protection
    ==     K+1
  ]
  AN     I_SM1xx_temperature_ok
  S      PN_error_SM1xx_temperature_too_high
  S      MG_win_spindle

  L      NP_tool_clamping_pneumatic_sensor
  A      MG_spindle_active
  IFT
     L      I_tool_clamped_pneumatic_pressure_ok
     O      O_tool_unclamping
     ON     O_pneumatic_inlet_valve_on
     ON     MG_power_delayed_on
     =      TS_tool_clamping_pneumatic_pressure

     LN     TS_tool_clamping_pneumatic_pressure
     AN     TR_tool_clamping_pneumatic_pressure
     S      PN_error_tool_clamping_pneumatic
  ENDI

  L      NP_tool_clamping_hydraulic_sensor
  A      MG_spindle_active
  IFT
     L      I_tool_clamped_hydraulic_pressure_ok
     O      O_tool_unclamping
#if (Hydraulic_ctrl_by_timer_plus_pressure = &inactive) and (Hydraulic_ctrl_by_pressure = &inactive) and (Hydraulic_2_tool_and_axes_clamp_valve = &inactive)
     ON[
       L      O_hydraulic_on
       O      NP_air_to_hydraulic_unit
     ]
#endif
     ON     MG_power_delayed_on
     =      TS_tool_clamping_hydraulic_pressure

     LN     TS_tool_clamping_hydraulic_pressure
     AN     TR_tool_clamping_hydraulic_pressure
     S      PN_error_tool_clamping_hydraulic
  ENDI

  L      NP_pneumatic_counter_weight_balancing
  IFT
     L      I_pneumatic_counter_weight_balancing_ok
     ON     O_pneumatic_inlet_valve_on
     ON     MG_power_delayed_on
     =      TS_pneumatic_counter_weight_balancing

     LN     TS_pneumatic_counter_weight_balancing
     AN     TR_pneumatic_counter_weight_balancing
     S      MG_error_pneumatic_counter_weight_balancing
  ENDI

#if HSS = &HS_type_296
  L      NP_M4031_tapping_cycle_controlled
  S      PN_error_function_inhibited
#endif

#if (Head = &S_head_type_01) or (Head = &S_head_type_02)
  L      I_tool_unclamped_without_V_H_head
  ON     I_tool_clamped_without_V_H_head
  AN     I_spindle_without_3D_head
  AN     MG_TC_help
  S      PN_error_V_H_no_head_tool_not_clamped

  L      I_V_H_head_in_vertical_pos
  O      I_V_H_head_in_horizontal_pos
  A      I_spindle_without_3D_head
  AN     NP_M4176_control_in_operation_on_or_flashes
  S      PN_error_V_H_head

  LN     I_V_H_head_in_vertical_pos
  XO     I_V_H_head_in_horizontal_pos
  AN     I_spindle_without_3D_head
  AN     MG_V_H_head_turning_proceeding
  AN     MG_TC_help
  S      PN_error_V_H_head_pos

  LN     I_V_H_head_clamped
  O      I_V_H_head_unclamped
  A      MG_automatic_V_H_head_installed
  AN     MG_V_H_head_turning_proceeding
  AN     MG_TC_help
  S      PN_error_V_H_head_clamping

  L      MG_Tool_Call_axis_checking
  AN     MG_TC_help
  S      PN_error_check_Tool_Call_axis

  L      PN_error_check_Tool_Call_axis
  A      MG_pulse_CE_key
  R      MG_Tool_Call_axis_checking

  L      NP_M4172_1st_PLC_run_after_power_on
  S      ML_power_on_3D_head_pos_confirmation

  L      MG_3D_head_pos_confirmation
  AN     MG_TC_help
  O[
    L      ML_power_on_3D_head_pos_confirmation
    A      MG_automatic_V_H_head_installed
    A      MG_reference_axes_traversed
    A      NP_DCM_option_purchased
  ]
  S      PN_error_3D_head_pos_confirmation
  R      ML_power_on_3D_head_pos_confirmation

  L      PN_error_3D_head_pos_confirmation
  A      MG_pulse_CE_key
  R      MG_3D_head_pos_confirmation
#endif

#if Head = &S_head_type_06
  L      I_rear_head_in_0_pos
  A      I_spindle_without_3D_head
  A      NP_manual_head_rear_axis_0_pos_sensor
  AN     NP_M4176_control_in_operation_on_or_flashes
  S      PN_error_V_H_head

#if (MT = &MT_12) or (MT = &MT_13) or (MT = &MT_21) or (MT = &MT_32)
  L      I_tool_unclamped_without_V_H_head
  ON     I_tool_clamped_without_V_H_head
  A      MG_soft_key_S_man_head
  AN     MG_TC_help
  S      PN_error_V_H_no_head_tool_not_clamped
#else
  L      I_tool_unclamped_without_V_H_head
  ON     I_tool_clamped_without_V_H_head
  AN     I_spindle_without_3D_head
  AN     MG_TC_help
  S      PN_error_V_H_no_head_tool_not_clamped
#endif
#endif

#if Head = &S_head_type_09
  L      I_rear_head_in_0_pos
  A      I_spindle_without_3D_head
  A      NP_manual_head_rear_axis_0_pos_sensor
  AN     NP_M4176_control_in_operation_on_or_flashes
  S      PN_error_V_H_head

  L      I_tool_unclamped_without_V_H_head
  ON     I_tool_clamped_without_V_H_head
  AN     I_spindle_without_3D_head
  AN     MG_TC_help
  S      PN_error_V_H_no_head_tool_not_clamped
#endif

#if Head = &S_head_type_10
  L      I_tool_unclamped_without_V_H_head
  ON     I_tool_clamped_without_V_H_head
  AN     I_spindle_without_3D_head
  AN     MG_TC_help
  S      PN_error_V_H_no_head_tool_not_clamped

  L      I_V_H_head_in_vertical_pos
  O      I_V_H_head_in_horizontal_pos
  A      I_spindle_without_3D_head
  AN     NP_M4176_control_in_operation_on_or_flashes
  S      PN_error_V_H_head
#endif

*;EUMACH S head running time
#if (MT = &MT_22) or (MT = &MT_25A) or (MT = &MT_25B) or (MT = &MT_2MV) or (MT = &MT_32B) or (MT = &MT_35A) or (MT = &MT_35B)
  L      PN_M4012_S_open_control_loop
  O      NP_M4031_tapping_cycle_controlled
  A      O_servo_drive_release_S
  =      ML_3D_head_run_time

  L      ML_3D_head_run_time
  AN     ML_3D_head_run_time_was_on
  IFT
    PS     KL_CM9190_9191_counter_2
    CM     9190
    M_display_module_error(KG_error_module_9190)
  ENDI

  LN     ML_3D_head_run_time
  A      ML_3D_head_run_time_was_on
  IFT
    PS     KL_CM9190_9191_counter_2
    CM     9191
    M_display_module_error(KG_error_module_9191)
  ENDI

  L      ML_3D_head_run_time
  =      ML_3D_head_run_time_was_on
#endif

#if (MT = &MT_22) or (MT = &MT_25A) or (MT = &MT_25B) or (MT = &MT_2MV) or (MT = &MT_32B) or (MT = &MT_35A) or (MT = &MT_35B)
  L      DG_position_axis_X_ref[KG_3D_head_axis_1]
  -      KL_0_degree
  PSW
  CM     Absolute
  PLW
  <[
    L      DG_MP430_hirth_increm_X[KG_3D_head_axis_1]
    /      K+2
  ]
  ON[
    L      WG_controlled_axes
    BT     KG_3D_head_axis_1
  ]
  =      ML_0_pos_3D_head_axis_1_ref

  L      DG_position_axis_X_ref[KG_3D_head_axis_2]
  -      KL_0_degree
  PSW
  CM     Absolute
  PLW
  <[
    L      DG_MP430_hirth_increm_X[KG_3D_head_axis_2]
    /      K+2
  ]
  ON[
    L      WG_controlled_axes
    BT     KG_3D_head_axis_2
  ]
  =      ML_0_pos_3D_head_axis_2_ref

  LN     ML_0_pos_3D_head_axis_1_ref
  ON     ML_0_pos_3D_head_axis_2_ref
  A      NP_M4060_tool_measurement_active
  S      PN_error_TT_rotary_axis_pos_error
#endif

