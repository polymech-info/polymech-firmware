;EM

;----------------------------
LBL S_head_transmission_lube_time

  RPLY   BL_identifier
  ==     K+0
  IFT
    SUBM   Spindle_head_running_time_submit
    =      BL_identifier
    ==     K+0
    S      PN_error_submit_spawn_queue_full
  ENDI

  L      NP_MP4231_20_S_head_transmission_lube_interval
  /      K+10000
  X      K+3600
  =      DG_S_head_transmission_lube_interval_sec

  L      NP_MP4231_20_S_head_transmission_lube_interval
  >      K+0
  A[
    L      DG_spindle_head_running_time
    >      K+0
  ]
  A[
    L      DG_spindle_head_running_time
    MOD    DG_S_head_transmission_lube_interval_sec
    ==     K+0
  ]
  AN     MG_S_head_lubricated
  A      MG_power_delayed_on
  S      MG_S_head_lubrication_necessary

  L      NP_D276_code_number_entered_via_MOD
  ==     KL_S_head_transmission_lubricated
  S      MG_S_head_lubricated
  R      MG_S_head_lubrication_necessary
  IFT
    L      K+0
    =      NP_D276_code_number_entered_via_MOD
  ENDI

  L      MG_S_head_lubrication_necessary
  =      PN_error_S_head_transmission_lubrication

  L      DG_spindle_head_running_time
  MOD    DG_S_head_transmission_lube_interval_sec
  >      K+0
  AN     MG_S_head_lubrication_necessary
  R      MG_S_head_lubricated

  L      PN_error_S_head_transmission_lubrication
  AN     NP_M4176_control_in_operation_on_or_flashes
  A      MG_automatic_mode
  AN     ML_error_S_head_transmission_lubrication
  =      MG_error_S_head_transmission_lube_p_pulse

  L      PN_error_S_head_transmission_lubrication
  AN     NP_M4176_control_in_operation_on_or_flashes
  A      MG_automatic_mode
  =      ML_error_S_head_transmission_lubrication

EM

;----------------------------
LBL S_head_bearing_lube_time

  L      NP_MP4230_7_S_head_bearing_lube_interval
  /      K+10000
  X      K+3600
  =      DG_S_head_bearing_lube_interval_sec

  L      NP_MP4230_7_S_head_bearing_lube_interval
  >      K+0
  A[
    L      DG_spindle_head_running_time
    >      K+0
  ]
  A[
    L      DG_spindle_head_running_time
    MOD    DG_S_head_bearing_lube_interval_sec
    ==     K+0
  ]
  AN     MG_S_head_bearing_lubricated
  A      MG_power_delayed_on
  S      MG_S_head_bearing_lube_necessary

  L      NP_D276_code_number_entered_via_MOD
  ==     KL_S_head_bearing_lubricated
  S      MG_S_head_bearing_lubricated
  R      MG_S_head_bearing_lube_necessary
  IFT
    L      K+0
    =      NP_D276_code_number_entered_via_MOD
  ENDI

  L      MG_S_head_bearing_lube_necessary
  =      PN_error_S_head_bearing_lubrication

  L      DG_spindle_head_running_time
  MOD    DG_S_head_bearing_lube_interval_sec
  >      K+0
  AN     MG_S_head_bearing_lube_necessary
  R      MG_S_head_bearing_lubricated

  L      PN_error_S_head_bearing_lubrication
  AN     NP_M4176_control_in_operation_on_or_flashes
  A      MG_automatic_mode
  AN     ML_error_S_head_bearing_lubrication
  =      MG_error_S_head_bearing_lube_p_pulse

  L      PN_error_S_head_bearing_lubrication
  AN     NP_M4176_control_in_operation_on_or_flashes
  A      MG_automatic_mode
  =      ML_error_S_head_bearing_lubrication

EM

;----------------------------
LBL Spindle_head_running_time_submit

  PS     KL_CM9192_counter_2
  CM     9192
  PL     DG_spindle_head_running_time
  M_display_module_error(KG_error_module_9192)

EM

#if MT = &MT_2MV
;----------------------------
LBL Ext_sag_comp_file_reading

  L      MG_error_ext_sag_comp_table_check
  EMT

  RPLY   BL_ext_sag_comp_identfier
  <>     K+0
  EMT

  SUBM   Ext_sag_comp_submit
  =      BL_ext_sag_comp_identfier
  ==     K+0
  S      PN_error_submit_spawn_queue_full

EM
#endif

#if MT = &MT_2MV
;----------------------------
LBL Ext_sag_comp_submit

  PS     KL_file_access_read_locked
  PS     S"PLC:\CORRECT\EXT_SAG_COMP.TAB"
  CM     9240                          ;Open a file by the PLC
  PL     DL_file_handle
  M_module_error_display(KG_error_module_9240,MG_win_file_open)

  L      K-1
  =      WL_index_ext_sag_comp_data

  REPEAT
    INC    WL_index_ext_sag_comp_data

    PS     DL_file_handle
    PS     WL_index_ext_sag_comp_data
    PS     S"REF"
    CM     9255                        ;Read a field from a table as an integer value
    PL     DG_ext_sag_comp_REF_pos[WL_index_ext_sag_comp_data] ;unit = 0.0001mm
    M_module_error_display(KG_error_module_9255,MG_win_read_table)

    L      NP_M4203_error_module_9xxx
    S      MG_error_ext_sag_comp_table_check

    LN     MG_error_ext_sag_comp_table_check
    IFT
      PS     DL_file_handle
      PS     WL_index_ext_sag_comp_data
      PS     S"PUSH_ROD"
      CM     9255                      ;Read a field from a table as an integer value
      PLW
      /      K+100
      =      DG_ext_sag_comp_push_rod[WL_index_ext_sag_comp_data] ;unit = 0.01V
      M_module_error_display(KG_error_module_9255,MG_win_read_table)

      L      NP_M4203_error_module_9xxx
      S      MG_error_ext_sag_comp_table_check
    ENDI

    LN     MG_error_ext_sag_comp_table_check
    IFT
      PS     DL_file_handle
      PS     WL_index_ext_sag_comp_data
      PS     S"PULL_ROD"
      CM     9255                      ;Read a field from a table as an integer value
      PLW
      /      K+100
      =      DG_ext_sag_comp_pull_rod[WL_index_ext_sag_comp_data] ;unit = 0.01V
      M_module_error_display(KG_error_module_9255,MG_win_read_table)

      L      NP_M4203_error_module_9xxx
      S      MG_error_ext_sag_comp_table_check
    ENDI

    L      KL_ext_sag_comp_table_size
    -      K+1
    <=     WL_index_ext_sag_comp_data
    S      MG_ext_sag_comp_file_reading_completed

    L      MG_ext_sag_comp_file_reading_completed
    O      MG_error_ext_sag_comp_table_check
  UNTILT

EM
#endif

