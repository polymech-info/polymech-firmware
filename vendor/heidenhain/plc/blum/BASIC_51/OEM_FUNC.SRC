;      L      K+16
;      =      WL_B_minus_motion_lock

;      L      MG_marker_one
;      =      ML_B_minus_motion_lock
;    ELSE
;      L      K+0
;      =      WL_B_minus_motion_lock

;      L      MG_marker_zero
