#include Mac_Lib.inc

;-----------------------------------------------------------------------------
LBL OEM_function_begin
;-----------------------------------------------------------------------------

  CM     Panel_input_assignment
  CM     Input_reassignment
  CM     Maker_reassignment
  CM     Datum_shifting
  CM     REF_position_initialization
  CM     KINEMATICS_assignment
  CM     DCM_CMO_on_off
  CM     Axes_error_compensation
  CM     MP_file_overwritten
  CM     Axes_clamped_compensation                                    *;EUMACH Table clamped -> Z comp
  CM     Thermal_compensation                                         *;EUMACH Table clamped -> Z comp

EM

;----------------------------
LBL Panel_input_assignment

  L      I_key1_axis_X_plus
#if Additional_machine_panel = &MB620_01
  AN     MG_IPC_61x0_active
  O[
    L      I_key2_axis_X_plus
    A      MG_IPC_61x0_active
  ]
#endif
  =      I_key_axis_1_plus

  L      I_key1_axis_X_minus
#if Additional_machine_panel = &MB620_01
  AN     MG_IPC_61x0_active
  O[
    L      I_key2_axis_X_minus
    A      MG_IPC_61x0_active
  ]
#endif
  =      I_key_axis_1_minus

#if MT = &MT_3A
  L      NP_DCM_option_purchased
  AN     MG_automatic_V_H_head_installed
  IFT                                                                 *;EBM with V/H head + DCM (VMC axis designation)
    L      I_key1_axis_Z_plus                                         *;When V/H head is removed, axis jog key Z+ moves axis 2+ motion.
#if Additional_machine_panel = &MB620_01
    AN     MG_IPC_61x0_active
    O[
      L      I_key2_axis_Z_plus
      A      MG_IPC_61x0_active
    ]
#endif
    =      I_key_axis_2_plus
  ELSE
    L      I_key1_axis_Y_plus
#if Additional_machine_panel = &MB620_01
    AN     MG_IPC_61x0_active
    O[
      L      I_key2_axis_Y_plus
      A      MG_IPC_61x0_active
    ]
#endif
    =      I_key_axis_2_plus
  ENDI
#else
  L      I_key1_axis_Y_plus
#if Additional_machine_panel = &MB620_01
  AN     MG_IPC_61x0_active
  O[
    L      I_key2_axis_Y_plus
    A      MG_IPC_61x0_active
  ]
#endif
  =      I_key_axis_2_plus
#endif

#if MT = &MT_3A
  L      NP_DCM_option_purchased
  AN     MG_automatic_V_H_head_installed
  IFT                                                                 *;EBM with V/H head + DCM (VMC axis designation)
    L      I_key1_axis_Z_minus                                        *;When V/H head is removed, axis jog key Z- moves axis 2- motion.
#if Additional_machine_panel = &MB620_01
    AN     MG_IPC_61x0_active
    O[
      L      I_key2_axis_Z_minus
      A      MG_IPC_61x0_active
    ]
#endif
    =      I_key_axis_2_minus
  ELSE
    L      I_key1_axis_Y_minus
#if Additional_machine_panel = &MB620_01
    AN     MG_IPC_61x0_active
    O[
      L      I_key2_axis_Y_minus
      A      MG_IPC_61x0_active
    ]
#endif
    =      I_key_axis_2_minus
  ENDI
#else
  L      I_key1_axis_Y_minus
#if Additional_machine_panel = &MB620_01
  AN     MG_IPC_61x0_active
  O[
    L      I_key2_axis_Y_minus
    A      MG_IPC_61x0_active
  ]
#endif
  =      I_key_axis_2_minus
#endif

#if MT = &MT_3A
  L      NP_DCM_option_purchased
  AN     MG_automatic_V_H_head_installed
  IFT                                                                 *;EBM with V/H head + DCM (VMC axis designation)
    L      I_key1_axis_Y_plus                                         *;When V/H head is removed, axis jog key Y+ moves axis 3+ motion.
#if Additional_machine_panel = &MB620_01
    AN     MG_IPC_61x0_active
    O[
      L      I_key2_axis_Y_plus
      A      MG_IPC_61x0_active
    ]
#endif
    =      I_key_axis_3_plus
  ELSE
    L      I_key1_axis_Z_plus
#if Additional_machine_panel = &MB620_01
    AN     MG_IPC_61x0_active
    O[
      L      I_key2_axis_Z_plus
      A      MG_IPC_61x0_active
    ]
#endif
    =      I_key_axis_3_plus
