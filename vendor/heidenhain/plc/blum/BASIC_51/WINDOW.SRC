*-----------------------------------------------------------------------------
*  PLC Window (little)
*-----------------------------------------------------------------------------
*  Module Description
*
*-----------------------------------------------------------------------------

#define /s    KL_color_black                           K+1
#define /s    KL_color_grey_10                         K+2
#define /s    KL_color_grey_20                         K+3
#define /s    KL_color_grey_40                         K+4
#define /s    KL_color_grey_60                         K+5
#define /s    KL_color_grey_80                         K+6
#define /s    KL_color_light_green                     K+7
#define /s    KL_color_yellow                          K+8
#define /s    KL_color_red                             K+9
#define /s    KL_color_green                           K+10
#define /s    KL_color_dark_blue                       K+11
#define /s    KL_color_turquoise                       K+12
#define /s    KL_color_blue                            K+13
#define /s    KL_color_purple                          K+14
#define /s    KL_color_white                           K+15

#define /s    KL_line_0                                K+0
#define /s    KL_line_1                                K+1
#define /s    KL_column_0                              K+0
#define /s    KL_column_1                              K+1            *;EUMACH G00% override
#define /s    KL_column_10                             K+10           *;EUMACH G00% override
#define /s    KL_column_11                             K+11
#define /s    KL_column_16                             K+16           *;EUMACH G00% override
#define /s    KL_column_19                             K+19           *;EUMACH
#define /s    KL_column_23                             K+23           *;EUMACH
#define /s    KL_column_26                             K+26           *;EUMACH G00% override
#define /s    KL_column_34                             K+34           *;EUMACH G00% override
#define /s    KL_string_0                              K+0
#define /s    KL_string_1                              K+1            *;EUMACH Dual TC
#define /s    KL_max_bar_chart                         K+150
#define /s    KL_display_without_sign_left             K+0
#define /s    KL_display_no_sign_right                 K+1            *;EUMACH
#define /s    KL_display_sign_right                    K+2
#define /s    KL_0_digits_after_point                  K+0
#define /s    KL_1_digits_after_point                  K+1            *;EUMACH G00% override
#define /s    KL_2_digits_after_point                  K+2            *;EUMACH
#define /s    KL_2_digits_before_point                 K+2            *;EUMACH
#define /s    KL_3_digits_before_point                 K+3
#define /s    KL_4_digits_before_point                 K+4            *;EUMACH
#define /s    KL_5_digits_before_point                 K+5
#define /s    KL_format_time_h_m_s                     K+13
#define /s    KL_error_common                          K-1
#define /s    KL_error_in_display                      K%01
#define /s    KL_error_in_queue                        K%10
#define /s    KL_inactive                              K+0
#define /s    KL_magazine_1                            K+0            *;EUMACH Dual TC
#define /s    KL_magazine_2                            K+1            *;EUMACH Dual TC

#define /s    ML_message_in_PLC_win                    M
#define /s    ML_display_L0_L1_equal                   M
#define /s    ML_axes_in_position                      M
#define /s    ML_spindle_M5                            M
#define /s    ML_PLC_Preset                            M
#define /s    ML_gear_range_display                    M              *;EUMACH
#define /s /r ML_initialization_ok                     M

#define /s    BL_identifier                            B
#define /s    BL_line_number                           B
#define /s    BL_not_used                              B
#define /s    BL_axis_limit                            B
#define /s    BL_index_old                             B


#define /s    WL_S_act_percent                         W
#define /s    WL_drive_utilization_S_absolute          W
#define /s    WL_drive_utilization_absolute            W
#define /s    WL_drive_utilization_0_old               W
#define /s    WL_drive_utilization_1_old               W
#define /s    WL_drive_utilization_S_old               W
#define /s    WL_factor_feed_override                  W
#define /s    WL_S_override_plc                        W

#define /s    DL_spindle_actual_rpm                    D

#include Mac_Lib.inc

EXTERN Absolute

GLOBAL PLC_Window

;----------------------------
LBL PLC_Window

  L      MG_soft_key_mode_line_0
  IFT
    S      MG_clear_screen
    INC    BG_mode_line_0
  ENDI

  L      MG_soft_key_mode_line_1
  IFT
    S      MG_clear_screen
    INC    BG_mode_line_1
  ENDI

  LN     MG_pulse_250_ms
  EMT

  RPLY   BL_identifier
  <>     K+0
  EMT

  SUBM   SubWindow
  =      BL_identifier
  ==     K+0
  S      PN_error_submit_spawn_queue_full

EM

;----------------------------
LBL SubWindow

  L      MG_M80_workpiece_counter_reset
  AN     NP_M4157_mode_restore_position
  IFT
    S      MG_clear_screen
    S      PN_M4092_quit_M_function

    L      K+0
    =      WG_workpiece_counter
  ENDI

  L      MG_M81_workpiece_counter_plus_1
  AN     NP_M4158_mode_block_scan
  IFT
    S      MG_clear_screen
    S      PN_M4092_quit_M_function

    INC    WG_workpiece_counter

    L      WG_workpiece_counter
    >      K+9999
    IFT
      L      K+1
      =      WG_workpiece_counter
    ENDI
  ENDI

  CM     Message_in_PLC_window

  LX
  <>     BL_index_old
  O      MG_clear_screen
  IFT
    R      MG_clear_screen
    CM     9080
    M_display_module_error(KG_error_module_9080)

    L      K-1
    =      BL_axis_limit
    =      WL_drive_utilization_0_old
    =      WL_drive_utilization_1_old
    =      WL_drive_utilization_S_old
    =      WL_factor_feed_override
    =      WL_S_override_plc
    =      DL_spindle_actual_rpm
  ENDI

  LX
  =      BL_index_old

  L      ML_message_in_PLC_win
  IFT
    CM     Display_error
  ELSE

*;EUMACH
    L      BG_mode_line_0
    >      K+14
    IFT
      L      K+0
      =      BG_mode_line_0
    ENDI

    L      BG_mode_line_1
    >      K+14
    IFT
      L      K+0
      =      BG_mode_line_1
    ENDI
*;EUMACH

    L      BG_mode_line_0
    ==     BG_mode_line_1
    =      ML_display_L0_L1_equal

    L      KL_line_0
    =      BL_line_number

    L      BG_mode_line_0
;    >      K+12                                                      *;EUMACH
    >      K+14                                                       *;EUMACH
    IFT
;      L      K+0                                                     *;EUMACH Original PLC
;      =      BG_mode_line_0                                          *;EUMACH Original PLC

*;EUMACH G00% override
;#if Override_knobs ! &2_knobs                                         *;EUMACH G00% override (original PLC)
#if (Override_knobs ! &2_knobs) or (Override_FMAX_instead_S = &active) *;EUMACH S% knob -> FMAX% knob
      L      K-1
      =      BL_axis_limit
      =      WL_drive_utilization_0_old
      =      WL_drive_utilization_1_old
      =      WL_drive_utilization_S_old
      =      WL_factor_feed_override
      =      WL_S_override_plc
      =      DL_spindle_actual_rpm
#endif
*;EUMACH G00% override
    ENDI

    CASE   BG_mode_line_0
      CM     Nnominal_actual           ;00
      CM     S_torque                  ;01
      CM     S_override                ;02
      CM     F_override                ;03
      CM     Axes_utilization          ;04  X
      CM     Axes_utilization          ;05  Y
      CM     Axes_utilization          ;06  Z
      CM     Axes_utilization          ;07  4
      CM     Axes_utilization          ;08  5
      CM     Axes_utilization          ;09  6
      CM     Axes_utilization          ;10  7
      CM     Axes_utilization          ;11  8
      CM     Axes_utilization          ;12  9
      CM     Axes_utilization          ;13  10
      CM     Axes_utilization          ;14  11
      CM     Axes_utilization          ;15  12
      CM     Axes_utilization          ;16  13
      CM     Axes_utilization          ;17  14
    ENDC

    L      KL_line_1
    =      BL_line_number

    L      BG_mode_line_1
;    >      K+12                                                      *;EUMACH
    >      K+14                                                       *;EUMACH
    IFT
;      L      K+0                                                     *;EUMACH Original PLC
;      =      BG_mode_line_1                                          *;EUMACH Original PLC

*;EUMACH G00% override
;#if Override_knobs ! &2_knobs                                         *;EUMACH G00% override (original PLC)
#if (Override_knobs ! &2_knobs) or (Override_FMAX_instead_S = &active) *;EUMACH S% knob -> FMAX% knob
      L      K-1
      =      BL_axis_limit
      =      WL_drive_utilization_0_old
      =      WL_drive_utilization_1_old
      =      WL_drive_utilization_S_old
      =      WL_factor_feed_override
      =      WL_S_override_plc
      =      DL_spindle_actual_rpm
#endif
*;EUMACH G00% override
    ENDI

    CASE   BG_mode_line_1
      CM     Nnominal_actual           ;00
      CM     S_torque                  ;01
      CM     S_override                ;02
      CM     F_override                ;03
      CM     Axes_utilization          ;04  X
      CM     Axes_utilization          ;05  Y
      CM     Axes_utilization          ;06  Z
      CM     Axes_utilization          ;07  4
      CM     Axes_utilization          ;08  5
      CM     Axes_utilization          ;09  6
      CM     Axes_utilization          ;10  7
      CM     Axes_utilization          ;11  8
      CM     Axes_utilization          ;12  9
      CM     Axes_utilization          ;13  10
      CM     Axes_utilization          ;14  11
      CM     Axes_utilization          ;15  12
      CM     Axes_utilization          ;16  13
      CM     Axes_utilization          ;17  14
    ENDC

    CM     Probe_Count
    CM     AxisLimit

  ENDI

  L      MG_submit_CE_key
  S      MG_clear_screen
  CMT    Delete_error_marker
  R      MG_submit_CE_key

  LN     NP_commissioning
  A      ML_initialization_ok
  EMT

  CM     9019
  PL     BG_bytes_on_stack
  M_display_module_error(KG_error_module_9019)

  L      BG_bytes_on_stack
  >      K+0
  S      PN_error_stack_not_empty

  L      ML_initialization_ok
  EMT

  LN     ML_initialization_ok
  S      ML_initialization_ok

  L      K+0
  =      BG_mode_line_0

  L      K+1
  =      BG_mode_line_1

EM

;----------------------------
LBL Message_in_PLC_window

  L      K-1
  =X

  REPEAT
    INCX

    L      MG_PLC_window_begin[X]
    =      ML_message_in_PLC_win

    LX
    >=     K &MG_PLC_window_end - &MG_PLC_window_begin
    O      MG_PLC_window_begin[X]
  UNTILT

  PS     KL_error_common
  CM     9087
  PLW
  <>     KL_error_in_display
  A      ML_message_in_PLC_win
  A      I_control_operational
  S      PN_error_in_PLC_window
  M_display_module_error(KG_error_module_9087)

  LN     ML_message_in_PLC_win
  R      PN_error_in_PLC_window
  IFT
    L      K-1
    =X
  ENDI

EM

;----------------------------
LBL Display_error

  LX
  X      K+2
  =X

  L      S#E200[X]
  =      S0

  PS     KL_line_0
  PS     KL_column_0
  PS     KL_color_red
  PS     KL_string_0
  CM     9082
  M_display_module_error(KG_error_module_9082)

  INCX
  L      S#E200[X]
  =      S0

  PS     KL_line_1
  PS     KL_column_0
  PS     KL_color_red
  PS     KL_string_0
  CM     9082
  M_display_module_error(KG_error_module_9082)

EM

;----------------------------
LBL Delete_error_marker

  L      K-1
  =X

  REPEAT
    INCX
    LX
    >=     K &MG_PLC_window_end - &MG_PLC_window_begin
    O      MG_PLC_window_begin[X]
  UNTILT

  L      MG_marker_one
  R      MG_PLC_window_begin[X]

EM

;----------------------------
LBL Axes_utilization

;#if Override_knobs = &2_knobs                                         *;EUMACH G00% override (original PLC)
#if (Override_knobs = &2_knobs) and (Override_FMAX_instead_S = &inactive) *;EUMACH S% knob -> FMAX% knob
  L      BL_line_number
  ==     KL_line_0
  IFT
    L      BG_mode_line_0
    -      K+4
    =X

    PS     WG_drive_utilization[X]
    CM     Absolute
    PL     WL_drive_utilization_absolute

    L      WL_drive_utilization_absolute
    ==     WL_drive_utilization_0_old
    AN     ML_display_L0_L1_equal
    EMT

    L      WL_drive_utilization_absolute
    =      WL_drive_utilization_0_old
  ELSE
    L      BG_mode_line_1
    -      K+4
    =X

    PS     WG_drive_utilization[X]
    CM     Absolute
    PL     WL_drive_utilization_absolute

    L      WL_drive_utilization_absolute
    ==     WL_drive_utilization_1_old
    AN     ML_display_L0_L1_equal
    EMT

    L      WL_drive_utilization_absolute
    =      WL_drive_utilization_1_old
  ENDI

  PS     BL_line_number
  PS     KL_color_light_green

  L      MG_gear_change_active
  IFT
    L      K+0
    =      WL_drive_utilization_absolute
  ENDI

  L      WL_drive_utilization_absolute
  >=     K+50
  IFT
    PL     BL_not_used
    PS     KL_color_yellow
  ENDI

  L      WL_drive_utilization_absolute
  >=     K+80
  IFT
    PL     BL_not_used
    PS     KL_color_red
  ENDI

  PS     KL_color_grey_20
  PS     WL_drive_utilization_absolute
  PS     KL_max_bar_chart
  CM     9083
  M_display_module_error(KG_error_module_9083)

  PS     WL_drive_utilization_absolute
  PS     KL_display_sign_right
  PS     KL_0_digits_after_point
  PS     KL_3_digits_before_point
  PS     KL_string_0
  CM     9051
  M_display_module_error(KG_error_module_9051)

  L      S0
  +      S#D30[X]
  =      S0

  PS     BL_line_number
  PS     KL_column_0
  PS     KL_color_black
  PS     KL_string_0
  CM     9082
  M_display_module_error(KG_error_module_9082)
#else                                                                 *;EUMACH G00% override
*;EUMACH G00% override
  L      BL_line_number
  ==     KL_line_0
  IFT
    L      BG_mode_line_0
    -      K+4
    =X

    PS     WG_drive_utilization[X]
    CM     Absolute
    PL     WL_drive_utilization_absolute

    L      WL_drive_utilization_absolute
    ==     WL_drive_utilization_0_old
    AN     ML_display_L0_L1_equal
    EMT

    L      WL_drive_utilization_absolute
    =      WL_drive_utilization_0_old

*;No bar chart, only numbers, due to displaying of G00% value
    L      MG_gear_change_active
    IFT
      L      K+0
      =      WL_drive_utilization_absolute
    ENDI

    PS     WL_drive_utilization_absolute
    PS     KL_display_sign_right
    PS     KL_0_digits_after_point
    PS     KL_3_digits_before_point
    PS     KL_string_0
    CM     9051
    M_display_module_error(KG_error_module_9051)

    L      S0
    +      S#D30[X]
    =      S0

    PS     BL_line_number
    PS     KL_column_16
    PS     KL_color_black
    PS     KL_string_0
    CM     9082
    M_display_module_error(KG_error_module_9082)
*;No bar chart, only numbers, due to displaying of G00% value
  ELSE
    L      BG_mode_line_1
    -      K+4
    =X

    PS     WG_drive_utilization[X]
    CM     Absolute
    PL     WL_drive_utilization_absolute

    L      WL_drive_utilization_absolute
    ==     WL_drive_utilization_1_old
    AN     ML_display_L0_L1_equal
    EMT

    L      WL_drive_utilization_absolute
    =      WL_drive_utilization_1_old

    PS     BL_line_number
    PS     KL_color_light_green

    L      MG_gear_change_active
    IFT
      L      K+0
      =      WL_drive_utilization_absolute
    ENDI

    L      WL_drive_utilization_absolute
    >=     K+50
    IFT
      PL     BL_not_used
      PS     KL_color_yellow
    ENDI

    L      WL_drive_utilization_absolute
    >=     K+80
    IFT
      PL     BL_not_used
      PS     KL_color_red
    ENDI

    PS     KL_color_grey_20
    PS     WL_drive_utilization_absolute
    PS     KL_max_bar_chart
    CM     9083
    M_display_module_error(KG_error_module_9083)

    PS     WL_drive_utilization_absolute
    PS     KL_display_sign_right
    PS     KL_0_digits_after_point
    PS     KL_3_digits_before_point
    PS     KL_string_0
    CM     9051
    M_display_module_error(KG_error_module_9051)

    L      S0
    +      S#D30[X]
    =      S0

    PS     BL_line_number
    PS     KL_column_1
    PS     KL_color_black
    PS     KL_string_0
    CM     9082
    M_display_module_error(KG_error_module_9082)
  ENDI
*;EUMACH G00% override
#endif                                                                *;EUMACH G00% override

EM

;----------------------------
LBL S_torque

  PS     WG_drive_utilization_S
  CM     Absolute
  PL     WL_drive_utilization_S_absolute

  L      WL_drive_utilization_S_absolute
  ==     WL_drive_utilization_S_old
  AN     ML_display_L0_L1_equal
  EMT

  L      WL_drive_utilization_S_absolute
  =      WL_drive_utilization_S_old

;#if Override_knobs = &2_knobs                                         *;EUMACH G00% override (original PLC)
#if (Override_knobs = &2_knobs) and (Override_FMAX_instead_S = &inactive) *;EUMACH S% knob -> FMAX% knob
  PS     BL_line_number
  PS     KL_color_light_green

  L      MG_gear_change_active
  IFT
    L      K+0
    =      WL_drive_utilization_S_absolute
  ENDI

  L      WL_drive_utilization_S_absolute
  >=     K+50
  IFT
    PLX
    PS     KL_color_yellow
  ENDI

  L      WL_drive_utilization_S_absolute
  >=     K+80
  IFT
    PLX
    PS     KL_color_red
  ENDI

  L      MG_spindle_stand_still
  IFT
    PLX
    PS     KL_color_grey_10
  ENDI

  PS     KL_color_grey_20
  PS     WL_drive_utilization_S_absolute
  PS     KL_max_bar_chart
  CM     9083
  M_display_module_error(KG_error_module_9083)

  PS     WL_drive_utilization_S_absolute
  PS     KL_display_sign_right
  PS     KL_0_digits_after_point
  PS     KL_3_digits_before_point
  PS     KL_string_0
  CM     9051
  M_display_module_error(KG_error_module_9051)

  L      S0
  +      S"% SLOAD"
  =      S0

  PS     BL_line_number
  PS     KL_column_0
  L      MG_tool_torque_monitoring_active
  IFT
    PS     KL_color_red
  ELSE
    PS     KL_color_black
  ENDI
  PS     KL_string_0
  CM     9082
  M_display_module_error(KG_error_module_9082)
#else                                                                 *;EUMACH G00% override
*;EUMACH G00% override
*;No bar chart, only numbers, due to displaying of G00% value
  L      BL_line_number
  ==     KL_line_0
  IFT
    L      MG_gear_change_active
    IFT
      L      K+0
      =      WL_drive_utilization_S_absolute
    ENDI

    PS     WL_drive_utilization_S_absolute
    PS     KL_display_sign_right
    PS     KL_0_digits_after_point
    PS     KL_3_digits_before_point
    PS     KL_string_0
    CM     9051
    M_display_module_error(KG_error_module_9051)

    L      S0
    +      S"%SLOAD"
    =      S0

    PS     BL_line_number
    PS     KL_column_16
    L      MG_tool_torque_monitoring_active
    IFT
      PS     KL_color_red
    ELSE
      PS     KL_color_black
    ENDI
    PS     KL_string_0
    CM     9082
    M_display_module_error(KG_error_module_9082)
*;No bar chart, only numbers, due to displaying of G00% value
  ELSE
    PS     BL_line_number
    PS     KL_color_light_green

    L      MG_gear_change_active
    IFT
      L      K+0
      =      WL_drive_utilization_S_absolute
    ENDI

    L      WL_drive_utilization_S_absolute
    >=     K+50
    IFT
      PLX
      PS     KL_color_yellow
    ENDI

    L      WL_drive_utilization_S_absolute
    >=     K+80
    IFT
      PLX
      PS     KL_color_red
    ENDI

    L      MG_spindle_stand_still
    IFT
      PLX
      PS     KL_color_grey_10
    ENDI

    PS     KL_color_grey_20
    PS     WL_drive_utilization_S_absolute
    PS     KL_max_bar_chart
    CM     9083
    M_display_module_error(KG_error_module_9083)

    PS     WL_drive_utilization_S_absolute
    PS     KL_display_sign_right
    PS     KL_0_digits_after_point
    PS     KL_3_digits_before_point
    PS     KL_string_0
    CM     9051
    M_display_module_error(KG_error_module_9051)

    L      S0
    +      S"%SLOAD"
    =      S0

    PS     BL_line_number
    PS     KL_column_1
    L      MG_tool_torque_monitoring_active
    IFT
      PS     KL_color_red
    ELSE
      PS     KL_color_black
    ENDI
    PS     KL_string_0
    CM     9082
    M_display_module_error(KG_error_module_9082)
  ENDI                                                                *;EUMACH G00% override
*;EUMACH G00% override
#endif                                                                *;EUMACH G00% override

EM

;----------------------------
LBL Nnominal_actual

  L      DG_spindle_actual_rpm
  ==     DL_spindle_actual_rpm
  AN     ML_display_L0_L1_equal
  O      MG_3D_head_active
  EMT

  L      DG_spindle_actual_rpm
  =      DL_spindle_actual_rpm

  L      DG_spindle_actual_rpm
  X      K+10000
  +[
    L      NP_D356_S_programmed_rpm
    /      K+20
  ]
  /[
    L      NP_D356_S_programmed_rpm
    /      K+10
  ]
  =      WL_S_act_percent

;#if Override_knobs = &2_knobs                                         *;EUMACH G00% override (original PLC)
#if (Override_knobs = &2_knobs) and (Override_FMAX_instead_S = &inactive) *;EUMACH S% knob -> FMAX% knob
  PS     BL_line_number
  PS     KL_color_red

  L      WL_S_act_percent
  >=     K+60
  A[
    L      WL_S_act_percent
    <=     K+120
  ]
  IFT
    PLX
    PS     KL_color_yellow
  ENDI

  L      WL_S_act_percent
  >=     K+80
  A[
    L      WL_S_act_percent
    <=     K+110
  ]
  IFT
    PLX
    PS     KL_color_light_green
  ENDI

  L      MG_spindle_stand_still
  ON     PN_M4012_S_open_control_loop
  IFT
    PLX
    PS     KL_color_grey_10
  ENDI

  PS     KL_color_grey_20

  L      WL_S_act_percent
  PSW
  <      K+0
  ON     PN_M4012_S_open_control_loop
  O      MG_gear_change_active
  O      PN_M4011_S_speed_from_MP3520.0
  IFT
    PLX
    PS     K+0
  ENDI

  PS     KL_max_bar_chart
  CM     9083
  M_display_module_error(KG_error_module_9083)

  L      WL_S_act_percent
  PSW
  >      K+150
  IFT
    PLX
    PS     K+150
  ENDI
  PLW
  PSW
  <      K+0
  ON     PN_M4012_S_open_control_loop
  IFT
    PLX
    PS     K+0
  ENDI

  PS     KL_display_sign_right
  PS     KL_0_digits_after_point
  PS     KL_3_digits_before_point
  PS     KL_string_0
  CM     9051
  M_display_module_error(KG_error_module_9051)

  L      S0
  +      S"% S-ACT"
  =      S0

  PS     BL_line_number
  PS     KL_column_0
  PS     KL_color_black
  PS     KL_string_0
  CM     9082
  M_display_module_error(KG_error_module_9082)
#else                                                                 *;EUMACH G00% override
*;EUMACH G00% override
*;No bar chart, only numbers, due to displaying of G00% value
  L      BL_line_number
  ==     KL_line_0
  IFT
    L      WL_S_act_percent
    PSW
    >      K+150
    IFT
      PLX
      PS     K+150
    ENDI
    PLW
    PSW
    <      K+0
    ON     PN_M4012_S_open_control_loop
    IFT
      PLX
      PS     K+0
    ENDI

    PS     KL_display_sign_right
    PS     KL_0_digits_after_point
    PS     KL_3_digits_before_point
    PS     KL_string_0
    CM     9051
    M_display_module_error(KG_error_module_9051)

    L      S0
    +      S"%S-ACT"
    =      S0

    PS     BL_line_number
    PS     KL_column_16
    PS     KL_color_black
    PS     KL_string_0
    CM     9082
    M_display_module_error(KG_error_module_9082)
*;No bar chart, only numbers, due to displaying of G00% value
  ELSE
    PS     BL_line_number
    PS     KL_color_red

    L      WL_S_act_percent
    >=     K+60
    A[
      L      WL_S_act_percent
      <=     K+120
    ]
    IFT
      PLX
      PS     KL_color_yellow
    ENDI

    L      WL_S_act_percent
    >=     K+80
    A[
      L      WL_S_act_percent
      <=     K+110
    ]
    IFT
      PLX
      PS     KL_color_light_green
    ENDI

    L      MG_spindle_stand_still
    ON     PN_M4012_S_open_control_loop
    IFT
      PLX
      PS     KL_color_grey_10
    ENDI

    PS     KL_color_grey_20

    L      WL_S_act_percent
    PSW
    <      K+0
    ON     PN_M4012_S_open_control_loop
    O      MG_gear_change_active
    O      PN_M4011_S_speed_from_MP3520.0
    IFT
      PLX
      PS     K+0
    ENDI

    PS     KL_max_bar_chart
    CM     9083
    M_display_module_error(KG_error_module_9083)

    L      WL_S_act_percent
    PSW
    >      K+150
    IFT
      PLX
      PS     K+150
    ENDI
    PLW
    PSW
    <      K+0
    ON     PN_M4012_S_open_control_loop
    IFT
      PLX
      PS     K+0
    ENDI

    PS     KL_display_sign_right
    PS     KL_0_digits_after_point
    PS     KL_3_digits_before_point
    PS     KL_string_0
    CM     9051
    M_display_module_error(KG_error_module_9051)

    L      S0
    +      S"%S-ACT"
    =      S0

    PS     BL_line_number
    PS     KL_column_1
    PS     KL_color_black
    PS     KL_string_0
    CM     9082
    M_display_module_error(KG_error_module_9082)
  ENDI
*;EUMACH G00% override
#endif                                                                *;EUMACH G00% override

