;----------------------------
LBL AxisLimit

  LB     MG_axis_limit_1
  ==     BL_axis_limit

*;EUMACH G00% override
;#if Override_knobs ! &2_knobs                                         *;EUMACH G00% override (original PLC)
;#if (Override_knobs ! &2_knobs) or (Override_FMAX_instead_S = &active) *;EUMACH S% knob -> FMAX% knob
;  O[
;    L      BL_axis_limit
;    ==     K-1
;  ]
;#endif
*;EUMACH G00% override
  EMT

  L      S"???"
  =      S0

  L      MG_axis_limit_1
  IFT
    L      S" 1 "
    =      S0
  ENDI

  L      MG_axis_limit_2
  IFT
    L      S" 2 "
    =      S0
  ENDI

  L      MG_axis_limit_3
  IFT
    L      S" 3 "
    =      S0
  ENDI

  L      MG_alternating_table_on
  IFT
    L      S"TABLE"
    +      S0
    =      S0
  ELSE
    L      S"LIMIT"
    +      S0
    =      S0
  ENDI

  PS     KL_line_1
  PS     KL_column_11

  L      MG_soft_key_working_area_monitoring_off
  A      MG_clock_1_s
  IFT
    PS     KL_color_red
  ELSE
    PS     KL_color_yellow
  ENDI

  PS     KL_string_0
  CM     9082
  M_display_module_error(KG_error_module_9082)

*;EUMACH
  L      MG_spindle_with_gear
  A      MG_spindle_active
  AN     NP_without_gear_range_display
  =      ML_gear_range_display

  L      ML_gear_range_display
  ON     MG_soft_key_fluid_flow_valve
  IFT
    L      ML_gear_range_display
    A      MG_soft_key_fluid_flow_valve
    IFT
      L      I_gear_range_1
      XO     I_gear_range_2
      IFT
        L      I_gear_range_1
        AN     I_gear_range_2
        IFT
          L      S"GR1 "
          =      S0
        ELSE
          L      S"GR2 "
          =      S0
        ENDI
      ELSE
        L      S"GR? "
        =      S0
      ENDI

      PS     KL_line_1
      PS     KL_column_19
      PS     KL_color_black
      PS     KL_string_0
      CM     9082
      M_display_module_error(KG_error_module_9082)
    ELSE
      LN     ML_gear_range_display
      AN     MG_soft_key_fluid_flow_valve
      IFT
        LN     MG_clock_1_s
        IFT
          L      S"M09 "
          =      S0

          PS     KL_line_1
          PS     KL_column_19
          PS     KL_color_red
          PS     KL_string_0
          CM     9082
          M_display_module_error(KG_error_module_9082)
        ELSE
          L      S"    "
          =      S0

          PS     KL_line_1
          PS     KL_column_19
          PS     KL_color_black
          PS     KL_string_0
          CM     9082
          M_display_module_error(KG_error_module_9082)
        ENDI
      ELSE
        L      ML_gear_range_display
        A      MG_clock_1_s
        IFT
          L      I_gear_range_1
          XO     I_gear_range_2
          IFT
            L      I_gear_range_1
            AN     I_gear_range_2
            IFT
              L      S"GR1 "
              =      S0
            ELSE
              L      S"GR2 "
              =      S0
            ENDI
          ELSE
            L      S"GR? "
            =      S0
          ENDI

          PS     KL_line_1
          PS     KL_column_19
          PS     KL_color_black
          PS     KL_string_0
          CM     9082
          M_display_module_error(KG_error_module_9082)
        ENDI

        LN     MG_soft_key_fluid_flow_valve
        AN     MG_clock_1_s
        IFT
          L      S"M09 "
          =      S0

          PS     KL_line_1
          PS     KL_column_19
          PS     KL_color_red
          PS     KL_string_0
          CM     9082
          M_display_module_error(KG_error_module_9082)
        ENDI
      ENDI
    ENDI
  ELSE
    L      S"    "
    =      S0

    PS     KL_line_1
    PS     KL_column_19
    PS     KL_color_black
    PS     KL_string_0
    CM     9082
    M_display_module_error(KG_error_module_9082)
  ENDI

#if Cycle_332 = &active
  L      BG_tuning_mode
  ==     K+0
  IFT
    L      S"L"
    =      S0
  ELSE
    L      BG_tuning_mode
    ==     K+1
    IFT
      L      S"M"
      =      S0
    ELSE
      L      BG_tuning_mode
      ==     K+2
      IFT
        L      S"H"
        =      S0
      ELSE
        L      S"?"
        =      S0
      ENDI
    ENDI
  ENDI
#else
  L      S" "
  =      S0
#endif

  PS     KL_line_1
  PS     KL_column_23
  PS     KL_color_blue
  PS     KL_string_0
  CM     9082
  M_display_module_error(KG_error_module_9082)
*;EUMACH

EM

;----------------------------
LBL Probe_Count

*;EUMACH G00% override (G00% & G01% value display)
;#if Override_knobs ! &2_knobs                                         *;EUMACH G00% override (original PLC)
#if (Override_knobs ! &2_knobs) or (Override_FMAX_instead_S = &active) *;EUMACH S% knob -> FMAX% knob
  L      NP_W752_rapid_traverse_override_PLC
  /      K+10
  PSW
  PS     KL_display_sign_right
  PS     KL_1_digits_after_point
  PS     KL_3_digits_before_point
  PS     KL_string_0
  CM 9051
  M_display_module_error(KG_error_module_9051)

  L      S0
  +      S"%FMAX"
  =      S0

  PS     KL_line_0
  PS     KL_column_0
  PS     KL_color_purple
  PS     KL_string_0
  CM     9082
  M_display_module_error(KG_error_module_9082)

  L      PN_W766_factor_feed_override_PLC
  /      K+100
  PSW
  PS     KL_display_sign_right
  PS     KL_0_digits_after_point
  PS     KL_3_digits_before_point
  PS     KL_string_0
  CM     9051
  M_display_module_error(KG_error_module_9051)

  L      S0
  +      S"%F "
  =      S0

  PS     KL_line_0
  PS     KL_column_10
  PS     KL_color_black
  PS     KL_string_0
  CM     9082
  M_display_module_error(KG_error_module_9082)
#endif
*;EUMACH G00% override (G00% & G01% value display)

  L      MG_TC_manual
  O      MG_TC_automatic
  O      MG_TC_help
  O      MG_T_select_start                                            *;EUMACH standby tool loading/unloading
  O      MG_TC_magazine_start
;  O      MG_soft_key_TC_mag_load_active                              *;EUMACH
  O      MG_TM_loading_active                                         *;EUMACH
#if (Tool_magazine_system_2 ! &inactive) or (Tool_changing_arm_2 ! &inactive) *;EUMACH Dual TC
  O      MG_TC2_automatic                                             *;EUMACH Dual TC
  O      MG_TC_magazine_2_start                                       *;EUMACH Dual TC
  O      MG_TM2_loading_active                                        *;EUMACH Dual TC
#endif                                                                *;EUMACH Dual TC
  AN     NP_display_standby_pocket_inactive
  A      MG_TC_auto_active
  IFT
*;EUMACH Dual TC
    L      MG_TC_magazine_2_active
    IFT
      L      MG_clock_2_s
      IFT
        PS     WG_TC_magazine_actual_pocket
      ELSE
        PS     WG_TC_magazine_2_actual_pocket
      ENDI
    ELSE
*;EUMACH Dual TC
      PS     WG_TC_magazine_actual_pocket
    ENDI                                                              *;EUMACH Dual TC
;    PS     KL_display_without_sign_left                              *;EUMACH Original PLC
    PS     KL_display_no_sign_right                                   *;EUMACH
    PS     KL_0_digits_after_point
    PS     KL_3_digits_before_point
    PS     KL_string_0
    CM     9051
    M_display_module_error(KG_error_module_9051)

*;EUMACH Dual TC
    L      MG_TC_magazine_2_active
    IFT
      L      MG_clock_2_s
      IFT
        L      S"P1-"
        +      S0
        +      S"  "
        =      S0
      ELSE
        L      S"P2-"
        +      S0
        +      S"  "
        =      S0
      ENDI
    ELSE
*;EUMACH Dual TC
      L      S"P "
      +      S0                                                       *;EUMACH
;      +      S"        "                                             *;EUMACH Original PLC
      +      S"   "                                                   *;EUMACH
      =      S0
    ENDI                                                              *;EUMACH Dual TC
  ELSE
    L      WG_workpiece_counter
    >      K+0
    IFT
      PS     WG_workpiece_counter
      PS     KL_display_without_sign_left
      PS     KL_0_digits_after_point
      PS     KL_5_digits_before_point
      PS     KL_string_0
      CM     9051
      M_display_module_error(KG_error_module_9051)

      L      S"WP:"
      +      S0
;      +      S"     "                                                *;EUMACH Original PLC
      =      S0
    ELSE
      L      BG_PLC_preset_number
      >      KL_inactive
      IFT
        S      ML_PLC_Preset
        PS     BG_PLC_preset_number
        PS     KL_display_without_sign_left
        PS     KL_0_digits_after_point
        PS     KL_3_digits_before_point
        PS     KL_string_0
        CM     9051
          M_display_module_error(KG_error_module_9051)

        L      S"DAT"
        +      S0
;        +      S"       "                                            *;EUMACH Original PLC
        +      S"  "                                                  *;EUMACH
        =      S0
      ELSE
*;EUMACH Standby tool number display & feed disable
        L      MG_TC_auto_active
        A      NP_display_standby_tool_number
#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
        O      MG_feed_disable_axis_4
        O      MG_feed_disable_axis_5
#else
        O      MG_feed_disable_axis_4
#endif
        IFT
          L      MG_feed_disable_axis_4
#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
          O      MG_feed_disable_axis_5
#endif
          AN     MG_clock_1_s
          IFT
#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
            L      MG_feed_disable_axis_4
            AN     MG_feed_disable_axis_5
            IFT
              L      S"C1-LCK  "
              =      S0
            ENDI

            LN     MG_feed_disable_axis_4
            A      MG_feed_disable_axis_5
            IFT
              L      S"C2-LCK  "
              =      S0
            ENDI

            L      MG_feed_disable_axis_4
            A      MG_feed_disable_axis_5
            IFT
              L      S"C1C2-LCK"
              =      S0
            ENDI
#else
            L      S"C-LOCKED"
            =      S0
#endif
          ELSE
            L      S"        "
            =      S0
          ENDI

          L      MG_feed_disable_axis_4
#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
          O      MG_feed_disable_axis_5
#endif
          A      MG_clock_1_s
#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
          O[
            LN     MG_feed_disable_axis_4
            AN     MG_feed_disable_axis_5
          ]
#else
          ON     MG_feed_disable_axis_4
#endif
          A      MG_TC_auto_active
          A      NP_display_standby_tool_number
          IFT
            PS     WG_TC_standby_tool_number
            PS     KL_display_no_sign_right
            PS     KL_0_digits_after_point
            PS     KL_4_digits_before_point
            PS     KL_string_0
            CM     9051
            M_display_module_error(KG_error_module_9051)

            L      S"STDT"
            +      S0
            =      S0
          ENDI
        ELSE
*;EUMACH Standby tool number display & feed disable
          PS     DG_real_time
          PS     KL_string_0
          PS     KL_format_time_h_m_s
          CM     9055
          M_display_module_error(KG_error_module_9055)

          L      K+5
          =X

          L      S""
          =      S0^X

          L      S0
;          +      S"        "                                         *;EUMACH Original PLC
          +      S"   "                                               *;EUMACH
          =      S0
        ENDI                                                          *;EUMACH
      ENDI
    ENDI
  ENDI

*;EUMACH Spindle warming-up count down display
#if HSS ! &inactive
  L      PN_error_spindle_during_warming_up
  ON     MG_spindle_warmed_up
  A      MG_spindle_active
  IFT
    PS     WG_spindle_warming_up_remaining_seconds
    PS     KL_display_no_sign_right
    PS     KL_0_digits_after_point
    PS     KL_5_digits_before_point
    PS     KL_string_0
    CM     9051
    M_display_module_error(KG_error_module_9051)

    L      S0
;    +      S" S"                                                     *;EUMACH Original PLC
    +      S" S "                                                     *;EUMACH
    =      S0
  ENDI
#endif
*;EUMACH Spindle warming-up count down display

  L      MG_touch_probe_active
  A      MG_clock_1_s
  IFT
;    L      S"PROBE    "
    L      S"PROBE   "                                                *;EUMACH Original PLC
    =      S0
  ENDI

  L      MG_auto_power_off_after_END_PGM
  A      NP_auto_power_off_after_END_PGM_active                       *;EUMACH
  AN     MG_clock_1_s
  IFT
;    L      S"END OFF  "
    L      S"END OFF "                                                *;EUMACH Original PLC
    =      S0
  ENDI

*;EUMACH Tool clamping/unclamping sensor voltage display
#if Tool_clamping_sensor_type = &Analog
  L      MG_sensor_calibration_active
  IFT
;    PS     WG_voltage_input_0_on_MC                                   *;EUMACH non-HSCI
    PS     IW_S_tool_clamp_unclamp_sensor_voltage                     *;EUMACH HSCI
    PS     KL_display_no_sign_right
    PS     KL_2_digits_after_point
    PS     KL_2_digits_before_point
    PS     KL_string_0
    CM     9051
    M_display_module_error(KG_error_module_9051)

    L      O_tool_unclamping
    IFT
      L      S"UCP"
      +      S0
      =      S0
    ELSE
      L      S"CLP"
      +      S0
      =      S0
    ENDI
  ENDI
#endif
*;EUMACH Tool clamping/unclamping sensor voltage display

  PS     KL_line_0
;#if Override_knobs ! &2_knobs                                         *;EUMACH G00% override (original PLC)
#if (Override_knobs ! &2_knobs) or (Override_FMAX_instead_S = &active) *;EUMACH S% knob -> FMAX% knob
  PS     KL_column_26                                                 *;EUMACH G00% override
#else
  PS     KL_column_11
#endif                                                                *;EUMACH G00% override

  L      MG_touch_probe_active
  A      MG_clock_1_s
  O[
    L      MG_auto_power_off_after_END_PGM
*;EUMACH
    A      NP_auto_power_off_after_END_PGM_active
#if (MT = &MT_2D) or (MT = &MT_37) or (MT = &MT_37A) or (MT = &MT_37B)
    O      MG_feed_disable_axis_4
    O      MG_feed_disable_axis_5
#else
    O     MG_feed_disable_axis_4
#endif
*;EUMACH
    AN     MG_clock_1_s
  ]
  O      MG_sensor_calibration_active                                 *;EUMACH
  IFT
    PS     KL_color_red
  ELSE
    L      ML_PLC_Preset
    R      ML_PLC_Preset
    IFT
      PS     KL_color_yellow
    ELSE
#if HSS ! &inactive                                                   *;EUMACH
      L      PN_error_spindle_during_warming_up                       *;EUMACH
      ON     MG_spindle_warmed_up                                     *;EUMACH
      A      MG_spindle_active                                        *;EUMACH
      A      MG_clock_1_s                                             *;EUMACH
#else
      L      MG_marker_zero                                           *;EUMACH
#endif                                                                *;EUMACH
      IFT                                                             *;EUMACH
        PS     KL_color_red                                           *;EUMACH
      ELSE                                                            *;EUMACH
        PS     KL_color_black
      ENDI                                                            *;EUMACH
    ENDI
  ENDI

  PS     KL_string_0
  CM     9082
  M_display_module_error(KG_error_module_9082)

*;EUMACH
  L      MG_soft_key_F100_percent
  A      MG_clock_1_s
  IFT
    L      S"F100%"
    =      S0
  ELSE
#if ((Override_knobs = &2_knobs) and (Override_FMAX_instead_S = &inactive)) or (Override_knobs = &3_knobs) *;EUMACH S% knob -> FMAX% knob
    L      MG_soft_key_S100_percent
    AN     MG_clock_1_s
    IFT
      L      S"S100%"
      =      S0
    ELSE
      L      S"     "
      =      S0
    ENDI
#else                                                                 *;EUMACH S% knob -> FMAX% knob
    L      S"     "                                                   *;EUMACH S% knob -> FMAX% knob
    =      S0                                                         *;EUMACH S% knob -> FMAX% knob
#endif                                                                *;EUMACH S% knob -> FMAX% knob
  ENDI

  PS     KL_line_0
;#if Override_knobs ! &2_knobs                                         *;EUMACH G00% override (original PLC)
#if (Override_knobs ! &2_knobs) or (Override_FMAX_instead_S = &active) *;EUMACH S% knob -> FMAX% knob
  PS     KL_column_34                                                 *;EUMACH G00% override
#else
  PS     KL_column_19
#endif                                                                *;EUMACH G00% override
  PS     KL_color_red
  PS     KL_string_0
  CM     9082
  M_display_module_error(KG_error_module_9082)
*;EUMACH

EM

