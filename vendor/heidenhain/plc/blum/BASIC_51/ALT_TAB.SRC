;----------------------------
LBL Limit_1_2_Selection                ;15

  L      MG_M61_alternating_table_1
  =      MG_axis_limit_1
  =N     MG_axis_limit_2
  =N     PN_M4574_axis_limit_Bit_0

*;EUMACH
  L      MG_marker_one
  S      PN_M4135_strobe_axes_limit
  PSL
*;EUMACH
;  PS     MG_marker_one                                               *;EUMACH Original PLC

EM

;----------------------------                                         *;EUMACH
LBL Y_end_start_alt_table              ;16

  PS     KG_axis_Y
  PS     NP_D920_posit_Y_end_alternating_table
  L      NP_D772_feed_PLC_Y
  /      K+10000
  PSW
  PS     KL_absolute_without_software_limit_switch
  CM     9221
  PLW
  ==     K+0
  PSL
  M_display_module_error(KG_error_module_9221)

EM

;----------------------------                                         *;EUMACH
LBL Y_end_in_Pos                       ;17

  L      DG_position_axis_Y_ref
  -      NP_D920_posit_Y_end_alternating_table
  PSW
  CM     Absolute
  PLW
  <      DG_MP1030_pos_window_Y
  AN     PN_M4121_strobe_PLC_posit_axis_Y
  AN     MG_interrupt_alternating_table
  PSL

EM

;----------------------------
LBL Alt_table_quit                     ;18

  L      MG_M61_alternating_table_1
  O      MG_M62_alternating_table_2
  AN     PN_M4135_strobe_axes_limit
  S      PN_M4092_quit_M_function

  LN     NP_M4072_strobe_M_function
  AN     PN_M4135_strobe_axes_limit
  PSL
*;EUMACH Auto door
#if ADS ! &inactive
  IFT
    L      MG_axis_limit_2
    R      O_auto_door_1_closing

    L      NP_all_modes_auto_door_opening_M61_M62
    O      NP_M4153_mode_program_run_single_block
    O      NP_M4154_mode_program_run_full_sequence
    A      NP_auto_door_opening_after_M61_M62
    A      MG_axis_limit_2
    S      O_auto_door_1_opening

    L      MG_axis_limit_1
    R      O_auto_door_2_closing

    L      NP_all_modes_auto_door_opening_M61_M62
    O      NP_M4153_mode_program_run_single_block
    O      NP_M4154_mode_program_run_full_sequence
    A      NP_auto_door_opening_after_M61_M62
    A      MG_axis_limit_1
    S      O_auto_door_2_opening
  ENDI
#endif
*;EUMACH Auto door
EM

;----------------------------
LBL Alt_table_end                      ;19

  PS     MG_marker_zero

LBL Alt_table_reset

  L      MG_marker_one
  R      MG_enable_alternating_table
  R      MG_new_workpiece_table_1
  R      MG_new_workpiece_table_2
  R      MG_interrupt_alternating_table

  L      K+0
  =      BL_step_alternating_table

EM
