  <      DG_MP1030_pos_window_X
  AN     PN_M4120_strobe_PLC_posit_axis_X
  AN     MG_interrupt_alternating_table
  PSL

EM

;----------------------------                                         *;EUMACH
LBL B_end_alt_table                    ;13

#if MT = &MT_2D
  PS     KG_axis_6
  PS     KL_0_degree
  L      NP_D788_feed_PLC_6
  /      K+10000
  PSW
  PS     KL_absolute_with_software_limit_switch
  CM     9221
  PLW
  ==     K+0
  PSL
  M_display_module_error(KG_error_module_9221)
