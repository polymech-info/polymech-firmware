#endif

EM

;----------------------------                                         *;EUMACH
LBL B_end_in_Pos                       ;14

#if MT = &MT_2D
  L      DG_position_axis_6_ref
  -      KL_0_degree
  PSW
  CM     Absolute
  PLW
  <      DG_MP1030_pos_window_6
