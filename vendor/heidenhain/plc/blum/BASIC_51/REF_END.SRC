  IFT
    L      WG_MP1320_direction_traverse_ref_negative
    BT     KG_axis_X
    IFT
      L      DG_position_axis_X_ref
      <      K+0
      =      MG_ref_end_position_X
    ELSE
      L      DG_position_axis_X_ref
      >      K+0
      =      MG_ref_end_position_X
    ENDI
  ENDI
#endif

