  LN     I_not_ref_end_posit_16
  =      MG_ref_end_position_16
#endif

  L      NP_W1032_reference_nesessary
  O      WG_PLC_reference_necessary
  AN     WG_MP12_simulated_axes                                       *;EUMACH MP12
  ==     K+0
  R      ML_reference_auto_start
  EMT

  LW     MG_ref_end_positions
  =      PN_W1054_reference_end_position

;Special functions

  LN     NP_W1032_reference_nesessary
  A      WL_pos_0_degree_necessary
  A      KG_0_degree_positioning
  AN     WG_PLC_axes
  <>     K+0
  A      MG_axes_in_position
  A      ML_reference_auto_start
  CMT    Posit_0_degree

  L      PN_W1046_manual_motion_plus
  O      PN_W1048_manual_motion_minus
  A      WG_controlled_axes                                           *;EUMACH
  >      K+0
  =      MG_manual_motion_in_reference_mode

  L      MG_key_NC_start
  AN     NP_ref_autostart_inactive
  S      ML_reference_auto_start

  L      MG_manual_motion_in_reference_mode
  O      MG_key_NC_stop
  O      MG_TC_help
  O      MG_PC_help
  O      PN_error_safety_mode_2                                       *;EUMACH CE 2008
  ON     MG_control_operational
  R      ML_reference_auto_start

  LW     PN_M4120_strobe_PLC_posit_axis_X
  A      K$1FF
  >      K+0
  =      ML_PLC_posit_active

  L      PN_W1038_activate_control_loop_open
  ==     PN_W1040_control_loop_open
  =      ML_control_loop_open

  L      NP_W1032_reference_nesessary
  <>     WG_PLC_reference_necessary
  A[
    L      NP_W1032_reference_nesessary
    >      K+0
  ]
  A      ML_reference_auto_start
  A      MG_axes_in_position
  A      ML_control_loop_open
  AN     ML_PLC_posit_active
  A      NP_M4155_mode_pass_over_reference
  =      MG_NC_start_from_reference

  L      MG_axes_in_position
  IFT
    L      NP_W1032_reference_nesessary
    =      WL_pos_0_degree_necessary
  ENDI

*$WS
;  L      NP_W1032_Referenz_notwendig
;  >      WG_PLC_Referenz_notwendig
;  AN     ML_Achsen_Moment_reduziert
;  IFT
;    S     ML_Achsen_Moment_reduziert
;    L      K+0
;    =X
;    REPEAT
;      PSX
;      L      NP_MP4230_10_Moment_reduziert_X[X]
;      /      K+10
;      PSW
;      CM     9158
;       M_Modul_Fehler_anzeigen(KG_Fehler_Modul_9158)
;
;      INCX
;      LX
;      >=     KG_max_Achs_Anzahl
;    UNTILT
;  ENDI
;
  LN     ML_PLC_posit_active
  A      MG_axes_in_position
  A      ML_control_loop_open
  IFT
    L      NP_W1032_reference_nesessary
    =      WG_PLC_reference_necessary
  ENDI

*$WS
;  L      NP_W1032_Referenz_notwendig
;  O      WG_PLC_Referenz_notwendig
;  ==     K+0
;  IFT
;    R     ML_Achsen_Moment_reduziert
;
;    L      K+0
;    =X
;    REPEAT
;      PSX
;      PS     KL_inaktiv
;      CM     9158
;       M_Modul_Fehler_anzeigen(KG_Fehler_Modul_9158)
;      INCX
;      LX
;      >=     KG_max_Achs_Anzahl
;    UNTILT
;  ENDI
;
EM

;----------------------------
LBL Posit_0_degree

  L      K-1
  =X

  REPEAT
    INCX

    LN     NP_W1032_reference_nesessary
    A      WL_pos_0_degree_necessary
    BTX
  UNTILT

  PSX
  PS     NP_MP4230_12_posit_after_reference_X[X]
  PS     WG_MP1330_feed_X_ref[X]
*;EUMACH BASIC 54
  L      MG_DCM_active
  IFT
    PS     KL_absolute_with_soft_limit_no_DCM
  ELSE
    PS     KL_absolute_with_software_limit_switch
  ENDI
*;EUMACH BASIC 54
  CM     9221
  PLX
  M_display_module_error(KG_error_module_9221)

EM
