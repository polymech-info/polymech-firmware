#if (KG_reference_end_position_software & %0000000000000001) = 0
*;EUMACH
#if Pallet_changer = &Alternat_table
  L      WG_MP1320_direction_traverse_ref_negative
  BT     KG_axis_X
  IFT
    LN     I_alternat_table_partition_removed
    A      MG_alternating_table_on
    A[
      L      DG_position_axis_X_ref
      >      NP_D940_limit_X_alternating_table
    ]
    IFT
      L      I_alternating_table_zone_overtravel
      =      MG_ref_end_position_X
    ELSE
      LN     I_not_ref_end_posit_X
      =      MG_ref_end_position_X
    ENDI
  ELSE
    LN     I_alternat_table_partition_removed
    A      MG_alternating_table_on
    A[
      L      DG_position_axis_X_ref
      <=     NP_D940_limit_X_alternating_table
    ]
    IFT
      L      I_alternating_table_zone_overtravel
      =      MG_ref_end_position_X
    ELSE
      LN     I_not_ref_end_posit_X
      =      MG_ref_end_position_X
    ENDI
  ENDI
*;EUMACH
#else                                                                 *;EUMACH
  LN     I_not_ref_end_posit_X
  =      MG_ref_end_position_X
#endif                                                                *;EUMACH
#endif

