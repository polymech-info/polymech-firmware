{
  "name": "mb-logic-engine-ts-ref",
  "version": "1.0.0",
  "description": "TypeScript ESM reference implementation for Modbus Logic Engine",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc -w & nodemon dist/index.js",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run src/e2e.test.ts",
    "test:e2e:watch": "vitest src/e2e.test.ts",
    "server:run": "npm run build && node dist/index.js serve"
  },
  "keywords": [
    "modbus",
    "logic-engine",
    "typescript",
    "esm"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.11.20",
    "@types/yargs": "^17.0.32",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "dependencies": {
    "tslog": "^4.9.2",
    "yargs": "^17.7.2",
    "zod": "^3.22.4",
    "jsmodbus": "^4.0.6"
  }
} 